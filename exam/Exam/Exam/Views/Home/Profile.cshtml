@model Exam.DTOs.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile - الملف الشخصي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-6">

    <!-- 1. USER PROFILE CARD (SIMPLE & CLEAN) -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            
            <!-- User Basic Info -->
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 font-black text-2xl flex-shrink-0">
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Trim()[0].ToString().ToUpper())
                </div>

                <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-900">@Model.FullName</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700">
                            @Model.RoleName
                        </span>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                        <span><i class="far fa-user text-slate-400 mr-1"></i> @Model.UserName</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <span>•</span>
                            <span><i class="far fa-envelope text-slate-400 mr-1"></i> @Model.Email</span>
                        }
                    </div>

                    <!-- Code Badge -->
                    <div class="pt-1 flex items-center gap-2 text-xs">
                        <span class="text-slate-400">الكود الأكاديمي:</span>
                        <button onclick="copyToClipboard('@Model.UserCode', this)" 
                                class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-md font-mono font-bold transition-all text-xs" 
                                title="نسخ الكود">
                            <span>@(string.IsNullOrWhiteSpace(Model.UserCode) ? "N/A" : Model.UserCode)</span>
                            <i class="far fa-copy text-slate-400 text-[10px]"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Branch & Shift details -->
            <div class="flex flex-wrap items-center gap-3 sm:border-l sm:border-slate-100 sm:pl-6">
                <div class="bg-slate-50 rounded-xl px-4 py-2.5 border border-slate-100 text-left min-w-[130px]">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Branch</span>
                    <span class="text-xs font-bold text-slate-800 block truncate">@Model.BranchName</span>
                </div>

                <div class="bg-slate-50 rounded-xl px-4 py-2.5 border border-slate-100 text-left min-w-[130px]">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Shift</span>
                    <span class="text-xs font-bold text-brand-600 block truncate">@Model.ShiftName</span>
                </div>
            </div>

        </div>
    </div>

    <!-- 2. PROFILE NAVIGATION TABS -->
    <div class="bg-white rounded-2xl border border-slate-200 p-2 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2 p-1 bg-slate-100 rounded-xl" id="profileTabsNav" role="tablist">
                <!-- Tab 1: My Certificates -->
                <button type="button" 
                        onclick="switchProfileTab('certificates')" 
                        id="tabBtn-certificates"
                        class="profile-tab-btn px-4 py-2.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2 bg-white text-brand-700 shadow-sm">
                    <i class="fas fa-award text-sm text-brand-600"></i>
                    <span>شهاداتي (Certificates)</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-50 text-brand-600">
                        @Model.Certificates.Count()
                    </span>
                </button>

                <!-- Tab 2: My Exams -->
                <button type="button" 
                        onclick="switchProfileTab('exams')" 
                        id="tabBtn-exams"
                        class="profile-tab-btn px-4 py-2.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                    <i class="fas fa-file-signature text-sm text-emerald-600"></i>
                    <span>امتحاناتي (My Exams)</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700">
                        @(Model.Exams?.Count() ?? 0)
                    </span>
                </button>

                <!-- Tab 3: My Assignments -->
                <button type="button" 
                        onclick="switchProfileTab('assignments')" 
                        id="tabBtn-assignments"
                        class="profile-tab-btn px-4 py-2.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                    <i class="fas fa-tasks text-sm text-indigo-600"></i>
                    <span>تكليفاتي (My Assignments)</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700">
                        @(Model.Assignments?.Count() ?? 0)
                    </span>
                </button>

                <!-- Tab 4: Wave Registration Form -->
                <button type="button" 
                        onclick="switchProfileTab('waveform')" 
                        id="tabBtn-waveform"
                        class="profile-tab-btn px-4 py-2.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                    <i class="fas fa-clipboard-list text-sm text-amber-500"></i>
                    <span>استمارة تسجيل الويف (Wave Form)</span>
                </button>

                @if (Model.HasProgramDashAccess)
                {
                    <!-- Tab 5: Program Dash -->
                    <button type="button" 
                            onclick="switchProfileTab('program')" 
                            id="tabBtn-program"
                            class="profile-tab-btn px-4 py-2.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                        <i class="fas fa-project-diagram text-sm text-slate-800"></i>
                        <span>لوحة التدريب (Program Dash)</span>
                    </button>
                }
            </div>

            <div class="hidden lg:flex items-center gap-2 px-3 text-xs text-slate-400 font-medium">
                <i class="fas fa-compass text-slate-300"></i>
                <span>Trainee Hub Navigation</span>
            </div>
        </div>
    </div>

    <!-- 3. TAB CONTENT 1: MY CERTIFICATES -->
    <div id="tabContent-certificates" class="profile-tab-content space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i class="fas fa-award text-brand-600"></i>
                    <span>شهاداتي (My Certificates)</span>
                </h2>
                <span class="text-xs font-bold text-slate-400">@Model.Certificates.Count() شهادة</span>
            </div>

            @if (Model.Certificates != null && Model.Certificates.Any())
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var cert in Model.Certificates)
                    {
                        <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="flex items-start gap-3">
                                <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-500 text-base flex-shrink-0 mt-0.5">
                                    <i class="fas fa-certificate text-brand-600"></i>
                                </div>

                                <div class="space-y-0.5">
                                    <p class="text-sm font-bold text-slate-900">@cert.WaveName</p>
                                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                        <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-[11px] text-slate-700 font-bold">@cert.CertificateCode</span>
                                        @if (cert.Score.HasValue)
                                        {
                                            <span>• النتيجة: <strong class="text-brand-600">@cert.Score.Value.ToString("0.##")%</strong></span>
                                        }
                                        @if (cert.CreatedAt.HasValue)
                                        {
                                            <span>• @cert.CreatedAt.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 sm:self-center">
                                @if (cert.HasFileOnDisk && !string.IsNullOrEmpty(cert.DownloadUrl))
                                {
                                    <a href="@cert.DownloadUrl" download 
                                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold transition-all shadow-sm">
                                        <i class="fas fa-download"></i>
                                        <span>تحميل الشهادة</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                                        معتمدة بالنظام
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-8 text-center text-slate-400 text-xs font-medium">
                    <i class="fas fa-file-alt text-2xl text-slate-300 mb-2 block"></i>
                    لا توجد شهادات مرفوعة لك حالياً. ستظهر هنا فور اعتمادها ورفعها من الأكاديمية.
                </div>
            }
        </div>
    </div>

    <!-- 4. TAB CONTENT 2: WAVE EXAM REGISTRATION FORM -->
    <div id="tabContent-waveform" class="profile-tab-content hidden space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
            
            <!-- Header Notice -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-xl flex-shrink-0">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                            <span>استمارة تسجيل الويف</span>
                            <span class="text-xs font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200/60">Wave Registration Form</span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-1">يرجى الضغط على الرابط أدناه لفتح الاستمارة في نافذة جديدة واستيفاء البيانات المطلوبة للويف التدريبي.</p>
                    </div>
                </div>

                <a href="@Model.WaveFormUrl" target="_blank" rel="noopener noreferrer" 
                   class="inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-black uppercase tracking-wider transition-all shadow-md shadow-amber-500/20 hover:shadow-amber-500/30 flex-shrink-0">
                    <span>فتح الاستمارة (Open Form)</span>
                    <i class="fas fa-external-link-alt text-xs"></i>
                </a>
            </div>

            <!-- Trainee Quick Copy Helper (كود الطالب وبياناته للتسهيل عند ملء الاستمارة) -->
            <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200/80 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                        <i class="fas fa-id-card text-brand-600"></i> بياناتك المطلوب إدخالها في الاستمارة (اضغط للنسخ):
                    </span>
                    <span class="text-[11px] text-slate-400">تأكد من مطابقة هذه البيانات في النموذج</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                    <!-- Academic Code -->
                    <div class="bg-white rounded-xl p-3 border border-slate-200 shadow-xs flex items-center justify-between">
                        <div>
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">كود المستخدم / الطالب</span>
                            <span class="text-xs font-mono font-bold text-slate-900 block mt-0.5">@(string.IsNullOrWhiteSpace(Model.UserCode) ? "N/A" : Model.UserCode)</span>
                        </div>
                        <button type="button" onclick="copyToClipboard('@Model.UserCode', this)" 
                                class="p-2 rounded-lg bg-slate-100 hover:bg-brand-50 text-slate-500 hover:text-brand-600 text-xs transition-all"
                                title="نسخ الكود">
                            <i class="far fa-copy"></i>
                        </button>
                    </div>

                    <!-- User Name -->
                    <div class="bg-white rounded-xl p-3 border border-slate-200 shadow-xs flex items-center justify-between">
                        <div class="truncate mr-2">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">الاسم المسجل</span>
                            <span class="text-xs font-bold text-slate-900 block mt-0.5 truncate">@Model.FullName</span>
                        </div>
                        <button type="button" onclick="copyToClipboard('@Model.FullName', this)" 
                                class="p-2 rounded-lg bg-slate-100 hover:bg-brand-50 text-slate-500 hover:text-brand-600 text-xs transition-all"
                                title="نسخ الاسم">
                            <i class="far fa-copy"></i>
                        </button>
                    </div>

                    <!-- Branch -->
                    <div class="bg-white rounded-xl p-3 border border-slate-200 shadow-xs flex items-center justify-between">
                        <div class="truncate mr-2">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">الفرع</span>
                            <span class="text-xs font-bold text-slate-900 block mt-0.5 truncate">@Model.BranchName</span>
                        </div>
                        <button type="button" onclick="copyToClipboard('@Model.BranchName', this)" 
                                class="p-2 rounded-lg bg-slate-100 hover:bg-brand-50 text-slate-500 hover:text-brand-600 text-xs transition-all"
                                title="نسخ الفرع">
                            <i class="far fa-copy"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Prominent Direct Action Banner -->
            <div class="border-2 border-dashed border-amber-200 rounded-2xl p-8 text-center bg-amber-50/40 space-y-4">
                <div class="w-16 h-16 rounded-full bg-amber-500 text-white flex items-center justify-center text-2xl mx-auto shadow-lg shadow-amber-500/20">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="max-w-md mx-auto space-y-1">
                    <p class="text-base font-black text-slate-900">جاهز لتسجيل بياناتك في الاستمارة؟</p>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        سيتم فتح نموذج Google Forms في علامة تبويب جديدة لتسجيل الدخول بأمان وتجنب أي تعارض في حسابات البريد الإلكتروني.
                    </p>
                </div>
                <div class="pt-2">
                    <a href="@Model.WaveFormUrl" target="_blank" rel="noopener noreferrer" 
                       class="inline-flex items-center gap-3 px-8 py-3.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md shadow-amber-600/20 hover:shadow-amber-600/30 transform hover:-translate-y-0.5">
                        <span>الانتقال إلى الاستمارة الرسمية (Open Form)</span>
                        <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- 5. TAB CONTENT 3: MY EXAMS -->
    <div id="tabContent-exams" class="profile-tab-content hidden space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <i class="fas fa-file-signature text-emerald-600"></i>
                        <span>امتحاناتي المجدولة (My Scheduled Assessments)</span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">الامتحانات المسندة لك مع فترات التفعيل ومواعيد الدخول المحددة.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="@Url.Action("StudentExams", "Home")" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-brand-50 text-slate-600 hover:text-brand-600 text-xs font-bold transition-all">
                        <span>عرض في صفحة كاملة</span>
                        <i class="fas fa-external-link-alt text-[10px]"></i>
                    </a>
                </div>
            </div>

            @if (Model.UserShift != null && Model.UserShift.ShiftId > 0)
            {
                <div class="bg-blue-50/70 border border-blue-100 rounded-xl p-3.5 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2.5">
                        <i class="fas fa-business-time text-blue-600 text-sm"></i>
                        <span class="font-bold text-blue-900">شفت العمل المسجل: <strong>@Model.UserShift.ShiftName</strong> (@Model.UserShift.StartTime.ToString(@"hh\:mm") - @Model.UserShift.EndTime.ToString(@"hh\:mm"))</span>
                    </div>
                    <span class="text-[11px] text-blue-700 bg-white/80 px-2.5 py-0.5 rounded-lg border border-blue-200/50">Shift Restriction Active</span>
                </div>
            }

            @if (Model.Exams == null || !Model.Exams.Any())
            {
                <div class="py-12 text-center text-slate-400 text-xs font-medium space-y-2">
                    <i class="fas fa-calendar-times text-3xl text-slate-300 block"></i>
                    <p class="text-sm font-bold text-slate-700">لا توجد امتحانات مسندة لك حالياً</p>
                    <p class="text-slate-400">ستظهر هنا أي تقييمات أو امتحانات جديدة فور جدولتها من إدارة التدريب.</p>
                </div>
            }
            else
            {
                var now = DateTime.Now;
                var currentTime = now.TimeOfDay;

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    @foreach (var e in Model.Exams)
                    {
                        var inExamWindow = now >= e.ExamDate && now <= e.EndTime;
                        var inShift = true;

                        if (Model.UserShift != null && Model.UserShift.ShiftId > 0)
                        {
                            var sStart = Model.UserShift.StartTime;
                            var sEnd = Model.UserShift.EndTime;
                            inShift = (sStart <= sEnd) 
                                ? (currentTime >= sStart && currentTime <= sEnd) 
                                : (currentTime >= sStart || currentTime <= sEnd);
                        }

                        var canStart = inExamWindow && inShift;

                        <div class="bg-slate-50/60 border border-slate-200/80 rounded-2xl p-5 hover:border-emerald-500/30 hover:bg-white hover:shadow-md transition-all flex flex-col justify-between space-y-4">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-2.5">
                                    <span class="text-[10px] font-mono font-bold bg-white text-slate-600 px-2 py-0.5 rounded border border-slate-200">#@e.ExamId</span>
                                    @if (canStart)
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-600 border border-emerald-200/60 flex items-center gap-1 shadow-xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> متاح الآن
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500">
                                            مغلق / مجدول
                                        </span>
                                    }
                                </div>
                                <h3 class="text-sm font-bold text-slate-900 line-clamp-1">@e.ExamTitle</h3>
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">@(string.IsNullOrEmpty(e.ExamDescription) ? "تقييم أكاديمي رسمي معتمد" : e.ExamDescription)</p>
                            </div>

                            <div class="bg-white rounded-xl p-3 text-xs space-y-2 border border-slate-100 shadow-xs">
                                <div class="flex items-center justify-between text-slate-500 text-[11px]">
                                    <span><i class="far fa-clock mr-1 text-slate-400"></i>مدة الامتحان:</span>
                                    <strong class="text-slate-800 font-mono">@e.DurationInMinutes دقيقة</strong>
                                </div>
                                <div class="flex items-center justify-between text-slate-500 text-[11px]">
                                    <span><i class="far fa-calendar-alt mr-1 text-slate-400"></i>الموعد:</span>
                                    <span class="text-slate-700 font-medium">@e.ExamDate.ToString("dd/MM hh:mm tt")</span>
                                </div>
                                <div class="flex items-center justify-between text-slate-500 text-[11px]">
                                    <span><i class="fas fa-hourglass-end mr-1 text-slate-400"></i>نهاية الامتحان:</span>
                                    <span class="text-slate-700 font-medium">@e.EndTime.ToString("dd/MM hh:mm tt")</span>
                                </div>
                            </div>

                            @if (canStart)
                            {
                                <a href="@Url.Action("StartExam", "Exams", new { examId = e.ExamId })" 
                                   class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs flex items-center justify-center gap-2 shadow-sm transition-all">
                                    <span>بدء الامتحان الآن</span>
                                    <i class="fas fa-play text-[10px]"></i>
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled 
                                        class="w-full py-2.5 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs cursor-not-allowed flex items-center justify-center gap-2">
                                    <i class="fas fa-lock text-[10px]"></i>
                                    <span>الامتحان غير متاح حالياً</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 6. TAB CONTENT 4: MY ASSIGNMENTS -->
    <div id="tabContent-assignments" class="profile-tab-content hidden space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <i class="fas fa-tasks text-indigo-600"></i>
                        <span>تكليفاتي التدريبية (Continuous Assignments)</span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">التكليفات والواجبات الدورية المسندة لدُفعتك التدريبية.</p>
                </div>
                <div class="flex items-center gap-2">
                    @if (!string.IsNullOrEmpty(Model.ActiveWaveName))
                    {
                        <span class="text-xs font-bold bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-xl border border-indigo-200/50">
                            <i class="fas fa-water mr-1"></i> @Model.ActiveWaveName
                        </span>
                    }
                    <a href="@Url.Action("Index", "Assignments")" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 text-slate-600 hover:text-indigo-600 text-xs font-bold transition-all">
                        <span>عرض في صفحة كاملة</span>
                        <i class="fas fa-external-link-alt text-[10px]"></i>
                    </a>
                </div>
            </div>

            @if (Model.Assignments == null || !Model.Assignments.Any())
            {
                <div class="py-12 text-center text-slate-400 text-xs font-medium space-y-2">
                    <i class="fas fa-clipboard-check text-3xl text-slate-300 block"></i>
                    <p class="text-sm font-bold text-slate-700">لا توجد تكليفات نشطة مسندة لك حالياً</p>
                    <p class="text-slate-400">ستظهر هنا التكليفات والمهام الجديدة فور جدولتها من المدربين.</p>
                </div>
            }
            else
            {
                var now = DateTime.Now;

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    @foreach (var a in Model.Assignments)
                    {
                        bool isExpired = now > (DateTime)a.ScheduledEndTime;
                        bool isSubmitted = ((int?)a.SubmissionsCount ?? 0) > 0;

                        <div class="bg-slate-50/60 border border-slate-200/80 rounded-2xl p-5 hover:border-indigo-500/30 hover:bg-white hover:shadow-md transition-all flex flex-col justify-between space-y-4">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-2.5">
                                    <span class="text-[10px] font-mono font-bold bg-white text-indigo-700 px-2 py-0.5 rounded border border-indigo-100">#@a.Id</span>
                                    @if (isSubmitted)
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-600 border border-emerald-200/60 flex items-center gap-1 shadow-xs">
                                            <i class="fas fa-check-circle"></i> تم التسليم
                                        </span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-600 border border-rose-200/60">
                                            انتهى الموعد
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-amber-50 text-amber-700 border border-amber-200/60 flex items-center gap-1 shadow-xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> قيد الحل
                                        </span>
                                    }
                                </div>
                                <h3 class="text-sm font-bold text-slate-900 line-clamp-1">@a.Title</h3>
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">@(string.IsNullOrEmpty((string)a.Description) ? "تكليف أكاديمي دوري مطلوب تسليمه" : a.Description)</p>
                            </div>

                            <div class="bg-white rounded-xl p-3 text-xs space-y-1.5 border border-slate-100 shadow-xs">
                                <div class="flex items-center justify-between text-slate-500 text-[11px]">
                                    <span><i class="far fa-calendar-check mr-1 text-slate-400"></i>آخر موعد للتسليم:</span>
                                    <strong class="@(isExpired ? "text-rose-600" : "text-slate-800")">@(((DateTime)a.ScheduledEndTime).ToString("dd/MM/yyyy hh:mm tt"))</strong>
                                </div>
                            </div>

                            <div>
                                <a href="@Url.Action("Details", "Assignments", new { id = a.Id })" 
                                   class="w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs flex items-center justify-center gap-1.5 shadow-sm transition-all">
                                    <span>@(isSubmitted ? "عرض الإجابات المسلمة" : "فتح وحل التكليف")</span>
                                    <i class="fas fa-arrow-left text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.HasProgramDashAccess)
    {
        <!-- 7. TAB CONTENT 5: PROGRAM DASH -->
        <div id="tabContent-program" class="profile-tab-content hidden space-y-4">
            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-6">
                <div class="w-16 h-16 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-2xl mx-auto shadow-md">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <div class="max-w-md mx-auto space-y-2">
                    <h3 class="text-lg font-black text-slate-900">لوحة مواد وتدريب البرنامج (Program Dash)</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        منصة المحتوى الأكاديمي الشامل: استعرض المنهج التدريبي المعتمد، المراجع العلمية، وملفات المحاضرات الخاصة بدُفعتك التدريبية.
                    </p>
                </div>
                <div>
                    <a href="@Url.Action("Index", "Materials")" 
                       class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-black uppercase tracking-wider transition-all shadow-md shadow-slate-900/20 hover:shadow-slate-900/30">
                        <span>الانتقال إلى لوحة التدريب (Open Program Dash)</span>
                        <i class="fas fa-external-link-alt text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    }

</div>

<script>
    function copyToClipboard(text, elem) {
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            const originalHtml = elem.innerHTML;
            elem.innerHTML = '<span class="text-emerald-600 font-bold text-xs"><i class="fas fa-check mr-1"></i> تم النسخ</span>';
            setTimeout(() => {
                elem.innerHTML = originalHtml;
            }, 1500);
        });
    }

    function switchProfileTab(tabKey) {
        // Update button states
        document.querySelectorAll('.profile-tab-btn').forEach(btn => {
            btn.classList.remove('bg-white', 'text-brand-700', 'shadow-sm');
            btn.classList.add('text-slate-600', 'hover:text-slate-900', 'hover:bg-white/60');
        });

        // Hide all tab contents
        document.querySelectorAll('.profile-tab-content').forEach(content => {
            content.classList.add('hidden');
        });

        const activeBtn = document.getElementById('tabBtn-' + tabKey);
        const activeContent = document.getElementById('tabContent-' + tabKey);

        if (activeBtn) {
            activeBtn.classList.add('bg-white', 'text-brand-700', 'shadow-sm');
            activeBtn.classList.remove('text-slate-600', 'hover:text-slate-900', 'hover:bg-white/60');
        }

        if (activeContent) {
            activeContent.classList.remove('hidden');
        }

        if (history.replaceState) {
            history.replaceState(null, null, '#' + tabKey);
        }
    }

    // Support direct linking via hash or query param e.g. #exams or ?tab=exams
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const queryTab = urlParams.get('tab');
        const hashTab = window.location.hash.replace('#', '');
        const targetTab = queryTab || hashTab;
        const validTabs = ['certificates', 'exams', 'assignments', 'waveform', 'program'];
        
        if (targetTab && validTabs.includes(targetTab.toLowerCase())) {
            switchProfileTab(targetTab.toLowerCase());
        }
    });
</script>
