@{
    var company = ViewBag.Company;
    var products = ViewBag.Products as IEnumerable<Exam.DTOs.CompanyProductDto> ?? Enumerable.Empty<Exam.DTOs.CompanyProductDto>();
    var companyName = company?.Name?.ToString() ?? "Partner Profile";
    var companyType = company?.CompanyType?.ToString() ?? "Medical";
    var tagline = company?.Tagline?.ToString() ?? "Advancing Healthcare & Clinical Excellence";
    var description = company?.Description?.ToString() ?? "Strategic healthcare partner collaborating with Eltarshouby Academy to provide cutting-edge clinical training and certified pharmaceutical solutions.";
    var logoUrl = company?.LogoUrl?.ToString();
    var coverUrl = company?.CoverImageUrl?.ToString() ?? "https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?q=80&w=1600&auto=format&fit=crop";
    var website = company?.Website?.ToString();
    var email = company?.Email?.ToString();
    var phone = company?.Phone?.ToString();
    var contactPerson = company?.ContactPerson?.ToString();
    var productCount = company?.ProductCount != null ? (int)company.ProductCount : products.Count();
    var traineesCount = company?.TraineesCount != null ? (int)company.TraineesCount : 0;
    var sessionsCount = company?.SessionsCount != null ? (int)company.SessionsCount : 0;

    ViewData["Title"] = $"{companyName} - Partner Profile";

    var isCosmo = companyType.Equals("Cosmetics", StringComparison.OrdinalIgnoreCase);
    var isHybrid = companyType.Equals("Hybrid", StringComparison.OrdinalIgnoreCase);
    var badgeColor = isCosmo ? "bg-fuchsia-500/10 text-fuchsia-600 border-fuchsia-200 dark:border-fuchsia-800" :
                     isHybrid ? "bg-indigo-500/10 text-indigo-600 border-indigo-200 dark:border-indigo-800" :
                     "bg-emerald-500/10 text-emerald-600 border-emerald-200 dark:border-emerald-800";
}

<div class="min-h-screen bg-slate-50/50 dark:bg-slate-950/40 pb-28">
    <!-- Top Floating Navigation -->
    <div class="sticky top-0 z-40 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Home")" 
                   class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back to Academy</span>
                </a>
                <span class="text-slate-300 dark:text-slate-700">/</span>
                <span class="text-xs font-black text-slate-900 dark:text-white truncate">@companyName</span>
            </div>

            <div class="flex items-center gap-3">
                @if (!string.IsNullOrEmpty(website))
                {
                    <a href="@website" target="_blank" rel="noopener noreferrer" 
                       class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2">
                        <i class="fas fa-external-link-alt text-[10px]"></i>
                        <span class="hidden sm:inline">Official Website</span>
                    </a>
                }
                <a href="#portfolio" 
                   class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-black uppercase tracking-wider shadow-md shadow-brand-600/20 transition-all flex items-center gap-2">
                    <i class="fas fa-pills"></i>
                    <span>View Products</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Banner Section -->
    <div class="relative overflow-hidden bg-slate-900 text-white">
        <!-- Background Cover Image with Modern Overlays -->
        <div class="absolute inset-0 z-0">
            <img src="@coverUrl" alt="@companyName Cover" class="w-full h-full object-cover opacity-25 filter blur-[1px] scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 pt-16 pb-20">
            <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-8">
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
                    <!-- Company Logo Card -->
                    <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-white p-3 shadow-2xl border border-white/20 flex items-center justify-center shrink-0 overflow-hidden">
                        @if (!string.IsNullOrEmpty(logoUrl))
                        {
                            <img src="@logoUrl" alt="@companyName" class="w-full h-full object-contain" />
                        }
                        else
                        {
                            <span class="text-3xl font-black text-slate-900 uppercase">@companyName.Substring(0, Math.Min(2, companyName.Length))</span>
                        }
                    </div>

                    <!-- Company Identity -->
                    <div>
                        <div class="flex flex-wrap items-center gap-2.5 mb-2">
                            <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider border @badgeColor bg-white/90 dark:bg-slate-900/90 shadow-sm">
                                @companyType Partner
                            </span>
                            <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 flex items-center gap-1.5">
                                <i class="fas fa-check-circle text-xs text-emerald-400"></i>
                                <span>Verified Formulary</span>
                            </span>
                        </div>
                        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-2">
                            @companyName
                        </h1>
                        <p class="text-sm sm:text-base font-medium text-slate-300 max-w-2xl leading-relaxed">
                            @tagline
                        </p>
                    </div>
                </div>

                <!-- Action Button in Hero -->
                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    @if (!string.IsNullOrEmpty(website))
                    {
                        <a href="@website" target="_blank" rel="noopener noreferrer" 
                           class="flex-1 md:flex-none justify-center px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/10 text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2">
                            <i class="fas fa-globe"></i>
                            <span>Corporate Portal</span>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(email))
                    {
                        <a href="mailto:@email" 
                           class="flex-1 md:flex-none justify-center px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/10 text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2">
                            <i class="fas fa-envelope"></i>
                            <span>Contact</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Key Performance & Partnership Stats Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-12 pt-8 border-t border-white/10">
                <div class="p-4 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Contracted Products</p>
                    <p class="text-2xl sm:text-3xl font-black text-white mt-1">@productCount</p>
                </div>
                <div class="p-4 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Clinical Training Sessions</p>
                    <p class="text-2xl sm:text-3xl font-black text-white mt-1">@sessionsCount</p>
                </div>
                <div class="p-4 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Pharmacists Trained</p>
                    <p class="text-2xl sm:text-3xl font-black text-white mt-1">@traineesCount</p>
                </div>
                <div class="p-4 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Partnership Status</p>
                    <p class="text-xs sm:text-sm font-black text-emerald-400 mt-2 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Active Collaboration
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Container -->
    <div class="max-w-7xl mx-auto px-6 mt-12 space-y-12">
        <!-- Section: Company Overview & Partnership -->
        <section class="bg-white dark:bg-slate-900 rounded-[32px] p-8 md:p-12 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <div class="lg:col-span-8 space-y-4">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-50 dark:bg-brand-950/40 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-300 text-xs font-black uppercase tracking-wider">
                        <i class="fas fa-building"></i>
                        <span>Company Overview</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                        About @companyName
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed font-normal">
                        @description
                    </p>
                </div>

                <div class="lg:col-span-4 bg-slate-50 dark:bg-slate-800/40 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 space-y-4">
                    <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-handshake text-brand-600"></i>
                        <span>Partnership Details</span>
                    </h4>
                    <ul class="space-y-3 text-xs text-slate-500 dark:text-slate-400 font-medium">
                        <li class="flex items-center justify-between pb-2 border-b border-slate-200/50 dark:border-slate-700/50">
                            <span>Classification:</span>
                            <span class="font-bold text-slate-900 dark:text-white">@companyType</span>
                        </li>
                        @if (!string.IsNullOrEmpty(contactPerson))
                        {
                            <li class="flex items-center justify-between pb-2 border-b border-slate-200/50 dark:border-slate-700/50">
                                <span>Representative:</span>
                                <span class="font-bold text-slate-900 dark:text-white">@contactPerson</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(phone))
                        {
                            <li class="flex items-center justify-between pb-2 border-b border-slate-200/50 dark:border-slate-700/50">
                                <span>Contact Line:</span>
                                <span class="font-bold text-slate-900 dark:text-white">@phone</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(website))
                        {
                            <li class="flex items-center justify-between pb-2 border-b border-slate-200/50 dark:border-slate-700/50">
                                <span>Official Site:</span>
                                <a href="@website" target="_blank" rel="noopener noreferrer" class="font-bold text-brand-600 hover:underline truncate max-w-[150px]">
                                    @website.Replace("https://", "").Replace("http://", "").TrimEnd('/')
                                </a>
                            </li>
                        }
                        <li class="flex items-center justify-between">
                            <span>Clinical Integration:</span>
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">Eltarshouby Accredited</span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Section: Contracted Products & Formulary -->
        <section id="portfolio" class="space-y-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-xs font-black uppercase tracking-wider mb-2">
                        <i class="fas fa-boxes-stacked"></i>
                        <span>Contracted Portfolio</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                        Contracted Pharmaceutical & Cosmeceutical Formulations
                    </h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                        Approved medications and therapeutic products actively supplied to Eltarshouby Pharmacies & Academy.
                    </p>
                </div>

                <!-- Product Search Input -->
                <div class="relative w-full md:w-80">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="productSearchInput" onkeyup="filterProductsList()" 
                           placeholder="Search drug name or generic..." 
                           class="w-full pl-10 pr-4 py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white shadow-sm transition-all" />
                </div>
            </div>

            <!-- Category Filter Pills -->
            @{
                var categories = products.Select(p => p.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
            }
            @if (categories.Any())
            {
                <div class="flex flex-wrap items-center gap-2 pt-2">
                    <button type="button" onclick="filterByCategory('all')" id="catBtn-all" 
                            class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-brand-600 text-white transition-all shadow-sm">
                        All Products (@products.Count())
                    </button>
                    @foreach (var cat in categories)
                    {
                        var countInCat = products.Count(p => p.Category == cat);
                        <button type="button" onclick="filterByCategory('@cat')" id="catBtn-@cat.Replace(" ", "-").ToLower()" 
                                class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:border-brand-500 transition-all shadow-sm">
                            @cat (@countInCat)
                        </button>
                    }
                </div>
            }

            <!-- Products Grid -->
            @if (products.Any())
            {
                <div id="productsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
                    @foreach (var p in products)
                    {
                        <div class="product-card bg-white dark:bg-slate-900 rounded-[28px] p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group"
                             data-name="@p.ProductName.ToLower()" 
                             data-generic="@(p.GenericName?.ToLower() ?? "")" 
                             data-category="@(p.Category ?? "all")">
                            <div>
                                <!-- Top Row: Dosage Form & Price -->
                                <div class="flex items-start justify-between gap-3 mb-4">
                                    <div class="w-14 h-14 rounded-2xl bg-brand-50 dark:bg-brand-950/40 border border-brand-100 dark:border-brand-900/50 flex items-center justify-center text-brand-600 text-2xl shrink-0 group-hover:scale-105 transition-transform overflow-hidden">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.ProductName" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <i class="fas fa-pills"></i>
                                        }
                                    </div>
                                    <div class="text-right">
                                        @if (p.Price.HasValue && p.Price > 0)
                                        {
                                            <span class="text-base font-black text-slate-900 dark:text-white">
                                                @p.Price.Value.ToString("N2") <span class="text-[10px] text-slate-400 font-bold uppercase">EGP</span>
                                            </span>
                                        }
                                        <div class="mt-1">
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
                                                Active Supply
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Brand Name & Generic -->
                                <h3 class="text-lg font-black text-slate-900 dark:text-white group-hover:text-brand-600 transition-colors leading-snug">
                                    @p.ProductName
                                </h3>

                                @if (!string.IsNullOrEmpty(p.GenericName))
                                {
                                    <p class="text-xs font-bold text-brand-600 dark:text-brand-400 mt-1 flex items-center gap-1.5">
                                        <i class="fas fa-atom text-[10px]"></i>
                                        <span>@p.GenericName</span>
                                    </p>
                                }

                                <!-- Pills: Category & Dosage Form -->
                                <div class="flex flex-wrap gap-1.5 mt-3">
                                    @if (!string.IsNullOrEmpty(p.Category))
                                    {
                                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
                                            @p.Category
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.DosageForm))
                                    {
                                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800/60">
                                            @p.DosageForm
                                        </span>
                                    }
                                </div>

                                <!-- Clinical Description -->
                                @if (!string.IsNullOrEmpty(p.Description))
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-4 leading-relaxed font-normal line-clamp-3">
                                        @p.Description
                                    </p>
                                }
                            </div>

                            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 font-bold">
                                <span>Formulary: Eltarshouby Approved</span>
                                <span class="text-brand-600 dark:text-brand-400"><i class="fas fa-shield-halved mr-1"></i> Quality Verified</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-16 text-center bg-white dark:bg-slate-900 rounded-[32px] border border-dashed border-slate-200 dark:border-slate-800">
                    <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-4 text-2xl">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h4 class="text-sm font-black text-slate-800 dark:text-white uppercase">No Contracted Products Registered Yet</h4>
                    <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
                        Products for this partner can be configured and updated via the Company Settings module in the Admin portal.
                    </p>
                </div>
            }

            <!-- No search matches feedback -->
            <div id="noSearchMatches" class="hidden p-12 text-center bg-white dark:bg-slate-900 rounded-[32px] border border-slate-200 dark:border-slate-800">
                <i class="fas fa-search text-3xl text-slate-300 dark:text-slate-600 mb-2 block"></i>
                <h4 class="text-xs font-black uppercase text-slate-700 dark:text-slate-300">No matching products found</h4>
                <p class="text-[11px] text-slate-400 mt-1">Try searching by commercial brand name, generic active ingredient, or clear the filter.</p>
            </div>
        </section>
    </div>
</div>

<script>
    let activeCategoryFilter = 'all';

    function filterByCategory(category) {
        activeCategoryFilter = category;
        document.querySelectorAll('.cat-filter-btn').forEach(btn => {
            btn.classList.remove('bg-brand-600', 'text-white');
            btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-800');
        });

        const activeBtn = document.getElementById(category === 'all' ? 'catBtn-all' : 'catBtn-' + category.replace(/\s+/g, '-').toLowerCase());
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-300', 'border');
            activeBtn.classList.add('bg-brand-600', 'text-white');
        }

        applyCombinedFilter();
    }

    function filterProductsList() {
        applyCombinedFilter();
    }

    function applyCombinedFilter() {
        const query = (document.getElementById('productSearchInput')?.value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('.product-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = card.dataset.name || '';
            const generic = card.dataset.generic || '';
            const cat = card.dataset.category || '';

            const matchesQuery = !query || name.includes(query) || generic.includes(query) || cat.toLowerCase().includes(query);
            const matchesCat = activeCategoryFilter === 'all' || cat === activeCategoryFilter;

            if (matchesQuery && matchesCat) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });

        const noMatches = document.getElementById('noSearchMatches');
        if (noMatches) {
            if (visibleCount === 0 && cards.length > 0) {
                noMatches.classList.remove('hidden');
            } else {
                noMatches.classList.add('hidden');
            }
        }
    }
</script>
