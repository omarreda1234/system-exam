@model Exam.Models.HomeCmsViewModel
@{
    ViewData["Title"] = "Home Page";

    var story = Model?.Sections?.TryGetValue("story", out var s1) == true ? s1 : new Exam.Models.HomeSection { Title = "Our Story", Subtitle = "Knowledge into Performance", ContentHtml = "Eltarshoubi Training Academy began with a single vision: to bridge the gap between academic theory and clinical excellence.", IsVisible = true };
    var storyBadge = Model?.Sections?.TryGetValue("story_badge", out var s2) == true ? s2 : new Exam.Models.HomeSection { Title = "Established 2026 Founded In Mansoura", Subtitle = "Founded in Cairo", IsVisible = true };
    var vision = Model?.Sections?.TryGetValue("vision", out var s3) == true ? s3 : new Exam.Models.HomeSection { Title = "Our Vision", Subtitle = "Global Pioneer", ContentHtml = "To develop highly qualified pharmaceutical professionals who contribute to enhancing the quality of healthcare in Egypt.", IsVisible = true };
    var mission = Model?.Sections?.TryGetValue("mission", out var s4) == true ? s4 : new Exam.Models.HomeSection { Title = "Our Mission", Subtitle = "Innovation, Safety, Impact", ContentHtml = "Provide hands-on training in pharmaceutical and cosmeceutical formulations.||Enhance personal and soft skills essential for professional success.||Deliver specialized training in customer service, call center operations, and digital systems handling.||Offer continuous development programs for professionals to ensure sustained excellence.||Create summer training opportunities for pharmacy students to integrate them into real work environments.", IsVisible = true };
    var facultySec = Model?.Sections?.TryGetValue("faculty", out var s5) == true ? s5 : new Exam.Models.HomeSection { Title = "Meet Our Faculty", Subtitle = "Empowering Pharmacists", ContentHtml = "We believe that building an integrated healthcare community starts with empowering pharmacists through knowledge, skills, and continuous development.", IsVisible = true };

    var sliderImages = Model?.SliderImages?.Where(x => x.IsActive).ToList() ?? new List<Exam.Models.HomeSliderImage>();
    if (!sliderImages.Any())
    {
        sliderImages.Add(new Exam.Models.HomeSliderImage { ImageUrl = "/images/LL.jpg", Title = "Digital Powerhouse" });
        sliderImages.Add(new Exam.Models.HomeSliderImage { ImageUrl = "/images/slider2.png", Title = "Lab Research" });
        sliderImages.Add(new Exam.Models.HomeSliderImage { ImageUrl = "/images/slider3.png", Title = "Team Collaboration" });
    }
}

<style>
    /* Floating Animation */
    @@keyframes floatAnim {
        0%, 100% { transform: translateY(0px) scale(1); }
        50% { transform: translateY(-10px) scale(1.01); }
    }
    .animate-float {
        animation: floatAnim 6s ease-in-out infinite;
    }

    /* Hover Sweeping Shine Effect */
    @@keyframes shine {
        100% { left: 125%; }
    }
    .animate-shine {
        position: absolute;
        top: 0;
        left: -75%;
        width: 50%;
        height: 100%;
        background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 50%, rgba(255, 255, 255, 0) 100%);
        transform: skewX(-25deg);
    }
    .group:hover .animate-shine {
        animation: shine 1.2s ease-in-out;
    }

    /* Continuous Color Morphing for Title */
    @@keyframes morphColor {
        0%, 100% { color: #01443c; text-shadow: 0 0 20px rgba(1, 68, 60, 0.05); }
        50% { color: #0f172a; text-shadow: none; }
    }
    .morph-color {
        animation: morphColor 10s ease-in-out infinite;
    }

    /* Letter reveal effects */
    .academy-reveal-wrapper {
        display: inline-flex;
        align-items: baseline;
        cursor: default;
        padding-bottom: 0.15em;
        margin-bottom: -0.15em;
    }
    .reveal-letter {
        display: inline-block;
        transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
        padding-bottom: 0.15em;
        margin-bottom: -0.15em;
    }
    .reveal-rest {
        display: inline-block;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        white-space: nowrap;
        vertical-align: bottom;
        padding-bottom: 0.15em;
        margin-bottom: -0.15em;
        transition: max-width 3.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 2.8s ease;
    }

    @@keyframes autoRevealTextLoop {
        0%, 8% { max-width: 0; opacity: 0; }
        18%, 92% { max-width: 320px; opacity: 1; }
        98%, 100% { max-width: 0; opacity: 0; }
    }
    .reveal-rest {
        animation: autoRevealTextLoop 20s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    /* Slide-in Animations */
    @@keyframes slideInLeft {
        0% { opacity: 0; transform: translateX(-60px); }
        100% { opacity: 1; transform: translateX(0); }
    }
    @@keyframes slideInRight {
        0% { opacity: 0; transform: translateX(60px); }
        100% { opacity: 1; transform: translateX(0); }
    }
    .animate-slide-in-left {
        animation: slideInLeft 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
    .animate-slide-in-right {
        animation: slideInRight 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
</style>

<div class="space-y-32 mb-32">
    @if (story.IsVisible || sliderImages.Any())
    {
        <!-- Section 1: Our Story & Hero Slider -->
        <section id="about" class="pt-20 px-6 max-w-7xl mx-auto">
            <div class="grid grid-cols-1 @(story.IsVisible && sliderImages.Any() ? "lg:grid-cols-2 gap-16" : "") items-center justify-center">
                @if (story.IsVisible)
                {
                    <div id="story-left-col" class="order-2 lg:order-1 opacity-0 @(!sliderImages.Any() ? "max-w-3xl mx-auto text-center" : "")">
                        <h2 class="text-xs font-black text-brand-600 uppercase tracking-[0.3em] mb-4">@(string.IsNullOrEmpty(story.Subtitle) ? "Our Story" : story.Subtitle)</h2>
                        <h1 class="text-5xl md:text-7xl font-black text-slate-900 leading-[1.1] mb-8 tracking-tighter flex flex-col md:block">
                            Eltarshoubi 
                            <span class="academy-reveal-wrapper morph-color">
                                <span class="reveal-letter font-black text-brand-600">T</span><span class="reveal-rest">raining</span>
                                <span class="reveal-letter font-black text-brand-600 ml-2">A</span><span class="reveal-rest">cademy</span>
                            </span>
                        </h1>
                        <p class="text-lg text-slate-500 leading-relaxed font-medium max-w-lg mb-8 @(!sliderImages.Any() ? "mx-auto" : "")">
                            @story.ContentHtml
                        </p>
                        
                        @if (storyBadge.IsVisible)
                        {
                            <div class="flex items-center gap-6 p-6 bg-slate-50 rounded-[32px] border border-slate-100 inline-flex">
                                <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center text-brand-600">
                                    <i class="fas fa-history text-2xl"></i>
                                </div>
                                <div>
                                    <p class="text-xl font-black text-slate-900 leading-none">@storyBadge.Title</p>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">@storyBadge.Subtitle</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                
                @if (sliderImages.Any())
                {
                    <div id="story-right-col" class="order-1 lg:order-2 relative flex items-center justify-center min-h-[480px] @(story.IsVisible ? "lg:sticky lg:top-28 lg:self-start" : "mx-auto") opacity-0">
                        <!-- Decorative Background Blurs -->
                        <div class="absolute -bottom-8 -left-8 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl opacity-70 animate-pulse"></div>
                        <div class="absolute -top-8 -right-8 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl opacity-70 animate-pulse" style="animation-delay: 2.5s;"></div>
                        
                        <!-- Main Image Slider -->
                        <div class="relative w-full max-w-[500px] aspect-[4/3] rounded-[48px] overflow-hidden shadow-2xl shadow-brand-600/10 border border-slate-200/50 dark:border-slate-800/50 bg-white p-2 animate-float">
                            <div class="w-full h-full rounded-[40px] overflow-hidden relative group" id="heroSlider">
                                
                                @for (int i = 0; i < sliderImages.Count; i++)
                                {
                                    var img = sliderImages[i];
                                    <div class="absolute inset-0 transition-opacity duration-1000 @(i == 0 ? "opacity-100" : "opacity-0")" data-slide="@i">
                                        <img src="@img.ImageUrl" alt="@img.Title" class="w-full h-full object-cover" />
                                    </div>
                                }

                                <!-- Glass Tag -->
                                <div class="absolute bottom-6 left-6 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border border-white/40 dark:border-slate-800/40 rounded-2xl px-4 py-2 flex items-center gap-2 shadow-lg z-10">
                                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                                    <span class="text-[10px] font-black text-slate-800 dark:text-white uppercase tracking-wider">Eltarshoubi Academy</span>
                                </div>
                                
                                <!-- Slider Dots -->
                                <div class="absolute bottom-6 right-6 flex items-center gap-2 z-10">
                                    @for (int i = 0; i < sliderImages.Count; i++)
                                    {
                                        <div class="w-2 h-2 rounded-full bg-white shadow shadow-black/20 transition-all duration-300 cursor-pointer @(i == 0 ? "opacity-100 scale-125" : "opacity-50 hover:opacity-100")" id="dot-@i" onclick="goToSlide(@i)"></div>
                                    }
                                </div>
                            </div>
                            
                            <script>
                                let currentSlide = 0;
                                const totalSlides = @sliderImages.Count;
                                let slideInterval;

                                function goToSlide(index) {
                                    if(index === currentSlide) return;
                                    
                                    document.querySelector(`[data-slide="${currentSlide}"]`)?.classList.remove('opacity-100');
                                    document.querySelector(`[data-slide="${currentSlide}"]`)?.classList.add('opacity-0');
                                    document.getElementById(`dot-${currentSlide}`)?.classList.remove('opacity-100', 'scale-125');
                                    document.getElementById(`dot-${currentSlide}`)?.classList.add('opacity-50');

                                    currentSlide = index;
                                    document.querySelector(`[data-slide="${currentSlide}"]`)?.classList.remove('opacity-0');
                                    document.querySelector(`[data-slide="${currentSlide}"]`)?.classList.add('opacity-100');
                                    document.getElementById(`dot-${currentSlide}`)?.classList.remove('opacity-50');
                                    document.getElementById(`dot-${currentSlide}`)?.classList.add('opacity-100', 'scale-125');
                                    
                                    resetInterval();
                                }

                                function nextSlide() {
                                    if (totalSlides <= 1) return;
                                    let next = (currentSlide + 1) % totalSlides;
                                    goToSlide(next);
                                }

                                function resetInterval() {
                                    clearInterval(slideInterval);
                                    if (totalSlides > 1) {
                                        slideInterval = setInterval(nextSlide, 5000);
                                    }
                                }

                                resetInterval();
                            </script>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Section 2: Mission & Vision -->
    @if (vision.IsVisible || mission.IsVisible)
    {
        <section class="px-6 max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-7 gap-8">
                @if (vision.IsVisible)
                {
                    <!-- Vision Card -->
                    <div class="@(mission.IsVisible ? "md:col-span-3" : "md:col-span-7") bg-brand-600 rounded-[48px] p-12 shadow-xl shadow-brand-600/20 text-white flex flex-col justify-between relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-12 opacity-10 group-hover:scale-110 transition-transform duration-700">
                            <i class="fas fa-eye text-[120px] -rotate-12"></i>
                        </div>
                        <div>
                            <div class="w-16 h-16 bg-white/10 backdrop-blur-xl rounded-2xl flex items-center justify-center text-white mb-8 border border-white/10">
                                <i class="fas fa-eye text-2xl"></i>
                            </div>
                            <h3 class="text-3xl font-black mb-6 tracking-tight">@vision.Title</h3>
                            <p class="text-lg text-brand-100 leading-relaxed font-medium">
                                @vision.ContentHtml
                            </p>
                        </div>
                        <div class="mt-12 flex items-center gap-2">
                            <div class="w-2 h-2 bg-white rounded-full"></div>
                            <span class="text-[10px] font-black uppercase tracking-widest opacity-80">@(string.IsNullOrEmpty(vision.Subtitle) ? "Global Pioneer" : vision.Subtitle)</span>
                        </div>
                    </div>
                }

                @if (mission.IsVisible)
                {
                    <!-- Mission Card -->
                    <div class="@(vision.IsVisible ? "md:col-span-4" : "md:col-span-7") bg-white border border-slate-200 rounded-[48px] p-12 shadow-sm flex flex-col justify-between relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-12 opacity-[0.03] group-hover:scale-110 transition-transform duration-700">
                            <i class="fas fa-rocket text-[120px] -rotate-12"></i>
                        </div>
                        <div>
                            <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-900 mb-8 border border-slate-100">
                                <i class="fas fa-rocket text-2xl"></i>
                            </div>
                            <h3 class="text-3xl font-black text-slate-900 mb-6 tracking-tight">@mission.Title</h3>
                            <ul class="space-y-4 max-w-md">
                                @if (!string.IsNullOrEmpty(mission.ContentHtml))
                                {
                                    var bullets = mission.ContentHtml.Split(new[] { "||" }, StringSplitOptions.RemoveEmptyEntries);
                                    foreach (var b in bullets)
                                    {
                                        <li class="flex items-start gap-4 group/li">
                                            <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0 group-hover/li:scale-150 transition-transform"></div>
                                            <p class="text-slate-600 font-medium leading-relaxed">@b.Trim()</p>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        @if (!string.IsNullOrEmpty(mission.Subtitle))
                        {
                            <div class="flex flex-wrap gap-2 mt-12">
                                @foreach (var tag in mission.Subtitle.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="px-4 py-1.5 rounded-full bg-slate-50 text-[10px] font-black text-slate-400 uppercase tracking-widest">@tag.Trim()</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <!-- Custom Additional Sections -->
    @if (Model?.CustomSections != null)
    {
        foreach (var csec in Model.CustomSections.Where(x => x.IsVisible))
        {
            <section class="max-w-7xl mx-auto px-6">
                <div class="bg-white border border-slate-200 rounded-[48px] p-12 shadow-sm relative overflow-hidden">
                    @if (!string.IsNullOrEmpty(csec.Subtitle))
                    {
                        <h3 class="text-xs font-black text-brand-600 uppercase tracking-[0.3em] mb-2">@csec.Subtitle</h3>
                    }
                    <h2 class="text-3xl font-black text-slate-900 mb-6 tracking-tight">@csec.Title</h2>
                    <div class="text-slate-600 font-medium leading-relaxed">
                        @Html.Raw(csec.ContentHtml)
                    </div>
                </div>
            </section>
        }
    }

    <!-- Section: Faculty -->
    @if (facultySec.IsVisible)
    {
        <section id="program" class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-20">
                <h2 class="text-4xl font-black text-slate-900 mb-6 tracking-tight uppercase">@facultySec.Title</h2>
                <p class="text-slate-500 font-medium leading-relaxed">
                    @facultySec.ContentHtml
                </p>
                @if (Model?.FacultyMembers?.Any() != true)
                {
                    <p class="text-slate-500 font-medium leading-relaxed mt-2">
                        coming soon....
                    </p>
                }
            </div>

            @if (Model?.FacultyMembers?.Any() == true)
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    @foreach (var member in Model.FacultyMembers.Where(x => x.IsActive))
                    {
                        <div class="bg-white border border-slate-100 rounded-[32px] p-8 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all group text-center">
                            <div class="w-32 h-32 rounded-3xl overflow-hidden mx-auto mb-6 shadow-lg shadow-brand-600/10 grayscale group-hover:grayscale-0 transition-all duration-500">
                                <img src="@(string.IsNullOrEmpty(member.ImageUrl) ? "https://i.pravatar.cc/300?u=" + member.Id : member.ImageUrl)" alt="@member.Name" class="w-full h-full object-cover" />
                            </div>
                            <h4 class="text-lg font-black text-slate-900 mb-1">@member.Name</h4>
                            <p class="text-[10px] font-bold text-brand-600 uppercase tracking-widest mb-4">@member.RoleTitle</p>
                            <div class="pt-6 border-t border-slate-50 text-[11px] font-medium text-slate-400 leading-relaxed">
                                @member.Bio
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const leftCol = document.getElementById("story-left-col");
        const rightCol = document.getElementById("story-right-col");
        
        function triggerAnimations() {
            if (leftCol) {
                leftCol.classList.remove("opacity-0");
                leftCol.classList.add("animate-slide-in-left");
            }
            if (rightCol) {
                rightCol.classList.remove("opacity-0");
                rightCol.classList.add("animate-slide-in-right");
            }
        }

        const splash = document.getElementById("splash-screen");
        if (splash && splash.style.display !== "none") {
            setTimeout(triggerAnimations, 2500);
        } else {
            triggerAnimations();
        }
    });
</script>