@model IEnumerable<Exam.DTOs.BranchDto>
@using System.Web
@inject Exam.Services.IExamService ExamService
@{
    ViewData["Title"] = "Branch Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var userRoles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    bool HasSpecificPermission(string permissionType)
    {
        if (userRoles.Contains("Admin")) return true;
        return ExamService.HasSpecificPermissionAsync(userRoles, "Admin", "Branches", permissionType).GetAwaiter().GetResult();
    }

    var defaultCities = new List<string> {
        "المنصورة", "بورسعيد", "طلخا", "بلقاس", "دمياط", "شربين", "طنطا", 
        "بورفؤاد", "السنبلاوين", "ميت غمر", "القاهرة", "الإسكندرية", 
        "دكرنس", "أجا", "كفر الشيخ", "الإدارة المركزية"
    };
    var cityCounts = Model
        .GroupBy(b => string.IsNullOrWhiteSpace(b.City) ? "غير محدد" : b.City.Trim())
        .ToDictionary(g => g.Key, g => g.Count());

    var allSystemCities = defaultCities
        .Union(Model.Where(b => !string.IsNullOrWhiteSpace(b.City)).Select(b => b.City!.Trim()))
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    if (Model.Any(b => string.IsNullOrWhiteSpace(b.City)) && !allSystemCities.Contains("غير محدد"))
    {
        allSystemCities.Add("غير محدد");
    }

    var sortedCities = allSystemCities
        .Select(c => new {
            Name = c,
            Count = cityCounts.ContainsKey(c) ? cityCounts[c] : 0
        })
        .OrderByDescending(c => c.Count)
        .ThenBy(c => c.Name)
        .ToList();
}

@Html.AntiForgeryToken()

<div class="min-h-screen pb-20 bg-slate-50/50 dark:bg-slate-950/20">
    <!-- Main Premium Header -->
    <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-24 pb-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight flex items-center gap-3">
                        <i class="fas fa-code-branch text-brand-600"></i>
                        <span>Branch Management / إدارة الفروع</span>
                    </h1>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mt-1">Manage system branches, codes, and associated resources</p>
                </div>
                @if (User.IsInRole("Admin") || HasSpecificPermission("create") || HasSpecificPermission("edit"))
                {
                    <div class="flex items-center gap-3">
                        <button onclick="openImportBranchesModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-2 group">
                            <i class="fas fa-file-excel text-xs"></i>
                            <span>Import from Excel / استيراد بالإكسيل</span>
                        </button>
                        @if (User.IsInRole("Admin") || HasSpecificPermission("create"))
                        {
                            <button onclick="openBranchModal()" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-brand-600/20 flex items-center gap-2 group">
                                <i class="fas fa-plus text-xs group-hover:rotate-90 transition-transform"></i>
                                <span>Add New Branch</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 mt-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] shadow-sm">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4 rounded-t-[32px]">
                <div class="flex items-center gap-3">
                    <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Active Branches (@Model.Count())</span>
                </div>
                
                <!-- Modern Multi-City Quick Filter Dropdown -->
                <div id="branchCityFilterContainer" class="relative z-30">
                    <button type="button"
                            id="btnBranchCityFilterToggle"
                            onclick="toggleBranchCityFilterDropdown(event)"
                            class="flex items-center justify-between gap-3 bg-slate-50 hover:bg-slate-100/90 dark:bg-slate-800 dark:hover:bg-slate-700/80 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 shadow-2xs transition-all cursor-pointer select-none min-w-[240px]">
                        <div class="flex items-center gap-2 truncate min-w-0">
                            <i class="fas fa-city text-sky-500 text-xs shrink-0"></i>
                            <span class="text-[11px] font-bold text-slate-400 dark:text-slate-400 shrink-0">المدينة:</span>
                            <span id="branchCityFilterSummary" class="truncate text-xs font-black text-slate-800 dark:text-white">جميع المدن (@Model.Count() فرع)</span>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <span id="branchCityFilterCountBadge" class="text-[10px] font-mono font-black bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 rounded-full">
                                الكل (@sortedCities.Count)
                            </span>
                            <i id="branchCityFilterChevron" class="fas fa-chevron-down text-slate-400 text-[10px] transition-transform duration-200"></i>
                        </div>
                    </button>

                    <!-- Dropdown Panel -->
                    <div id="branchCityFilterDropdown"
                         class="hidden absolute left-0 top-full mt-1.5 w-76 sm:w-80 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl z-50 p-2.5 space-y-2">
                        
                        <!-- Header with select all / deselect all -->
                        <div class="flex items-center justify-between px-2.5 py-1.5 bg-slate-50 dark:bg-slate-800/60 rounded-xl text-[11px] font-bold text-slate-600 dark:text-slate-300 border border-slate-100 dark:border-slate-800">
                            <button type="button" onclick="selectAllBranchCities(true, event)" class="text-sky-600 hover:text-sky-700 dark:text-sky-400 hover:underline flex items-center gap-1 cursor-pointer">
                                <i class="fas fa-check-double text-[10px]"></i> تحديد كل المدن (@sortedCities.Count)
                            </button>
                            <span class="text-slate-300 dark:text-slate-700">|</span>
                            <button type="button" onclick="selectAllBranchCities(false, event)" class="text-rose-500 hover:text-rose-600 dark:text-rose-400 hover:underline flex items-center gap-1 cursor-pointer">
                                <i class="fas fa-times text-[10px]"></i> إلغاء التحديد
                            </button>
                        </div>

                        <!-- Search input inside dropdown -->
                        <div class="relative">
                            <i class="fas fa-search absolute left-2.5 top-2 text-slate-400 text-xs"></i>
                            <input type="text" id="branchCitySearchInput" oninput="filterCityDropdownItems(this.value)" placeholder="ابحث عن مدينة..." class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-7 pr-3 py-1 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-sky-500" />
                        </div>

                        <!-- Cities list -->
                        <div id="branchCityItemsList" class="space-y-1 max-h-60 overflow-y-auto custom-scrollbar p-0.5">
                            @foreach (var c in sortedCities)
                            {
                                <div class="city-filter-item flex items-center justify-between p-2 rounded-xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all select-none text-xs"
                                     data-city-name="@c.Name" data-branch-count="@c.Count">
                                    <label class="flex items-center gap-2 truncate min-w-0 cursor-pointer flex-1">
                                        <input type="checkbox"
                                               value="@c.Name"
                                               checked
                                               data-count="@c.Count"
                                               onchange="onBranchCityCheckboxChange(event)"
                                               class="branch-city-checkbox w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-600 cursor-pointer shrink-0" />
                                        <div class="flex items-center gap-1.5 truncate">
                                            <i class="fas fa-map-marker-alt text-[11px] text-sky-500 shrink-0"></i>
                                            <span class="truncate text-xs font-black text-slate-800 dark:text-slate-200">@c.Name</span>
                                        </div>
                                    </label>
                                    <div class="flex items-center gap-2 shrink-0 text-[10px]">
                                        <span class="font-mono text-slate-400 font-bold">(@c.Count فرع)</span>
                                        <button type="button"
                                                onclick="selectOnlyBranchCity('@c.Name', event)"
                                                class="text-[9px] font-bold text-sky-600 hover:text-sky-700 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-950/50 px-2 py-0.5 rounded transition-colors cursor-pointer"
                                                title="عرض فروع @c.Name فقط">
                                            فقط
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800 px-1 text-[11px]">
                            <span id="branchCityFilterFooterText" class="text-slate-500 font-bold">المحدد: <span class="text-sky-600 font-black">@sortedCities.Count</span> مدينة</span>
                            <button type="button" onclick="closeBranchCityFilterDropdown(event)" class="px-3 py-1 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold transition-all shadow-2xs cursor-pointer">
                                تم / إغلاق
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="overflow-x-auto w-full">
                <table class="saas-table datatable">
                <thead>
                    <tr>
                        <th>Branch Name</th>
                        <th>City / المدينة</th>
                        <th>Branch Code</th>
                        <th>Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in Model)
                    {
                        <tr id="row-@branch.Id">
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/30 flex items-center justify-center font-black text-indigo-600 text-xs uppercase">
                                        @(branch.BranchName?[0].ToString() ?? "B")
                                    </div>
                                    <div>
                                        <p class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wide">@branch.BranchName</p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-300 border border-sky-200/50">
                                    <i class="fas fa-map-marker-alt text-[10px] text-sky-500"></i>
                                    @(string.IsNullOrEmpty(branch.City) ? "غير محدد" : branch.City)
                                </span>
                            </td>
                            <td>
                                <span class="bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded border border-slate-200 dark:border-slate-700 text-[10px] font-mono font-bold text-slate-500">
                                    @(string.IsNullOrEmpty(branch.BranchCode) ? "N/A" : branch.BranchCode)
                                </span>
                            </td>
                            <td>
                                @if (branch.IsActive ?? true)
                                {
                                    <span class="bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200/50 dark:border-emerald-800/50 px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-widest inline-flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-rose-50 text-rose-600 dark:bg-rose-900/30 dark:text-rose-400 border border-rose-200/50 dark:border-rose-800/50 px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-widest inline-flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-2">
                                    @if (User.IsInRole("Admin") || HasSpecificPermission("edit"))
                                    {
                                        <button onclick="openBranchModal('@branch.Id', '@Html.Raw(HttpUtility.JavaScriptStringEncode(branch.BranchName))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(branch.BranchCode ?? ""))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(branch.City ?? ""))')" class="bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white px-3 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all shrink-0">
                                            <i class="fas fa-edit mr-1"></i> Edit
                                        </button>
                                        <button onclick="mergeBranch('@branch.Id', '@Html.Raw(HttpUtility.JavaScriptStringEncode(branch.BranchName))')" class="bg-amber-50 text-amber-600 hover:bg-amber-600 hover:text-white px-3 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all shrink-0 border border-amber-100 dark:border-amber-900/30">
                                            <i class="fas fa-compress-arrows-alt mr-1"></i> Merge
                                        </button>
                                    }
                                    @if (User.IsInRole("Admin") || HasSpecificPermission("delete"))
                                    {
                                        <button onclick="deleteBranch('@branch.Id', '@Html.Raw(HttpUtility.JavaScriptStringEncode(branch.BranchName))')" class="bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white px-3 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all shrink-0 border border-rose-100 dark:border-rose-900/30">
                                            <i class="fas fa-trash-alt mr-1"></i> Delete
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const systemCities = @Html.Raw(Json.Serialize(allSystemCities));

        window.toggleCustomCityInput = function(val) {
            const customDiv = document.getElementById('newCityContainer');
            if (!customDiv) return;
            if (val === '__NEW_CITY__') {
                customDiv.classList.remove('hidden');
                document.getElementById('branchCityCustom')?.focus();
            } else {
                customDiv.classList.add('hidden');
            }
        };

        function openBranchModal(id = null, currentName = '', currentCode = '', currentCity = '') {
            const isEdit = id != null;
            Swal.fire({
                title: isEdit ? 'Edit Branch / تعديل الفرع' : 'Add New Branch / إضافة فرع جديد',
                html: `
                    <div class="text-left space-y-4">
                        <div>
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Branch Name / اسم الفرع <span class="text-rose-500">*</span></label>
                            <input type="text" id="branchName" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 dark:text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" placeholder="e.g. الترعه" value="${currentName}">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">City / المنطقة أو المدينة التابع لها الفرع</label>
                            <select id="branchCitySelect" onchange="window.toggleCustomCityInput(this.value)" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 dark:text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 cursor-pointer">
                                <option value="">-- اختر المدينة / Select City --</option>
                                ${systemCities.map(c => `<option value="${c}" ${c === currentCity ? 'selected' : ''}>${c}</option>`).join('')}
                                ${currentCity && !systemCities.includes(currentCity) ? `<option value="${currentCity}" selected>${currentCity}</option>` : ''}
                                <option value="__NEW_CITY__">➕ إضافة مدينة جديدة / + Add New City...</option>
                            </select>
                            <div id="newCityContainer" class="hidden mt-2">
                                <input type="text" id="branchCityCustom" class="w-full bg-white dark:bg-slate-900 border border-brand-500 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none" placeholder="اكتب اسم المدينة الجديدة هنا...">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Branch Code (Optional) / كود الفرع</label>
                            <input type="text" id="branchCode" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 dark:text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" placeholder="e.g. BR-01" value="${currentCode}">
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: isEdit ? 'Save Changes' : 'Create Branch',
                cancelButtonText: 'Cancel',
                customClass: {
                    confirmButton: 'bg-brand-600 hover:bg-brand-700 text-white px-8 py-3 rounded-xl font-bold uppercase text-xs tracking-widest',
                    cancelButton: 'text-slate-500 font-bold uppercase text-xs tracking-widest px-8 py-3'
                },
                buttonsStyling: false,
                preConfirm: () => {
                    const name = document.getElementById('branchName').value.trim();
                    const citySelect = document.getElementById('branchCitySelect').value.trim();
                    let city = citySelect;
                    if (citySelect === '__NEW_CITY__') {
                        city = (document.getElementById('branchCityCustom')?.value || '').trim();
                        if (!city) {
                            Swal.showValidationMessage('يرجى كتابة اسم المدينة الجديدة أو اختيار مدينة من القائمة.');
                            return false;
                        }
                    }
                    const code = document.getElementById('branchCode').value.trim();
                    if (!name) {
                        Swal.showValidationMessage('Branch name is required');
                        return false;
                    }
                    return { id, name, city, code };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const data = result.value;
                    const url = data.id ? '@Url.Action("EditBranch", "Admin")' : '@Url.Action("AddBranch", "Admin")';
                    
                    $.ajax({
                        url: url,
                        type: 'POST',
                        data: {
                            id: data.id,
                            name: data.name,
                            city: data.city,
                            code: data.code,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(res) {
                            if (res.success) {
                                showAppToast('success', isEdit ? 'تم تحديث الفرع' : 'تم إضافة الفرع', res.message || 'تم حفظ بيانات الفرع بنجاح');
                                setTimeout(() => location.reload(), 1200);
                            } else {
                                showAppToast('error', 'فشل الحفظ', res.message || 'تعذر حفظ بيانات الفرع');
                            }
                        },
                        error: function() {
                            showAppToast('error', 'خطأ في النظام', 'حدث خطأ غير متوقع أثناء الحفظ.');
                        }
                    });
                }
            });
        }

        function deleteBranch(id, name) {
            Swal.fire({
                title: 'Delete Branch?',
                text: `Are you sure you want to delete ${name}? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteBranch", "Admin")',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (res) {
                            if (res.success) {
                                const $tr = $('#row-' + id);
                                const $tbl = $tr.closest('table.datatable');
                                if ($tbl.length && $.fn.DataTable.isDataTable($tbl[0])) {
                                    $tbl.DataTable().row($tr).remove().draw(false);
                                } else {
                                    $tr.remove();
                                }
                                showAppToast('success', 'تم حذف الفرع', res.message || 'تم حذف الفرع بنجاح');
                            } else {
                                showAppToast('error', 'فشل الحذف', res.message || 'تعذر حذف الفرع');
                            }
                        },
                        error: function () {
                            showAppToast('error', 'خطأ في النظام', 'حدث خطأ أثناء محاولة حذف الفرع.');
                        }
                    });
                }
            });
        }

        const branchesList = @Html.Raw(Json.Serialize(Model.Select(b => new { b.Id, b.BranchName })));

        function mergeBranch(sourceId, name) {
            let optionsHtml = '<option value="">-- Select Target Branch --</option>';
            branchesList.forEach(b => {
                if(b.id.toString() !== sourceId.toString()) {
                    optionsHtml += `<option value="${b.id}">${b.branchName.replace(/</g, "&lt;")}</option>`;
                }
            });

            Swal.fire({
                title: 'Merge Branch',
                html: `
                    <p class="text-xs text-slate-500 mb-4">You are about to merge <strong class="text-rose-500">${name}</strong> into another branch. This will move all users and delete the old branch.</p>
                    <div class="text-left">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Target Branch (Keep this one)</label>
                        <select id="mergeTargetId" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm outline-none focus:border-brand-500">
                            ${optionsHtml}
                        </select>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Confirm Merge',
                confirmButtonColor: '#f59e0b',
                preConfirm: () => {
                    const targetId = document.getElementById('mergeTargetId').value;
                    if (!targetId) {
                        Swal.showValidationMessage('Please select a target branch');
                        return false;
                    }
                    return targetId;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const targetId = result.value;
                    Swal.fire({ title: 'Merging...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                    $.ajax({
                        url: '@Url.Action("MergeBranch", "Admin")',
                        type: 'POST',
                        data: { sourceId: sourceId, targetId: targetId },
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                        success: function (res) {
                            if (res.success) {
                                const $tr = $('#row-' + sourceId);
                                const $tbl = $tr.closest('table.datatable');
                                if ($tbl.length && $.fn.DataTable.isDataTable($tbl[0])) {
                                    $tbl.DataTable().row($tr).remove().draw(false);
                                } else {
                                    $tr.remove();
                                }
                                showAppToast('success', 'تم الدمج بنجاح', res.message || 'تم دمج الفرع بنجاح');
                            } else {
                                showAppToast('error', 'فشل الدمج', res.message || 'تعذر دمج الفرع');
                            }
                        },
                        error: function () { showAppToast('error', 'خطأ في النظام', 'حدث خطأ غير متوقع أثناء الدمج.'); }
                    });
                }
            });
        }

        function openImportBranchesModal() {
            Swal.fire({
                title: '<span class="text-slate-900 dark:text-white">تحديث بيانات الفروع بالإكسيل</span>',
                html: `
                    <div class="text-left space-y-4 p-1">
                        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700/80 space-y-3">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">نموذج الفروع الجاهز (مع البيانات الحالية)</p>
                                    <p class="text-[10px] text-slate-500 dark:text-slate-400">ملف إكسيل يحتوي على جميع الفروع الحالية لتعديل الاسم والكود مباشرة</p>
                                </div>
                                <a href="/Admin/DownloadBranchesTemplate" class="px-3.5 py-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/60 dark:hover:bg-indigo-900/60 text-indigo-600 dark:text-indigo-400 text-xs font-extrabold flex items-center gap-1.5 transition-all border border-indigo-200/50 dark:border-indigo-800/50 shrink-0">
                                    <i class="fas fa-download"></i>
                                    <span>تحميل النموذج</span>
                                </a>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest">اختر ملف الإكسيل المحدث (.xlsx / .xls)</label>
                            <input type="file" id="branchesExcelInput" accept=".xlsx,.xls" class="block w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:uppercase file:bg-indigo-600 file:text-white hover:file:opacity-90 transition-all cursor-pointer bg-slate-50 dark:bg-slate-800 p-2 rounded-xl border border-slate-200 dark:border-slate-700" />
                        </div>

                        <div class="text-[10px] text-slate-500 dark:text-slate-400 space-y-1 bg-amber-500/10 p-3 rounded-xl border border-amber-500/20 text-right leading-relaxed" dir="rtl">
                            <p class="font-bold text-amber-700 dark:text-amber-400"><i class="fas fa-info-circle ml-1"></i> معلومات هامة:</p>
                            <p>• يمكنك تعديل (اسم الفرع) أو (كود الفرع) أو كليهما لنفس الفرع.</p>
                            <p>• عمود <b>BranchId</b> يضمن تحديث الفرع الصحيح بنسبة 100% حتى وإن غيرت الاسم والكود معاً.</p>
                            <p>• لإضافة فروع جديدة، يمكنك كتابة سطور جديدة دون ملء رقم المعرف.</p>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'بدء التحديث / Import Now',
                cancelButtonText: 'إلغاء',
                customClass: {
                    confirmButton: 'bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-bold uppercase text-xs tracking-widest',
                    cancelButton: 'text-slate-500 font-bold uppercase text-xs tracking-widest px-8 py-3'
                },
                buttonsStyling: false,
                showLoaderOnConfirm: true,
                preConfirm: async () => {
                    const fileInput = document.getElementById('branchesExcelInput');
                    if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                        Swal.showValidationMessage('يرجى اختيار ملف إكسيل أولاً.');
                        return false;
                    }

                    const formData = new FormData();
                    formData.append('branchesExcelFile', fileInput.files[0]);

                    try {
                        const response = await fetch('@Url.Action("ImportBranchesFromExcel", "Admin")', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            }
                        });

                        const res = await response.json();
                        if (!res.success) {
                            Swal.showValidationMessage(res.message || 'فشلت معالجة الملف.');
                            return false;
                        }
                        return res;
                    } catch (err) {
                        Swal.showValidationMessage('خطأ في الاتصال بالخادم: ' + err.message);
                        return false;
                    }
                }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    const res = result.value;
                    if (res.errors && res.errors.length > 0) {
                        let errHtml = '<ul class="text-right text-xs text-rose-500 overflow-y-auto max-h-48 mt-3 list-disc pr-4" dir="rtl">';
                        res.errors.forEach(e => { errHtml += `<li>${String(e).replace(/</g, '&lt;')}</li>`; });
                        errHtml += '</ul>';

                        Swal.fire({
                            icon: 'warning',
                            title: 'اكتمل الاستيراد مع وجود ملاحظات',
                            html: `<p class="text-sm font-bold text-slate-700 dark:text-slate-200">${res.message}</p>${errHtml}`,
                            confirmButtonText: 'حسناً'
                        }).then(() => location.reload());
                    } else {
                        showAppToast('success', 'اكتمل الاستيراد بنجاح', res.message || 'تم تحديث بيانات الفروع بنجاح');
                        setTimeout(() => location.reload(), 1200);
                    }
                }
            });
        }

        // ==================== MODERN MULTI-CITY FILTER SCRIPT ====================
        let _branchCityDropdownOpen = false;

        window.toggleBranchCityFilterDropdown = function(event) {
            if (event) event.stopPropagation();
            _branchCityDropdownOpen = !_branchCityDropdownOpen;
            const dropdown = document.getElementById('branchCityFilterDropdown');
            const chevron = document.getElementById('branchCityFilterChevron');
            const btn = document.getElementById('btnBranchCityFilterToggle');
            if (dropdown) dropdown.classList.toggle('hidden', !_branchCityDropdownOpen);
            if (chevron) chevron.classList.toggle('rotate-180', _branchCityDropdownOpen);
            if (btn) {
                if (_branchCityDropdownOpen) {
                    btn.classList.add('border-sky-500', 'ring-2', 'ring-sky-100', 'dark:ring-sky-900/40', 'bg-white', 'dark:bg-slate-800');
                } else {
                    btn.classList.remove('border-sky-500', 'ring-2', 'ring-sky-100', 'dark:ring-sky-900/40');
                }
            }
        };

        window.closeBranchCityFilterDropdown = function(event) {
            if (event) event.stopPropagation();
            _branchCityDropdownOpen = false;
            const dropdown = document.getElementById('branchCityFilterDropdown');
            const chevron = document.getElementById('branchCityFilterChevron');
            const btn = document.getElementById('btnBranchCityFilterToggle');
            if (dropdown) dropdown.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
            if (btn) btn.classList.remove('border-sky-500', 'ring-2', 'ring-sky-100', 'dark:ring-sky-900/40');
        };

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!_branchCityDropdownOpen) return;
            const container = document.getElementById('branchCityFilterContainer');
            if (container && !container.contains(e.target)) {
                closeBranchCityFilterDropdown();
            }
        });

        window.filterCityDropdownItems = function(term) {
            const q = (term || '').trim().toLowerCase();
            const items = document.querySelectorAll('.city-filter-item');
            items.forEach(item => {
                const name = (item.dataset.cityName || '').toLowerCase();
                item.style.display = (!q || name.includes(q)) ? 'flex' : 'none';
            });
        };

        window.onBranchCityCheckboxChange = function(event) {
            if (event) event.stopPropagation();
            applyBranchCityFilter();
        };

        window.selectOnlyBranchCity = function(cityName, event) {
            if (event) event.stopPropagation();
            const checkboxes = document.querySelectorAll('.branch-city-checkbox');
            checkboxes.forEach(chk => {
                chk.checked = (chk.value === cityName);
            });
            applyBranchCityFilter();
        };

        window.selectAllBranchCities = function(selectAll, event) {
            if (event) event.stopPropagation();
            const checkboxes = document.querySelectorAll('.branch-city-checkbox');
            checkboxes.forEach(chk => {
                chk.checked = selectAll;
            });
            applyBranchCityFilter();
        };

        window.applyBranchCityFilter = function() {
            const allCheckboxes = Array.from(document.querySelectorAll('.branch-city-checkbox'));
            const checkedCheckboxes = allCheckboxes.filter(chk => chk.checked);
            const totalCities = allCheckboxes.length;
            const selectedCities = checkedCheckboxes.map(chk => chk.value);
            const selectedCount = selectedCities.length;

            // Compute total branches selected
            let totalBranchesSelected = 0;
            checkedCheckboxes.forEach(chk => {
                totalBranchesSelected += parseInt(chk.dataset.count) || 0;
            });

            // Update item container styles (highlight checked ones)
            allCheckboxes.forEach(chk => {
                const parent = chk.closest('.city-filter-item');
                if (parent) {
                    if (chk.checked) {
                        parent.classList.add('bg-sky-50/80', 'dark:bg-sky-950/30', 'border-sky-300', 'dark:border-sky-800');
                    } else {
                        parent.classList.remove('bg-sky-50/80', 'dark:bg-sky-950/30', 'border-sky-300', 'dark:border-sky-800');
                    }
                }
            });

            // Update summary button text
            const summaryElem = document.getElementById('branchCityFilterSummary');
            const badgeElem = document.getElementById('branchCityFilterCountBadge');
            const footerElem = document.getElementById('branchCityFilterFooterText');

            if (selectedCount === 0) {
                if (summaryElem) summaryElem.textContent = 'لم يتم تحديد أي مدينة (0 فرع)';
                if (badgeElem) {
                    badgeElem.textContent = '0 فرع';
                    badgeElem.className = 'text-[10px] font-mono font-black bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300 px-2 py-0.5 rounded-full';
                }
            } else if (selectedCount === totalCities) {
                if (summaryElem) summaryElem.textContent = `جميع المدن (${totalBranchesSelected} فرع)`;
                if (badgeElem) {
                    badgeElem.textContent = `الكل (${totalCities})`;
                    badgeElem.className = 'text-[10px] font-mono font-black bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 rounded-full';
                }
            } else if (selectedCount === 1) {
                if (summaryElem) summaryElem.textContent = `فروع ${selectedCities[0]} (${totalBranchesSelected} فرع)`;
                if (badgeElem) {
                    badgeElem.textContent = `${totalBranchesSelected} فرع`;
                    badgeElem.className = 'text-[10px] font-mono font-black bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 rounded-full';
                }
            } else if (selectedCount === 2) {
                if (summaryElem) summaryElem.textContent = `${selectedCities[0]} + ${selectedCities[1]} (${totalBranchesSelected} فرع)`;
                if (badgeElem) {
                    badgeElem.textContent = `${totalBranchesSelected} فرع`;
                    badgeElem.className = 'text-[10px] font-mono font-black bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 rounded-full';
                }
            } else {
                if (summaryElem) summaryElem.textContent = `تم تحديد ${selectedCount} مدن (${totalBranchesSelected} فرع)`;
                if (badgeElem) {
                    badgeElem.textContent = `${totalBranchesSelected} فرع`;
                    badgeElem.className = 'text-[10px] font-mono font-black bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 rounded-full';
                }
            }

            if (footerElem) {
                footerElem.innerHTML = `المحدد: <span class="text-sky-600 font-black">${selectedCount}</span> من <span class="font-black">${totalCities}</span> مدينة (${totalBranchesSelected} فرع)`;
            }

            // Apply filter to DataTable
            const tbl = $('table.datatable');
            if (tbl.length && $.fn.DataTable.isDataTable(tbl[0])) {
                const dt = tbl.DataTable();
                if (selectedCount === 0) {
                    // Match nothing
                    dt.column(1).search('__NO_MATCHING_CITY__', false, false).draw();
                } else if (selectedCount === totalCities) {
                    // Show all
                    dt.column(1).search('', false, false).draw();
                } else {
                    // Build regex pattern of selected cities
                    const escaped = selectedCities.map(c => $.fn.dataTable.util.escapeRegex(c)).join('|');
                    dt.column(1).search(escaped, true, false).draw();
                }
            }
        };

        $(function() {
            setTimeout(() => {
                applyBranchCityFilter();
            }, 100);
        });
    </script>
}
