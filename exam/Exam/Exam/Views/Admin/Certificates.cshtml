@model IEnumerable<Exam.DTOs.ExamResultRowDto>
@{
    ViewData["Title"] = "Wave Results & Certificates";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var waves = ViewBag.Waves as IEnumerable<Exam.DTOs.WaveDto> ?? Enumerable.Empty<Exam.DTOs.WaveDto>();
    var branches = ViewBag.Branches as IEnumerable<Exam.DTOs.BranchDto> ?? Enumerable.Empty<Exam.DTOs.BranchDto>();
    var selectedWaveId = ViewBag.SelectedWaveId as int? ?? 0;
    var selectedExamId = ViewBag.SelectedExamId as int? ?? 0;
    var selectedBranchId = ViewBag.SelectedBranchId as int? ?? 0;
}

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-8 mb-8 shadow-sm space-y-6">
    <!-- Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-5">
        <div>
            <h2 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] mb-1">Analytical Filter</h2>
            <div class="flex items-center gap-3">
                <p class="text-xl font-bold">Wave Results & Certificates</p>
                <span class="bg-emerald-100 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border border-emerald-200">
                     Advanced Mode Active
                 </span>
            </div>
        </div>
        
        <div class="flex flex-wrap items-center gap-3">
            <button onclick="triggerPdfUpload()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3.5 rounded-2xl text-[10px] font-black tracking-widest uppercase shadow-md shadow-indigo-600/10 flex items-center gap-2.5 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-600/20 active:translate-y-0 border border-transparent">
                <i class="fas fa-file-pdf text-indigo-100"></i> Upload PDF Certificates
            </button>
            <input type="file" id="certPdfInput" class="hidden" accept=".pdf" multiple onchange="uploadCertPdfs(event)" />

            <button onclick="triggerExcelUpload()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3.5 rounded-2xl text-[10px] font-black tracking-widest uppercase shadow-md shadow-emerald-600/10 flex items-center gap-2.5 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-emerald-600/20 active:translate-y-0 border border-transparent">
                <i class="fas fa-file-excel text-emerald-100"></i> Import Certificates Excel
            </button>
            <input type="file" id="certExcelInput" class="hidden" accept=".xlsx, .xls" onchange="uploadCertExcel(event)" />

            <button onclick="exportCertificatesExcel()" class="bg-teal-600 hover:bg-teal-700 text-white px-6 py-3.5 rounded-2xl text-[10px] font-black tracking-widest uppercase shadow-md shadow-teal-600/10 flex items-center gap-2.5 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-teal-600/20 active:translate-y-0 border border-transparent">
                <i class="fas fa-file-export text-teal-100"></i> Export Certificates Excel
            </button>
        </div>
    </div>

    <!-- Filter Bar Row -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-4">
            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Branch (الفرع)</label>
                <select id="branchFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold min-w-[180px] transition-colors focus:border-brand-500 outline-none">
                    <option value="0">All Branches (جميع الفروع)</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.Id" selected="@(b.Id.ToString() == selectedBranchId.ToString() ? "selected" : null)">@b.BranchName</option>
                    }
                </select>
            </div>

            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Year</label>
                <select id="yearFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold w-[110px] transition-colors focus:border-brand-500 outline-none">
                    <option value="0">Year</option>
                    @for (int y = DateTime.Now.Year; y >= 2024; y--)
                    {
                        <option value="@y" selected="@(ViewBag.SelectedYear == y ? "selected" : null)">@y</option>
                    }
                </select>
            </div>

            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Selected Wave</label>
                <select id="examFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold min-w-[200px] transition-colors focus:border-brand-500 outline-none">
                    <option value="-1">ALL WAVES</option>
                    <optgroup label="WAVES">
                        @foreach (var w in waves)
                        {
                            <option value="@w.Id" selected="@(w.Id == selectedWaveId ? "selected" : null)">
                                @w.WaveName.ToUpper() @(w.StartDate.HasValue ? $"({w.StartDate.Value.ToString("MMM yyyy")})" : "")
                            </option>
                        }
                    </optgroup>
                </select>
            </div>

            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Status Filter</label>
                <select id="certStatusFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold min-w-[240px] transition-colors focus:border-brand-500 outline-none">
                    <option value="all">All Statuses</option>
                    <option value="cert_uploaded">Uploaded on Server 📄</option>
                    <option value="cert_not_uploaded">Not Uploaded Yet ⏳</option>
                    <option value="cert_downloaded">Downloaded by Trainee 📥</option>
                    <option value="cert_not_downloaded">Uploaded - Not Downloaded 🔔</option>
                    <option value="passed_cert">Passed with Cert (> 75%)</option>
                    <option value="passed_no_cert">Passed without Cert (70-75%)</option>
                    <option value="failed">Failed (< 70%)</option>
                    <option value="not_examined">Not Examined ⚪</option>
                    <option value="email_sent">Email Sent ✉️</option>
                    <option value="email_failed">Email Failed / Not Sent ⚠️</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-6 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table id="certificatesTable" class="datatable saas-table">
            <thead>
                <tr>
                    <th class="min-w-[280px]">Personnel</th>
                    <th>Wave</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>User Code</th>
                    <th>Certificate Code</th>
                    <th class="text-right px-8">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model) {
                    bool hasCertCode = !string.IsNullOrEmpty(s.CertificateCode) && s.CertificateCode.Trim() != "/";
                    int rowWaveId = s.WaveId ?? selectedWaveId;
                    string certStatus = "not_examined";
                    string certStatusText = "Not Examined";
                    string statusBadgeClass = "bg-slate-100 text-slate-600 dark:bg-slate-800/80 dark:text-slate-400 border border-slate-200 dark:border-slate-700";
                    string emailStatusAttr = hasCertCode ? (s.EmailSent ? "email_sent" : "email_failed") : "no_email";
                    string uploadStatusAttr = s.CertificateUploaded ? "uploaded" : "not_uploaded";
                    string downloadStatusAttr = s.IsDownloaded ? "downloaded" : "not_downloaded";
                    
                    if (s.Score > 75m)
                    {
                        certStatus = "passed_cert";
                        certStatusText = "Passed with Cert";
                        statusBadgeClass = "bg-emerald-500 text-emerald-700 bg-opacity-10 dark:bg-emerald-950/30 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800";
                    }
                    else if (s.Status == "CertUploaded" || s.CertificateUploaded || hasCertCode)
                    {
                        certStatus = "passed_cert";
                        certStatusText = "Certified in System";
                        statusBadgeClass = "bg-emerald-500 text-emerald-700 bg-opacity-10 dark:bg-emerald-950/30 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800";
                    }
                    else if (s.Status == "PassedNoCert" || (s.Score >= 70m && s.Score <= 75m))
                    {
                        certStatus = "passed_no_cert";
                        certStatusText = "Passed without Cert";
                        statusBadgeClass = "bg-amber-500 text-amber-700 bg-opacity-10 dark:bg-amber-950/30 dark:text-amber-400 border border-amber-200 dark:border-amber-800";
                    }
                    else if (s.Status == "Failed" || (s.Score < 70m && s.Score > 0m))
                    {
                        certStatus = "failed";
                        certStatusText = "Failed";
                        statusBadgeClass = "bg-rose-500 text-rose-700 bg-opacity-10 dark:bg-rose-950/30 dark:text-rose-400 border border-rose-200 dark:border-rose-800";
                    }

                    <tr class="student-row" 
                        data-cert-status="@certStatus" 
                        data-email-status="@emailStatusAttr"
                        data-upload-status="@uploadStatusAttr"
                        data-download-status="@downloadStatusAttr">
                        <td>
                            <div class="flex items-center gap-3 px-4 py-3 flex-nowrap">
                                <div class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-400 font-bold uppercase transition-transform hover:scale-105">@(string.IsNullOrEmpty(s.StudentName) ? "?" : s.StudentName.Substring(0,1))</div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-slate-900 dark:text-white leading-tight">@s.StudentName</span>
                                        <span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            @s.RoleName
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td><span class="text-[10px] font-black text-slate-400 uppercase">@s.WaveName</span></td>
                        <td><span class="text-[10px] font-black text-slate-400 uppercase">@(string.IsNullOrEmpty(s.BranchName) ? "--" : s.BranchName)</span></td>
                        <td>
                            <div class="flex flex-col gap-1.5 w-fit">
                                <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg @statusBadgeClass shadow-sm w-fit">
                                    <span class="text-[10px] font-black tracking-wide">@certStatusText</span>
                                </div>

                                @if (s.CertificateUploaded)
                                {
                                    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300 text-[9px] font-black border border-indigo-200 dark:border-indigo-800 w-fit"
                                         title="@(s.UploadedAt.HasValue ? $"Uploaded on Server: {s.UploadedAt.Value:yyyy-MM-dd hh:mm tt}" : "Certificate file verified on server")">
                                        <i class="fas fa-file-circle-check text-indigo-600"></i>
                                        <span>Uploaded on Server @(s.UploadedAt.HasValue ? $"({s.UploadedAt.Value:dd/MM})" : "")</span>
                                    </div>
                                }
                                else if (hasCertCode)
                                {
                                    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 text-[9px] font-black border border-amber-200 dark:border-amber-800 w-fit">
                                        <i class="fas fa-file-circle-exclamation text-amber-500"></i>
                                        <span>PDF Not Uploaded</span>
                                    </div>
                                }

                                @if (s.IsDownloaded)
                                {
                                    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-300 text-[9px] font-black border border-sky-200 dark:border-sky-800 w-fit"
                                         title="@(s.DownloadedAt.HasValue ? $"Downloaded at: {s.DownloadedAt.Value:yyyy-MM-dd hh:mm tt}" : "Downloaded by trainee")">
                                        <i class="fas fa-cloud-arrow-down text-sky-600"></i>
                                        <span>Downloaded by Trainee @(s.DownloadCount > 1 ? $"({s.DownloadCount}x)" : "") @(s.DownloadedAt.HasValue ? $"• {s.DownloadedAt.Value:dd/MM hh:mm tt}" : "")</span>
                                    </div>
                                }
                                else if (s.CertificateUploaded)
                                {
                                    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-slate-50 text-slate-500 dark:bg-slate-800/60 dark:text-slate-400 text-[9px] font-bold border border-slate-200 dark:border-slate-700 w-fit">
                                        <i class="fas fa-clock text-slate-400"></i>
                                        <span>Not Downloaded Yet</span>
                                    </div>
                                }

                                @if (hasCertCode)
                                {
                                    if (s.EmailSent)
                                    {
                                        <div class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 text-[9px] font-black border border-emerald-200 dark:border-emerald-800 w-fit">
                                            <i class="fas fa-envelope-circle-check text-emerald-500"></i> Email Sent
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 text-[9px] font-black border border-rose-200 dark:border-rose-800 w-fit">
                                            <i class="fas fa-envelope-circle-xmark text-rose-500"></i> Email Not Sent
                                        </div>
                                    }
                                }
                            </div>
                        </td>

                        <td class="font-mono font-bold text-slate-700 dark:text-slate-300">
                            <span class="text-brand-600 dark:text-brand-400 text-sm">@(s.Score > 0 ? $"{s.Score.ToString("0.0")}%" : "--")</span>
                        </td>
                        <td>
                             <span class="text-[10px] font-bold text-slate-500 uppercase">@s.UserCode</span>
                        </td>
                        <td>
                            <div class="flex items-center gap-1.5">
                                @if (hasCertCode)
                                {
                                    <span id="certCodeDisplay_@s.Id" class="px-3 py-1.5 bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-mono text-[10px] font-bold tracking-widest rounded-lg border border-amber-200 dark:border-amber-800 shadow-sm whitespace-nowrap">
                                        @s.CertificateCode
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400 dark:text-slate-600 text-xs font-mono font-bold">--</span>
                                }
                            </div>
                        </td>
                        <td class="text-right px-8">
                            <div class="flex items-center justify-end gap-2">
                                @if (s.CertificateUploaded)
                                {
                                    <a href="@Url.Action("DownloadCertificate", "Home", new { fileName = s.UploadedFileName ?? $"{s.UserCode}.pdf", waveId = rowWaveId, adminPreview = true })" 
                                       target="_blank"
                                       class="p-2 text-indigo-600 hover:text-white hover:bg-indigo-600 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl transition-colors" 
                                       title="معاينة / تحميل ملف الشهادة المرفوع على السيرفر">
                                        <i class="fas fa-file-pdf"></i>
                                    </a>
                                }
                                <button class="p-2 text-slate-400 hover:text-emerald-600 bg-slate-50 dark:bg-slate-800 rounded-xl resend-email-btn" 
                                        data-user-id="@s.Id" 
                                        data-username="@s.StudentName" 
                                        data-wave-id="@rowWaveId" 
                                        title="رفع شهادة / إرسال الإيميل لهذا المتدرب">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                                @if (!hasCertCode && !s.CertificateUploaded)
                                {
                                    <button class="p-2.5 text-slate-400 hover:text-amber-600 bg-slate-50 dark:bg-slate-800 rounded-xl reassign-wave" 
                                            data-user-id="@s.Id" 
                                            data-username="@s.StudentName" 
                                            data-old-wave-id="@rowWaveId" 
                                            title="Move to another Wave">
                                        <i class="fas fa-exchange-alt"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

</div>

@section Scripts {
    <script>
        const allWaves = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waves.Select(w => new { id = w.Id, name = w.WaveName })));

        function notifyToast(type, title, message) {
            if (typeof window.showAppToast === 'function') {
                window.showAppToast(type, title, message);
                return;
            }
            if (window.parent && typeof window.parent.showAppToast === 'function') {
                try {
                    window.parent.showAppToast(type, title, message);
                    return;
                } catch(e) {}
            }
            let container = document.getElementById('appGlobalToastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'appGlobalToastContainer';
                container.className = 'fixed top-5 left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 z-[999999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto transform translate-y-[-16px] opacity-0 transition-all duration-300 ease-out flex items-start gap-3 p-4 rounded-2xl shadow-2xl backdrop-blur-xl border text-xs select-none';

            let iconHtml = '';
            let bgBorder = '';
            let progressBg = '';

            const t = (type || 'info').toLowerCase();
            if (t === 'success') {
                bgBorder = 'bg-slate-900/95 text-emerald-100 border-emerald-500/40 shadow-emerald-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-check-circle"></i></div>';
                progressBg = 'bg-emerald-400';
            } else if (t === 'error' || t === 'danger') {
                bgBorder = 'bg-slate-900/95 text-rose-100 border-rose-500/40 shadow-rose-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-circle"></i></div>';
                progressBg = 'bg-rose-400';
            } else if (t === 'warning') {
                bgBorder = 'bg-slate-900/95 text-amber-100 border-amber-500/40 shadow-amber-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-triangle"></i></div>';
                progressBg = 'bg-amber-400';
            } else {
                bgBorder = 'bg-slate-900/95 text-indigo-100 border-indigo-500/40 shadow-indigo-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-info-circle"></i></div>';
                progressBg = 'bg-indigo-400';
            }

            toast.className += ' ' + bgBorder;
            toast.innerHTML = `
                ${iconHtml}
                <div class="flex-1 min-w-0 pr-1">
                    <h5 class="font-black text-xs text-white leading-snug">${title || ''}</h5>
                    ${message ? `<p class="text-[11px] opacity-80 mt-0.5 leading-normal break-words">${message}</p>` : ''}
                </div>
                <button type="button" class="text-white/40 hover:text-white transition-colors text-xs p-1 shrink-0" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
                <div class="absolute bottom-0 left-0 right-0 h-1 rounded-b-2xl overflow-hidden bg-white/10">
                    <div class="h-full ${progressBg} transition-all ease-linear" style="width: 100%; transition-duration: 3500ms;"></div>
                </div>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-[-16px]', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
                const progressBar = toast.querySelector(`.${progressBg}`);
                if (progressBar) {
                    requestAnimationFrame(() => {
                        progressBar.style.width = '0%';
                    });
                }
            });

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-[-8px]', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
        function updateExamList() {
            const type = 0;
            const year = $('#yearFilter').val();
            const month = 0;

            $.get('/Admin/GetFilteredExams', { typeId: type, month: month, year: year, mode: 'cert' }, function (data) {
                const $examFilter = $('#examFilter');
                $examFilter.empty();
                $examFilter.append('<option value="-1">ALL WAVES</option>');

                if (data.length > 0) {
                    // Group by typeName
                    const grouped = {};
                    data.forEach(e => {
                        if (!grouped[e.typeName]) grouped[e.typeName] = [];
                        grouped[e.typeName].push(e);
                    });

                    Object.keys(grouped).sort().reverse().forEach(type => {
                        const $group = $('<optgroup>').attr('label', type.toUpperCase());
                        grouped[type].forEach(e => {
                            $group.append($('<option>').val(e.id).text(e.title));
                        });
                        $examFilter.append($group);
                    });
                }
            });
        }

        $('#yearFilter, #examFilter, #branchFilter').change(function () {
            const waveId = $('#examFilter').val() || -1;
            const year = $('#yearFilter').val() || 0;
            const branchId = $('#branchFilter').val() || 0;
            const type = 0;
            const month = 0;
            let newUrl = '/Admin/Certificates?waveId=' + waveId + '&typeId=' + type + '&year=' + year + '&month=' + month + '&branchId=' + branchId; 
            if (window.location.search.includes('iframe=true')) newUrl += '&iframe=true';
            window.location = newUrl;
        });

        function exportCertificatesExcel() {
            const waveId = $('#examFilter').val() || -1;
            const year = $('#yearFilter').val() || 0;
            const branchId = $('#branchFilter').val() || 0;
            window.location.href = `/Admin/ExportCertificatesToExcel?waveId=${waveId}&year=${year}&branchId=${branchId}`;
        }



        function triggerExcelUpload() {
            Swal.fire({
                title: '<div class="flex flex-col items-center gap-2 pt-4 px-6"><i class="fas fa-file-excel text-emerald-500 text-3xl mb-2"></i><span class="text-lg font-black uppercase tracking-wider text-slate-800 dark:text-slate-100">دليل استيراد ملف الإكسيل</span></div>',
                html: `
                    <div class="text-right px-6 py-4 space-y-4" dir="rtl">
                        <p class="text-xs text-slate-600 dark:text-slate-400 font-bold mb-3">لاستيراد بيانات الطلاب والشهادات بنجاح، الأعمدة المدعومة بملف الإكسيل (Excel):</p>
                        <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 font-sans">
                            
                            <!-- كود المستخدم -->
                            <div class="flex items-start gap-3">
                                <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">مطلوب</span>
