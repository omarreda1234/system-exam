@model IEnumerable<Exam.DTOs.ExamResultRowDto>
@{
    ViewData["Title"] = "Certificates Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var waves = ViewBag.Waves as IEnumerable<Exam.DTOs.WaveDto> ?? Enumerable.Empty<Exam.DTOs.WaveDto>();
    var selectedWaveId = ViewBag.SelectedWaveId as int? ?? 0;
    var selectedExamId = ViewBag.SelectedExamId as int? ?? 0;
}

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-8 mb-8 shadow-sm space-y-6">
    <!-- Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-5">
        <div>
            <h2 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] mb-1">Analytical Filter</h2>
            <div class="flex items-center gap-3">
                <p class="text-xl font-bold">Certificates Management</p>
                <span class="bg-emerald-100 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border border-emerald-200">
                     Advanced Mode Active
                 </span>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <button onclick="triggerPdfUpload()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3.5 rounded-2xl text-[10px] font-black tracking-widest uppercase shadow-md shadow-indigo-600/10 flex items-center gap-2.5 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-600/20 active:translate-y-0 border border-transparent">
                <i class="fas fa-file-pdf text-indigo-100"></i> Upload PDF Certificates
            </button>
            <input type="file" id="certPdfInput" class="hidden" accept=".pdf" multiple onchange="uploadCertPdfs(event)" />

            <button onclick="triggerExcelUpload()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3.5 rounded-2xl text-[10px] font-black tracking-widest uppercase shadow-md shadow-emerald-600/10 flex items-center gap-2.5 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-emerald-600/20 active:translate-y-0 border border-transparent">
                <i class="fas fa-file-excel text-emerald-100"></i> Import Certificates Excel
            </button>
            <input type="file" id="certExcelInput" class="hidden" accept=".xlsx, .xls" onchange="uploadCertExcel(event)" />
        </div>
    </div>

    <!-- Filter Bar Row -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-4">
            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Year</label>
                <select id="yearFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold w-[110px] transition-colors focus:border-brand-500 outline-none">
                    <option value="0">Year</option>
                    @for (int y = DateTime.Now.Year; y >= 2024; y--)
                    {
                        <option value="@y" selected="@(ViewBag.SelectedYear == y ? "selected" : null)">@y</option>
                    }
                </select>
            </div>

            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Selected Wave</label>
                <select id="examFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold min-w-[280px] transition-colors focus:border-brand-500 outline-none">
                    <option value="-1" selected="@(-1 == selectedWaveId ? "selected" : null)">ALL WAVES</option>
                    <optgroup label="TRAINING BATCHES">
                        @foreach (var w in waves)
                        {
                            <option value="@w.Id" selected="@(w.Id == selectedWaveId ? "selected" : null)">
                                @w.WaveName.ToUpper() @(w.StartDate.HasValue ? $"({w.StartDate.Value.ToString("MMM yyyy")})" : "")
                            </option>
                        }
                    </optgroup>
                </select>
            </div>

            <div class="space-y-2">
                <label class="block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-1">Status Filter (تصفية بالحالة)</label>
                <select id="certStatusFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold min-w-[210px] transition-colors focus:border-brand-500 outline-none">
                    <option value="all">All Statuses (الكل)</option>
                    <option value="certified">Certified (تم إصدار الشهادة)</option>
                    <option value="pending">Pending (لم تصدر شهادة)</option>
                    <option value="email_sent">Email Sent (تم إرسال الإيميل ✉️)</option>
                    <option value="email_failed">Email Failed (فشل إرسال الإيميل ⚠️)</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-6 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table id="certificatesTable" class="datatable saas-table">
            <thead>
                <tr>
                    <th class="min-w-[280px]">Personnel</th>
                    <th>Wave</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>User Code</th>
                    <th>Certificate Code</th>
                    <th class="text-right px-8">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model) {
                    bool hasCertCode = !string.IsNullOrEmpty(s.CertificateCode) && s.CertificateCode.Trim() != "/";
                    string certStatus = "pending";
                    string certStatusText = "لم تصدر شهادة";
                    string statusBadgeClass = "bg-amber-500 text-amber-700 bg-opacity-10 dark:bg-amber-950/30 dark:text-amber-400 border border-amber-200 dark:border-amber-800";
                    string emailStatusAttr = hasCertCode ? (s.EmailSent ? "email_sent" : "email_failed") : "no_email";
                    
                    if (hasCertCode)
                    {
                        certStatus = "certified";
                        certStatusText = "تم إصدار الشهادة";
                        statusBadgeClass = "bg-emerald-500 text-emerald-700 bg-opacity-10 dark:bg-emerald-950/30 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800";
                    }

                    <tr class="student-row" data-cert-status="@certStatus" data-email-status="@emailStatusAttr">
                        <td>
                            <div class="flex items-center gap-3 px-4 py-3 flex-nowrap">
                                <div class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-400 font-bold uppercase transition-transform hover:scale-105">@(string.IsNullOrEmpty(s.StudentName) ? "?" : s.StudentName.Substring(0,1))</div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-slate-900 dark:text-white leading-tight">@s.StudentName</span>
                                        <span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase bg-slate-100 dark:bg-slate-850 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            @s.RoleName
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td><span class="text-[10px] font-black text-slate-400 uppercase">@s.WaveName</span></td>
                        <td><span class="text-[10px] font-black text-slate-400 uppercase">@(string.IsNullOrEmpty(s.BranchName) ? "--" : s.BranchName)</span></td>
                        <td>
                            <div class="flex flex-col gap-1.5 w-fit">
                                <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg @statusBadgeClass shadow-sm">
                                    <span class="text-[10px] font-black tracking-wide">@certStatusText</span>
                                </div>
                                @if (hasCertCode)
                                {
                                    if (s.EmailSent)
                                    {
                                        <div class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 text-[9px] font-black border border-emerald-200 dark:border-emerald-800">
                                            <i class="fas fa-envelope-circle-check text-emerald-500"></i> تم إرسال الإيميل
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 text-[9px] font-black border border-rose-200 dark:border-rose-800">
                                            <i class="fas fa-envelope-circle-xmark text-rose-500"></i> فشل إرسال الإيميل
                                        </div>
                                    }
                                }
                            </div>
                        </td>

                        <td class="font-mono font-bold text-slate-700 dark:text-slate-300">
                            <span class="text-brand-600 dark:text-brand-400 text-sm">@(s.Score > 0 ? $"{s.Score.ToString("0.0")}%" : "--")</span>
                        </td>
                        <td>
                             <span class="text-[10px] font-bold text-slate-500 uppercase">@s.UserCode</span>
                        </td>
                        <td>
                            <div class="flex items-center gap-1.5">
                                @if (hasCertCode)
                                {
                                    <span id="certCodeDisplay_@s.Id" class="px-3 py-1.5 bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-mono text-[10px] font-bold tracking-widest rounded-lg border border-amber-200 dark:border-amber-800 shadow-sm whitespace-nowrap">
                                        @s.CertificateCode
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400 dark:text-slate-600 text-xs font-mono font-bold">--</span>
                                }
                            </div>
                        </td>
                        <td class="text-right px-8">
                            <div class="flex items-center justify-end gap-2">
                                @if (hasCertCode)
                                {
                                    <button class="p-2 text-slate-400 hover:text-emerald-600 bg-slate-50 dark:bg-slate-800 rounded-xl resend-email-btn" 
                                            data-user-id="@s.Id" 
                                            data-username="@s.StudentName" 
                                            data-wave-id="@selectedWaveId" 
                                            title="إعادة إرسال الإيميل">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="p-2.5 text-slate-400 hover:text-amber-600 bg-slate-50 dark:bg-slate-800 rounded-xl reassign-wave" 
                                            data-user-id="@s.Id" 
                                            data-username="@s.StudentName" 
                                            data-old-wave-id="@selectedWaveId" 
                                            title="Move to another Wave">
                                        <i class="fas fa-exchange-alt"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const allWaves = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waves.Select(w => new { id = w.Id, name = w.WaveName })));
        function updateExamList() {
            const type = 0;
            const year = $('#yearFilter').val();
            const month = 0;

            $.get('/Admin/GetFilteredExams', { typeId: type, month: month, year: year, mode: 'cert' }, function (data) {
                const $examFilter = $('#examFilter');
                $examFilter.empty();
                $examFilter.append('<option value="-1">ALL WAVES</option>');

                if (data.length > 0) {
                    // Group by typeName
                    const grouped = {};
                    data.forEach(e => {
                        if (!grouped[e.typeName]) grouped[e.typeName] = [];
                        grouped[e.typeName].push(e);
                    });

                    Object.keys(grouped).sort().reverse().forEach(type => {
                        const $group = $('<optgroup>').attr('label', type.toUpperCase());
                        grouped[type].forEach(e => {
                            $group.append($('<option>').val(e.id).text(e.title));
                        });
                        $examFilter.append($group);
                    });
                }
            });
        }

        $('#yearFilter').change(function () {
            const year = $(this).val();
            const waveId = $('#examFilter').val() || -1;
            const type = 0;
            const month = 0;
            let newUrl = '/Admin/Certificates?waveId=' + waveId + '&typeId=' + type + '&year=' + year + '&month=' + month; 
            if (window.location.search.includes('iframe=true')) newUrl += '&iframe=true';
            window.location = newUrl;
        });

        $('#examFilter').change(function () {
            const waveId = $(this).val();
            const year = $('#yearFilter').val() || 0;
            const type = 0;
            const month = 0;
            let newUrl = '/Admin/Certificates?waveId=' + waveId + '&typeId=' + type + '&year=' + year + '&month=' + month; 
            if (window.location.search.includes('iframe=true')) newUrl += '&iframe=true';
            window.location = newUrl;
        });



        function triggerExcelUpload() {
            Swal.fire({
                title: '<div class="flex flex-col items-center gap-2 pt-4 px-6"><i class="fas fa-file-excel text-emerald-500 text-3xl mb-2"></i><span class="text-lg font-black uppercase tracking-wider text-slate-800 dark:text-slate-100">دليل استيراد ملف الإكسيل</span></div>',
                html: `
                    <div class="text-right px-6 py-4 space-y-4" dir="rtl">
                        <p class="text-xs text-slate-600 dark:text-slate-400 font-bold mb-3">لاستيراد بيانات الطلاب والشهادات بنجاح، الأعمدة المدعومة بملف الإكسيل (Excel):</p>
                        <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 font-sans">
                            
                            <!-- كود المستخدم -->
                            <div class="flex items-start gap-3">
                                <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">مطلوب</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">كود المستخدم (User Code)</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">العناوين المقبولة: Code، UserCode، User Code، الكود، كود، كود الطالب</p>
                                </div>
                            </div>
                            
                            <!-- كود السيريال التلقائي -->
                            <div class="flex items-start gap-3 border-t border-slate-200 dark:border-slate-800 pt-3">
                                <span class="bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">توليد آلي ⚡</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">كود السيريال والشهادة (Certificate Serial Code)</p>
                                    <p class="text-[10px] text-brand-600 dark:text-brand-400 font-bold">يتم توليده وحسابه تلقائياً من النظام وفق نمط سيريال الويف (مثل: WTTA-2026-001-PB-Off-5671) دون الحاجة لإدخاله يدوياً في ملف الإكسيل.</p>
                                </div>
                            </div>
                            
                            <!-- اسم الويف -->
                            <div class="flex items-start gap-3 border-t border-slate-200 dark:border-slate-800 pt-3">
                                <span class="bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">اختياري</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">اسم الويف (Wave Name)</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">العناوين المقبولة: Wave، الويف، الدورة، المجموعة، WaveName. <br><span class="text-amber-600 dark:text-amber-400 font-semibold">ملاحظة: إذا لم تكن الويف موجودة بالسيستم، فسيقوم النظام بإنشائها تلقائياً ونقل الطالب إليها.</span></p>
                                </div>
                            </div>
                            
                            <!-- النسبة المئوية -->
                            <div class="flex items-start gap-3 border-t border-slate-200 dark:border-slate-800 pt-3">
                                <span class="bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">اختياري</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">النسبة المئوية أو الدرجة (Score)</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">العناوين المقبولة: Score، الدرجة، النسبة، النسبة المئوية، درجة، نسبة، Score %، Percentage.</p>
                                </div>
                            </div>

                            <!-- الاسم بالكامل -->
                            <div class="flex items-start gap-3 border-t border-slate-200 dark:border-slate-800 pt-3">
                                <span class="bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">اختياري</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">اسم الطالب بالكامل</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">العناوين المقبولة: Name، FullName، StudentName، الاسم، اسم الطالب، الاسم بالكامل.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'اختيار ملف الإكسيل <i class="fas fa-upload mr-2"></i>',
                cancelButtonText: 'إلغاء',
                width: '600px',
                customClass: {
                    popup: 'rounded-[32px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                    confirmButton: 'bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 px-10 rounded-2xl transition-all shadow-xl shadow-emerald-600/10 text-xs uppercase tracking-widest ml-3',
                    cancelButton: 'bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-400 font-bold py-4 px-10 rounded-2xl transition-all text-xs uppercase'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#certExcelInput').click();
                }
            });
        }

        function uploadCertExcel(event) {
            const file = event.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('excelFile', file);
            
            Swal.fire({
                title: 'Importing Certificates...',
                text: 'Please wait while we process the Excel file',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch('/Admin/UploadCertificatesOnlyExcel?examId=@selectedExamId&waveId=@selectedWaveId', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(res => {
                $('#certExcelInput').val('');
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Import Successful',
                        text: res.message,
                        confirmButtonText: 'Reload Page'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Import Failed',
                        text: res.message
                    });
                }
            })
            .catch(err => {
                $('#certExcelInput').val('');
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred during upload.'
                });
            });
        }

        function triggerPdfUpload() {
            const selectedWaveId = $('#examFilter').val();
            if (!selectedWaveId || selectedWaveId == "-1" || selectedWaveId == "0") {
                Swal.fire('تنبيـه', 'يرجى اختيار الـ Wave المطلوبة أولاً من القائمة قبل رفع الشهادات.', 'warning');
                return;
            }

            Swal.fire({
                title: '<div class="flex flex-col items-center gap-2 pt-4 px-6"><i class="fas fa-file-pdf text-indigo-500 text-3xl mb-2"></i><span class="text-lg font-black uppercase tracking-wider text-slate-800 dark:text-slate-100">تعليمات رفع شهادات PDF الجاهزة</span></div>',
                html: `
                    <div class="text-right px-6 py-4 space-y-4" dir="rtl">
                        <p class="text-xs text-slate-600 dark:text-slate-400 font-bold mb-3">لرفع شهادات الطلاب وتوليد السيريال تلقائياً ورسائل البريد:</p>
                        <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 font-sans">
                            <div class="flex items-start gap-3">
                                <span class="bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">اسم الملف</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">اسم كل ملف PDF يجب أن يكون كود المستخدم (UserCode)</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">مثال: <code class="bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 px-1 py-0.5 rounded">5671.pdf</code> أو <code class="bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 px-1 py-0.5 rounded">6013.pdf</code></p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 border-t border-slate-200 dark:border-slate-800 pt-3">
                                <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">تعدد الملفات</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">يمكنك تحديد عدة ملفات PDF دفعة واحدة</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">سيقوم النظام بربط كل شهادة بالطالب المناسب حسب الكود وتوليد كود السيريال <code class="bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 px-1 py-0.5 rounded">WTTA-2026-011-PB-Off-5671</code> وإرسال البريد الإلكتروني المرفق تلقائياً.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'اختيار ملفات الـ PDF <i class="fas fa-upload mr-2"></i>',
                cancelButtonText: 'إلغاء',
                width: '600px',
                customClass: {
                    popup: 'rounded-[32px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                    confirmButton: 'bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 px-10 rounded-2xl transition-all shadow-xl shadow-indigo-600/10 text-xs uppercase tracking-widest ml-3',
                    cancelButton: 'bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-400 font-bold py-4 px-10 rounded-2xl transition-all text-xs uppercase'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#certPdfInput').click();
                }
            });
        }

        function uploadCertPdfs(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            const selectedWaveId = $('#examFilter').val();
            if (!selectedWaveId || selectedWaveId == "-1" || selectedWaveId == "0") {
                Swal.fire('تنبيـه', 'يرجى اختيار الـ Wave المطلوبة أولاً من القائمة قبل رفع الشهادات.', 'warning');
                return;
            }

            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('pdfFiles', files[i]);
            }

            Swal.fire({
                title: 'جاري رفع ومعالجة الشهادات...',
                text: `جاري رفع ${files.length} ملف PDF وتوليد السيريال وإرسال البريد الإلكتروني...`,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch(`/Admin/UploadCertificatesPdfs?waveId=${selectedWaveId}`, {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(res => {
                $('#certPdfInput').val('');
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم التجهيز والإرسال بنجاح',
                        text: res.message,
                        confirmButtonText: 'إعادة تحميل الصفحة'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'فشل الرفع',
                        text: res.message
                    });
                }
            })
            .catch(err => {
                $('#certPdfInput').val('');
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ',
                    text: 'حدث خطأ أثناء رفع ومعالجة الملفات.'
                });
            });
        }

        $.fn.dataTable.ext.search.push(
            function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'certificatesTable') return true;
                const selectedFilter = $('#certStatusFilter').val();
                if (!selectedFilter || selectedFilter === 'all') return true;

                const tr = settings.aoData[dataIndex] ? settings.aoData[dataIndex].nTr : null;
                if (!tr) return true;

                const rowCertStatus = $(tr).attr('data-cert-status') || '';
                const rowEmailStatus = $(tr).attr('data-email-status') || '';

                if (selectedFilter === 'certified') {
                    return rowCertStatus === 'certified';
                }
                if (selectedFilter === 'pending') {
                    return rowCertStatus === 'pending';
                }
                if (selectedFilter === 'email_sent') {
                    return rowEmailStatus === 'email_sent';
                }
                if (selectedFilter === 'email_failed') {
                    return rowEmailStatus === 'email_failed';
                }
                return true;
            }
        );

        $(document).on('change', '#certStatusFilter', function() {
            if ($.fn.DataTable.isDataTable('#certificatesTable')) {
                $('#certificatesTable').DataTable().draw();
            }
        });

        $(document).ready(function() {
            let table;
            if ($.fn.DataTable.isDataTable('#certificatesTable')) {
                table = $('#certificatesTable').DataTable();
            } else {
                table = $('#certificatesTable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    ordering: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records..."
                    }
                });
            }

            $(document).on('click', '.reassign-wave', function() {
                const userId = $(this).data('user-id');
                const username = $(this).data('username');
                const oldWaveId = $(this).data('old-wave-id');

                let optionsHtml = '';
                if (typeof allWaves !== 'undefined' && Array.isArray(allWaves)) {
                    allWaves.forEach(w => {
                        if (w.id != oldWaveId) {
                            optionsHtml += `<option value="${w.id}">${w.name.toUpperCase()}</option>`;
                        }
                    });
                }

                if (!optionsHtml) {
                    Swal.fire('Warning', 'No other waves available for reassignment.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Move student to another Wave',
                    html: `
                        <div class="text-left space-y-4 p-2">
                            <p class="text-sm text-slate-600">Select the destination Wave to move <strong>${username}</strong>:</p>
                            <select id="newWaveSelect" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold">
                                ${optionsHtml}
                            </select>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Reassign Wave <i class="fas fa-exchange-alt ml-2"></i>',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-xl transition-all shadow-md',
                        cancelButton: 'bg-white hover:bg-slate-50 text-slate-400 font-bold py-3 px-6 rounded-xl transition-all border border-slate-200 ml-2'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        const newWaveId = $('#newWaveSelect').val();
                        
                        Swal.fire({
                            title: 'Reassigning...',
                            didOpen: () => Swal.showLoading()
                        });

                        fetch('/Admin/MoveUserToWave', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: new URLSearchParams({
                                userId: userId,
                                oldWaveId: oldWaveId,
                                newWaveId: newWaveId
                            })
                        })
                        .then(r => r.json())
                        .then(res => {
                            if (res.success) {
                                Swal.fire('Success', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'An error occurred.', 'error');
                        });
                    }
                });
            });

            $(document).on('click', '.resend-email-btn', function() {
                const userId = $(this).data('user-id');
                const waveId = $(this).data('wave-id');
                const username = $(this).data('username');

                Swal.fire({
                    title: 'إرسال البريد الإلكتروني للشهادة',
                    html: `
                        <div class="text-right space-y-4 p-2" dir="rtl">
                            <p class="text-xs text-slate-600 font-bold">هل ترغب في إرسال شهادة الـ PDF للمستخدم <strong>(${username})</strong>؟</p>
                            <div class="bg-indigo-50/50 p-4 rounded-2xl border border-indigo-100 space-y-2 text-right">
                                <label class="block text-xs font-bold text-indigo-900 mb-1">إرفاق / استبدال ملف PDF لهذا الطالب (اختياري):</label>
                                <input type="file" id="resendPdfInput" accept=".pdf" class="w-full text-xs text-slate-500 file:ml-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 cursor-pointer" />
                                <p class="text-[10px] text-slate-400 mt-1">إذا لم تقم باختيار ملف، سيتم استخدام ملف الـ PDF المحفوظ سابقاً لهذا الطالب تلقائياً.</p>
                            </div>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'إرسال الآن <i class="fas fa-paper-plane mr-2"></i>',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const formData = new FormData();
                        formData.append('userId', userId);
                        formData.append('waveId', waveId);

                        const fileInput = document.getElementById('resendPdfInput');
                        if (fileInput && fileInput.files.length > 0) {
                            formData.append('pdfFile', fileInput.files[0]);
                        }

                        Swal.fire({
                            title: 'جاري إرسال البريد الإلكتروني...',
                            text: 'يرجى الانتظار...',
                            allowOutsideClick: false,
                            didOpen: () => Swal.showLoading()
                        });

                        fetch('/Admin/ResendCertificateEmail', {
                            method: 'POST',
                            body: formData
                        })
                        .then(r => r.json())
                        .then(res => {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'تم الإرسال بنجاح',
                                    text: res.message
                                }).then(() => location.reload());
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'فشل الإرسال',
                                    text: res.message
                                });
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('خطأ', 'حدث خطأ أثناء التواصل مع السيرفر.', 'error');
                        });
                    }
                });
            });
        });
    </script>
}
