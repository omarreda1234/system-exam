        function uploadCertExcel(event) {
            const file = event.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('excelFile', file);
            
            Swal.fire({
                title: 'Importing Certificates...',
                text: 'Please wait while we process the Excel file',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch('/Admin/UploadCertificatesOnlyExcel?examId=@selectedExamId&waveId=@selectedWaveId', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(res => {
                $('#certExcelInput').val('');
                Swal.close();
                if (res.success) {
                    notifyToast('success', 'Import Successful', res.message);
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } else {
                    notifyToast('error', 'Import Failed', res.message);
                }
            })
            .catch(err => {
                $('#certExcelInput').val('');
                console.error(err);
                Swal.close();
                notifyToast('error', 'Error', 'An error occurred during upload.');
            });
        }

        function triggerPdfUpload() {
            const selectedWaveId = $('#examFilter').val();
            if (!selectedWaveId || selectedWaveId == "-1" || selectedWaveId == "0") {
                notifyToast('warning', 'تنبيـه', 'يرجى اختيار الـ Wave المطلوبة أولاً من القائمة قبل رفع الشهادات.');
                return;
            }

            Swal.fire({
                title: '<div class="flex flex-col items-center gap-2 pt-4 px-6"><i class="fas fa-file-pdf text-indigo-500 text-3xl mb-2"></i><span class="text-lg font-black uppercase tracking-wider text-slate-800 dark:text-slate-100">تعليمات رفع شهادات PDF الجاهزة</span></div>',
                html: `
                    <div class="text-right px-6 py-4 space-y-4" dir="rtl">
                        <p class="text-xs text-slate-600 dark:text-slate-400 font-bold mb-3">لرفع شهادات الطلاب وتوليد السيريال تلقائياً ورسائل البريد:</p>
                        <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-3 font-sans">
                            <div class="flex items-start gap-3">
                                <span class="bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">اسم الملف</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">اسم كل ملف PDF يجب أن يكون كود المستخدم (UserCode)</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">مثال: <code class="bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 px-1 py-0.5 rounded">5671.pdf</code> أو <code class="bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 px-1 py-0.5 rounded">6013.pdf</code></p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 border-t border-slate-200 dark:border-slate-800 pt-3">
                                <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider mt-0.5">تعدد الملفات</span>
                                <div class="flex-1 pr-2">
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">يمكنك تحديد عدة ملفات PDF دفعة واحدة</p>
                                    <p class="text-[10px] text-slate-400 dark:text-slate-500">سيقوم النظام بربط كل شهادة بالطالب المناسب حسب الكود وتوليد كود السيريال <code class="bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 px-1 py-0.5 rounded">WTTA-2026-011-PB-Off-5671</code> وإتاحتها للتحميل المباشر من بروفايل الطالب فوراً.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'اختيار ملفات الـ PDF <i class="fas fa-upload mr-2"></i>',
                cancelButtonText: 'إلغاء',
                width: '600px',
                customClass: {
                    popup: 'rounded-[32px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                    confirmButton: 'bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 px-10 rounded-2xl transition-all shadow-xl shadow-indigo-600/10 text-xs uppercase tracking-widest ml-3',
                    cancelButton: 'bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-400 font-bold py-4 px-10 rounded-2xl transition-all text-xs uppercase'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#certPdfInput').click();
                }
            });
        }

        function uploadCertPdfs(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            const selectedWaveId = $('#examFilter').val();
            if (!selectedWaveId || selectedWaveId == "-1" || selectedWaveId == "0") {
                notifyToast('warning', 'تنبيـه', 'يرجى اختيار الـ Wave المطلوبة أولاً من القائمة قبل رفع الشهادات.');
                return;
            }

            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('pdfFiles', files[i]);
            }

            // Calculate total size
            let totalBytes = 0;
            for (let i = 0; i < files.length; i++) {
                totalBytes += files[i].size;
            }
            const totalMbFormatted = (totalBytes / (1024 * 1024)).toFixed(1);

            Swal.fire({
                title: 'رفع ومعالجة الشهادات (Bulk Upload)',
                html: `
                    <div class="py-2 text-right dir-rtl space-y-4">
                        <div class="flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-300">
                            <span id="uploadProgressStatus" class="flex items-center gap-1.5">
                                <i class="fas fa-arrow-circle-up text-indigo-600 animate-bounce"></i>
                                <span>جاري رفع الملفات إلى السيرفر...</span>
                            </span>
                            <span id="uploadProgressPercent" class="text-indigo-600 dark:text-indigo-400 font-black text-sm">0%</span>
                        </div>

                        <!-- Progress Bar Container -->
                        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-4 overflow-hidden p-0.5 border border-slate-200 dark:border-slate-700 shadow-inner">
                            <div id="uploadProgressBar" class="bg-gradient-to-r from-indigo-500 via-indigo-600 to-emerald-500 h-full rounded-full transition-all duration-150 ease-out" style="width: 0%"></div>
                        </div>

                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400">
                            <span id="uploadBytesText">0.0 MB / ${totalMbFormatted} MB</span>
                            <span class="bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 rounded-lg text-slate-600 dark:text-slate-300 font-extrabold">${files.length} ملف PDF</span>
                        </div>

                        <!-- Processing Phase Box -->
                        <div id="uploadProcessingNotice" class="hidden p-3.5 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 rounded-2xl text-xs text-amber-800 dark:text-amber-300">
                            <div class="flex items-center gap-2 font-bold mb-1">
                                <i class="fas fa-spinner fa-spin text-amber-600"></i>
                                <span>اكتمل الرفع! جاري المعالجة الفورية...</span>
                            </div>
                            <p class="text-[11px] text-amber-700/80 dark:text-amber-400/80">
                                يقوم السيرفر الآن بمطابقة أكواد الطلاب، وتوليد الأرقام التسلسلية (Serials)، وربط الشهادات وإتاحتها للتحميل من البروفايل.
                            </p>
                        </div>
                    </div>
                `,
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    const xhr = new XMLHttpRequest();
                    xhr.open('POST', `/Admin/UploadCertificatesPdfs?waveId=${selectedWaveId}`, true);

                    xhr.upload.onprogress = function(evt) {
                        if (evt.lengthComputable) {
                            const percent = Math.min(100, Math.round((evt.loaded / evt.total) * 100));
                            const loadedMb = (evt.loaded / (1024 * 1024)).toFixed(1);
                            
                            const bar = document.getElementById('uploadProgressBar');
                            const txt = document.getElementById('uploadProgressPercent');
                            const bTxt = document.getElementById('uploadBytesText');
                            const notice = document.getElementById('uploadProcessingNotice');
                            const status = document.getElementById('uploadProgressStatus');

                            if (bar) bar.style.width = percent + '%';
                            if (txt) txt.innerText = percent + '%';
                            if (bTxt) bTxt.innerText = `${loadedMb} MB / ${totalMbFormatted} MB`;

                            if (percent >= 100) {
                                if (notice) notice.classList.remove('hidden');
                                if (status) status.innerHTML = '<i class="fas fa-cog fa-spin text-amber-500"></i> <span>جاري المعالجة وإصدار الشهادات...</span>';
                            }
                        }
                    };

                    xhr.onload = function() {
                        $('#certPdfInput').val('');
                        try {
                            const res = JSON.parse(xhr.responseText);
                            Swal.close();
                            if (xhr.status === 200 && res.success) {
                                notifyToast('success', 'تم الرفع والتجهيز بنجاح', res.message);
                                setTimeout(() => {
                                    location.reload();
                                }, 2000);
                            } else {
                                notifyToast('error', 'فشل الرفع', res.message || 'حدث خطأ أثناء معالجة الشهادات على السيرفر.');
                            }
                        } catch(err) {
                            Swal.close();
                            notifyToast('error', 'خطأ', 'استجابة غير متوقعة من السيرفر.');
                        }
                    };

                    xhr.onerror = function() {
                        $('#certPdfInput').val('');
                        Swal.close();
                        notifyToast('error', 'فشل الاتصال', 'حدث خطأ في الاتصال بالسيرفر أثناء رفع الملفات.');
                    };

                    xhr.send(formData);
                }
            });
        }

        $.fn.dataTable.ext.search.push(
            function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'certificatesTable') return true;

                // Status Filter Check
                const selectedFilter = $('#certStatusFilter').val();
                if (!selectedFilter || selectedFilter === 'all') return true;

                const tr = settings.aoData[dataIndex] ? settings.aoData[dataIndex].nTr : null;
                if (!tr) return true;

                const rowCertStatus = $(tr).attr('data-cert-status') || '';
                const rowEmailStatus = $(tr).attr('data-email-status') || '';
                const rowUploadStatus = $(tr).attr('data-upload-status') || '';
                const rowDownloadStatus = $(tr).attr('data-download-status') || '';

                if (selectedFilter === 'cert_uploaded') {
                    return rowUploadStatus === 'uploaded';
                }
                if (selectedFilter === 'cert_not_uploaded') {
                    return rowUploadStatus === 'not_uploaded';
                }
                if (selectedFilter === 'cert_downloaded') {
                    return rowDownloadStatus === 'downloaded';
                }
                if (selectedFilter === 'cert_not_downloaded') {
                    return rowUploadStatus === 'uploaded' && rowDownloadStatus === 'not_downloaded';
                }
                if (selectedFilter === 'passed_cert' || selectedFilter === 'certified') {
                    return rowCertStatus === 'passed_cert' || rowCertStatus === 'certified';
                }
                if (selectedFilter === 'passed_no_cert') {
                    return rowCertStatus === 'passed_no_cert';
                }
                if (selectedFilter === 'failed') {
                    return rowCertStatus === 'failed';
                }
                if (selectedFilter === 'not_examined' || selectedFilter === 'pending') {
                    return rowCertStatus === 'not_examined' || rowCertStatus === 'pending';
                }
                if (selectedFilter === 'email_sent') {
                    return rowEmailStatus === 'email_sent';
                }
                if (selectedFilter === 'email_failed') {
                    return rowEmailStatus === 'email_failed';
                }
                return true;
            }
        );

        $(document).on('change', '#certStatusFilter', function() {
            if ($.fn.DataTable.isDataTable('#certificatesTable')) {
                $('#certificatesTable').DataTable().draw();
            }
        });

        $(document).ready(function() {
            let table;
            if ($.fn.DataTable.isDataTable('#certificatesTable')) {
                table = $('#certificatesTable').DataTable();
            } else {
                table = $('#certificatesTable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    ordering: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records..."
                    }
                });
            }

            $(document).on('click', '.reassign-wave', function() {
                const userId = $(this).data('user-id');
                const username = $(this).data('username');
                const oldWaveId = $(this).data('old-wave-id');

                let optionsHtml = '';
                if (typeof allWaves !== 'undefined' && Array.isArray(allWaves)) {
                    allWaves.forEach(w => {
                        if (w.id != oldWaveId) {
                            optionsHtml += `<option value="${w.id}">${w.name.toUpperCase()}</option>`;
                        }
                    });
                }

                if (!optionsHtml) {
                    notifyToast('warning', 'Notice', 'No other waves available for reassignment.');
                    return;
                }

                Swal.fire({
                    title: 'Move student to another Wave',
                    html: `
                        <div class="text-left space-y-4 p-2">
                            <p class="text-sm text-slate-600">Select the destination Wave to move <strong>${username}</strong>:</p>
                            <select id="newWaveSelect" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold">
                                ${optionsHtml}
                            </select>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Reassign Wave <i class="fas fa-exchange-alt ml-2"></i>',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-xl transition-all shadow-md',
                        cancelButton: 'bg-white hover:bg-slate-50 text-slate-400 font-bold py-3 px-6 rounded-xl transition-all border border-slate-200 ml-2'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        const newWaveId = $('#newWaveSelect').val();
                        
                        Swal.fire({
                            title: 'Reassigning...',
                            didOpen: () => Swal.showLoading()
                        });

                        fetch('/Admin/MoveUserToWave', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: new URLSearchParams({
                                userId: userId,
                                oldWaveId: oldWaveId,
                                newWaveId: newWaveId
                            })
                        })
                        .then(r => r.json())
                        .then(res => {
                            Swal.close();
                            if (res.success) {
                                notifyToast('success', 'Success', res.message);
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                notifyToast('error', 'Error', res.message);
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.close();
                            notifyToast('error', 'Error', 'An error occurred.');
                        });
                    }
                });
            });

            $(document).on('click', '.resend-email-btn', function() {
                const userId = $(this).data('user-id');
                const waveId = $(this).data('wave-id');
                const username = $(this).data('username');

                Swal.fire({
                    title: 'إرسال البريد الإلكتروني للشهادة',
                    html: `
                        <div class="text-right space-y-4 p-2" dir="rtl">
                            <p class="text-xs text-slate-600 font-bold">هل ترغب في إرسال شهادة الـ PDF للمستخدم <strong>(${username})</strong>؟</p>
                            <div class="bg-indigo-50/50 p-4 rounded-2xl border border-indigo-100 space-y-2 text-right">
                                <label class="block text-xs font-bold text-indigo-900 mb-1">إرفاق / استبدال ملف PDF لهذا الطالب (اختياري):</label>
                                <input type="file" id="resendPdfInput" accept=".pdf" class="w-full text-xs text-slate-500 file:ml-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 cursor-pointer" />
                                <p class="text-[10px] text-slate-400 mt-1">إذا لم تقم باختيار ملف، سيتم استخدام ملف الـ PDF المحفوظ سابقاً لهذا الطالب تلقائياً.</p>
                            </div>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'إرسال الآن <i class="fas fa-paper-plane mr-2"></i>',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const formData = new FormData();
                        formData.append('userId', userId);
                        formData.append('waveId', waveId);

                        const fileInput = document.getElementById('resendPdfInput');
                        if (fileInput && fileInput.files.length > 0) {
                            formData.append('pdfFile', fileInput.files[0]);
                        }

                        Swal.fire({
                            title: 'جاري إرسال البريد الإلكتروني...',
                            text: 'يرجى الانتظار...',
                            allowOutsideClick: false,
                            didOpen: () => Swal.showLoading()
                        });

                        fetch('/Admin/ResendCertificateEmail', {
                            method: 'POST',
                            body: formData
                        })
                        .then(r => r.json())
                        .then(res => {
                            Swal.close();
                            if (res.success) {
                                notifyToast('success', 'تم الإرسال بنجاح', res.message);
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                notifyToast('error', 'فشل الإرسال', res.message);
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.close();
                            notifyToast('error', 'خطأ', 'حدث خطأ أثناء التواصل مع السيرفر.');
                        });
                    }
                });
            });
        });
    </script>
}
