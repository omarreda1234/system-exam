        <div class="h-[320px] relative w-full overflow-x-auto">
            <canvas id="branchWeeklyExamChart"></canvas>
        </div>
    </div>

    <!-- Question Bank Inventory & Wave Topic Analysis -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
        <div class="p-8 border-b border-slate-100 dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-50/50 dark:bg-slate-800/20">
            <div>
                <h3 class="font-black text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 flex items-center gap-2">
                    <i class="fas fa-layer-group text-brand-500"></i> INVENTORY & WAVE TOPIC TELEMETRY ANALYSIS
                </h3>
                <p class="text-xl font-bold mt-1 text-slate-900 dark:text-white">Global Question Bank & Wave Topic Performance Overview</p>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                <!-- Wave Filter Dropdown -->
                <div class="flex items-center gap-2">
                    <label for="invWaveFilter" class="text-xs font-black text-slate-500 dark:text-slate-400 uppercase tracking-wider">Wave Analytics Filter:</label>
                    <select id="invWaveFilter" onchange="onInventoryWaveChange(this.value)" class="bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-bold rounded-xl px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 shadow-sm transition-all cursor-pointer">
                        <option value="0">📊 All Waves (جميع الدفعات)</option>
                        @if (ViewBag.WavesList != null)
                        {
                            foreach (var w in (IEnumerable<dynamic>)ViewBag.WavesList)
                            {
                                <option value="@w.Id">🌊 @w.WaveName</option>
                            }
                        }
                    </select>
                </div>

                <span class="px-4 py-2 bg-brand-500 text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-lg shadow-brand-500/20">
                    <i class="fas fa-database mr-2"></i> @Model.TotalQuestionsCount Questions Total
                </span>
            </div>
        </div>
        
        <div class="p-8">
            <div id="invCategoriesContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var cat in Model.QuestionsPerCategory)
                {
                    <div class="bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 hover:shadow-lg transition-all border-l-4 border-l-brand-500">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider truncate mr-2">@cat.CategoryName</h4>
                            <span class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] font-black px-2.5 py-1 rounded-xl text-slate-600 dark:text-slate-400">@cat.Count Qs</span>
                        </div>
                        <div class="space-y-2">
                            @foreach (var top in cat.Topics.Take(5))
                            {
                                <div class="flex justify-between items-center text-[10px] text-slate-500 dark:text-slate-500 font-bold">
                                    <span class="flex items-center gap-1.5 truncate">
                                        <i class="fas fa-caret-right text-[8px] text-brand-500/50"></i>
                                        @top.TopicName
                                    </span>
                                    <span class="text-slate-400 font-mono">@top.Count Qs</span>
                                </div>
                            }
                            @if (cat.Topics.Count > 5)
                            {
                                <p class="text-[9px] text-slate-400 italic mt-2">+ @(cat.Topics.Count - 5) more topics...</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top Performers Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
        <div class="p-8 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h3 class="font-black text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400">Top Performing Personnel</h3>
            <div class="p-2 bg-slate-50 dark:bg-slate-800 rounded-xl">
                 <i class="fas fa-award text-amber-500"></i>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="saas-table">
                <thead>
                    <tr>
                        <th>Personnel Name</th>
                        <th>Classification</th>
                        <th class="text-center">Most Recent Exam</th>
                        <th class="text-center">High Score</th>
                        <th class="text-right">Academic Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.TopPerformingPharmacists) {
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-slate-500 text-xs">@doc.Name.Substring(0,1)</div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 dark:text-white">@doc.Name</span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">@(doc.UserCode ?? "SYS-ID")</span>
                                    </div>
                                </div>
                            <td>
                                <div class="px-3 py-1 bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full text-[10px] font-bold uppercase tracking-widest inline-block select-none">MEDICAL_STAFF</div>
                            </td>
                            <td class="text-center italic font-semibold text-slate-500">@doc.ExamTitle</td>
                            <td class="text-center">
                                <span class="font-mono font-bold text-brand-600 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 rounded-lg">@doc.Score</span>
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="h-1.5 w-16 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full bg-emerald-500" style="width: @Math.Min(100, doc.Score)%"></div>
                                    </div>
                                    <span class="text-[10px] font-bold text-emerald-500">QUALIFIED</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let waveDonutChart = null;

        function renderWaveDonutChart(cert, passed, failed, notEx) {
            const canvas = document.getElementById('waveResultsDonutChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            if (waveDonutChart) {
                waveDonutChart.destroy();
                waveDonutChart = null;
            }

            const isDark = document.documentElement.classList.contains('dark');

            waveDonutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Certified (≥75%)', 'Passed (70-75%)', 'Failed (<70%)', 'Not Examined'],
                    datasets: [{
                        data: [cert, passed, failed, notEx],
                        backgroundColor: ['#10b981', '#f59e0b', '#ef4444', isDark ? '#475569' : '#cbd5e1'],
                        borderWidth: 2,
                        borderColor: isDark ? '#0f172a' : '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        let waveSessionsAttendanceChart = null;

        function renderWaveSessionsAttendanceChart(labels, presentData, absentData, rateData) {
            const ctx = document.getElementById('waveSessionsAttendanceChart')?.getContext('2d');
            if (!ctx) return;

            if (waveSessionsAttendanceChart) {
                waveSessionsAttendanceChart.destroy();
            }

            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

            waveSessionsAttendanceChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Present (حاضر)',
                            data: presentData,
                            backgroundColor: '#10b981',
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Absent (غائب)',
                            data: absentData,
                            backgroundColor: '#f43f5e',
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Attendance Rate % (نسبة الحضور)',
                            data: rateData,
                            type: 'line',
                            borderColor: '#06b6d4',
                            backgroundColor: '#06b6d4',
                            borderWidth: 3,
                            pointRadius: 4,
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { font: { size: 10, weight: '700' } }
                        }
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: { color: gridColor, drawBorder: false },
                            title: { display: true, text: 'Trainees Count', font: { size: 10, weight: '700' } }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            min: 0,
                            max: 100,
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Attendance %', font: { size: 10, weight: '700' } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 9, weight: '600' } }
                        }
                    }
                }
            });
        }

        function onWaveAnalyticsChange(waveId) {
            $.get('/Admin/GetWaveAnalyticsData', { waveId: waveId }, function (data) {
                if (!data) return;

                $('#waTotalStudents').text(data.totalStudents);
                $('#waCertified').text(data.certifiedCount);
                $('#waPassedNoCert').text(data.passedNoCertCount);
                $('#waFailed').text(data.failedCount);
                $('#waNotExamined').text(data.notExaminedCount);
                $('#waOverallPassRate').text((data.passRate || 0) + '% Pass Rate');

                // Pharmacists
                const ph = data.pharmacistStats || {};
                $('#waPhTotal').text('Total: ' + (ph.total || 0) + ' trainees');
                $('#waPhPassRate').text((ph.passRate || 0) + '% Pass Rate');
                $('#waPhCert').text(ph.certified || 0);
                $('#waPhPassed').text(ph.passedNoCert || 0);
                $('#waPhFailed').text(ph.failed || 0);
                $('#waPhNotEx').text(ph.notExamined || 0);

                // Assistants
                const asst = data.assistantStats || {};
                $('#waAsstTotal').text('Total: ' + (asst.total || 0) + ' trainees');
                $('#waAsstPassRate').text((asst.passRate || 0) + '% Pass Rate');
                $('#waAsstCert').text(asst.certified || 0);
                $('#waAsstPassed').text(asst.passedNoCert || 0);
                $('#waAsstFailed').text(asst.failed || 0);
                $('#waAsstNotEx').text(asst.notExamined || 0);

                // Donut Chart
                renderWaveDonutChart(data.certifiedCount || 0, data.passedNoCertCount || 0, data.failedCount || 0, data.notExaminedCount || 0);

                // Branch Table
                const branches = data.branchStats || [];
                $('#waBranchCount').text(branches.length);

                let rowsHtml = '';
                branches.forEach(function (b) {
                    rowsHtml += `
                        <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="p-3.5 font-black text-slate-900 dark:text-white">${b.branchName}</td>
                            <td class="p-3.5 text-center font-mono">${b.total}</td>
                            <td class="p-3.5 text-center text-emerald-600 dark:text-emerald-400 font-mono">${b.certified}</td>
                            <td class="p-3.5 text-center text-amber-600 dark:text-amber-400 font-mono">${b.passedNoCert}</td>
                            <td class="p-3.5 text-center text-rose-600 dark:text-rose-400 font-mono">${b.failed}</td>
                            <td class="p-3.5 text-center text-slate-400 font-mono">${b.notExamined}</td>
                            <td class="p-3.5 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="w-16 bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
                                        <div class="bg-brand-500 h-full rounded-full" style="width: ${b.passRate}%"></div>
                                    </div>
                                    <span class="font-mono text-emerald-600 dark:text-emerald-400 text-[10px]">${b.passRate}%</span>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                if (branches.length === 0) {
                    rowsHtml = `<tr><td colspan="7" class="p-6 text-center text-slate-400 font-bold uppercase text-[10px]">No branch data found</td></tr>`;
                }

                $('#waBranchTbody').html(rowsHtml);

                // Session Attendance Table & Visual Chart
                const sessions = data.sessionAttendanceStats || [];
                $('#waSessionCount').text(sessions.length);

                const sessLabels = sessions.map(s => s.sessionName);
                const sessPresents = sessions.map(s => s.presentCount);
                const sessAbsents = sessions.map(s => s.absentCount);
                const sessRates = sessions.map(s => s.attendanceRate);

                renderWaveSessionsAttendanceChart(sessLabels, sessPresents, sessAbsents, sessRates);

                let sessRowsHtml = '';
                sessions.forEach(function (s) {
                    sessRowsHtml += `
                        <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="p-3.5 font-black text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="fas fa-book-open text-brand-500 text-xs"></i>
                                ${s.sessionName}
                            </td>
                            <td class="p-3.5 text-center font-mono text-slate-500">${s.sessionDate}</td>
                            <td class="p-3.5 text-center font-mono">${s.totalEnrolled}</td>
                            <td class="p-3.5 text-center text-emerald-600 dark:text-emerald-400 font-mono">${s.presentCount}</td>
                            <td class="p-3.5 text-center text-rose-600 dark:text-rose-400 font-mono">${s.absentCount}</td>
                            <td class="p-3.5 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="w-16 bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
                                        <div class="bg-emerald-500 h-full rounded-full" style="width: ${s.attendanceRate}%"></div>
                                    </div>
                                    <span class="font-mono text-emerald-600 dark:text-emerald-400 text-[10px]">${s.attendanceRate}%</span>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                if (sessions.length === 0) {
                    sessRowsHtml = `<tr><td colspan="6" class="p-6 text-center text-slate-400 font-bold uppercase text-[10px]">No session attendance data recorded for this wave yet</td></tr>`;
                }

                $('#waSessionTbody').html(sessRowsHtml);
            });
        }

        $(function () {
            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';
            const textColor = isDark ? '#94a3b8' : '#64748b';

            // Chart Defaults
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.font.weight = "600";
            Chart.defaults.font.size = 11;
            Chart.defaults.color = textColor;

            // Render Wave Sessions Attendance Visual Chart
            const initSessLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.SessionAttendanceStats.Select(s => s.SessionName)));
            const initSessPresents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.SessionAttendanceStats.Select(s => s.PresentCount)));
            const initSessAbsents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.SessionAttendanceStats.Select(s => s.AbsentCount)));
            const initSessRates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.SessionAttendanceStats.Select(s => s.AttendanceRate)));
            renderWaveSessionsAttendanceChart(initSessLabels, initSessPresents, initSessAbsents, initSessRates);

            // Render Wave Donut Chart
            renderWaveDonutChart(@waveAnalytics.CertifiedCount, @waveAnalytics.PassedNoCertCount, @waveAnalytics.FailedCount, @waveAnalytics.NotExaminedCount);

            // Render Wave Monthly Telemetry Curve Chart
            const ctxMonthly = document.getElementById('waveMonthlyTelemetryChart')?.getContext('2d');
            if (ctxMonthly) {
                const gradCert = ctxMonthly.createLinearGradient(0, 0, 0, 220);
                gradCert.addColorStop(0, 'rgba(6, 182, 212, 0.35)');
                gradCert.addColorStop(1, 'rgba(6, 182, 212, 0.01)');

                const gradTotal = ctxMonthly.createLinearGradient(0, 0, 0, 220);
                gradTotal.addColorStop(0, 'rgba(99, 102, 241, 0.15)');
                gradTotal.addColorStop(1, 'rgba(99, 102, 241, 0)');

                const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.MonthlyTrends.Select(x => x.MonthLabel)));
                const monthlyTotalData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.MonthlyTrends.Select(x => x.TotalTrainees)));
                const monthlyCertData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waveAnalytics.MonthlyTrends.Select(x => x.CertifiedCount)));

                new Chart(ctxMonthly, {
                    type: 'line',
                    data: {
                        labels: monthlyLabels,
                        datasets: [
                            {
                                label: 'Certified Trainees (≥75%)',
                                data: monthlyCertData,
                                borderColor: '#06b6d4',
                                backgroundColor: gradCert,
                                fill: true,
                                tension: 0.4,
                                borderWidth: 3.5,
                                pointRadius: 5,
                                pointBackgroundColor: '#06b6d4',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2.5
                            },
                            {
                                label: 'Total Enrolled Trainees',
                                data: monthlyTotalData,
                                borderColor: '#6366f1',
                                backgroundColor: gradTotal,
                                fill: true,
                                tension: 0.4,
                                borderWidth: 2,
                                borderDash: [4, 4],
                                pointRadius: 3,
                                pointBackgroundColor: '#6366f1',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 1.5
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                labels: {
                                    boxWidth: 10,
                                    usePointStyle: true,
                                    font: { size: 11, weight: '700' }
                                }
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false
                            }
                        },
                        scales: {
                            y: {
                                grid: { color: gridColor, drawBorder: false },
                                beginAtZero: true
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // 3. Weekly Exam Telemetry Chart (Hover displaying Exam Title)
            const ctxMonthlyWeekly = document.getElementById('monthlyWeeklyExamChart')?.getContext('2d');
            if (ctxMonthlyWeekly) {
                const weeklyExamTitles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWeeklyExamStats.Select(x => x.ExamTitle)));
                const monthlyExamineesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWeeklyExamStats.Select(x => x.ExamineesCount)));
                const monthlyAvgScoresData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWeeklyExamStats.Select(x => x.AverageScore)));

                new Chart(ctxMonthlyWeekly, {
                    type: 'bar',
                    data: {
                        labels: weeklyExamTitles,
                        datasets: [
                            {
                                label: 'Examinees Count',
                                data: monthlyExamineesData,
                                backgroundColor: 'rgba(6, 182, 212, 0.75)',
                                borderColor: '#06b6d4',
                                borderWidth: 1.5,
                                borderRadius: 8,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Average Score %',
                                data: monthlyAvgScoresData,
                                type: 'line',
                                borderColor: '#10b981',
                                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                                fill: true,
                                tension: 0.4,
                                borderWidth: 3,
                                pointRadius: 5,
                                pointBackgroundColor: '#10b981',
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    title: function(context) {
                                        return context[0].label; // Shows Weekly Exam Name e.g. "Weekly 8/2026"
                                    },
                                    label: function(context) {
                                        if (context.dataset.type === 'line') {
                                            return `Average Score: ${context.raw}%`;
                                        }
                                        return `Examinees Count: ${context.raw}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                grid: { color: gridColor, drawBorder: false },
                                title: { display: true, text: 'Examinees Count', font: { size: 10, weight: '700' } }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                min: 0,
                                max: 100,
                                title: { display: true, text: 'Avg Score %', font: { size: 10, weight: '700' } }
                            },
                            x: { 
                                grid: { display: false },
                                ticks: { font: { size: 11, weight: '700' } }
                            }
                        }
                    }
                });
            }

            // 4. Dynamic Branch Weekly Exam Activity & Score Chart (All Branches + Filter)
            let branchChartInstance = null;

            function renderBranchWeeklyChart(branchLabels, examineesData, avgScoresData) {
                const ctxBranchWeekly = document.getElementById('branchWeeklyExamChart')?.getContext('2d');
                if (!ctxBranchWeekly) return;

                if (branchChartInstance) {
                    branchChartInstance.destroy();
                }

                branchChartInstance = new Chart(ctxBranchWeekly, {
                    type: 'bar',
                    data: {
                        labels: branchLabels,
                        datasets: [
                            {
                                label: 'Examinees Count',
                                data: examineesData,
                                backgroundColor: 'rgba(168, 85, 247, 0.75)',
                                borderColor: '#a855f7',
                                borderWidth: 1.5,
                                borderRadius: 8,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Branch Avg Score %',
                                data: avgScoresData,
                                type: 'line',
                                borderColor: '#f59e0b',
                                backgroundColor: 'rgba(245, 158, 11, 0.1)',
                                fill: false,
                                tension: 0.3,
                                borderWidth: 3,
                                pointRadius: 5,
                                pointBackgroundColor: '#f59e0b',
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    title: function(context) {
                                        return `فرع: ${context[0].label}`;
                                    },
                                    label: function(context) {
                                        if (context.dataset.type === 'line') {
                                            return `متوسط الدرجات: ${context.raw}%`;
                                        }
                                        return `عدد الممتحنين: ${context.raw}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                grid: { color: gridColor, drawBorder: false },
                                title: { display: true, text: 'Examinees Count', font: { size: 10, weight: '700' } }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                min: 0,
                                max: 100,
                                title: { display: true, text: 'Branch Avg Score %', font: { size: 10, weight: '700' } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { maxRotation: 45, minRotation: 0, font: { size: 10, weight: '600' } }
                            }
                        }
                    }
                });
            }

            // Initial Branch Chart Render
            const initialBranchLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BranchWeeklyExamStats.Select(x => x.BranchName)));
            const initialBranchExaminees = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BranchWeeklyExamStats.Select(x => x.ExamineesCount)));
            const initialBranchAvgScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BranchWeeklyExamStats.Select(x => x.AverageScore)));

            renderBranchWeeklyChart(initialBranchLabels, initialBranchExaminees, initialBranchAvgScores);

            // Handle Weekly Exam Filter Select Change
            $('#weeklyExamSelectFilter').on('change', function() {
                const selectedExamId = $(this).val();
                $.get('/Admin/GetBranchWeeklyTelemetry', { examId: selectedExamId }, function(data) {
                    const labels = (data || []).map(x => x.branchName || x.BranchName);
                    const examinees = (data || []).map(x => x.examineesCount || x.ExamineesCount);
                    const scores = (data || []).map(x => x.averageScore || x.AverageScore);
                    renderBranchWeeklyChart(labels, examinees, scores);
                });
            });
        });

        function onInventoryWaveChange(waveId) {
            $.get('/Admin/GetWaveTopicAnalyticsData', { waveId: waveId }, function (data) {
                const categories = data.categories || [];
                let containerHtml = '';

                categories.forEach(function (cat) {
                    let masteryBadgeClass = 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/30 dark:text-emerald-400 border-emerald-200';
                    if (cat.masteryRate < 70) {
                        masteryBadgeClass = 'bg-rose-50 text-rose-600 dark:bg-rose-950/30 dark:text-rose-400 border-rose-200';
                    } else if (cat.masteryRate < 80) {
                        masteryBadgeClass = 'bg-amber-50 text-amber-600 dark:bg-amber-950/30 dark:text-amber-400 border-amber-200';
                    }

                    containerHtml += `
                        <div class="bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 hover:shadow-lg transition-all border-l-4 border-l-brand-500">
                            <div class="flex items-center justify-between mb-2">
                                <h4 class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider truncate mr-2">${cat.categoryName}</h4>
                                <span class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] font-black px-2.5 py-1 rounded-xl text-slate-600 dark:text-slate-400">${cat.totalQuestions} Qs</span>
                            </div>
                            
                            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200/50 dark:border-slate-800/50">
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Wave Mastery Rate</span>
                                <span class="px-2 py-0.5 rounded-lg text-[10px] font-black border ${masteryBadgeClass}">${cat.masteryRate}%</span>
                            </div>

                            <div class="space-y-2">
                                ${(cat.topics || []).slice(0, 5).map(top => `
                                    <div class="flex justify-between items-center text-[10px] text-slate-500 dark:text-slate-400 font-bold">
                                        <span class="flex items-center gap-1.5 truncate">
                                            <i class="fas fa-caret-right text-[8px] text-brand-500/50"></i>
                                            ${top.topicName}
                                        </span>
                                        <div class="flex items-center gap-2">
                                            <span class="text-slate-400 font-mono">${top.questionCount} Qs</span>
                                            ${top.totalAnswers > 0 ? `<span class="text-brand-600 dark:text-brand-400 font-mono text-[9px]">(${top.accuracyRate}%)</span>` : ''}
                                        </div>
                                    </div>
                                `).join('')}
                                ${cat.topics.length > 5 ? `<p class="text-[9px] text-slate-400 italic mt-2">+ ${cat.topics.length - 5} more topics...</p>` : ''}
                            </div>
                        </div>
                    `;
                });

                if (categories.length === 0) {
                    containerHtml = `<div class="col-span-full p-8 text-center text-slate-400 font-bold uppercase text-xs">No topic telemetry data found for this wave</div>`;
                }

                $('#invCategoriesContainer').html(containerHtml);
            });
        }
    </script>
}
