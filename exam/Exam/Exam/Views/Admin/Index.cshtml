                    <tbody id="waSessionTbody" class="divide-y divide-slate-100 dark:divide-slate-800 font-bold text-slate-700 dark:text-slate-300">
                        @foreach (var s in waveAnalytics.SessionAttendanceStats)
                        {
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                                <td class="p-3.5 font-black text-slate-900 dark:text-white flex items-center gap-2">
                                    <i class="fas fa-book-open text-brand-500 text-xs"></i>
                                    @s.SessionName
                                </td>
                                <td class="p-3.5 text-center font-mono text-slate-500">@s.SessionDate</td>
                                <td class="p-3.5 text-center font-mono">@s.TotalEnrolled</td>
                                <td class="p-3.5 text-center text-emerald-600 dark:text-emerald-400 font-mono">@s.PresentCount</td>
                                <td class="p-3.5 text-center text-rose-600 dark:text-rose-400 font-mono">@s.AbsentCount</td>
                                <td class="p-3.5 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <div class="w-16 bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
                                            <div class="bg-emerald-500 h-full rounded-full" style="width: @s.AttendanceRate%"></div>
                                        </div>
                                        <span class="font-mono text-emerald-600 dark:text-emerald-400 text-[10px]">@s.AttendanceRate%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!waveAnalytics.SessionAttendanceStats.Any())
                        {
                            <tr>
                                <td colspan="6" class="p-6 text-center text-slate-400 font-bold uppercase text-[10px]">No session attendance data recorded for this wave yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Certification & Wave Telemetry Monthly Curve -->
        <div class="mt-8 border-t border-slate-100 dark:border-slate-800 pt-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-500 dark:text-slate-400 flex items-center gap-2">
                    <i class="fas fa-chart-line text-cyan-500"></i> WAVE CERTIFICATION & ENROLLMENT TELEMETRY
                </h3>
                <span class="text-[9px] font-extrabold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span> CERTIFICATE REGISTRATION CURVE
                </span>
            </div>
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
                <div class="h-[230px] w-full relative">
                    <canvas id="waveMonthlyTelemetryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Weekly Exam Telemetry -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h3 class="font-black text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 flex items-center gap-2">
