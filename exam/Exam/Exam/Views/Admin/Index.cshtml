            // 3. Weekly Exam Telemetry Chart (Hover displaying Exam Title)
            const ctxMonthlyWeekly = document.getElementById('monthlyWeeklyExamChart')?.getContext('2d');
            if (ctxMonthlyWeekly) {
                const weeklyExamTitles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWeeklyExamStats.Select(x => x.ExamTitle)));
                const monthlyExamineesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWeeklyExamStats.Select(x => x.ExamineesCount)));
                const monthlyAvgScoresData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWeeklyExamStats.Select(x => x.AverageScore)));

                new Chart(ctxMonthlyWeekly, {
