                        {
                            <option value="@w.Id">📝 @w.Title</option>
                        }
                    </select>
                </div>

                <div class="flex items-center gap-4 text-[10px] font-extrabold uppercase tracking-widest bg-slate-50 dark:bg-slate-800/50 px-3 py-2 rounded-xl border border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-purple-600 dark:text-purple-400">
                        <span class="w-3 h-3 rounded-md bg-purple-500"></span>
                        <span>Examinees Count</span>
                    </div>
                    <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400">
                        <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                        <span>Avg Score %</span>
                    </div>
                </div>
