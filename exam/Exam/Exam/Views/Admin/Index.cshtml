            const initialBranchAvgScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BranchWeeklyExamStats.Select(x => x.AverageScore)));

            renderBranchWeeklyChart(initialBranchLabels, initialBranchExaminees, initialBranchAvgScores);

            // Handle Weekly Exam Filter Select Change
            $('#weeklyExamSelectFilter').on('change', function() {
                const selectedExamId = $(this).val();
                $.get('/Admin/GetBranchWeeklyTelemetry', { examId: selectedExamId }, function(data) {
                    const labels = (data || []).map(x => x.branchName || x.BranchName);
                    const examinees = (data || []).map(x => x.examineesCount || x.ExamineesCount);
                    const scores = (data || []).map(x => x.averageScore || x.AverageScore);
