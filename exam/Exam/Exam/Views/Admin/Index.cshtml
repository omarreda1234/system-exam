            <div class="flex items-center gap-4 text-[10px] font-extrabold uppercase tracking-widest">
                <div class="flex items-center gap-2 text-brand-600 dark:text-brand-400">
                    <span class="w-3 h-3 rounded-md bg-brand-500"></span>
                    <span>Examinees Count</span>
                </div>
                <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                    <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                    <span>Avg Score %</span>
                </div>
            </div>
        </div>
        <div class="h-[280px] relative">
            <canvas id="monthlyWeeklyExamChart"></canvas>
        </div>
    </div>

    <!-- Branch-wise Weekly Exam Turnout & Performance -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-8 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
                <h3 class="font-black text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 flex items-center gap-2">
