        </div>

        <!-- Visual Analytics Charts Row -->
        <div class="p-6 md:p-8 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/30 dark:bg-slate-950/20">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <!-- Donut Chart: Category Share -->
                <div class="lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-5 rounded-3xl shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
                            <i class="fas fa-chart-pie text-emerald-500"></i> Category Volume Share
                        </h4>
                        <span class="text-[10px] font-bold text-slate-400">Proportions</span>
                    </div>
                    <div class="relative h-64 flex items-center justify-center">
                        <canvas id="qbCategoryDonutChart"></canvas>
                    </div>
                </div>

                <!-- Horizontal Bar Chart: Top Topics -->
                <div class="lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-5 rounded-3xl shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
                            <i class="fas fa-chart-bar text-cyan-500"></i> Highest Topic Question Volumes
                        </h4>
                        <span class="text-[10px] font-bold text-slate-400">Top Academic Topics</span>
                    </div>
                    <div class="relative h-64">
                        <canvas id="qbTopTopicsBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Category Breakdown Cards Grid -->
        <div class="p-6 md:p-8">
            <div class="flex items-center justify-between mb-4">
                <h4 class="text-xs font-black text-slate-400 uppercase tracking-widest">Normalized Academic Categories & Core Topics</h4>
                <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Click any card to inspect full topic syllabus</span>
            </div>

            <div id="invCategoriesContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
                @foreach (var cat in Model.QuestionsPerCategory)
                {
                    var catColorClass = "border-l-emerald-500";
                    var catBadgeClass = "text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800/60";
                    var catIcon = "fa-stethoscope";
                    var lower = cat.CategoryName.ToLowerInvariant();
                    if (lower.Contains("cosmo")) {
                        catColorClass = "border-l-rose-500";
                        catBadgeClass = "text-rose-700 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800/60";
                        catIcon = "fa-spa";
                    } else if (lower.Contains("insurance")) {
                        catColorClass = "border-l-amber-500";
                        catBadgeClass = "text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 border-amber-200 dark:border-amber-800/60";
                        catIcon = "fa-shield-alt";
                    } else if (lower.Contains("customer")) {
                        catColorClass = "border-l-sky-500";
                        catBadgeClass = "text-sky-700 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/40 border-sky-200 dark:border-sky-800/60";
                        catIcon = "fa-headset";
                    } else if (lower.Contains("soft")) {
                        catColorClass = "border-l-purple-500";
                        catBadgeClass = "text-purple-700 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/40 border-purple-200 dark:border-purple-800/60";
                        catIcon = "fa-comments";
                    }

                    var pct = Model.TotalQuestionsCount > 0 ? Math.Round((double)cat.Count * 100.0 / Model.TotalQuestionsCount, 1) : 0;
                    var escapedName = cat.CategoryName.Replace("'", "\\'");

                    <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-5 hover:shadow-lg transition-all border-l-4 @catColorClass flex flex-col justify-between cursor-pointer group" onclick="showCategoryTopicsModal('@escapedName')">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider truncate mr-1 flex items-center gap-1.5">
                                    <i class="fas @catIcon text-[11px] opacity-70 group-hover:scale-110 transition-transform"></i>
                                    @cat.CategoryName
                                </h4>
                                <span class="border text-[10px] font-black px-2 py-0.5 rounded-xl @catBadgeClass whitespace-nowrap">@cat.Count Qs (@pct%)</span>
                            </div>
                            <div class="space-y-1.5 pt-1">
                                @foreach (var top in cat.Topics.Take(5))
                                {
                                    <div class="flex justify-between items-center text-[10px] text-slate-600 dark:text-slate-400 font-bold">
                                        <span class="flex items-center gap-1.5 truncate">
                                            <i class="fas fa-caret-right text-[8px] text-brand-500/50"></i>
                                            @top.TopicName
                                        </span>
                                        <span class="text-slate-400 font-mono text-[9px]">@top.Count</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between">
                            <span class="text-[9px] font-bold text-slate-400 group-hover:text-brand-500 transition-colors">
                                @if (cat.Topics.Count > 5)
                                {
                                    <span>+ @(cat.Topics.Count - 5) more topics</span>
                                }
                                else
                                {
                                    <span>@(cat.Topics.Count) Topic(s) total</span>
                                }
                            </span>
                            <i class="fas fa-arrow-right text-[9px] text-slate-300 dark:text-slate-600 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all"></i>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top Performers Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
        <div class="p-8 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h3 class="font-black text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400">Top Performing Personnel</h3>
            <div class="p-2 bg-slate-50 dark:bg-slate-800 rounded-xl">
                 <i class="fas fa-award text-amber-500"></i>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="saas-table">
                <thead>
                    <tr>
                        <th>Personnel Name</th>
                        <th>Classification</th>
                        <th class="text-center">Most Recent Exam</th>
                        <th class="text-center">High Score</th>
                        <th class="text-right">Academic Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.TopPerformingPharmacists) {
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-bold text-slate-500 text-xs">@doc.Name.Substring(0,1)</div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 dark:text-white">@doc.Name</span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">@(doc.UserCode ?? "SYS-ID")</span>
                                    </div>
                                </div>
                            <td>
                                <div class="px-3 py-1 bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full text-[10px] font-bold uppercase tracking-widest inline-block select-none">MEDICAL_STAFF</div>
                            </td>
                            <td class="text-center italic font-semibold text-slate-500">@doc.ExamTitle</td>
                            <td class="text-center">
                                <span class="font-mono font-bold text-brand-600 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 rounded-lg">@doc.Score</span>
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="h-1.5 w-16 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full bg-emerald-500" style="width: @Math.Min(100, doc.Score)%"></div>
                                    </div>
                                    <span class="text-[10px] font-bold text-emerald-500">QUALIFIED</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let waveDonutChart = null;

        function renderWaveDonutChart(cert, passed, failed, notEx) {
            const canvas = document.getElementById('waveResultsDonutChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            if (waveDonutChart) {
                waveDonutChart.destroy();
                waveDonutChart = null;
            }

            const isDark = document.documentElement.classList.contains('dark');

            waveDonutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Certified (≥75%)', 'Passed (70-75%)', 'Failed (<70%)', 'Not Examined'],
                    datasets: [{
                        data: [cert, passed, failed, notEx],
                        backgroundColor: ['#10b981', '#f59e0b', '#ef4444', isDark ? '#475569' : '#cbd5e1'],
                        borderWidth: 2,
                        borderColor: isDark ? '#0f172a' : '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        let waveSessionsAttendanceChart = null;

        function renderWaveSessionsAttendanceChart(labels, presentData, absentData, rateData) {
            const ctx = document.getElementById('waveSessionsAttendanceChart')?.getContext('2d');
            if (!ctx) return;

            if (waveSessionsAttendanceChart) {
                waveSessionsAttendanceChart.destroy();
            }

            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

            waveSessionsAttendanceChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Present (حاضر)',
                            data: presentData,
                            backgroundColor: '#10b981',
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Absent (غائب)',
                            data: absentData,
                            backgroundColor: '#f43f5e',
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Attendance Rate % (نسبة الحضور)',
                            data: rateData,
                            type: 'line',
                            borderColor: '#06b6d4',
                            backgroundColor: '#06b6d4',
                            borderWidth: 3,
                            pointRadius: 4,
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { font: { size: 10, weight: '700' } }
                        }
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: { color: gridColor, drawBorder: false },
                            title: { display: true, text: 'Trainees Count', font: { size: 10, weight: '700' } }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            min: 0,
                            max: 100,
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Attendance %', font: { size: 10, weight: '700' } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 9, weight: '600' } }
                        }
                    }
                }
            });
        }

        function syncAndFilterWaveAnalytics(waveId) {
            $('#waveAnalyticsSelector').val(waveId);
            $('#invWaveFilter').val(waveId);
            $('#sessionWaveFilter').val(waveId);

            onWaveAnalyticsChange(waveId);
            onInventoryWaveChange(waveId);
        }

        function onWaveAnalyticsChange(waveId) {
            $.get('/Admin/GetWaveAnalyticsData', { waveId: waveId }, function (data) {
                if (!data) return;

                $('#waTotalStudents').text(data.totalStudents);
                $('#waCertified').text(data.certifiedCount);
                $('#waPassedNoCert').text(data.passedNoCertCount);
                $('#waFailed').text(data.failedCount);
                $('#waNotExamined').text(data.notExaminedCount);
                $('#waOverallPassRate').text((data.passRate || 0) + '% Pass Rate');

                // Pharmacists
                const ph = data.pharmacistStats || {};
                $('#waPhTotal').text('Total: ' + (ph.total || 0) + ' trainees');
                $('#waPhPassRate').text((ph.passRate || 0) + '% Pass Rate');
                $('#waPhCert').text(ph.certified || 0);
                $('#waPhPassed').text(ph.passedNoCert || 0);
                $('#waPhFailed').text(ph.failed || 0);
                $('#waPhNotEx').text(ph.notExamined || 0);

                // Assistants
                const asst = data.assistantStats || {};
                $('#waAsstTotal').text('Total: ' + (asst.total || 0) + ' trainees');
                $('#waAsstPassRate').text((asst.passRate || 0) + '% Pass Rate');
                $('#waAsstCert').text(asst.certified || 0);
                $('#waAsstPassed').text(asst.passedNoCert || 0);
                $('#waAsstFailed').text(asst.failed || 0);
                $('#waAsstNotEx').text(asst.notExamined || 0);

                // Donut Chart
                renderWaveDonutChart(data.certifiedCount || 0, data.passedNoCertCount || 0, data.failedCount || 0, data.notExaminedCount || 0);

                // Branch Table
                const branches = data.branchStats || [];
                $('#waBranchCount').text(branches.length);

                let rowsHtml = '';
                branches.forEach(function (b) {
                    rowsHtml += `
                        <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="p-3.5 font-black text-slate-900 dark:text-white">${b.branchName}</td>
                            <td class="p-3.5 text-center font-mono">${b.total}</td>
                            <td class="p-3.5 text-center text-emerald-600 dark:text-emerald-400 font-mono">${b.certified}</td>
                            <td class="p-3.5 text-center text-amber-600 dark:text-amber-400 font-mono">${b.passedNoCert}</td>
                            <td class="p-3.5 text-center text-rose-600 dark:text-rose-400 font-mono">${b.failed}</td>
                            <td class="p-3.5 text-center text-slate-400 font-mono">${b.notExamined}</td>
                            <td class="p-3.5 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="w-16 bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
                                        <div class="bg-brand-500 h-full rounded-full" style="width: ${b.passRate}%"></div>
                                    </div>
                                    <span class="font-mono text-emerald-600 dark:text-emerald-400 text-[10px]">${b.passRate}%</span>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                if (branches.length === 0) {
