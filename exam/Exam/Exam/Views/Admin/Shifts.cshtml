@model IEnumerable<Exam.DTOs.ShiftDto>
@using System.Web
@using System.Text.Encodings.Web
@inject Exam.Services.IExamService ExamService
@{
    ViewData["Title"] = "Work Shifts Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var userRoles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    bool HasSpecificPermission(string permissionType)
    {
        if (userRoles.Contains("Admin")) return true;
        return ExamService.HasSpecificPermissionAsync(userRoles, "Admin", "Shifts", permissionType).GetAwaiter().GetResult();
    }

    var shiftsList = Model?.ToList() ?? new List<Exam.DTOs.ShiftDto>();
    int totalAssigned = shiftsList.Sum(s => s.AssignedUsersCount);
    int overnightCount = shiftsList.Count(s => s.IsOvernight);
}

@Html.AntiForgeryToken()

<div class="min-h-screen pb-20 bg-slate-50/50 dark:bg-slate-950/20">
    <!-- Header -->
    <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-24 pb-10">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <div class="flex items-center gap-2 text-xs font-black text-brand-600 dark:text-brand-400 uppercase tracking-widest mb-1">
                        <i class="fas fa-business-time"></i>
                        <span>Shift Configuration Console</span>
                    </div>
                    <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight flex items-center gap-3">
                        <span>Work Shifts Management / إدارة الشيفتات</span>
                    </h1>
                    <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-1">
                        التحكم الكامل بأوقات الشيفتات، عدد الساعات، وتحديد الفترات الزمنية المسموح للموظفين بأداء الامتحانات خلالها
                    </p>
                </div>
                
                <div class="flex items-center gap-3">
                    <a href="/Admin/AllUsers" class="bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2">
                        <i class="fas fa-users text-xs"></i>
                        <span>Personnel Registry</span>
                    </a>
                    @if (User.IsInRole("Admin") || HasSpecificPermission("create") || HasSpecificPermission("access") || HasSpecificPermission("edit"))
                    {
                        <button onclick="openManageShiftGroupsModal()" class="bg-purple-600 hover:bg-purple-700 text-white px-5 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-purple-600/20 flex items-center gap-2">
                            <i class="fas fa-layer-group text-xs"></i>
                            <span>Shift Groups / مجموعات الشيفتات</span>
                        </button>
                        <button onclick="openUploadShiftsModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-2">
                            <i class="fas fa-file-excel text-xs"></i>
                            <span>Upload Shifts (.xlsx) / رفع الشيفتات</span>
                        </button>
                        <button onclick="openShiftModal(0)" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-brand-600/20 flex items-center gap-2 group">
                            <i class="fas fa-plus text-xs group-hover:rotate-90 transition-transform"></i>
                            <span>Add New Shift / إضافة شيفت</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8">
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Total Shifts</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@shiftsList.Count</p>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-emerald-500">Daytime Shifts</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@(shiftsList.Count - overnightCount)</p>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-indigo-500">Overnight / ليلي</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@overnightCount</p>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-brand-500">Assigned Personnel</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@totalAssigned</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Shifts Table Section -->
    <div class="max-w-7xl mx-auto px-6 mt-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
            <div class="px-8 py-5 border-b border-slate-100 dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-wider">Active Work Windows</h2>
                    <p class="text-[11px] text-slate-400 font-medium">قائمة الشيفتات المتاحة وتوزيع الموظفين عليها مع إمكانية التجميع والبحث الفوري</p>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" onclick="openManageShiftGroupsModal()" class="text-[10px] font-black uppercase tracking-wider px-3.5 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 rounded-xl border border-purple-200 transition-all flex items-center gap-1.5 shadow-2xs">
                        <i class="fas fa-layer-group text-purple-600"></i>
                        <span>إدارة المجموعات</span>
                    </button>
                    <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1 bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-400 rounded-full border border-brand-200/50">
                        Live Shift Enforcer
                    </span>
                </div>
            </div>

            <!-- DataTable Live Search & Filter Bar -->
            <div class="px-8 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-100 dark:border-slate-800 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <!-- Search Box -->
                <div class="relative flex-1 max-w-md">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="shiftSearchInput" oninput="filterShiftsTable()" placeholder="ابحث باسم الشيفت، التوقيت، أو المجموعة..." 
                           class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl pl-10 pr-10 py-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-brand-500 shadow-2xs transition-all" />
                    <button type="button" onclick="clearShiftSearch()" id="btnClearShiftSearch" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-sm font-black">×</button>
                </div>

                <!-- Shift Groups Quick Filter Dropdown -->
                <div class="flex items-center gap-2 shrink-0">
                    <div class="flex items-center gap-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-3 py-2 shadow-2xs">
                        <i class="fas fa-layer-group text-purple-600 text-xs shrink-0"></i>
                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 shrink-0">المجموعة:</span>
                        <select id="shiftGroupFilterSelect" onchange="filterByGroup(this.value)" class="bg-transparent text-xs font-bold text-slate-800 dark:text-slate-200 outline-none cursor-pointer">
                            <option value="all">🌟 جميع المجموعات (@shiftsList.Count)</option>
                            @if (ViewBag.ShiftGroups is List<Exam.DTOs.ShiftGroupDto> shiftGroupsList)
                            {
                                foreach (var g in shiftGroupsList)
                                {
                                    <option value="@g.Id">🏷️ @g.GroupName (@g.ShiftsCount)</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Count Info -->
                <div class="text-[11px] font-mono font-bold text-slate-500 shrink-0" id="shiftsCountDisplay">
                    عرض @shiftsList.Count شيفت
                </div>
            </div>

            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse" id="shiftsMainTable">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-wider select-none">
                            <th class="py-4 px-6 cursor-pointer hover:text-brand-600" onclick="sortTable(0)">Shift Identity <i class="fas fa-sort text-[8px] ml-1"></i></th>
                            <th class="py-4 px-6 cursor-pointer hover:text-brand-600" onclick="sortTable(1)">Group / المجموعة <i class="fas fa-sort text-[8px] ml-1"></i></th>
                            <th class="py-4 px-6 cursor-pointer hover:text-brand-600" onclick="sortTable(2)">Start Time <i class="fas fa-sort text-[8px] ml-1"></i></th>
                            <th class="py-4 px-6 cursor-pointer hover:text-brand-600" onclick="sortTable(3)">End Time <i class="fas fa-sort text-[8px] ml-1"></i></th>
                            <th class="py-4 px-6 cursor-pointer hover:text-brand-600" onclick="sortTable(4)">Calculated Duration <i class="fas fa-sort text-[8px] ml-1"></i></th>
                            <th class="py-4 px-6 text-center cursor-pointer hover:text-brand-600" onclick="sortTable(5)">Assigned Users <i class="fas fa-sort text-[8px] ml-1"></i></th>
                            <th class="py-4 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60" id="shiftsTableBody">
                        @if (!shiftsList.Any())
                        {
                            <tr>
                                <td colspan="6" class="py-12 text-center text-slate-400 text-xs font-bold">
                                    No shifts found. Click "Add New Shift" to create one.
                                </td>
                            </tr>
                        }
                        @foreach (var s in shiftsList)
                        {
                            DateTime startDt = DateTime.Today.Add(s.StartTime);
                            DateTime endDt = DateTime.Today.Add(s.EndTime);

                            <tr id="shift-row-@s.Id" 
                                class="shift-data-row hover:bg-slate-50/70 dark:hover:bg-slate-800/30 transition-colors"
                                data-shift-id="@s.Id"
                                data-shift-name="@s.ShiftName.ToLower()"
                                data-group-id="@(s.GroupId ?? 0)"
                                data-group-name="@(s.GroupName?.ToLower() ?? "")"
                                data-start-time="@startDt.ToString("HH:mm")"
                                data-end-time="@endDt.ToString("HH:mm")"
                                data-duration="@s.DurationHours"
                                data-users="@s.AssignedUsersCount">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl @(s.IsOvernight ? "bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400" : "bg-amber-50 text-amber-600 dark:bg-amber-950/40 dark:text-amber-400") flex items-center justify-center font-black text-sm shadow-sm">
                                            <i class="fas @(s.IsOvernight ? "fa-moon" : "fa-sun")"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wide">@s.ShiftName</p>
                                            <span class="text-[10px] font-mono text-slate-400">ID: #@s.Id</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    @if (!string.IsNullOrEmpty(s.GroupName))
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black border shadow-2xs"
                                              style="background-color: @(s.GroupColor ?? "#7C3AED")15; color: @(s.GroupColor ?? "#7C3AED"); border-color: @(s.GroupColor ?? "#7C3AED")40;">
                                            <i class="fas fa-layer-group text-[9px]"></i>
                                            @s.GroupName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-bold text-slate-400 italic">بدون مجموعة</span>
                                    }
                                </td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-mono font-black text-slate-800 dark:text-slate-200">
                                            @startDt.ToString("hh:mm tt")
                                        </span>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-mono font-black text-slate-800 dark:text-slate-200">
                                            @endDt.ToString("hh:mm tt")
                                        </span>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="bg-brand-50 text-brand-700 dark:bg-brand-950/50 dark:text-brand-300 border border-brand-200/60 dark:border-brand-800/60 px-2.5 py-1 rounded-lg text-xs font-black font-mono">
                                            <i class="far fa-clock mr-1 text-[10px]"></i>@s.DurationHours hrs
                                        </span>
                                        @if (s.IsOvernight)
                                        {
                                            <span class="bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider">
                                                <i class="fas fa-moon mr-0.5 text-[9px]"></i> Overnight
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold @(s.AssignedUsersCount > 0 ? "bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-mono" : "bg-slate-50 dark:bg-slate-800/50 text-slate-400")">
                                        <i class="fas fa-user text-[10px] text-slate-400"></i>
                                        @s.AssignedUsersCount
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (User.IsInRole("Admin") || HasSpecificPermission("edit"))
                                        {
                                            <button onclick="openShiftModal(@s.Id, '@JavaScriptEncoder.Default.Encode(s.ShiftName)', '@s.StartTime.ToString(@"hh\:mm")', '@s.EndTime.ToString(@"hh\:mm")', @(s.GroupId ?? 0))" 
                                                    class="p-2 text-slate-400 hover:text-brand-600 hover:bg-brand-50 dark:hover:bg-brand-950/40 rounded-lg transition-all" title="Edit Shift">
                                                <i class="fas fa-pen text-xs"></i>
                                            </button>
                                        }
                                        @if (User.IsInRole("Admin") || HasSpecificPermission("delete"))
                                        {
                                            <button onclick="deleteShift(@s.Id, '@JavaScriptEncoder.Default.Encode(s.ShiftName)', @s.AssignedUsersCount)" 
                                                    class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-all" title="Delete Shift">
                                                <i class="fas fa-trash text-xs"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add / Edit Shift -->
<div id="shiftModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-8 shadow-2xl relative animate-in fade-in zoom-in-95 duration-200">
        <button onclick="closeShiftModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
            <i class="fas fa-times text-lg"></i>
        </button>

        <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/50 text-brand-600 flex items-center justify-center text-xl shadow-inner">
                <i class="fas fa-business-time"></i>
            </div>
            <div>
                <h3 id="modalTitle" class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight">Add New Shift</h3>
                <p class="text-xs text-slate-400 font-medium">تحديد اسم الشيفت، وقت البداية، ووقت الانتهاء</p>
            </div>
        </div>

        <form id="shiftForm" onsubmit="handleShiftSubmit(event)" class="space-y-5">
            <input type="hidden" id="shiftId" value="0" />

            <!-- Shift Name -->
            <div>
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Shift Name / اسم الشيفت</label>
                <input type="text" id="shiftName" required placeholder="e.g. Morning Shift, Evening Shift B" 
                       class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-brand-500 transition-all" />
            </div>

            <!-- Shift Group Selector -->
            <div>
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Shift Group / مجموعة الشيفت (اختياري)</label>
                <select id="shiftGroupId" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-brand-500 transition-all">
                    <option value="0">-- بدون مجموعة (None) --</option>
                    @if (ViewBag.ShiftGroups is List<Exam.DTOs.ShiftGroupDto> modalShiftGroups)
                    {
                        foreach (var g in modalShiftGroups)
                        {
                            <option value="@g.Id">@g.GroupName</option>
                        }
                    }
                </select>
            </div>

            <!-- Times Grid -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">
                        <i class="far fa-clock mr-1 text-emerald-500"></i> Start Time / وقت البدء
                    </label>
                    <input type="time" id="shiftStartTime" required oninput="calculateDurationPreview()"
                           class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-mono font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-brand-500 transition-all" />
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">
                        <i class="far fa-clock mr-1 text-rose-500"></i> End Time / وقت الانتهاء
                    </label>
                    <input type="time" id="shiftEndTime" required oninput="calculateDurationPreview()"
                           class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-mono font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-brand-500 transition-all" />
                </div>
            </div>

            <!-- Quick Duration Preset Buttons -->
            <div>
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">
                    Quick Preset Hours / اختصارات سريعة لساعات الشيفت:
                </label>
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="setPresetHours(4)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-brand-50 hover:text-brand-600 dark:bg-slate-800 dark:hover:bg-brand-950/40 rounded-lg text-[11px] font-bold transition-colors">4 Hours</button>
                    <button type="button" onclick="setPresetHours(6)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-brand-50 hover:text-brand-600 dark:bg-slate-800 dark:hover:bg-brand-950/40 rounded-lg text-[11px] font-bold transition-colors">6 Hours</button>
                    <button type="button" onclick="setPresetHours(8)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-brand-50 hover:text-brand-600 dark:bg-slate-800 dark:hover:bg-brand-950/40 rounded-lg text-[11px] font-bold transition-colors">8 Hours (Standard)</button>
                    <button type="button" onclick="setPresetHours(10)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-brand-50 hover:text-brand-600 dark:bg-slate-800 dark:hover:bg-brand-950/40 rounded-lg text-[11px] font-bold transition-colors">10 Hours</button>
                    <button type="button" onclick="setPresetHours(12)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-brand-50 hover:text-brand-600 dark:bg-slate-800 dark:hover:bg-brand-950/40 rounded-lg text-[11px] font-bold transition-colors">12 Hours (Long)</button>
                </div>
            </div>

            <!-- Live Calculated Duration Box -->
            <div id="durationPreviewBox" class="p-4 bg-brand-50/50 dark:bg-brand-950/20 border border-brand-200/50 dark:border-brand-800/40 rounded-2xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i class="fas fa-hourglass-half text-brand-600 text-lg"></i>
                    <div>
                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">Total Shift Length</span>
                        <p id="durationPreviewText" class="text-sm font-black font-mono text-brand-700 dark:text-brand-300">8.0 Hours</p>
                    </div>
                </div>
                <span id="overnightBadge" class="hidden text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-700 dark:bg-indigo-900/60 dark:text-indigo-300 px-2.5 py-1 rounded-md">
                    <i class="fas fa-moon mr-1"></i> Overnight
                </span>
            </div>

            <div class="pt-2 flex items-center justify-end gap-3">
                <button type="button" onclick="closeShiftModal()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitShift" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider shadow-lg shadow-brand-600/20 transition-all">
                    Save Shift
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Upload Shifts Excel Modal -->
<div id="uploadShiftsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl">
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
                    <i class="fas fa-file-excel text-lg"></i>
                </div>
                <div>
                    <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider">Upload Shifts (.xlsx)</h3>
                    <p class="text-[11px] text-slate-400 font-medium">رفع وتحديث تعريفات الشيفتات دفعة واحدة من ملف إكسيل</p>
                </div>
            </div>
            <button type="button" onclick="closeUploadShiftsModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <form id="uploadShiftsForm" onsubmit="handleUploadShiftsSubmit(event)" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <!-- Guidance Box -->
            <div class="p-4 bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl text-right dir-rtl space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">الأعمدة المطلوبة في ملف الإكسيل:</span>
                    <a href="/Admin/DownloadShiftsTemplate" class="text-xs font-black text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1.5">
                        <i class="fas fa-download"></i>
                        <span>تحميل النموذج (.xlsx)</span>
                    </a>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center text-[10px] font-mono pt-1">
                    <div class="p-2 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 font-bold text-slate-700 dark:text-slate-300">
                        اسم الشيفت
                    </div>
                    <div class="p-2 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 font-bold text-slate-700 dark:text-slate-300">
                        وقت البداية (08:00 AM)
                    </div>
                    <div class="p-2 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 font-bold text-slate-700 dark:text-slate-300">
                        وقت النهاية (04:00 PM)
                    </div>
                </div>
            </div>

            <!-- File Input -->
            <div class="space-y-1.5">
                <label class="block text-[10px] font-black uppercase tracking-wider text-slate-400">Excel File (.xlsx / .xls)</label>
                <input type="file" id="shiftsExcelFileInput" name="shiftsExcelFile" accept=".xlsx,.xls" required
                       class="block w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-6 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:uppercase file:bg-indigo-600 file:text-white hover:file:opacity-90 transition-all cursor-pointer bg-slate-50 dark:bg-slate-950 p-2 rounded-xl border border-slate-200 dark:border-slate-700" />
            </div>

            <div class="pt-2 flex items-center justify-end gap-3">
                <button type="button" onclick="closeUploadShiftsModal()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">
                    إلغاء
                </button>
                <button type="submit" id="btnUploadShiftsSubmit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-2">
                    <i class="fas fa-file-upload"></i>
                    <span>بدء الرفع والحفظ</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Shift Groups Management -->
<div id="shiftGroupsModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-4xl w-full p-6 sm:p-8 shadow-2xl relative max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        <!-- Header -->
        <div class="flex items-center justify-between pb-5 border-b border-slate-100 dark:border-slate-800 shrink-0">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xl shadow-inner border border-purple-200/50">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight">Shift Groups / إدارة مجموعات الشيفتات</h3>
                    <p class="text-xs text-slate-400 font-medium">تجميع الشيفتات تحت مظلة واحدة (مثل: شيفتات صباحية، مسائية، ليلية) للتحكم والفلترة السريعة في الشركات</p>
                </div>
            </div>
            <button onclick="closeManageShiftGroupsModal()" class="w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="fas fa-times text-base"></i>
            </button>
