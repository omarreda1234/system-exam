        <!-- Body Grid: Left = Create/Edit Form, Right = Existing Groups List -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 pt-5 overflow-y-auto flex-1 custom-scrollbar">
            <!-- Form: Create / Edit Group (lg:col-span-6) -->
            <div class="lg:col-span-6 bg-slate-50 dark:bg-slate-800/40 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col space-y-4">
                <div class="flex items-center justify-between">
                    <h4 id="groupFormTitle" class="text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fas fa-plus-circle text-purple-600"></i>
                        <span>إضافة مجموعة شيفتات جديدة</span>
                    </h4>
                    <button type="button" onclick="resetGroupModalForm()" id="btnResetGroupForm" class="hidden px-2.5 py-1 rounded-lg bg-purple-100 hover:bg-purple-200 dark:bg-purple-950/60 dark:hover:bg-purple-900 text-[11px] font-bold text-purple-700 dark:text-purple-300 transition-all flex items-center gap-1 cursor-pointer">
                        <i class="fas fa-arrow-right"></i> <span>العودة لإنشاء مجموعة جديدة</span>
                    </button>
                </div>

                <form id="shiftGroupForm" onsubmit="submitShiftGroup(event)" class="space-y-3.5 flex-1 flex flex-col">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="groupEditId" value="0" />

                    <!-- Group Name -->
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1.5">اسم المجموعة (Group Name)</label>
                        <input type="text" id="groupNameInput" required placeholder="مثال: Morning Shifts / شيفتات صباحية"
                               class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-purple-500 transition-all shadow-2xs" />
                    </div>

                    <!-- Description -->
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1.5">الوصف (Description)</label>
                        <input type="text" id="groupDescInput" placeholder="وصف مختصر للمجموعة أو أوقاتها..."
                               class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 dark:text-slate-200 outline-none focus:border-purple-500 transition-all shadow-2xs" />
                    </div>

                    <!-- Color Code -->
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1.5">لون التمييز (Color Theme)</label>
                        <div class="flex items-center gap-2">
                            <input type="color" id="groupColorInput" value="#7C3AED" class="w-10 h-9 p-0.5 rounded-xl border border-slate-200 cursor-pointer bg-white" />
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="setGroupColor('#D97706')" class="w-6 h-6 rounded-lg bg-amber-500 shadow-2xs hover:scale-110 transition-transform" title="Amber"></button>
                                <button type="button" onclick="setGroupColor('#2563EB')" class="w-6 h-6 rounded-lg bg-blue-600 shadow-2xs hover:scale-110 transition-transform" title="Blue"></button>
                                <button type="button" onclick="setGroupColor('#7C3AED')" class="w-6 h-6 rounded-lg bg-purple-600 shadow-2xs hover:scale-110 transition-transform" title="Purple"></button>
                                <button type="button" onclick="setGroupColor('#059669')" class="w-6 h-6 rounded-lg bg-emerald-600 shadow-2xs hover:scale-110 transition-transform" title="Emerald"></button>
                                <button type="button" onclick="setGroupColor('#DC2626')" class="w-6 h-6 rounded-lg bg-rose-600 shadow-2xs hover:scale-110 transition-transform" title="Rose"></button>
                                <button type="button" onclick="setGroupColor('#475569')" class="w-6 h-6 rounded-lg bg-slate-600 shadow-2xs hover:scale-110 transition-transform" title="Slate"></button>
                            </div>
                        </div>
                    </div>

                    <!-- Shifts Checklist -->
                    <div class="flex-1 flex flex-col space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400">
                                تعيين الشيفتات التابعة للمجموعة (<span id="modalSelectedShiftsCount">0</span> محدد)
                            </label>
                            <div class="flex items-center gap-2 text-xs">
                                <button type="button" onclick="toggleModalGroupShifts(true)" class="text-[10px] font-bold text-purple-600 hover:underline">الكل</button>
                                <span class="text-slate-300">|</span>
                                <button type="button" onclick="toggleModalGroupShifts(false)" class="text-[10px] font-bold text-slate-400 hover:underline">إلغاء</button>
                            </div>
                        </div>
                        <input type="text" id="modalShiftFilterInput" oninput="filterModalShiftsList(this.value)" placeholder="ابحث باسم الشيفت لتعيينه..."
                               class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-purple-500 shadow-2xs" />
                        
                        <div id="modalShiftsChecklist" class="max-h-48 overflow-y-auto custom-scrollbar p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl space-y-1">
                            <!-- Populated dynamically by JS -->
                        </div>
                    </div>

                    <div class="pt-2 flex items-center justify-end gap-2">
                        <button type="submit" id="btnSaveShiftGroup" class="w-full py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-purple-600/20 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-save"></i>
                            <span id="btnSaveShiftGroupText">حفظ المجموعة</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Existing Groups List (lg:col-span-6) -->
            <div class="lg:col-span-6 flex flex-col space-y-3">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                        <h4 class="text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-list text-purple-600"></i>
                            <span>المجموعات الحالية في النظام</span>
                        </h4>
                        <span id="existingGroupsCountBadge" class="text-[10px] font-black bg-purple-50 text-purple-700 border border-purple-200 px-2.5 py-0.5 rounded-full"></span>
                    </div>
                    <button type="button" onclick="resetGroupModalForm()" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 active:scale-95 text-white text-xs font-black shadow-sm transition-all flex items-center gap-1.5 cursor-pointer" title="إنشاء وإضافة مجموعة جديدة">
                        <i class="fas fa-plus text-xs"></i>
                        <span>+ إضافة مجموعة جديدة</span>
                    </button>
                </div>

                <div id="modalExistingGroupsList" class="space-y-2.5 overflow-y-auto max-h-[460px] custom-scrollbar p-1">
                    <!-- Populated dynamically by JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const allShiftsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(shiftsList.Select(s => new {
        id = s.Id,
        name = s.ShiftName,
        start = DateTime.Today.Add(s.StartTime).ToString("hh:mm tt"),
        end = DateTime.Today.Add(s.EndTime).ToString("hh:mm tt"),
        duration = s.DurationHours,
        groupId = s.GroupId ?? 0,
        groupName = s.GroupName ?? ""
    })));

    let currentFilterGroupId = 'all';
    let sortColumnIndex = -1;
    let sortAscending = true;
    let shiftGroupsCache = [];

    // ==========================================
    // DataTable Instant Filter & Search
    // ==========================================
    function filterShiftsTable() {
        const query = (document.getElementById('shiftSearchInput')?.value || '').trim().toLowerCase();
        const clearBtn = document.getElementById('btnClearShiftSearch');
        if (clearBtn) {
            if (query.length > 0) clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');
        }

        const rows = document.querySelectorAll('.shift-data-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const name = row.getAttribute('data-shift-name') || '';
            const gId = row.getAttribute('data-group-id') || '0';
            const gName = row.getAttribute('data-group-name') || '';
            const sTime = row.getAttribute('data-start-time') || '';
            const eTime = row.getAttribute('data-end-time') || '';
            const duration = row.getAttribute('data-duration') || '';
            const shiftId = row.getAttribute('data-shift-id') || '';

            const matchesGroup = (currentFilterGroupId === 'all' || currentFilterGroupId === null) || (gId === String(currentFilterGroupId));
            const matchesQuery = !query || 
                name.includes(query) || 
                gName.includes(query) || 
                sTime.includes(query) || 
                eTime.includes(query) || 
                duration.includes(query) ||
                shiftId.includes(query);

            if (matchesGroup && matchesQuery) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const countDisplay = document.getElementById('shiftsCountDisplay');
        if (countDisplay) {
            countDisplay.textContent = `عرض ${visibleCount} من ${rows.length} شيفت`;
        }

        let emptyRow = document.getElementById('shiftsNoMatchRow');
        if (visibleCount === 0 && rows.length > 0) {
            if (!emptyRow) {
                emptyRow = document.createElement('tr');
                emptyRow.id = 'shiftsNoMatchRow';
                emptyRow.innerHTML = `<td colspan="7" class="py-10 text-center text-xs font-bold text-slate-400">لا توجد شيفتات مطابقة لمعايير البحث الحالية.</td>`;
                document.getElementById('shiftsTableBody')?.appendChild(emptyRow);
            }
            emptyRow.style.display = '';
        } else if (emptyRow) {
            emptyRow.style.display = 'none';
        }
    }

    function clearShiftSearch() {
        const input = document.getElementById('shiftSearchInput');
        if (input) input.value = '';
        filterShiftsTable();
    }

    function filterByGroup(groupId) {
        currentFilterGroupId = (groupId === null || groupId === 'all' || !groupId) ? 'all' : String(groupId);
        const sel = document.getElementById('shiftGroupFilterSelect');
        if (sel && sel.value !== currentFilterGroupId) {
            sel.value = currentFilterGroupId;
        }
        filterShiftsTable();
    }

    // ==========================================
    // Table Column Sorting
    // ==========================================
    function sortTable(colIndex) {
        const tbody = document.getElementById('shiftsTableBody');
        const rows = Array.from(document.querySelectorAll('.shift-data-row'));
        if (rows.length === 0) return;

        if (sortColumnIndex === colIndex) {
            sortAscending = !sortAscending;
        } else {
            sortColumnIndex = colIndex;
            sortAscending = true;
        }

        rows.sort((a, b) => {
            let valA, valB;
            switch (colIndex) {
                case 0: // Name
                    valA = a.getAttribute('data-shift-name') || '';
                    valB = b.getAttribute('data-shift-name') || '';
                    return sortAscending ? valA.localeCompare(valB) : valB.localeCompare(valA);
                case 1: // Group
                    valA = a.getAttribute('data-group-name') || '';
                    valB = b.getAttribute('data-group-name') || '';
                    return sortAscending ? valA.localeCompare(valB) : valB.localeCompare(valA);
                case 2: // Start Time
                    valA = a.getAttribute('data-start-time') || '';
                    valB = b.getAttribute('data-start-time') || '';
                    return sortAscending ? valA.localeCompare(valB) : valB.localeCompare(valA);
                case 3: // End Time
                    valA = a.getAttribute('data-end-time') || '';
                    valB = b.getAttribute('data-end-time') || '';
                    return sortAscending ? valA.localeCompare(valB) : valB.localeCompare(valA);
                case 4: // Duration
                    valA = parseFloat(a.getAttribute('data-duration') || '0');
                    valB = parseFloat(b.getAttribute('data-duration') || '0');
                    return sortAscending ? valA - valB : valB - valA;
                case 5: // Users
                    valA = parseInt(a.getAttribute('data-users') || '0', 10);
                    valB = parseInt(b.getAttribute('data-users') || '0', 10);
                    return sortAscending ? valA - valB : valB - valA;
                default:
                    return 0;
            }
        });

        rows.forEach(r => tbody.appendChild(r));
    }

    // ==========================================
    // Add / Edit Shift Modal
    // ==========================================
    function openShiftModal(id, name = '', start = '08:00', end = '16:00', groupId = 0) {
        document.getElementById('shiftId').value = id;
        document.getElementById('modalTitle').textContent = id > 0 ? 'Edit Shift / تعديل الشيفت' : 'Add New Shift / إضافة شيفت جديد';
        document.getElementById('shiftName').value = name;
        document.getElementById('shiftStartTime').value = start || '08:00';
        document.getElementById('shiftEndTime').value = end || '16:00';
        
        const grpSelect = document.getElementById('shiftGroupId');
        if (grpSelect) grpSelect.value = groupId || 0;

        calculateDurationPreview();
        document.getElementById('shiftModal').classList.remove('hidden');
    }

    function closeShiftModal() {
        document.getElementById('shiftModal').classList.add('hidden');
    }

    function setPresetHours(hours) {
        const startVal = document.getElementById('shiftStartTime').value || '08:00';
        const parts = startVal.split(':');
        let startH = parseInt(parts[0], 10) || 0;
        let startM = parseInt(parts[1], 10) || 0;

        let endH = (startH + hours) % 24;
        let endHStr = endH.toString().padStart(2, '0');
        let endMStr = startM.toString().padStart(2, '0');

        document.getElementById('shiftEndTime').value = `${endHStr}:${endMStr}`;
        calculateDurationPreview();
    }

    function calculateDurationPreview() {
        const startVal = document.getElementById('shiftStartTime').value;
        const endVal = document.getElementById('shiftEndTime').value;
        const textEl = document.getElementById('durationPreviewText');
        const badgeEl = document.getElementById('overnightBadge');

        if (!startVal || !endVal) {
            textEl.textContent = '--';
            badgeEl.classList.add('hidden');
            return;
        }

        const [sH, sM] = startVal.split(':').map(Number);
        const [eH, eM] = endVal.split(':').map(Number);

        let startMinutes = sH * 60 + sM;
        let endMinutes = eH * 60 + eM;

        let isOvernight = false;
        if (endMinutes < startMinutes) {
            endMinutes += 24 * 60;
            isOvernight = true;
        }

        let diffMinutes = endMinutes - startMinutes;
        let hours = Math.floor(diffMinutes / 60);
        let minutes = diffMinutes % 60;

        let formatted = `${hours} Hours`;
        if (minutes > 0) formatted += ` and ${minutes} Minutes`;

        textEl.textContent = `${formatted} (${(diffMinutes / 60).toFixed(1)} hrs)`;

        if (isOvernight) {
            badgeEl.classList.remove('hidden');
        } else {
            badgeEl.classList.add('hidden');
        }
    }

    async function handleShiftSubmit(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('shiftId').value, 10);
        const name = document.getElementById('shiftName').value.trim();
        const startTime = document.getElementById('shiftStartTime').value;
        const endTime = document.getElementById('shiftEndTime').value;
        const groupId = parseInt(document.getElementById('shiftGroupId')?.value || '0', 10);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const url = id > 0 ? '/Admin/EditShift' : '/Admin/AddShift';
        const formData = new FormData();
        if (id > 0) formData.append('id', id);
        formData.append('name', name);
        formData.append('startTime', startTime);
        formData.append('endTime', endTime);
        if (groupId > 0) formData.append('groupId', groupId);
        formData.append('__RequestVerificationToken', token);

        const btn = document.getElementById('btnSubmitShift');
        btn.disabled = true;
        btn.textContent = 'Saving...';

        try {
            const res = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Failed to save shift.');
                btn.disabled = false;
                btn.textContent = 'Save Shift';
            }
        } catch (err) {
            alert('An error occurred: ' + err.message);
            btn.disabled = false;
            btn.textContent = 'Save Shift';
        }
    }

    async function deleteShift(id, name, assignedCount) {
        if (assignedCount > 0) {
            alert(`لا يمكن حذف الشيفت "${name}" لأن هناك ${assignedCount} موظف مسجلين عليه حالياً. يرجى نقلهم لشيفت آخر أولاً.`);
            return;
        }

        if (!confirm(`هل أنت متأكد من حذف الشيفت "${name}"؟`)) {
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        try {
            const res = await fetch('/Admin/DeleteShift', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                const row = document.getElementById('shift-row-' + id);
                if (row) row.remove();
                filterShiftsTable();
            } else {
                alert(data.message || 'Failed to delete shift.');
            }
        } catch (err) {
            alert('An error occurred: ' + err.message);
        }
    }

    // ==========================================
    // Shift Groups Management Modal
    // ==========================================
    function setGroupColor(hex) {
        document.getElementById('groupColorInput').value = hex;
    }

    async function openManageShiftGroupsModal() {
        document.getElementById('shiftGroupsModal').classList.remove('hidden');
        resetGroupModalForm();
        await loadShiftGroups();
    }

    function closeManageShiftGroupsModal() {
        document.getElementById('shiftGroupsModal').classList.add('hidden');
    }

    function renderModalShiftsChecklist(selectedIds = []) {
        const container = document.getElementById('modalShiftsChecklist');
        if (!container) return;

        const selSet = new Set(selectedIds);
        container.innerHTML = allShiftsData.map(s => {
            const isChecked = selSet.has(s.id);
            return `
                <label class="modal-shift-item flex items-center justify-between p-2 rounded-xl border ${isChecked ? 'bg-purple-50/80 border-purple-300 text-purple-950 font-bold' : 'bg-slate-50 dark:bg-slate-800/40 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300'} cursor-pointer text-xs select-none hover:border-purple-300 transition-all" data-shift-name="${s.name.toLowerCase()}">
                    <div class="flex items-center gap-2 truncate">
                        <input type="checkbox" value="${s.id}" ${isChecked ? 'checked' : ''} onchange="updateModalSelectedCount()" class="modal-shift-chk w-3.5 h-3.5 rounded text-purple-600 focus:ring-purple-500 border-slate-300" />
                        <span class="truncate">${s.name}</span>
                    </div>
                    <span class="text-[10px] font-mono text-slate-400 shrink-0 ml-2">
                        ${s.duration} hrs (${s.start} - ${s.end})
                    </span>
                </label>
            `;
        }).join('');

        updateModalSelectedCount();
    }

    function filterModalShiftsList(term) {
        const q = (term || '').trim().toLowerCase();
        document.querySelectorAll('.modal-shift-item').forEach(el => {
            const name = el.getAttribute('data-shift-name') || '';
            el.style.display = (!q || name.includes(q)) ? '' : 'none';
        });
    }

    function toggleModalGroupShifts(selectAll) {
        document.querySelectorAll('.modal-shift-chk').forEach(c => {
            // Only affect visible items
            if (c.closest('.modal-shift-item').style.display !== 'none') {
                c.checked = selectAll;
            }
        });
        updateModalSelectedCount();
    }

    function updateModalSelectedCount() {
        const checked = document.querySelectorAll('.modal-shift-chk:checked').length;
        const countEl = document.getElementById('modalSelectedShiftsCount');
        if (countEl) countEl.textContent = checked;
    }

    async function loadShiftGroups() {
        try {
            const res = await fetch('/Admin/GetShiftGroups');
            const data = await res.json();
            if (data.success && data.groups) {
                shiftGroupsCache = data.groups;
                renderExistingGroupsList(data.groups);
            }
        } catch (err) {
            console.error('Failed to load shift groups:', err);
        }
    }

    function renderExistingGroupsList(groups) {
        const container = document.getElementById('modalExistingGroupsList');
        const badge = document.getElementById('existingGroupsCountBadge');
        if (!container) return;

        if (badge) badge.textContent = `${groups.length} مجموعات`;

        if (groups.length === 0) {
            container.innerHTML = `
                <div class="p-8 text-center text-xs text-slate-400 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-dashed border-slate-200 dark:border-slate-700">
                    لم يتم إنشاء أي مجموعات بعد. استخدم النموذج لإضافة مجموعة جديدة.
                </div>
            `;
            return;
        }

        container.innerHTML = groups.map(g => {
            const color = g.colorCode || '#7C3AED';
            const count = g.shiftsCount || (g.shiftIds ? g.shiftIds.length : 0);
            return `
                <div class="p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xs hover:shadow-xs flex items-center justify-between gap-3 transition-all">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white shrink-0 shadow-sm text-sm font-bold" style="background-color: ${color};">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <div class="min-w-0">
                            <h5 class="text-xs font-black text-slate-900 dark:text-white truncate flex items-center gap-2">
                                <span>${g.groupName}</span>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-black border" style="background-color: ${color}15; color: ${color}; border-color: ${color}30;">
                                    ${count} شيفت
                                </span>
                            </h5>
                            <p class="text-[10px] text-slate-400 truncate mt-0.5">${g.description || 'بدون وصف'}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button type="button" onclick="editGroupInModal(${g.id})" class="p-2 text-slate-400 hover:text-purple-600 hover:bg-purple-50 dark:hover:bg-purple-950/40 rounded-xl text-xs transition-colors" title="تعديل المجموعة">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button type="button" onclick="deleteShiftGroupFromModal(${g.id}, '${g.groupName.replace(/'/g, "\\'")}')" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-xl text-xs transition-colors" title="حذف المجموعة">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function editGroupInModal(groupId) {
        const group = shiftGroupsCache.find(g => g.id === groupId);
        if (!group) return;

        document.getElementById('groupEditId').value = group.id;
        document.getElementById('groupNameInput').value = group.groupName;
        document.getElementById('groupDescInput').value = group.description || '';
        document.getElementById('groupColorInput').value = group.colorCode || '#7C3AED';

        document.getElementById('groupFormTitle').innerHTML = `<i class="fas fa-pen text-purple-600"></i> <span>تعديل مجموعة: ${group.groupName}</span>`;
        document.getElementById('btnSaveShiftGroupText').textContent = 'تحديث وحفظ المجموعة';
        document.getElementById('btnResetGroupForm').classList.remove('hidden');

        renderModalShiftsChecklist(group.shiftIds || []);
    }

    function resetGroupModalForm() {
        document.getElementById('groupEditId').value = '0';
        document.getElementById('groupNameInput').value = '';
        document.getElementById('groupDescInput').value = '';
        document.getElementById('groupColorInput').value = '#7C3AED';

        document.getElementById('groupFormTitle').innerHTML = `<i class="fas fa-plus-circle text-purple-600"></i> <span>إضافة مجموعة شيفتات جديدة</span>`;
        document.getElementById('btnSaveShiftGroupText').textContent = 'حفظ وإنشاء المجموعة';
        document.getElementById('btnResetGroupForm').classList.add('hidden');

        renderModalShiftsChecklist([]);

        const nameInput = document.getElementById('groupNameInput');
        if (nameInput) {
            nameInput.focus();
            nameInput.classList.add('ring-2', 'ring-purple-500');
            setTimeout(() => nameInput.classList.remove('ring-2', 'ring-purple-500'), 1500);
        }
    }

    async function submitShiftGroup(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('groupEditId').value, 10) || 0;
        const name = document.getElementById('groupNameInput').value.trim();
        const desc = document.getElementById('groupDescInput').value.trim();
        const color = document.getElementById('groupColorInput').value || '#7C3AED';

        const shiftIds = Array.from(document.querySelectorAll('.modal-shift-chk:checked')).map(c => parseInt(c.value, 10));

        const btn = document.getElementById('btnSaveShiftGroup');
        const origText = document.getElementById('btnSaveShiftGroupText').textContent;
        btn.disabled = true;
        const token = document.querySelector('#shiftGroupForm input[name="__RequestVerificationToken"]')?.value
                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value 
                   || (window.$ ? $('input[name="__RequestVerificationToken"]').val() : '') 
                   || '';

        try {
            const res = await fetch('/Admin/SaveShiftGroup', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    id: id,
                    groupName: name,
                    description: desc,
                    colorCode: color,
                    shiftIds: shiftIds
                })
            });

            if (!res.ok) {
                const errText = await res.text();
                let errMsg = `خطأ في الخادم (${res.status})`;
                try {
                    const parsed = JSON.parse(errText);
                    if (parsed.message) errMsg = parsed.message;
                } catch {
                    if (res.status === 400) errMsg = 'تعذر التحقق من رمز الحماية (400 Bad Request). يرجى تحديث الصفحة والمحاولة مجدداً.';
                    else if (res.status === 401 || res.status === 403) errMsg = 'غير مصرح لك بتنفيذ هذه العملية.';
                }
                Swal.fire('خطأ', errMsg, 'error');
                return;
            }

            const data = await res.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'تم الحفظ',
                    text: data.message || 'تم حفظ مجموعة الشيفتات بنجاح.',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('خطأ', data.message || 'فشل حفظ المجموعة', 'error');
            }
        } catch (err) {
            Swal.fire('خطأ', 'حدث خطأ أثناء الاتصال: ' + err.message, 'error');
        } finally {
            btn.disabled = false;
            document.getElementById('btnSaveShiftGroupText').textContent = origText;
        }
    }

    async function deleteShiftGroupFromModal(groupId, groupName) {
        const confirm = await Swal.fire({
            title: `<div class="text-base font-black text-slate-800 dark:text-white">حذف مجموعة: ${groupName}</div>`,
            text: 'هل أنت متأكد من حذف هذه المجموعة؟ لن يتم حذف الشيفتات ذاتها بل سيتم إزالتها فقط من هذه المجموعة.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'نعم، حذف',
            cancelButtonText: 'إلغاء',
            customClass: {
                confirmButton: 'px-4 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs',
                cancelButton: 'px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-bold text-xs'
            }
        });

        if (confirm.isConfirmed) {
            try {
                const token = document.querySelector('#shiftGroupForm input[name="__RequestVerificationToken"]')?.value
                           || document.querySelector('input[name="__RequestVerificationToken"]')?.value 
                           || (window.$ ? $('input[name="__RequestVerificationToken"]').val() : '') 
                           || '';

                const res = await fetch(`/Admin/DeleteShiftGroup?id=${groupId}`, { 
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!res.ok) {
                    const errText = await res.text();
                    let errMsg = `خطأ في الخادم (${res.status})`;
                    try {
                        const parsed = JSON.parse(errText);
                        if (parsed.message) errMsg = parsed.message;
                    } catch {
                        if (res.status === 400) errMsg = 'تعذر التحقق من رمز الحماية (400 Bad Request). يرجى تحديث الصفحة.';
                    }
                    Swal.fire('خطأ', errMsg, 'error');
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم الحذف',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('خطأ', data.message || 'تعذر حذف المجموعة', 'error');
                }
            } catch (err) {
                Swal.fire('خطأ', err.message, 'error');
            }
        }
    }

    // ==========================================
    // Upload Excel
    // ==========================================
    function openUploadShiftsModal() {
        const fileInput = document.getElementById('shiftsExcelFileInput');
        if (fileInput) fileInput.value = '';
        document.getElementById('uploadShiftsModal').classList.remove('hidden');
    }

    function closeUploadShiftsModal() {
        document.getElementById('uploadShiftsModal').classList.add('hidden');
    }

    async function handleUploadShiftsSubmit(e) {
        e.preventDefault();
        const fileInput = document.getElementById('shiftsExcelFileInput');
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            Swal.fire('تنبيه', 'يرجى اختيار ملف إكسيل (.xlsx) أولاً.', 'warning');
            return;
        }

        const form = document.getElementById('uploadShiftsForm');
        const fd = new FormData(form);
        const btn = document.getElementById('btnUploadShiftsSubmit');
        const originalHtml = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>جاري المعالجة...</span>';

        try {
            const res = await fetch('/Admin/ImportShiftsFromExcel', {
                method: 'POST',
                body: fd
            });

            const data = await res.json();
            if (data.success) {
                if (data.errors && data.errors.length > 0) {
                    let errHtml = '<ul class="text-right text-xs text-rose-500 overflow-y-auto max-h-48 mt-4 list-disc pr-4" dir="rtl">';
                    data.errors.forEach(err => { errHtml += `<li>${String(err).replace(/</g, '&lt;')}</li>`; });
                    errHtml += '</ul>';

                    Swal.fire({
                        icon: 'warning',
                        title: 'اكتمل الحفظ مع وجود ملاحظات',
                        width: '640px',
                        html: `<p class="text-sm font-bold text-slate-700 dark:text-slate-200">${data.message}</p>${errHtml}`,
                        confirmButtonText: 'حسناً'
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم بنجاح',
                        text: data.message,
                        timer: 2500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                }
            } else {
                Swal.fire('خطأ', data.message || 'فشل معالجة ملف الإكسيل.', 'error');
            }
        } catch (err) {
            Swal.fire('خطأ', 'حدث خطأ في الاتصال بالسيرفر: ' + err.message, 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }
</script>
