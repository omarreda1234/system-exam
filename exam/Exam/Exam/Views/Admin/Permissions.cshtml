@model List<Exam.Controllers.AdminController.ModulePermissionViewModel>
@{
    ViewBag.Title = "Dynamic Role Permissions";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var selectedRole = ViewBag.SelectedRole as string ?? "";

    var categories = new List<(string Slug, string Name, string Icon, string ColorClass, List<Exam.Controllers.AdminController.ModulePermissionViewModel> Items)>
    {
        ("core", "Core Dashboards & Inventory", "fas fa-cubes", "border-l-sky-500 bg-sky-50/50 dark:bg-sky-950/20 text-sky-700 dark:text-sky-300", Model.Where(m => new[] { "LMS_Overview", "AttendanceDash", "ProgramDash", "Items", "AttendanceTrends", "SkillTracks" }.Contains(m.ModuleKey)).ToList()),
        ("exams", "Examination Hub", "fas fa-file-invoice", "border-l-purple-500 bg-purple-50/50 dark:bg-purple-950/20 text-purple-700 dark:text-purple-300", Model.Where(m => new[] { "WeeklyExams", "WaveExams", "Assignments" }.Contains(m.ModuleKey)).ToList()),
        ("personnel", "Personnel Data & Management", "fas fa-users", "border-l-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20 text-emerald-700 dark:text-emerald-300", Model.Where(m => new[] { "PersonnelRegistry", "Personnel_EditProfile", "Personnel_EditShift", "Personnel_EditRole", "Personnel_ResetPassword", "Personnel_SendMessage", "Personnel_Delete", "Deactivated", "BatchCycles", "BatchCycles_RemoveUser", "TraineeProfile", "NewCome", "Companies", "Branches", "BranchSupervisors" }.Contains(m.ModuleKey)).ToList()),
        ("analytics", "Analytics & Live Monitoring", "fas fa-chart-pie", "border-l-amber-500 bg-amber-50/50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-300", Model.Where(m => new[] { "WeeklyAnalytics", "WaveAnalytics", "GeneralAnalytics", "LiveMonitor", "Certificates" }.Contains(m.ModuleKey)).ToList()),
        ("config", "System Configuration & CMS", "fas fa-cog", "border-l-indigo-500 bg-indigo-50/50 dark:bg-indigo-950/20 text-indigo-700 dark:text-indigo-300", Model.Where(m => new[] { "SystemRoles", "RolePermissions", "QuestionCategories", "ExamVarieties", "CourseStructure", "ExamInstructions", "ManageHome" }.Contains(m.ModuleKey)).ToList()),
        ("auto", "Dynamic Auto-Discovered Endpoints", "fas fa-bolt", "border-l-rose-500 bg-rose-50/50 dark:bg-rose-950/20 text-rose-700 dark:text-rose-300", Model.Where(m => m.ModuleKey.StartsWith("Auto_")).ToList())
    };
}

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/60 dark:border-slate-800/50 shadow-sm mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <span class="text-xs font-bold text-brand-600 dark:text-brand-400 tracking-[0.2em] uppercase">Security Settings</span>
                <h2 class="text-2xl sm:text-3xl font-black tracking-tight mt-1">Role Permissions Console</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Configure database-driven access control list (ACL) dynamically for system roles.</p>
            </div>
            
            <div class="flex items-center gap-3">
                <label for="roleSelector" class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Configure Role:</label>
                <select id="roleSelector" onchange="switchRole(this.value)" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-850 rounded-2xl px-4 py-2.5 text-xs font-bold focus:ring-4 focus:ring-brand-500/10 focus:border-brand-500 outline-none transition-all">
                    @foreach (var role in roles)
                    {
                        <!option value="@role" @(role == selectedRole ? "selected" : "")>@role</!option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Permissions Grid -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/60 dark:border-slate-800/50 shadow-sm overflow-hidden mb-8">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800/50 flex justify-between items-center bg-slate-50/50 dark:bg-slate-900/50">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Feature Matrix for "@selectedRole"</span>
            <div class="flex gap-4">
                <button type="button" onclick="toggleAllAccess(true)" class="text-[10px] font-bold text-brand-600 dark:text-brand-400 uppercase tracking-wider hover:underline">Select All Access</button>
                <span class="text-slate-350 dark:text-slate-700">|</span>
                <button type="button" onclick="toggleAllAccess(false)" class="text-[10px] font-bold text-red-500 uppercase tracking-wider hover:underline">Clear All</button>
            </div>
        </div>

        <div class="overflow-x-auto p-4">
            <table id="permissionsTable" class="saas-table display w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-950 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800">
                        <th class="py-4 px-6">Feature / Category / Module</th>
                        <th class="py-4 px-6 text-center w-32">Access (View)</th>
                        <th class="py-4 px-6 text-center w-32">Create (Add)</th>
                        <th class="py-4 px-6 text-center w-32">Edit (Update)</th>
                        <th class="py-4 px-6 text-center w-32">Delete (Wipe)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50 text-sm">
                    @foreach (var cat in categories)
                    {
                        if (!cat.Items.Any()) continue;

                        <!-- Category Header Row -->
                        <tr class="cat-header-row @cat.ColorClass border-l-4 font-black cursor-pointer select-none transition-colors" data-category="@cat.Slug" onclick="toggleCategoryGroup('@cat.Slug')">
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-3">
                                    <button type="button" class="w-7 h-7 rounded-xl bg-white/80 dark:bg-slate-900/80 shadow-sm flex items-center justify-center text-xs transition-transform duration-200" onclick="event.stopPropagation(); toggleCategoryGroup('@cat.Slug');">
                                        <i class="fas fa-chevron-down transition-transform duration-200" id="chevron-@cat.Slug"></i>
                                    </button>
                                    <div class="flex items-center gap-2">
                                        <i class="@cat.Icon text-sm opacity-80"></i>
                                        <span class="text-base font-black tracking-tight">@cat.Name</span>
                                        <span class="text-[10px] bg-white/80 dark:bg-slate-900/80 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider border border-slate-200/50 dark:border-slate-800/50">
                                            @cat.Items.Count(i => !i.ModuleKey.Contains("_")) Modules
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-center">
                                <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                    <input type="checkbox" class="cat-master-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" onchange="toggleCategoryAccess('@cat.Slug', this.checked)" title="Toggle all in @cat.Name" />
                                </label>
                            </td>
                            <td class="py-4 px-6 text-center font-mono text-[10px] opacity-40">--</td>
                            <td class="py-4 px-6 text-center font-mono text-[10px] opacity-40">--</td>
                            <td class="py-4 px-6 text-center font-mono text-[10px] opacity-40">--</td>
                        </tr>

                        <!-- Category Items -->
                        @foreach (var item in cat.Items)
                        {
                            var isPersonnelMain = item.ModuleKey == "PersonnelRegistry";
                            var isPersonnelChild = item.ModuleKey.StartsWith("Personnel_");
                            var isBatchCyclesMain = item.ModuleKey == "BatchCycles";
                            var isBatchCyclesChild = item.ModuleKey.StartsWith("BatchCycles_");

                            if (isPersonnelMain)
                            {
                                <tr class="cat-item-row-@cat.Slug bg-brand-50/30 dark:bg-brand-950/20 font-bold hover:bg-brand-50/60 dark:hover:bg-brand-900/30 transition-colors cursor-pointer select-none border-l-4 border-l-brand-600" data-module-key="@item.ModuleKey" onclick="togglePersonnelGroup(event)">
                                    <td class="py-4 px-6 pl-10">
                                        <div class="flex items-center gap-3">
                                            <button type="button" id="personnelToggleBtn" class="w-6 h-6 rounded-lg bg-brand-600/10 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xs transition-transform duration-200" onclick="event.stopPropagation(); togglePersonnelGroup(event);">
                                                <i class="fas fa-chevron-down transition-transform duration-200" id="personnelChevron"></i>
                                            </button>
                                            <div>
                                                <div class="font-black text-slate-900 dark:text-white flex items-center gap-2 text-sm">
                                                    <span>Personnel Registry</span>
                                                    <span class="text-[9px] bg-brand-600 text-white px-2 py-0.5 rounded-full font-bold uppercase tracking-wider shadow-sm">6 Sub-Actions Dropdown</span>
                                                </div>
                                                <div class="text-[10px] text-slate-400 dark:text-slate-500 font-mono mt-0.5">Admin/AllUsers — Click row to toggle actions dropdown</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="access-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanAccess ? "checked" : "") onchange="onAccessChange(this); togglePersonnelSubitems(this.checked);" />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="create-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanCreate ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="edit-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanEdit ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="delete-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanDelete ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                </tr>
                            }
                            else if (isPersonnelChild)
                            {
                                <tr class="cat-item-row-@cat.Slug personnel-child-row bg-slate-50/70 dark:bg-slate-950/40 border-l-4 border-l-brand-400 hover:bg-brand-50/40 dark:hover:bg-slate-800/40 transition-colors" data-module-key="@item.ModuleKey">
                                    <td class="py-3 px-6 pl-16">
                                        <div class="flex items-center gap-2">
                                            <span class="text-brand-500 dark:text-brand-400 font-black">↳</span>
                                            <div>
                                                <div class="font-bold text-xs text-slate-800 dark:text-slate-200">@item.DisplayName.Replace("Personnel Action: ", "")</div>
                                                <div class="text-[9px] text-slate-400 dark:text-slate-500 font-mono">@item.ControllerName/@item.ActionName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="access-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanAccess ? "checked" : "") onchange="onAccessChange(this)" />
                                        </label>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="create-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanCreate ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="edit-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanEdit ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="delete-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanDelete ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                </tr>
                            }
                            else if (isBatchCyclesMain)
                            {
                                <tr class="cat-item-row-@cat.Slug bg-brand-50/30 dark:bg-brand-950/20 font-bold hover:bg-brand-50/60 dark:hover:bg-brand-900/30 transition-colors cursor-pointer select-none border-l-4 border-l-brand-600" data-module-key="@item.ModuleKey" onclick="toggleBatchCyclesGroup(event)">
                                    <td class="py-4 px-6 pl-10">
                                        <div class="flex items-center gap-3">
                                            <button type="button" id="batchCyclesToggleBtn" class="w-6 h-6 rounded-lg bg-brand-600/10 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xs transition-transform duration-200" onclick="event.stopPropagation(); toggleBatchCyclesGroup(event);">
                                                <i class="fas fa-chevron-down transition-transform duration-200" id="batchCyclesChevron"></i>
                                            </button>
                                            <div>
                                                <div class="font-black text-slate-900 dark:text-white flex items-center gap-2 text-sm">
                                                    <span>Batch Cycles (Waves)</span>
                                                    <span class="text-[9px] bg-brand-600 text-white px-2 py-0.5 rounded-full font-bold uppercase tracking-wider shadow-sm">1 Sub-Action Dropdown</span>
                                                </div>
                                                <div class="text-[10px] text-slate-400 dark:text-slate-500 font-mono mt-0.5">Admin/Waves — Click row to toggle actions dropdown</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="access-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanAccess ? "checked" : "") onchange="onAccessChange(this); toggleBatchCyclesSubitems(this.checked);" />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="create-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanCreate ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="edit-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanEdit ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="delete-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanDelete ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                </tr>
                            }
                            else if (isBatchCyclesChild)
                            {
                                <tr class="cat-item-row-@cat.Slug batchcycles-child-row bg-slate-50/70 dark:bg-slate-950/40 border-l-4 border-l-brand-400 hover:bg-brand-50/40 dark:hover:bg-slate-800/40 transition-colors" data-module-key="@item.ModuleKey">
                                    <td class="py-3 px-6 pl-16">
                                        <div class="flex items-center gap-2">
                                            <span class="text-brand-500 dark:text-brand-400 font-black">↳</span>
                                            <div>
                                                <div class="font-bold text-xs text-slate-800 dark:text-slate-200">@item.DisplayName.Replace("Batch Cycles Action: ", "")</div>
                                                <div class="text-[9px] text-slate-400 dark:text-slate-500 font-mono">@item.ControllerName/@item.ActionName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="access-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanAccess ? "checked" : "") onchange="onAccessChange(this)" />
                                        </label>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="create-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanCreate ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="edit-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanEdit ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-3 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="delete-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanDelete ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="cat-item-row-@cat.Slug hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors" data-module-key="@item.ModuleKey">
                                    <td class="py-4 px-6 pl-10">
                                        <div class="font-bold text-slate-800 dark:text-slate-200">@item.DisplayName</div>
                                        <div class="text-[10px] text-slate-400 dark:text-slate-500 font-mono mt-0.5">@item.ControllerName/@item.ActionName</div>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="access-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanAccess ? "checked" : "") onchange="onAccessChange(this)" />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="create-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanCreate ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="edit-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanEdit ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <label class="inline-flex items-center justify-center cursor-pointer">
                                            <input type="checkbox" class="delete-chk w-4 h-4 text-brand-600 border-slate-300 rounded focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950" @(item.CanDelete ? "checked" : "") @(!item.CanAccess ? "disabled" : "") />
                                        </label>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-4">
        <a href="@Url.Action("Index")" class="px-6 py-3 rounded-2xl border border-slate-200 dark:border-slate-800 text-xs font-bold hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
            Cancel
        </a>
        <button type="button" onclick="savePermissions()" class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white rounded-2xl text-xs font-bold transition-all shadow-lg shadow-brand-500/20">
            Save Permissions Setup
        </button>
    </div>
</div>

@section Scripts {
<script>
    let permissionsTable;

    $(document).ready(function () {
        if ($('#permissionsTable').length) {
            permissionsTable = $('#permissionsTable').DataTable({
                pageLength: 100,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                ordering: false,
                language: {
                    search: "",
                    searchPlaceholder: "Search permissions...",
                    lengthMenu: "Display _MENU_ entries"
                }
            });
            $('.dataTables_filter input').addClass('bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2 text-xs font-bold outline-none mb-4');
        }
    });

    function switchRole(roleName) {
        window.location.href = '@Url.Action("Permissions", "Admin")?roleName=' + encodeURIComponent(roleName);
    }

    function getAllTableRows() {
        if (permissionsTable && $.fn.DataTable.isDataTable('#permissionsTable')) {
            return permissionsTable.$('tr');
        }
        return $('tbody tr');
    }

    function toggleCategoryGroup(slug) {
        const $childRows = getAllTableRows().filter('.cat-item-row-' + slug);
        const chevron = document.getElementById('chevron-' + slug);
        let willShow = false;
        $childRows.each(function() {
            if ($(this).hasClass('hidden')) {
                $(this).removeClass('hidden');
                willShow = true;
            } else {
                $(this).addClass('hidden');
            }
        });
        if (chevron) {
            chevron.style.transform = willShow ? 'rotate(0deg)' : 'rotate(-90deg)';
        }
    }

    function toggleCategoryAccess(slug, checked) {
        const $childRows = getAllTableRows().filter('.cat-item-row-' + slug);
        $childRows.find('.access-chk').each(function() {
            this.checked = checked;
            onAccessChange(this);
        });
    }

    function togglePersonnelGroup(e) {
        if (e) e.stopPropagation();
        const $childRows = getAllTableRows().filter('.personnel-child-row');
        const chevron = document.getElementById('personnelChevron');
        let willShow = false;
        $childRows.each(function() {
            if ($(this).hasClass('hidden')) {
                $(this).removeClass('hidden');
                willShow = true;
            } else {
                $(this).addClass('hidden');
            }
        });
        if (chevron) {
            chevron.style.transform = willShow ? 'rotate(0deg)' : 'rotate(-90deg)';
        }
    }

    function togglePersonnelSubitems(checked) {
        const $childRows = getAllTableRows().filter('.personnel-child-row');
        $childRows.find('.access-chk').each(function() {
            this.checked = checked;
            onAccessChange(this);
        });
    }

    function toggleBatchCyclesGroup(e) {
        if (e) e.stopPropagation();
        const $childRows = getAllTableRows().filter('.batchcycles-child-row');
        const chevron = document.getElementById('batchCyclesChevron');
        let willShow = false;
        $childRows.each(function() {
            if ($(this).hasClass('hidden')) {
                $(this).removeClass('hidden');
                willShow = true;
            } else {
                $(this).addClass('hidden');
            }
        });
        if (chevron) {
            chevron.style.transform = willShow ? 'rotate(0deg)' : 'rotate(-90deg)';
        }
    }

    function toggleBatchCyclesSubitems(checked) {
        const $childRows = getAllTableRows().filter('.batchcycles-child-row');
        $childRows.find('.access-chk').each(function() {
            this.checked = checked;
            onAccessChange(this);
        });
    }

    function onAccessChange(chk) {
        const row = $(chk).closest('tr');
        const childChks = row.find('.create-chk, .edit-chk, .delete-chk');
        childChks.each(function() {
            this.disabled = !chk.checked;
            if (!chk.checked) {
                this.checked = false;
            }
        });
    }

    function toggleAllAccess(checked) {
        const $rows = getAllTableRows();
        $rows.find('.access-chk, .cat-master-chk').each(function() {
            this.checked = checked;
            onAccessChange(this);
        });
    }

    async function savePermissions() {
        const permissions = [];
        const $rows = getAllTableRows();

        $rows.each(function() {
            const moduleKey = $(this).attr('data-module-key');
            if (!moduleKey) return;
            const canAccess = $(this).find('.access-chk').is(':checked');
            const canCreate = $(this).find('.create-chk').is(':checked');
            const canEdit = $(this).find('.edit-chk').is(':checked');
            const canDelete = $(this).find('.delete-chk').is(':checked');

            permissions.push({
                ModuleKey: moduleKey,
                CanAccess: canAccess,
                CanCreate: canCreate,
                CanEdit: canEdit,
                CanDelete: canDelete
            });
        });

        Swal.fire({
            title: 'Updating Permissions...',
            html: 'Writing matrix rules to database',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        try {
            const response = await fetch('@Url.Action("SavePermissions", "Admin")?roleName=' + encodeURIComponent('@selectedRole'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(permissions)
            });
            const res = await response.json();
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: res.message,
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'System Error',
                    text: res.message
                });
            }
        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'System Error',
                text: err.message
            });
        }
    }
</script>
}
