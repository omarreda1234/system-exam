@model IEnumerable<Exam.DTOs.DepartmentDto>
@using System.Text.Encodings.Web
@inject Exam.Services.IExamService ExamService
@{
    ViewData["Title"] = "Department Management / إدارة الأقسام";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var userRoles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    bool HasSpecificPermission(string permissionType)
    {
        if (userRoles.Contains("Admin")) return true;
        return ExamService.HasSpecificPermissionAsync(userRoles, "Admin", "Departments", permissionType).GetAwaiter().GetResult();
    }

    var deptsList = Model?.ToList() ?? new List<Exam.DTOs.DepartmentDto>();
    int totalAssigned = deptsList.Sum(d => d.AssignedPersonnelCount);
    int activeCount = deptsList.Count(d => d.IsActive);
}

@Html.AntiForgeryToken()

<div class="min-h-screen pb-20 bg-slate-50/50 dark:bg-slate-950/20">
    <!-- Header -->
    <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-24 pb-10">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <div class="flex items-center gap-2 text-xs font-black text-sky-600 dark:text-sky-400 uppercase tracking-widest mb-1">
                        <i class="fas fa-tags"></i>
                        <span>Department Management Console</span>
                    </div>
                    <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight flex items-center gap-3">
                        <span>Departments / إدارة وتصنيف الأقسام</span>
                    </h1>
                    <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-1">
                        إضافة وتعديل وحذف الأقسام وتصنيف الموظفين والربط مع نماذج الاستيراد والتحديث
                    </p>
                </div>
                
                <div class="flex items-center gap-3">
                    <a href="/Admin/AllUsers" class="bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2">
                        <i class="fas fa-users text-xs"></i>
                        <span>Personnel Registry</span>
                    </a>
                    <a href="/Admin/DownloadDepartmentUpdateTemplate" class="bg-sky-50 hover:bg-sky-100 dark:bg-sky-950/50 dark:hover:bg-sky-900/60 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800 px-5 py-3 rounded-xl text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2">
                        <i class="fas fa-download text-xs"></i>
                        <span>Excel Template / نموذج التحديث</span>
                    </a>
                    @if (User.IsInRole("Admin") || HasSpecificPermission("create"))
                    {
                        <button onclick="openDepartmentModal(0)" class="bg-sky-600 hover:bg-sky-700 text-white px-6 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-sky-600/20 flex items-center gap-2 group">
                            <i class="fas fa-plus text-xs group-hover:rotate-90 transition-transform"></i>
                            <span>Add New Department / إضافة قسم</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8">
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Total Departments / إجمالي الأقسام</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@deptsList.Count</p>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-emerald-500">Active / أقسام نشطة</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@activeCount</p>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4">
                    <span class="text-[10px] font-black uppercase tracking-widest text-sky-500">Assigned Personnel / الموظفين المسجلين</span>
                    <p class="text-xl font-black text-slate-900 dark:text-white mt-1">@totalAssigned</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Departments Table Section -->
    <div class="max-w-7xl mx-auto px-6 mt-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
            <div class="px-8 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-wider">Department Directory</h2>
                    <p class="text-[11px] text-slate-400 font-medium">سجل الأقسام المعتمدة في الهيكل الإداري</p>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1 bg-sky-50 text-sky-600 dark:bg-sky-950/40 dark:text-sky-400 rounded-full border border-sky-200/50">
                    Live Organization Schema
                </span>
            </div>

            <div class="p-6 md:p-8">
                <div class="overflow-x-auto w-full">
                    <table class="saas-table w-full datatable" id="departmentsTable">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-wider">
                                <th class="py-4 px-6">Department Identity / اسم القسم</th>
                                <th class="py-4 px-6">Code / الكود</th>
                                <th class="py-4 px-6">Description / الوصف</th>
                                <th class="py-4 px-6 text-center">Assigned Personnel / الموظفين</th>
                                <th class="py-4 px-6 text-center">Status / الحالة</th>
                                <th class="py-4 px-6 text-right" data-orderable="false">Actions / إجراءات</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                            @foreach (var d in deptsList)
                            {
                            <tr id="dept-row-@d.Id" class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30 transition-colors">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 dark:bg-sky-950/40 dark:text-sky-400 flex items-center justify-center font-black text-sm shadow-sm">
                                            <i class="fas fa-tags"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wide">@d.Name</p>
                                            <span class="text-[10px] font-mono text-slate-400">ID: #@d.Id</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    @if (!string.IsNullOrEmpty(d.Code))
                                    {
                                        <span class="text-xs font-mono font-bold text-sky-700 dark:text-sky-300 bg-sky-100 dark:bg-sky-900/50 px-2.5 py-1 rounded-lg border border-sky-200 dark:border-sky-800">
                                            @d.Code
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[11px] font-mono text-slate-400">--</span>
                                    }
                                </td>
                                <td class="py-4 px-6">
                                    <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 max-w-sm">
                                        @(string.IsNullOrWhiteSpace(d.Description) ? "--" : d.Description)
                                    </p>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    <button type="button" 
                                            onclick="openDeptPersonnelModal(@d.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(d.Name))', '@Html.Raw(JavaScriptEncoder.Default.Encode(d.Code ?? ""))', @d.AssignedPersonnelCount)" 
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold @(d.AssignedPersonnelCount > 0 ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200/60 hover:bg-emerald-100 hover:border-emerald-300 dark:hover:bg-emerald-900/40 hover:scale-105 active:scale-95 shadow-sm shadow-emerald-500/10 cursor-pointer" : "bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500 border border-slate-200 dark:border-slate-800 hover:bg-slate-200 cursor-pointer") transition-all"
                                            title="عرض الموظفين وتصدير إكسيل / View Assigned Personnel & Export Excel">
                                        <i class="fas fa-users text-[10px]"></i>
                                        <span>@d.AssignedPersonnelCount</span>
                                    </button>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    @if (d.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200/60">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (User.IsInRole("Admin") || HasSpecificPermission("edit"))
                                        {
                                            <button onclick="openDepartmentModal(@d.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(d.Name))', '@Html.Raw(JavaScriptEncoder.Default.Encode(d.Code ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(d.Description ?? ""))')" 
                                                    class="p-2 text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 rounded-lg hover:bg-sky-50 dark:hover:bg-sky-950/40 transition-colors" title="Edit Department / تعديل">
                                                <i class="fas fa-edit text-xs"></i>
                                            </button>
                                        }
                                        @if (User.IsInRole("Admin") || HasSpecificPermission("delete"))
                                        {
                                            <button onclick="deleteDepartment(@d.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(d.Name))', @d.AssignedPersonnelCount)" 
                                                    class="p-2 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Department / حذف">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add / Edit Department -->
<div id="deptModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-8 shadow-2xl relative animate-in fade-in zoom-in-95 duration-200">
        <button onclick="closeDepartmentModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
            <i class="fas fa-times text-lg"></i>
        </button>

        <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950/50 text-sky-600 flex items-center justify-center text-xl shadow-inner">
                <i class="fas fa-tags"></i>
            </div>
            <div>
                <h3 id="modalTitle" class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight">Add New Department</h3>
                <p class="text-xs text-slate-400 font-medium">تعريف القسم ورمزه المختصر ووصفه</p>
            </div>
        </div>

        <form id="deptForm" onsubmit="handleDepartmentSubmit(event)" class="space-y-5">
            <input type="hidden" id="deptId" value="0" />

            <!-- Department Name -->
            <div>
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Department Name / اسم القسم <span class="text-rose-500">*</span></label>
                <input type="text" id="deptName" required placeholder="e.g. Call Center, IT, Logistics, HR" 
                       class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-sky-500 transition-all" />
            </div>

            <!-- Department Code -->
            <div>
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Department Code / كود القسم (مختصر)</label>
                <input type="text" id="deptCode" placeholder="e.g. CC, IT, LOG, HR" 
                       class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-mono font-bold text-slate-800 dark:text-slate-200 outline-none focus:border-sky-500 transition-all" />
            </div>

            <!-- Description -->
            <div>
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Description / الوصف أو الملاحظات</label>
                <textarea id="deptDescription" rows="3" placeholder="ملاحظات توضيحية حول طبيعة عمل القسم..."
                          class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-xs font-medium text-slate-800 dark:text-slate-200 outline-none focus:border-sky-500 transition-all"></textarea>
            </div>

            <div class="pt-2 flex items-center justify-end gap-3">
                <button type="button" onclick="closeDepartmentModal()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">
                    إلغاء / Cancel
                </button>
                <button type="submit" id="btnSubmitDept" class="bg-sky-600 hover:bg-sky-700 text-white px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider shadow-lg shadow-sky-600/20 transition-all">
                    حفظ القسم / Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Assigned Personnel & Export -->
<div id="deptPersonnelModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-4xl w-full p-6 md:p-8 shadow-2xl relative animate-in fade-in zoom-in-95 duration-200 max-h-[90vh] flex flex-col">
        <!-- Close button -->
        <button onclick="closeDeptPersonnelModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
            <i class="fas fa-times text-base"></i>
        </button>

        <!-- Modal Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100 dark:border-slate-800 pr-10">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl shadow-inner border border-emerald-100 dark:border-emerald-800/40">
                    <i class="fas fa-users-viewfinder"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 id="deptPersonnelTitle" class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight">Assigned Personnel</h3>
                        <span id="deptPersonnelCodeBadge" class="text-xs font-mono font-bold text-sky-700 dark:text-sky-300 bg-sky-100 dark:bg-sky-900/50 px-2 py-0.5 rounded-md border border-sky-200 dark:border-sky-800"></span>
                    </div>
                    <p class="text-xs text-slate-400 font-medium mt-0.5">
                        <span id="deptPersonnelSubtitle">قائمة الموظفين المسجلين تحت هذا القسم</span>
                        <span class="mx-1">•</span>
                        <span id="deptPersonnelCountBadge" class="font-bold text-emerald-600 dark:text-emerald-400"></span>
                    </p>
                </div>
            </div>

            <!-- Export to Excel Button & Link -->
            <div class="flex items-center gap-2">
                <a id="btnExportDeptExcel" href="#" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg shadow-emerald-600/20 hover:shadow-emerald-600/30 transition-all hover:scale-[1.02] active:scale-95">
                    <i class="fas fa-file-excel text-sm"></i>
                    <span>Export Excel / تصدير إكسيل</span>
                </a>
                <a id="btnAllUsersFilter" href="#" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" title="Open in Personnel Registry / فتح في سجل الموظفين">
                    <i class="fas fa-external-link-alt text-xs"></i>
                </a>
            </div>
        </div>

        <!-- Filter & Search Bar -->
        <div class="py-4">
            <div class="relative">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="deptPersonnelSearch" oninput="filterDeptPersonnelTable()" placeholder="ابحث بالاسم، الكود، البريد، الفرع أو الشيفت..." 
                       class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl pl-10 pr-4 py-2.5 text-xs font-medium text-slate-800 dark:text-slate-200 outline-none focus:border-emerald-500 transition-all" />
            </div>
        </div>

        <!-- Personnel Table Body (Scrollable) -->
        <div class="flex-1 overflow-y-auto pr-1 -mr-1">
            <!-- Loading indicator -->
            <div id="deptPersonnelLoading" class="py-16 text-center text-slate-400">
                <i class="fas fa-circle-notch fa-spin text-3xl text-emerald-500 mb-3"></i>
                <p class="text-xs font-bold">جاري تحميل بيانات الموظفين...</p>
            </div>

            <!-- Empty State -->
            <div id="deptPersonnelEmpty" class="hidden py-16 text-center">
                <div class="w-16 h-16 rounded-3xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-3">
                    <i class="fas fa-user-slash"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300">لا يوجد موظفين مسجلين</h4>
                <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">هذا القسم لا يحتوي على أي موظف معين حالياً. يمكنك تحديث بيانات الموظفين وتعيينهم لهذا القسم عبر شيت الإكسيل.</p>
            </div>

            <!-- Table Container -->
            <div id="deptPersonnelTableContainer" class="hidden border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 text-[10px] font-black uppercase tracking-wider text-slate-400">
                            <th class="py-3 px-4">Employee / الموظف</th>
                            <th class="py-3 px-3 text-center">Code / الكود</th>
                            <th class="py-3 px-4">Branch / الفرع</th>
                            <th class="py-3 px-3">Shift / الشيفت</th>
                            <th class="py-3 px-3 text-center">Role / الصلاحية</th>
                            <th class="py-3 px-3 text-center">Status / الحالة</th>
                        </tr>
                    </thead>
                    <tbody id="deptPersonnelTbody" class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                        <!-- Rendered via JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="pt-4 mt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-400 font-medium">
            <span id="deptPersonnelFilteredCount"></span>
            <button type="button" onclick="closeDeptPersonnelModal()" class="px-5 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl transition-colors">
                إغلاق / Close
            </button>
        </div>
    </div>
</div>

<script>
    let currentDeptPersonnel = [];

    async function openDeptPersonnelModal(id, name, code, assignedCount) {
        document.getElementById('deptPersonnelTitle').textContent = name;
        const codeBadge = document.getElementById('deptPersonnelCodeBadge');
        if (code && code.trim().length > 0) {
            codeBadge.textContent = code;
            codeBadge.classList.remove('hidden');
        } else {
            codeBadge.classList.add('hidden');
        }

        document.getElementById('deptPersonnelCountBadge').textContent = `${assignedCount} Assigned`;
        document.getElementById('btnExportDeptExcel').href = `/Admin/ExportDepartmentPersonnelToExcel?id=${id}`;
        document.getElementById('btnAllUsersFilter').href = `/Admin/AllUsers?departmentId=${id}`;
        document.getElementById('deptPersonnelSearch').value = '';

        const modal = document.getElementById('deptPersonnelModal');
        const loading = document.getElementById('deptPersonnelLoading');
        const empty = document.getElementById('deptPersonnelEmpty');
        const tableContainer = document.getElementById('deptPersonnelTableContainer');
        const tbody = document.getElementById('deptPersonnelTbody');
        const filteredCount = document.getElementById('deptPersonnelFilteredCount');

        modal.classList.remove('hidden');
        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        tableContainer.classList.add('hidden');
        tbody.innerHTML = '';
        filteredCount.textContent = '';

        try {
            const res = await fetch(`/Admin/GetDepartmentPersonnel?id=${id}`);
            const data = await res.json();

            loading.classList.add('hidden');

            if (!data.success) {
                Swal.fire('خطأ', data.message || 'فشل جلب بيانات الموظفين.', 'error');
                closeDeptPersonnelModal();
                return;
            }

            currentDeptPersonnel = data.personnel || [];

            if (currentDeptPersonnel.length === 0) {
                empty.classList.remove('hidden');
                tableContainer.classList.add('hidden');
                filteredCount.textContent = '0 employees found';
                return;
            }

            renderDeptPersonnelRows(currentDeptPersonnel);
            tableContainer.classList.remove('hidden');
            filteredCount.textContent = `Showing ${currentDeptPersonnel.length} of ${currentDeptPersonnel.length} employees`;

        } catch (err) {
            loading.classList.add('hidden');
            Swal.fire('خطأ', 'حدث خطأ في الاتصال: ' + err.message, 'error');
            closeDeptPersonnelModal();
        }
    }

    function closeDeptPersonnelModal() {
        document.getElementById('deptPersonnelModal').classList.add('hidden');
    }

    function renderDeptPersonnelRows(list) {
        const tbody = document.getElementById('deptPersonnelTbody');
        tbody.innerHTML = '';

        if (list.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400 font-medium">لا توجد نتائج مطابقة لبحثك.</td></tr>`;
            return;
        }

        list.forEach(p => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors';

            const initial = (p.fullName || 'U').charAt(0).toUpperCase();

            tr.innerHTML = `
                <td class="py-3 px-4">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 font-black text-xs flex items-center justify-center shrink-0 border border-sky-200 dark:border-sky-800">
                            ${initial}
                        </div>
                        <div class="min-w-0">
                            <div class="font-bold text-slate-800 dark:text-slate-100 truncate">${escapeHtml(p.fullName)}</div>
                            <div class="text-[11px] text-slate-400 truncate">${escapeHtml(p.email)}</div>
                        </div>
                    </div>
                </td>
                <td class="py-3 px-3 text-center">
                    <span class="inline-block font-mono text-[11px] font-bold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-700">
                        ${escapeHtml(p.userCode || '--')}
                    </span>
                </td>
                <td class="py-3 px-4">
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                        <i class="fas fa-building text-[10px] text-slate-400"></i>
                        <span>${escapeHtml(p.branchName || 'Unassigned')}</span>
                    </span>
                </td>
                <td class="py-3 px-3">
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                        <i class="fas fa-clock text-[10px] text-slate-400"></i>
                        <span>${escapeHtml(p.shiftName || 'Unassigned')}</span>
                    </span>
                </td>
                <td class="py-3 px-3 text-center">
                    <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/40 px-2 py-0.5 rounded-full border border-sky-200/60 dark:border-sky-800">
                        ${escapeHtml(p.roleName || 'Trainee')}
                    </span>
                </td>
                <td class="py-3 px-3 text-center">
                    ${p.isActive ? `
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200/60">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                        </span>
                    ` : `
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Inactive
                        </span>
                    `}
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function filterDeptPersonnelTable() {
        const q = (document.getElementById('deptPersonnelSearch').value || '').trim().toLowerCase();
        if (!q) {
            renderDeptPersonnelRows(currentDeptPersonnel);
            document.getElementById('deptPersonnelFilteredCount').textContent = `Showing ${currentDeptPersonnel.length} of ${currentDeptPersonnel.length} employees`;
            return;
        }

        const filtered = currentDeptPersonnel.filter(p => {
            return (p.fullName && p.fullName.toLowerCase().includes(q)) ||
                   (p.userCode && p.userCode.toLowerCase().includes(q)) ||
                   (p.email && p.email.toLowerCase().includes(q)) ||
                   (p.phoneNumber && p.phoneNumber.toLowerCase().includes(q)) ||
                   (p.branchName && p.branchName.toLowerCase().includes(q)) ||
                   (p.shiftName && p.shiftName.toLowerCase().includes(q)) ||
                   (p.roleName && p.roleName.toLowerCase().includes(q));
        });

        renderDeptPersonnelRows(filtered);
        document.getElementById('deptPersonnelFilteredCount').textContent = `Showing ${filtered.length} of ${currentDeptPersonnel.length} employees`;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
    function openDepartmentModal(id, name = '', code = '', description = '') {
        document.getElementById('deptId').value = id;
        document.getElementById('modalTitle').textContent = id > 0 ? 'Edit Department / تعديل القسم' : 'Add New Department / إضافة قسم جديد';
        document.getElementById('deptName').value = name;
        document.getElementById('deptCode').value = code;
        document.getElementById('deptDescription').value = description;
        document.getElementById('deptModal').classList.remove('hidden');
    }

    function closeDepartmentModal() {
        document.getElementById('deptModal').classList.add('hidden');
    }

    async function handleDepartmentSubmit(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('deptId').value, 10);
        const name = document.getElementById('deptName').value.trim();
        const code = document.getElementById('deptCode').value.trim();
        const description = document.getElementById('deptDescription').value.trim();
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const formData = new FormData();
        formData.append('id', id);
        formData.append('name', name);
        formData.append('code', code);
        formData.append('description', description);
        formData.append('__RequestVerificationToken', token);

        const btn = document.getElementById('btnSubmitDept');
        btn.disabled = true;
        btn.textContent = 'Saving...';

        try {
            const res = await fetch('/Admin/SaveDepartment', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'تم بنجاح',
                    text: data.message,
                    timer: 1800,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('خطأ', data.message || 'فشل حفظ القسم.', 'error');
                btn.disabled = false;
                btn.textContent = 'حفظ القسم / Save';
            }
        } catch (err) {
            Swal.fire('خطأ', 'حدث خطأ في الاتصال: ' + err.message, 'error');
            btn.disabled = false;
            btn.textContent = 'حفظ القسم / Save';
        }
    }

    async function deleteDepartment(id, name, assignedCount) {
        if (assignedCount > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'لا يمكن حذف القسم',
                text: `لا يمكن حذف القسم "${name}" لأن هناك ${assignedCount} موظف مسجلين عليه حالياً. يرجى نقلهم لقسم آخر أولاً.`,
                confirmButtonText: 'حسناً'
            });
            return;
        }

        const confirmRes = await Swal.fire({
            title: `حذف قسم "${name}"؟`,
            text: 'هل أنت متأكد من حذف هذا القسم؟ لا يمكن التراجع عن هذا الإجراء.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'نعم، احذف',
            cancelButtonText: 'إلغاء'
        });

        if (!confirmRes.isConfirmed) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        try {
            const res = await fetch('/Admin/DeleteDepartment', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'تم الحذف بنجاح',
                    timer: 1500,
                    showConfirmButton: false
                });
                const row = document.getElementById('dept-row-' + id);
                if (row) {
                    if ($.fn.DataTable.isDataTable('#departmentsTable')) {
                        $('#departmentsTable').DataTable().row(row).remove().draw(false);
                    } else {
                        row.remove();
                    }
                }
            } else {
                Swal.fire('خطأ', data.message || 'فشل حذف القسم.', 'error');
            }
        } catch (err) {
            Swal.fire('خطأ', 'حدث خطأ في الاتصال بالسيرفر: ' + err.message, 'error');
        }
    }
</script>
