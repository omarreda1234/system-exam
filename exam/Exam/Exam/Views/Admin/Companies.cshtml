@section Scripts {
    <script>
        // Modal management for Add / Edit Company
        function openAddCompanyModal() {
            $('#addCompanyForm')[0].reset();
            $('#addCompVisibleOnHome').prop('checked', true);
            $('#addLogoPreview').addClass('hidden').attr('src', '');
            $('#addLogoPlaceholder').removeClass('hidden');
            $('#addCoverPreview').addClass('hidden').attr('src', '');
            $('#addCoverPlaceholder').removeClass('hidden');
            $('#addCompanyModal').removeClass('hidden').addClass('flex');
        }

        function closeAddCompanyModal() {
            $('#addCompanyModal').removeClass('flex').addClass('hidden');
        }

        function previewAddLogo(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#addLogoPreview').attr('src', e.target.result).removeClass('hidden');
                    $('#addLogoPlaceholder').addClass('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewAddCover(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#addCoverPreview').attr('src', e.target.result).removeClass('hidden');
                    $('#addCoverPlaceholder').addClass('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function submitAddCompany() {
            const name = $('#addCompName').val().trim();
            if (!name) return;

            const btn = $('#btnAddCompSubmit');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            const formData = new FormData();
            formData.append('name', name);
            formData.append('companyType', $('#addCompType').val());
            formData.append('tagline', $('#addCompTagline').val());
            formData.append('email', $('#addCompEmail').val());
            formData.append('contactPerson', $('#addCompContact').val());
            formData.append('phone', $('#addCompPhone').val());
            formData.append('website', $('#addCompWebsite').val());
            formData.append('description', $('#addCompDesc').val());
            formData.append('isVisibleOnHome', $('#addCompVisibleOnHome').is(':checked'));
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            const logoFile = document.getElementById('addLogoFile').files[0];
            if (logoFile) {
                formData.append('logoFile', logoFile);
            }

            const coverFile = document.getElementById('addCoverFile').files[0];
            if (coverFile) {
                formData.append('coverFile', coverFile);
            }

            try {
                const res = await fetch('@Url.Action("AddCompany", "Admin")', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Company Registered', text: data.message, timer: 1500, showConfirmButton: false }).then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Registration Failed', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Server communication failed.' });
            } finally {
                btn.prop('disabled', false).text('Register Company');
            }
        }

        function openEditCompanyModal(id, name, desc, tagline, type, website, phone, email, contact, logo, coverUrl, isVisibleOnHome) {
            $('#editCompId').val(id);
            $('#editCompName').val(name);
            $('#editCompDesc').val(desc);
            $('#editCompTagline').val(tagline || '');
            $('#editCompType').val(type || 'Medical');
            $('#editCompWebsite').val(website || '');
            $('#editCompPhone').val(phone || '');
            $('#editCompEmail').val(email || '');
            $('#editCompContact').val(contact || '');
            $('#editCompVisibleOnHome').prop('checked', isVisibleOnHome === true || isVisibleOnHome === 'true' || isVisibleOnHome === undefined);

            if (logo) {
                $('#editLogoPreview').attr('src', logo).removeClass('hidden');
                $('#editLogoPlaceholder').addClass('hidden');
            } else {
                $('#editLogoPreview').addClass('hidden').attr('src', '');
                $('#editLogoPlaceholder').removeClass('hidden');
            }

            if (coverUrl) {
                $('#editCoverPreview').attr('src', coverUrl).removeClass('hidden');
                $('#editCoverPlaceholder').addClass('hidden');
            } else {
                $('#editCoverPreview').addClass('hidden').attr('src', '');
                $('#editCoverPlaceholder').removeClass('hidden');
            }

            $('#editCompanyModal').removeClass('hidden').addClass('flex');
        }

        function closeEditCompanyModal() {
            $('#editCompanyModal').removeClass('flex').addClass('hidden');
        }

        function previewEditLogo(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#editLogoPreview').attr('src', e.target.result).removeClass('hidden');
                    $('#editLogoPlaceholder').addClass('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewEditCover(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#editCoverPreview').attr('src', e.target.result).removeClass('hidden');
                    $('#editCoverPlaceholder').addClass('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function submitEditCompany() {
            const id = $('#editCompId').val();
            const name = $('#editCompName').val().trim();
            if (!name) return;

            const btn = $('#btnEditCompSubmit');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            const formData = new FormData();
            formData.append('id', id);
            formData.append('name', name);
            formData.append('companyType', $('#editCompType').val());
            formData.append('tagline', $('#editCompTagline').val());
            formData.append('email', $('#editCompEmail').val());
            formData.append('contactPerson', $('#editCompContact').val());
            formData.append('phone', $('#editCompPhone').val());
            formData.append('website', $('#editCompWebsite').val());
            formData.append('description', $('#editCompDesc').val());
            formData.append('isVisibleOnHome', $('#editCompVisibleOnHome').is(':checked'));
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            const logoFile = document.getElementById('editLogoFile').files[0];
            if (logoFile) {
                formData.append('logoFile', logoFile);
            }

            const coverFile = document.getElementById('editCoverFile').files[0];
            if (coverFile) {
                formData.append('coverFile', coverFile);
            }

            try {
                const res = await fetch('@Url.Action("EditCompany", "Admin")', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Changes Saved', text: data.message, timer: 1500, showConfirmButton: false }).then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Update Failed', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Server communication failed.' });
            } finally {
                btn.prop('disabled', false).text('Save Changes');
            }
        }

        async function toggleCompanyHomeVisibility(companyId, isVisible) {
            const statusBadge = $(`#visStatus-${companyId}`);
            const token = $('input[name="__RequestVerificationToken"]').val();

            try {
                const formData = new FormData();
                formData.append('id', companyId);
                formData.append('isVisible', isVisible);
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('@Url.Action("ToggleCompanyHomeVisibility", "Admin")', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    if (isVisible) {
                        statusBadge.removeClass('bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500 border-slate-200 dark:border-slate-700')
                                   .addClass('bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border-emerald-200/60 dark:border-emerald-800/40')
                                   .text('Visible');
                    } else {
                        statusBadge.removeClass('bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border-emerald-200/60 dark:border-emerald-800/40')
                                   .addClass('bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500 border-slate-200 dark:border-slate-700')
                                   .text('Hidden');
                    }

                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true
                    });
                    Toast.fire({
