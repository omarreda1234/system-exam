        function openAddProductModal() {
            $('#productEditForm')[0].reset();
            $('#prodFormId').val('0');
            $('#prodFormCompanyId').val(currentActiveCompanyId);
            $('#prodEditModalTitle').html('<i class="fas fa-pills text-teal-600"></i> <span>Add Contracted Product</span>');
            $('#prodImgPreview').addClass('hidden').attr('src', '');
            $('#prodImgPlaceholder').removeClass('hidden');
            $('#productEditModal').removeClass('hidden').addClass('flex');
        }

        function editProductItem(id) {
            const p = activeCompanyProducts.find(x => x.id === id);
            if (!p) return;

            $('#prodFormId').val(p.id);
            $('#prodFormCompanyId').val(p.companyId);
            $('#prodFormName').val(p.productName);
            $('#prodFormGeneric').val(p.genericName || '');
            $('#prodFormCategory').val(p.category || 'Pharmaceutical');
            $('#prodFormDosage').val(p.dosageForm || '');
            $('#prodFormPrice').val(p.price || '');
            $('#prodFormDesc').val(p.description || '');

            if (p.imageUrl) {
                $('#prodImgPreview').attr('src', p.imageUrl).removeClass('hidden');
                $('#prodImgPlaceholder').addClass('hidden');
            } else {
                $('#prodImgPreview').addClass('hidden').attr('src', '');
                $('#prodImgPlaceholder').removeClass('hidden');
            }

            $('#prodEditModalTitle').html('<i class="fas fa-edit text-teal-600"></i> <span>Edit Product Details</span>');
            $('#productEditModal').removeClass('hidden').addClass('flex');
        }

        function closeProductEditModal() {
            $('#productEditModal').removeClass('flex').addClass('hidden');
        }

        function previewProductImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#prodImgPreview').attr('src', e.target.result).removeClass('hidden');
                    $('#prodImgPlaceholder').addClass('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function submitProductForm() {
            const name = $('#prodFormName').val().trim();
            if (!name) return;

            const btn = $('#btnProductSaveSubmit');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            const formData = new FormData();
            formData.append('Id', $('#prodFormId').val());
            formData.append('CompanyId', $('#prodFormCompanyId').val());
            formData.append('ProductName', name);
            formData.append('GenericName', $('#prodFormGeneric').val());
            formData.append('Category', $('#prodFormCategory').val());
            formData.append('DosageForm', $('#prodFormDosage').val());
            formData.append('Price', $('#prodFormPrice').val());
            formData.append('Description', $('#prodFormDesc').val());
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            const file = document.getElementById('prodFormImageFile').files[0];
            if (file) {
                formData.append('productImage', file);
            }

            try {
                const res = await fetch('@Url.Action("SaveCompanyProduct", "Admin")', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    closeProductEditModal();
                    await loadCompanyProducts(currentActiveCompanyId);
                    showProfessionalToast('fas fa-check-circle', data.message, 'success');
                } else {
                    Swal.fire({ icon: 'error', title: 'Save Failed', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to save product details.' });
            } finally {
                btn.prop('disabled', false).text('Save Product');
            }
        }

        async function deleteProductItem(id) {
            const { isConfirmed } = await Swal.fire({
                title: 'Delete this product?',
                text: 'This medication/item will be permanently removed from the company formulary.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                customClass: {
                    confirmButton: 'bg-rose-600 hover:bg-rose-700 text-white px-6 py-2.5 rounded-xl font-bold text-xs',
                    cancelButton: 'text-slate-500 font-bold text-xs px-6 py-2.5'
                },
                buttonsStyling: false
            });

            if (!isConfirmed) return;

            try {
                const res = await fetch('@Url.Action("DeleteCompanyProduct", "Admin")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: `id=${id}`
                });
                const data = await res.json();
                if (data.success) {
                    await loadCompanyProducts(currentActiveCompanyId);
                    showProfessionalToast('fas fa-check-circle', data.message, 'success');
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to delete product.' });
            }
        }

