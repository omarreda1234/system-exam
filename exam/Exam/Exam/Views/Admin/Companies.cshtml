@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Company Training Portfolios";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="min-h-screen pb-20 bg-slate-50/50 dark:bg-slate-950/20">
    <!-- Main Premium Header -->
    <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-24 pb-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight flex items-center gap-3">
                        <i class="fas fa-building text-brand-600"></i>
                        <span>Partner Companies & Portfolios</span>
                    </h1>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mt-1">Manage partner companies, contracted formulary products, corporate profiles, and training quotas</p>
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Human Resources"))
                {
                    <div class="flex items-center gap-3">
                        <button onclick="openAddCompanyModal()" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-lg shadow-brand-600/20 flex items-center gap-2 group">
                            <i class="fas fa-plus text-xs group-hover:rotate-90 transition-transform"></i>
                            Register Partner Company
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 mt-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Active Companies List</span>
                    <span class="text-xs font-bold text-slate-500">(@Model.Count() Partner Companies)</span>
                </div>
            </div>
            
            <div class="overflow-x-auto w-full">
                <table class="saas-table datatable">
                <thead>
                    <tr>
                        <th>Company & Logo</th>
                        <th>Classification</th>
                        <th>Show on Home</th>
                        <th>Contracted Products</th>
                        <th>Trainees & Sessions</th>
                        <th>Created Date</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comp in Model)
                    {
                        string cType = comp.CompanyType ?? "Medical";
                        string logo = comp.LogoUrl ?? "";
                        string cover = comp.CoverImageUrl ?? "";
                        string tagline = comp.Tagline ?? "";
                        string email = comp.Email ?? "";
                        bool isVisibleOnHome = true;
                        try { isVisibleOnHome = Convert.ToBoolean(comp.IsVisibleOnHome); } catch { }
                        int prodCount = 0;
                        try { prodCount = Convert.ToInt32(comp.ProductCount); } catch { }
                        int traineeCount = 0;
                        try { traineeCount = Convert.ToInt32(comp.TraineeCount); } catch { }
                        int sessionCount = 0;
                        try { sessionCount = Convert.ToInt32(comp.SessionCount); } catch { }

                        <tr id="row-@comp.Id">
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-1 flex items-center justify-center font-black text-brand-600 text-xs uppercase shadow-sm shrink-0 overflow-hidden">
                                        @if (!string.IsNullOrEmpty(logo))
                                        {
                                            <img src="@logo" alt="@comp.Name" class="w-full h-full object-contain rounded-xl" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <span style="display:none;" class="w-full h-full flex items-center justify-center font-black text-brand-600">@(comp.Name?[0].ToString() ?? "C")</span>
                                        }
                                        else
                                        {
                                            <span class="w-full h-full flex items-center justify-center font-black text-brand-600">@(comp.Name?[0].ToString() ?? "C")</span>
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2">
                                            <p class="font-black text-slate-900 dark:text-white uppercase text-xs truncate max-w-[200px]">@comp.Name</p>
                                        </div>
                                        @if (!string.IsNullOrEmpty(tagline))
                                        {
                                            <p class="text-[10px] font-bold text-brand-600 dark:text-brand-400 truncate max-w-[240px]">@tagline</p>
                                        }
                                        <p class="text-[11px] text-slate-400 truncate max-w-[240px]">@(string.IsNullOrEmpty(comp.Description) ? "No description provided." : comp.Description)</p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (cType.Equals("Cosmetics", StringComparison.OrdinalIgnoreCase) || cType.Contains("كوزم"))
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-fuchsia-50 text-fuchsia-600 border border-fuchsia-200 dark:bg-fuchsia-950/40 dark:text-fuchsia-300 inline-flex items-center gap-1.5 shadow-sm">
                                        <i class="fas fa-sparkles text-[9px]"></i> Cosmetics
                                    </span>
                                }
                                else if (cType.Equals("Hybrid", StringComparison.OrdinalIgnoreCase) || cType.Contains("هيبريد"))
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 inline-flex items-center gap-1.5 shadow-sm">
                                        <i class="fas fa-layer-group text-[9px]"></i> Hybrid
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-blue-50 text-blue-600 border border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 inline-flex items-center gap-1.5 shadow-sm">
                                        <i class="fas fa-pills text-[9px]"></i> Medical
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-2.5">
                                    <label class="relative inline-flex items-center cursor-pointer select-none" title="Toggle visibility on homepage animated ticker">
                                        <input type="checkbox" id="homeVisToggle-@comp.Id" class="sr-only peer" @(isVisibleOnHome ? "checked" : "") onchange="toggleCompanyHomeVisibility(@comp.Id, this.checked)" />
                                        <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:bg-emerald-500"></div>
                                    </label>
                                    <span id="visStatus-@comp.Id" class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md @(isVisibleOnHome ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40" : "bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500 border border-slate-200 dark:border-slate-700")">
                                        @(isVisibleOnHome ? "Visible" : "Hidden")
                                    </span>
                                </div>
                            </td>
                            <td>
                                <button type="button" onclick="openCompanyProductsModal(@comp.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.Name))', '@logo')" 
                                        class="px-3 py-1.5 rounded-xl bg-teal-50 dark:bg-teal-950/40 text-teal-700 dark:text-teal-300 hover:bg-teal-100 border border-teal-200 dark:border-teal-800 text-xs font-black transition-all flex items-center gap-1.5 shadow-sm active:scale-95 group">
                                    <i class="fas fa-capsules text-teal-600 group-hover:scale-110 transition-transform"></i>
                                    <span>@prodCount Products</span>
                                </button>
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[10px] font-bold" title="Sessions">
                                        <i class="far fa-calendar-alt text-brand-600 mr-1"></i> @sessionCount Sessions
                                    </span>
                                    <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[10px] font-bold" title="Trainees">
                                        <i class="fas fa-users text-indigo-500 mr-1"></i> @traineeCount Trainees
                                    </span>
                                </div>
                            </td>
                            <td class="whitespace-nowrap">
                                <span class="text-xs font-medium text-slate-500 uppercase">@comp.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="text-right">
                                <div class="flex flex-wrap md:flex-nowrap items-center justify-end gap-1.5">
                                    <a href="@Url.Action("CompanyProfile", "Home", new { id = comp.Id })" target="_blank" class="bg-sky-50 text-sky-600 hover:bg-sky-600 hover:text-white px-2.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all shadow-sm flex items-center gap-1 shrink-0 border border-sky-200 dark:border-sky-900/30" title="View Public Profile">
                                        <i class="fas fa-external-link-alt"></i> Profile
                                    </a>

                                    <button type="button" onclick="openCompanyProductsModal(@comp.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.Name))', '@logo')" 
                                            class="bg-teal-600 hover:bg-teal-700 text-white px-3 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all shadow-sm flex items-center gap-1 shrink-0" title="Manage Contracted Products">
                                        <i class="fas fa-capsules"></i> Products
                                    </button>

                                    <a href="@Url.Action("ManageSessions", "Attendance", new { companyId = comp.Id })" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-xl transition-all shadow-md shadow-indigo-600/20 text-[10px] font-black uppercase tracking-wider flex items-center gap-1 shrink-0">
                                        <i class="fas fa-calendar-alt"></i> Sessions
                                    </a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Human Resources"))
                                    {
                                        <button onclick="openEditCompanyModal(@comp.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.Name))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.Description ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(tagline))', '@cType', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.Website ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.Phone ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(email))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(comp.ContactPerson ?? ""))', '@logo', '@cover', @(isVisibleOnHome ? "true" : "false"))" 
                                                class="bg-amber-50 text-amber-600 hover:bg-amber-600 hover:text-white px-2.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all shrink-0 border border-amber-100 dark:border-amber-900/30" title="Edit Company Settings">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button onclick="deleteCompany(@comp.Id, '@comp.Name')" class="bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white px-2.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all shrink-0 border border-rose-100 dark:border-rose-900/30" title="Delete Company">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

            @if (!Model.Any())
            {
                <div class="p-20 text-center">
                    <div class="w-20 h-20 bg-slate-50 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-6 text-slate-300">
                        <i class="fas fa-building text-3xl"></i>
                    </div>
                    <p class="text-slate-400 font-bold uppercase text-[10px] tracking-widest">No company portfolios registered currently.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Add Company -->
<div id="addCompanyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] w-full max-w-2xl max-h-[92vh] flex flex-col overflow-hidden shadow-2xl">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-brand-50 dark:bg-brand-950/50 text-brand-600 flex items-center justify-center font-black">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white uppercase">Register Partner Company</h3>
                    <p class="text-xs text-slate-400">Configure corporate identity, branding assets, contact info, and formulary specifications</p>
                </div>
            </div>
            <button type="button" onclick="closeAddCompanyModal()" class="text-slate-400 hover:text-slate-600 text-lg">&times;</button>
        </div>

        <form id="addCompanyForm" onsubmit="event.preventDefault(); submitAddCompany();" class="p-6 overflow-y-auto space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Company Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="addCompName" required placeholder="e.g. Pharco, Eva Pharma, L'Oréal, GSK, Sandoz..." class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white" />
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Tagline / Corporate Slogan</label>
                    <input type="text" id="addCompTagline" placeholder="e.g. Elevating Health. Reaching Millions. Every Day." class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white" />
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Classification <span class="text-rose-500">*</span></label>
                    <select id="addCompType" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white">
                        <option value="Medical">🔵 Medical (Pharmaceuticals & Therapeutics)</option>
                        <option value="Cosmetics">🟣 Cosmetics (Skincare & Cosmeceuticals)</option>
                        <option value="Hybrid">🟢 Hybrid (Medical & Cosmeceutical)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Contact Email</label>
                    <input type="email" id="addCompEmail" placeholder="e.g. corporate@company.com" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white" />
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Key Account Manager</label>
                    <input type="text" id="addCompContact" placeholder="e.g. Dr. Ahmed Samir" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white" />
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Contact Phone</label>
                    <input type="text" id="addCompPhone" placeholder="e.g. +20 10xxxxxxxx" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white" />
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Official Website URL</label>
                    <input type="text" id="addCompWebsite" placeholder="e.g. https://company.com" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white" />
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Company Logo (SVG / PNG)</label>
                    <div class="flex items-center gap-3">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center overflow-hidden shrink-0" id="addLogoPreviewWrapper">
                            <i class="fas fa-image text-slate-400 text-lg" id="addLogoPlaceholder"></i>
                            <img id="addLogoPreview" class="hidden w-full h-full object-contain p-1" />
                        </div>
                        <input type="file" id="addLogoFile" accept="image/*" onchange="previewAddLogo(this)" class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-[11px] file:font-black file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 cursor-pointer" />
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Hero Cover Banner Image</label>
                    <div class="flex items-center gap-3">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center overflow-hidden shrink-0" id="addCoverPreviewWrapper">
                            <i class="fas fa-panorama text-slate-400 text-lg" id="addCoverPlaceholder"></i>
                            <img id="addCoverPreview" class="hidden w-full h-full object-cover" />
                        </div>
                        <input type="file" id="addCoverFile" accept="image/*" onchange="previewAddCover(this)" class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-[11px] file:font-black file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 cursor-pointer" />
                    </div>
                </div>

                <div class="sm:col-span-2 p-3.5 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200 dark:border-slate-700/80 flex items-center justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-black text-slate-800 dark:text-white uppercase tracking-wider">Show on Homepage Ticker</span>
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400 uppercase">Live Display</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-0.5">When enabled, this company's logo is featured in the animated marquee ticker on the public home page.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer select-none shrink-0">
                        <input type="checkbox" id="addCompVisibleOnHome" checked class="sr-only peer" />
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-emerald-500"></div>
                    </label>
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Corporate Overview & Collaboration Scope</label>
                    <textarea id="addCompDesc" rows="3" placeholder="Enter company background, therapeutic research lines, and partnership scope..." class="w-full px-4 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 dark:text-white"></textarea>
                </div>
            </div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeAddCompanyModal()" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300">Cancel</button>
                <button type="submit" id="btnAddCompSubmit" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs uppercase shadow-md shadow-brand-600/20">Register Company</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Edit Company -->
<div id="editCompanyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] w-full max-w-2xl max-h-[92vh] flex flex-col overflow-hidden shadow-2xl">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 flex items-center justify-center font-black">
                    <i class="fas fa-edit"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white uppercase">Edit Company Profile & Settings</h3>
                    <p class="text-xs text-slate-400">Update corporate branding, cover banner, contact details, and classification</p>
                </div>
            </div>
            <button type="button" onclick="closeEditCompanyModal()" class="text-slate-400 hover:text-slate-600 text-lg">&times;</button>
        </div>

        <form id="editCompanyForm" onsubmit="event.preventDefault(); submitEditCompany();" class="p-6 overflow-y-auto space-y-4">
            <input type="hidden" id="editCompId" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Company Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="editCompName" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-amber-500 text-slate-900 dark:text-white" />
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Tagline / Corporate Slogan</label>
                    <input type="text" id="editCompTagline" placeholder="e.g. Elevating Health. Reaching Millions. Every Day." class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-amber-500 text-slate-900 dark:text-white" />
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-widest mb-1">Classification <span class="text-rose-500">*</span></label>
