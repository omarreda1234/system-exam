                        <p class="text-xs text-slate-400 mt-1">Click "+ Add Product / Medication" to register formulary items and packaging photos.</p>
                    </div>
                `);
                return;
            }

            let html = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
            list.forEach(p => {
                const imgHtml = p.imageUrl 
                    ? `<img src="${p.imageUrl}" class="w-full h-full object-contain p-1" />` 
                    : `<i class="fas fa-pills text-teal-600 text-xl"></i>`;

                html += `
                    <div class="bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/80 rounded-2xl p-4 flex gap-4 hover:border-teal-500/40 transition-all shadow-sm group">
                        <div class="w-20 h-20 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center shrink-0 overflow-hidden shadow-inner">
