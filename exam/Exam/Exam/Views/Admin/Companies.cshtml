                        </div>
                        <div class="flex-1 min-w-0 flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="font-black text-slate-900 dark:text-white text-sm truncate">${p.productName}</h4>
                                    ${p.price ? `<span class="px-2 py-0.5 rounded-lg bg-emerald-50 text-emerald-600 font-mono font-black text-xs shrink-0">${p.price} EGP</span>` : ''}
                                </div>
                                ${p.genericName ? `<p class="text-[11px] font-bold text-teal-600 dark:text-teal-400 truncate mt-0.5"><i class="fas fa-atom text-[9px] mr-1"></i>${p.genericName}</p>` : ''}
                                <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
                                    ${p.category ? `<span class="px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-[9px] font-bold">${p.category}</span>` : ''}
                                    ${p.dosageForm ? `<span class="px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 text-[9px] font-bold">${p.dosageForm}</span>` : ''}
                                </div>
                                ${p.description ? `<p class="text-[10px] text-slate-500 line-clamp-2 mt-1.5">${p.description}</p>` : ''}
                            </div>
                            <div class="flex items-center justify-between pt-2 border-t border-slate-200/60 dark:border-slate-700/60 mt-2">
                                <span class="text-[9px] text-slate-400">${new Date(p.createdAt).toLocaleDateString('en-GB')}</span>
                                <div class="flex items-center gap-1.5">
                                    <button onclick="editProductItem(${p.id})" class="text-[10px] font-bold text-amber-600 hover:text-amber-700 px-2 py-1 rounded-lg hover:bg-amber-50 transition-colors">
                                        <i class="fas fa-edit mr-0.5"></i> Edit
