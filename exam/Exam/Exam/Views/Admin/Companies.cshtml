        async function openCompanyProductsModal(compId, compName, compLogo) {
            currentActiveCompanyId = compId;
            $('#prodModalCompanyName').text(compName);
            $('#prodFormCompanyId').val(compId);

            if (compLogo) {
                $('#prodModalCompanyLogoWrapper').html(`<img src="${compLogo}" class="w-full h-full object-contain p-1" />`);
            } else {
                $('#prodModalCompanyLogoWrapper').html('<i class="fas fa-capsules"></i>');
            }

            $('#companyProductsModal').removeClass('hidden').addClass('flex');
            await loadCompanyProducts(compId);
        }

        function closeCompanyProductsModal() {
            $('#companyProductsModal').removeClass('flex').addClass('hidden');
        }

        async function loadCompanyProducts(compId) {
            const container = $('#productsListContainer');
            container.html('<div class="p-12 text-center text-slate-400"><i class="fas fa-spinner fa-spin text-3xl text-teal-600 mb-2"></i><p class="font-bold">Loading contracted products portfolio...</p></div>');

            try {
                const res = await fetch(`/Admin/GetCompanyProducts?companyId=${compId}`);
                const data = await res.json();
                if (data.success) {
                    activeCompanyProducts = data.data || [];
                    renderCompanyProducts(activeCompanyProducts);
                } else {
                    container.html(`<div class="p-8 text-center text-rose-500 font-bold">${data.message}</div>`);
                }
            } catch (err) {
                container.html('<div class="p-8 text-center text-rose-500 font-bold">Failed to load company products catalog.</div>');
            }
        }

        function filterProductsList(term) {
            term = (term || '').toLowerCase().trim();
            if (!term) {
                renderCompanyProducts(activeCompanyProducts);
                return;
            }
            const filtered = activeCompanyProducts.filter(p => 
                (p.productName || '').toLowerCase().includes(term) ||
                (p.genericName || '').toLowerCase().includes(term) ||
                (p.category || '').toLowerCase().includes(term) ||
                (p.dosageForm || '').toLowerCase().includes(term) ||
                (p.description || '').toLowerCase().includes(term)
            );
            renderCompanyProducts(filtered);
        }

        function renderCompanyProducts(list) {
            const container = $('#productsListContainer');
            $('#prodCountBadge').text(`${list.length} Products`);

            if (list.length === 0) {
                container.html(`
                    <div class="p-16 text-center text-slate-400">
                        <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-300">
