@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Nomination & Approvals Audit History";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var stats = ViewBag.Stats;
    var branches = ViewBag.Branches as List<string> ?? new List<string>();
    int totalCount = ViewBag.TotalCount ?? 0;
    int currentPageNum = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 30;
    int totalPages = ViewBag.TotalPages ?? 1;

    string currentSearch = ViewBag.Search ?? "";
    string currentAction = ViewBag.ActionType ?? "All";
    string currentEntity = ViewBag.EntityType ?? "All";
    string currentBranch = ViewBag.Branch ?? "All";
    string currentDate = ViewBag.Date ?? "";
    string currentFromDate = ViewBag.FromDate ?? "";
    string currentToDate = ViewBag.ToDate ?? "";
}

<div class="space-y-6 animate-in fade-in duration-500" dir="ltr">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-[28px] border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-brand-500/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex items-center gap-4 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-600 to-emerald-500 text-white flex items-center justify-center text-2xl shadow-lg shadow-brand-500/20 shrink-0">
                <i class="fas fa-history"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Nomination & Approvals Audit Trail</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-400 border border-brand-200/50">Audit Trail</span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">
                    Track and document all branch nomination decisions (Approval, Rejection, and Replacement) for Waves and Company Sessions with full date & time audit.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 relative z-10">
            <a href="@Url.Action("ExportNominationHistoryExcel", new { search = currentSearch, actionType = currentAction, entityType = currentEntity, branch = currentBranch, date = currentDate, fromDate = currentFromDate, toDate = currentToDate })" 
               class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-black shadow-md shadow-emerald-600/20 transition-all flex items-center gap-2">
                <i class="fas fa-file-excel text-sm"></i>
                <span>Export Excel</span>
            </a>
            <button type="button" onclick="window.location.reload()" 
                    class="p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-all" 
                    title="Refresh Data">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <!-- Total -->
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-list-check"></i>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Total Operations</p>
                <h3 class="text-2xl font-black text-slate-900 dark:text-white">@(stats?.TotalCount ?? 0)</h3>
            </div>
        </div>

        <!-- Approved -->
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Approved</p>
                <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400">@(stats?.ApprovedCount ?? 0)</h3>
            </div>
        </div>

        <!-- Rejected -->
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-times-circle"></i>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400">Rejected / Declined</p>
                <h3 class="text-2xl font-black text-rose-600 dark:text-rose-400">@(stats?.RejectedCount ?? 0)</h3>
            </div>
        </div>

        <!-- Replaced -->
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-exchange-alt"></i>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Replaced</p>
                <h3 class="text-2xl font-black text-indigo-600 dark:text-indigo-400">@(stats?.ReplacedCount ?? 0)</h3>
            </div>
        </div>

        <!-- Pending -->
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-amber-600 dark:text-amber-400">Pending Approval</p>
                <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400">@(stats?.PendingCount ?? 0)</h3>
            </div>
        </div>
    </div>

    <!-- Advanced Filter Bar -->
    <div class="bg-white dark:bg-slate-900 p-6 rounded-[24px] border border-slate-200 dark:border-slate-800 shadow-sm">
        <form method="get" action="@Url.Action("NominationHistory")" id="filterForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Search Input -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1.5">Search by Name / Code / Course / Actor:</label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" name="search" value="@currentSearch" placeholder="Search trainee, code, wave, company..." 
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20" />
                    </div>
                </div>

                <!-- Action Type Filter -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1.5">Action / Decision:</label>
                    <select name="actionType" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20">
                        <option value="All" selected="@(currentAction == "All")">All Actions</option>
                        <option value="Approved" selected="@(currentAction == "Approved")">Approved</option>
                        <option value="Rejected" selected="@(currentAction == "Rejected")">Rejected</option>
                        <option value="Replaced" selected="@(currentAction == "Replaced")">Replaced</option>
                        <option value="Pending" selected="@(currentAction == "Pending")">Pending Approval</option>
                    </select>
                </div>

                <!-- Entity Type Filter -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1.5">Course / Session Type:</label>
                    <select name="entityType" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20">
                        <option value="All" selected="@(currentEntity == "All")">All (Waves & Company Sessions)</option>
                        <option value="Wave" selected="@(currentEntity == "Wave")">Wave Sessions</option>
                        <option value="CompanySession" selected="@(currentEntity == "CompanySession")">Company Sessions</option>
                    </select>
                </div>

                <!-- Branch Filter -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1.5">Branch:</label>
                    <select name="branch" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20">
                        <option value="All" selected="@(currentBranch == "All")">All Branches</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b" selected="@(currentBranch == b)">@b</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Date Filtering Row -->
            <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4 pt-2 border-t border-slate-100 dark:border-slate-800/60 items-end">
                <div>
                    <label class="block text-[11px] font-bold text-indigo-600 dark:text-indigo-400 mb-1.5 flex items-center gap-1.5">
                        <i class="far fa-calendar-day"></i> Filter by Specific Date:
                    </label>
                    <input type="date" name="date" value="@currentDate" 
                           class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1.5">From Date:</label>
                    <input type="date" name="fromDate" value="@currentFromDate" 
                           class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1.5">To Date:</label>
                    <input type="date" name="toDate" value="@currentToDate" 
                           class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20" />
                </div>

                <div class="flex items-center gap-2">
                    <button type="submit" class="flex-1 py-2.5 bg-brand-600 hover:bg-brand-700 active:scale-95 text-white rounded-xl text-xs font-black shadow-md shadow-brand-600/20 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-filter text-xs"></i>
                        <span>Apply Filter</span>
                    </button>
                    <a href="@Url.Action("NominationHistory")" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold transition-all text-center" title="Reset Filters">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Audit Logs Table Card -->
    <div class="bg-white dark:bg-slate-900 rounded-[28px] border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-5 px-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs font-black text-slate-800 dark:text-white">Operations Logs (@totalCount records)</span>
            </div>
            <span class="text-[11px] text-slate-400 font-bold">Page @currentPageNum of @totalPages</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-100 dark:border-slate-800 text-slate-400 font-black text-[10px] uppercase tracking-wider">
                        <th class="py-4 px-6">Trainee / Candidate</th>
                        <th class="py-4 px-4">Branch</th>
                        <th class="py-4 px-4">Course / Session</th>
                        <th class="py-4 px-4">Decision</th>
                        <th class="py-4 px-4">Reason / Replacement</th>
                        <th class="py-4 px-4">Actioned By</th>
                        <th class="py-4 px-6 text-right">Date & Time</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-16 text-center text-slate-400">
                                <i class="far fa-folder-open text-3xl mb-3 opacity-40 block"></i>
                                No records match the selected search and filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model)
                        {
                            string action = (string)row.Action;
                            string entityType = (string)row.EntityType;
                            DateTime actionDate = (DateTime)row.ActionDate;
                            string reason = (string)row.ActionReason;
                            string repName = (string)row.ReplacementTraineeName;

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                <!-- Trainee Details -->
                                <td class="py-3.5 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center font-black text-xs shrink-0">
                                            @((row.TraineeName != null && row.TraineeName.ToString().Length > 0) ? row.TraineeName.ToString()[0] : 'U')
                                        </div>
                                        <div>
                                            <p class="font-black text-slate-900 dark:text-white leading-tight">@row.TraineeName</p>
                                            <div class="flex items-center gap-2 mt-0.5 text-[10px] text-slate-400">
                                                <span>Code: <b class="text-slate-600 dark:text-slate-300 font-mono">@row.TraineeCode</b></span>
                                                @if (row.TraineeRole != null)
                                                {
                                                    <span>• @row.TraineeRole</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Branch -->
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                                        <i class="fas fa-map-marker-alt text-brand-500 text-[9px]"></i>
                                        @row.BranchName
                                    </span>
                                </td>

                                <!-- Course / Session Details -->
                                <td class="py-3.5 px-4">
                                    <div>
                                        <p class="font-black text-slate-800 dark:text-slate-200">@row.EntityName</p>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            @if (entityType == "Wave")
                                             {
                                                <span class="px-2 py-0.5 rounded text-[9px] font-black bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-400 border border-brand-200/50">
                                                    <i class="fas fa-layer-group text-[8px] mr-1"></i> Wave Session
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded text-[9px] font-black bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400 border border-indigo-200/50">
                                                    <i class="fas fa-building text-[8px] mr-1"></i> Company: @(row.CompanyName ?? "General")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Action / Status Badge -->
                                <td class="py-3.5 px-4">
                                    @if (action == "Approved")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                            <i class="fas fa-check-circle"></i> Approved
                                        </span>
                                    }
                                    else if (action == "Rejected")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-rose-50 dark:bg-rose-950/30 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                                            <i class="fas fa-times-circle"></i> Rejected
                                        </span>
                                    }
                                    else if (action == "Replaced")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
                                            <i class="fas fa-exchange-alt"></i> Replaced
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-amber-50 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                            <i class="fas fa-clock"></i> Pending Approval
                                        </span>
                                    }
                                </td>

                                <!-- Reason or Replacement -->
                                <td class="py-3.5 px-4 text-xs">
                                    @if (!string.IsNullOrWhiteSpace(repName))
                                    {
                                        <div class="text-[11px]">
                                            <span class="text-slate-400">Approved Replacement:</span>
                                            <p class="font-black text-indigo-600 dark:text-indigo-400">@repName</p>
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(reason))
                                    {
                                        <div class="max-w-xs">
                                            <span class="text-rose-500 font-bold text-[10px] block">Rejection Reason:</span>
                                            <p class="text-slate-600 dark:text-slate-300 text-[11px] font-medium line-clamp-2" title="@reason">@reason</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-[11px]">--</span>
                                    }
                                </td>

                                <!-- Actioned By (Actor) -->
                                <td class="py-3.5 px-4">
                                    <div>
                                        <p class="font-bold text-slate-800 dark:text-slate-200 text-xs">@(row.ActionByUserName ?? "System")</p>
                                        <span class="text-[9px] text-slate-400">@(row.ActionByUserRole ?? "Branch Manager")</span>
                                    </div>
                                </td>

                                <!-- Action Date & Time -->
                                <td class="py-3.5 px-6 text-right">
                                    <span class="font-bold text-slate-800 dark:text-slate-200 font-mono text-[11px] block">@actionDate.ToString("yyyy-MM-dd")</span>
                                    <span class="text-[10px] text-slate-400 font-mono">@actionDate.ToString("hh:mm tt")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        @if (totalPages > 1)
        {
            <div class="p-4 px-6 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 flex flex-col sm:flex-row items-center justify-between gap-4">
                <span class="text-xs text-slate-500 font-medium">
                    Showing records @((currentPageNum - 1) * pageSize + 1) to @(Math.Min(currentPageNum * pageSize, totalCount)) of @totalCount total entries
                </span>
                <div class="flex items-center gap-1.5">
                    @if (currentPageNum > 1)
                    {
                        <a href="@Url.Action("NominationHistory", new { page = currentPageNum - 1, search = currentSearch, actionType = currentAction, entityType = currentEntity, branch = currentBranch, date = currentDate, fromDate = currentFromDate, toDate = currentToDate })" 
                           class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-100 transition-all">
                            Previous
                        </a>
                    }

                    @for (int i = Math.Max(1, currentPageNum - 2); i <= Math.Min(totalPages, currentPageNum + 2); i++)
                    {
                        <a href="@Url.Action("NominationHistory", new { page = i, search = currentSearch, actionType = currentAction, entityType = currentEntity, branch = currentBranch, date = currentDate, fromDate = currentFromDate, toDate = currentToDate })" 
                           class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-black transition-all @(i == currentPageNum ? "bg-brand-600 text-white shadow-md shadow-brand-600/20" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-100")">
                            @i
                        </a>
                    }

                    @if (currentPageNum < totalPages)
                    {
                        <a href="@Url.Action("NominationHistory", new { page = currentPageNum + 1, search = currentSearch, actionType = currentAction, entityType = currentEntity, branch = currentBranch, date = currentDate, fromDate = currentFromDate, toDate = currentToDate })" 
                           class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-100 transition-all">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
