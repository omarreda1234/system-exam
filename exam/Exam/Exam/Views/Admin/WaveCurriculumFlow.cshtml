@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Wave Curriculum & Assessment Flow Tracker";
    var waves = ViewBag.Waves as IEnumerable<dynamic> ?? new List<dynamic>();
    int activeWaveId = ViewBag.ActiveWaveId != null ? (int)ViewBag.ActiveWaveId : 0;
}

<div class="space-y-6 animate-fade-in" dir="rtl">
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-400 mb-1 font-medium">
                <a href="@Url.Action("Dashboard", "Admin")" class="hover:text-purple-600 transition-colors">لوحة التحكم</a>
                <span>/</span>
                <span>عمليات الويفات</span>
                <span>/</span>
                <span class="text-slate-700 dark:text-slate-300 font-bold">متابعة فلو المنهج والتقييمات</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white flex items-center justify-center shadow-lg shadow-purple-500/20">
                    <i class="fas fa-project-diagram text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-slate-900 dark:text-white">Wave Curriculum & Assessment Flow Tracker</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        متابعة شجرة المنهج: كويزات التوبيكس ⬅️ امتحانات الكاتيجوريز ⬅️ التكليفات ⬅️ الفاينال الشامل ⬅️ رصد الدرجة النهائية والشهادة.
                    </p>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Wave Selector -->
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800/80 px-3 py-1.5 rounded-2xl border border-slate-200 dark:border-slate-700">
                <i class="fas fa-water text-purple-600 text-sm"></i>
                <select id="curriculumWaveSelect" onchange="loadCurriculumFlowData()" class="bg-transparent text-xs font-bold text-slate-800 dark:text-white focus:outline-none cursor-pointer">
                    @foreach (var w in waves)
                    {
                        <option value="@w.Id" selected="@(w.Id == activeWaveId)">@w.WaveName</option>
                    }
                </select>
            </div>

            <button onclick="openWeightsModal()" type="button" class="px-4 py-2.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60 text-xs font-bold transition-all flex items-center gap-2 shadow-xs">
                <i class="fas fa-sliders-h"></i>
                <span>توزيع أوزان الشهادة</span>
            </button>

            <button onclick="switchFlowTab('simulator')" type="button" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-black transition-all flex items-center gap-2 shadow-sm">
                <i class="fas fa-vial"></i>
                <span>محاكي الفلو (Test Lab)</span>
            </button>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <!-- 1. Categories -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-[11px] font-bold">الكاتيجوريز</span>
                <i class="fas fa-folder text-indigo-500"></i>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span id="kpiCategoriesCount" class="text-2xl font-black text-slate-900 dark:text-white font-mono">0</span>
                <span class="text-[10px] text-slate-400">قسم رئيسي</span>
            </div>
            <span id="kpiTopicsCount" class="text-[10px] text-slate-500 mt-1 block font-medium">0 توبيك مسجل</span>
        </div>

        <!-- 2. Topic Quizzes -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-[11px] font-bold">كويزات التوبيكس</span>
                <i class="fas fa-bolt text-purple-500"></i>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span id="kpiQuizzesCount" class="text-2xl font-black text-purple-600 dark:text-purple-400 font-mono">0</span>
                <span class="text-[10px] text-slate-400">كويز مجدول</span>
            </div>
            <span class="text-[10px] text-purple-700 dark:text-purple-300 font-bold mt-1 block">وزن الشهادة: <span id="lblQuizzesWeight">25</span>%</span>
        </div>

        <!-- 3. Category Exams -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-[11px] font-bold">امتحانات الكاتيجوريز</span>
                <i class="fas fa-layer-group text-sky-500"></i>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span id="kpiCategoryExamsCount" class="text-2xl font-black text-sky-600 dark:text-sky-400 font-mono">0</span>
                <span class="text-[10px] text-slate-400">امتحان مجمع</span>
            </div>
            <span class="text-[10px] text-sky-700 dark:text-sky-300 font-bold mt-1 block">وزن الشهادة: <span id="lblCatExamsWeight">25</span>%</span>
        </div>

        <!-- 4. Assignments -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-[11px] font-bold">التكليفات الدورية</span>
                <i class="fas fa-tasks text-amber-500"></i>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span id="kpiAssignmentsCount" class="text-2xl font-black text-amber-600 dark:text-amber-400 font-mono">0</span>
                <span class="text-[10px] text-slate-400">تكليف مطلوب</span>
            </div>
            <span class="text-[10px] text-amber-700 dark:text-amber-300 font-bold mt-1 block">وزن الشهادة: <span id="lblAssignmentsWeight">15</span>%</span>
        </div>

        <!-- 5. Wave Final Exam -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-[11px] font-bold">الفاينال الشامل</span>
                <i class="fas fa-graduation-cap text-emerald-500"></i>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span id="kpiFinalExamStatus" class="text-sm font-black text-emerald-600 dark:text-emerald-400 font-mono">جاهز</span>
            </div>
            <span class="text-[10px] text-emerald-700 dark:text-emerald-300 font-bold mt-1 block">وزن الشهادة: <span id="lblFinalExamWeight">35</span>%</span>
        </div>

        <!-- 6. Enrolled & Certified -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-[11px] font-bold">المتدربين والشهادات</span>
                <i class="fas fa-award text-rose-500"></i>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span id="kpiEligibleCount" class="text-2xl font-black text-slate-900 dark:text-white font-mono">0</span>
                <span class="text-[10px] text-slate-400">/ <span id="kpiTotalEnrolled">0</span> مستحق</span>
            </div>
            <span id="kpiCertifiedText" class="text-[10px] text-emerald-600 font-bold mt-1 block">0 شهادة معتمدة</span>
        </div>
    </div>

    <!-- Flow Navigation Tabs -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-2 border border-slate-200/80 dark:border-slate-800 flex flex-wrap gap-2 shadow-xs">
        <button type="button" onclick="switchFlowTab('tree')" id="tabBtn-tree"
                class="flow-nav-tab px-5 py-2.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 bg-purple-600 text-white shadow-sm">
            <i class="fas fa-sitemap"></i>
            <span>خريطة وشجرة المنهج (Curriculum Hierarchy Map)</span>
        </button>

        <button type="button" onclick="switchFlowTab('gradebook')" id="tabBtn-gradebook"
                class="flow-nav-tab px-5 py-2.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800">
            <i class="fas fa-user-graduate"></i>
            <span>سجل درجات المتدربين والشهادة (Trainees Audit Gradebook)</span>
            <span id="tabBadgeTraineesCount" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
        </button>

        <button type="button" onclick="switchFlowTab('simulator')" id="tabBtn-simulator"
                class="flow-nav-tab px-5 py-2.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800">
            <i class="fas fa-microscope text-purple-500"></i>
            <span>مختبر ومحاكي الفلو (Interactive Flow Simulator)</span>
            <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">Test Lab</span>
        </button>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 1: CURRICULUM HIERARCHY MAP                              -->
    <!-- ============================================================ -->
    <div id="tabContent-tree" class="flow-tab-content space-y-6">
        <!-- Visual Progression Pipeline Banner -->
        <div class="bg-gradient-to-l from-slate-900 via-indigo-950 to-purple-950 text-white rounded-3xl p-6 shadow-xl relative overflow-hidden">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-6 relative z-10">
                <div class="space-y-1 text-center lg:text-right">
                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-white/10 text-purple-300 border border-white/10">
                        Visual Curriculum Workflow
                    </span>
                    <h3 class="text-lg font-black text-white">مسار التقييم المتكامل للويف التدريبي</h3>
                    <p class="text-xs text-purple-200/80 max-w-xl leading-relaxed">
                        يتدرج المتدرب من كويزات الموضوعات السريعة حتى الامتحان الشامل، وتُحسب النسبة الإجمالية تلقائياً لتحديد الاستحقاق الرسمي لشهادة الاعتماد.
                    </p>
                </div>

                <!-- Step badges -->
                <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-bold" dir="ltr">
                    <div class="flex items-center gap-2 bg-white/10 border border-white/15 px-3 py-2 rounded-xl backdrop-blur-xs">
                        <span class="w-6 h-6 rounded-lg bg-purple-500 text-white flex items-center justify-center text-xs font-black">1</span>
                        <span>Topic Quizzes (25%)</span>
                    </div>
                    <i class="fas fa-chevron-right text-purple-300 text-xs hidden sm:inline"></i>
                    <div class="flex items-center gap-2 bg-white/10 border border-white/15 px-3 py-2 rounded-xl backdrop-blur-xs">
                        <span class="w-6 h-6 rounded-lg bg-sky-500 text-white flex items-center justify-center text-xs font-black">2</span>
                        <span>Category Exams (25%)</span>
                    </div>
                    <i class="fas fa-chevron-right text-purple-300 text-xs hidden sm:inline"></i>
                    <div class="flex items-center gap-2 bg-white/10 border border-white/15 px-3 py-2 rounded-xl backdrop-blur-xs">
                        <span class="w-6 h-6 rounded-lg bg-amber-500 text-white flex items-center justify-center text-xs font-black">3</span>
                        <span>Assignments (15%)</span>
                    </div>
                    <i class="fas fa-chevron-right text-purple-300 text-xs hidden sm:inline"></i>
                    <div class="flex items-center gap-2 bg-white/10 border border-white/15 px-3 py-2 rounded-xl backdrop-blur-xs">
                        <span class="w-6 h-6 rounded-lg bg-emerald-500 text-white flex items-center justify-center text-xs font-black">4</span>
                        <span>Wave Final (35%)</span>
                    </div>
                    <i class="fas fa-equals text-purple-300 text-xs hidden sm:inline"></i>
                    <div class="flex items-center gap-2 bg-purple-500/40 border border-purple-400/30 px-3.5 py-2 rounded-xl">
                        <i class="fas fa-award text-amber-300"></i>
                        <span>Certificate</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories & Topics Tree Container -->
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-network-wired text-purple-600"></i>
                        <span>خريطة الأقسام، الكويزات، والامتحانات</span>
                    </h3>
                    <p class="text-xs text-slate-500">كل قسم وتوبيكاته وحالة كويزاته وامتحانه الفاينال أو امتحانه المباشر.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="@Url.Action("Quizzes", "Admin")" class="text-xs font-bold text-purple-600 hover:text-purple-700 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-xl border border-purple-200 transition-all">
                        <i class="fas fa-plus mr-1"></i> إضافة كويز جديد
                    </a>
                </div>
            </div>

            <div id="categoriesTreeContainer" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="col-span-full p-12 text-center text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl mb-2 text-purple-600"></i>
                    <p class="text-xs">جاري تحميل شجرة المنهج والتقييمات...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 2: TRAINEES AUDIT GRADEBOOK                              -->
    <!-- ============================================================ -->
    <div id="tabContent-gradebook" class="flow-tab-content hidden space-y-4">
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-800">
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-user-check text-purple-600"></i>
                        <span>سجل رصد درجات متدربي الويف وحالة الشهادة</span>
                    </h3>
                    <p class="text-xs text-slate-500">حساب فوري للمجموع المركب من 100 درجة واستحقاق شهادة الاعتماد الأكاديمية.</p>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                    <div class="relative w-64">
                        <i class="fas fa-search absolute right-3 top-2.5 text-xs text-slate-400"></i>
                        <input type="text" id="traineeGradebookSearch" onkeyup="filterTraineeGradebook()" placeholder="بحث بالاسم، الكود، أو الفرع..."
                               class="w-full text-xs font-medium pr-8 pl-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500" />
                    </div>

                    <select id="traineeStatusFilter" onchange="filterTraineeGradebook()" class="text-xs font-bold px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200">
                        <option value="all">جميع الحالات</option>
                        <option value="passed">مؤهل للشهادة (ناجح)</option>
                        <option value="failed">أقل من النسبة (راسب)</option>
                        <option value="certified">تم إصدار الشهادة له</option>
                    </select>

                    <button onclick="exportGradebookToExcel()" type="button" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5 transition-all shadow-xs">
                        <i class="fas fa-file-excel"></i>
                        <span>تصدير Excel</span>
                    </button>
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs" id="curriculumGradebookTable">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 font-bold border-b border-slate-200 dark:border-slate-800">
                        <tr>
                            <th class="p-3.5">المتدرب</th>
                            <th class="p-3.5">الفرع والدور</th>
                            <th class="p-3.5 text-center">كويزات التوبيكس (<span class="header-q-weight">25</span>%)</th>
                            <th class="p-3.5 text-center">امتحانات الكاتيجوريز (<span class="header-c-weight">25</span>%)</th>
                            <th class="p-3.5 text-center">التكليفات (<span class="header-a-weight">15</span>%)</th>
                            <th class="p-3.5 text-center">الفاينال الشامل (<span class="header-f-weight">35</span>%)</th>
                            <th class="p-3.5 text-center bg-purple-50/50 dark:bg-purple-950/20 text-purple-900 dark:text-purple-300">الدرجة النهائية (/100)</th>
                            <th class="p-3.5 text-center">حالة الاعتماد</th>
                        </tr>
                    </thead>
                    <tbody id="curriculumGradebookTbody" class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
                        <tr>
                            <td colspan="8" class="p-10 text-center text-slate-400">
                                اختر ويف أعلاه لعرض سجل الدرجات والتحصيل.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 3: INTERACTIVE FLOW SIMULATOR & TEST LAB                 -->
    <!-- ============================================================ -->
    <div id="tabContent-simulator" class="flow-tab-content hidden space-y-6">
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-8">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                        Interactive Test Lab
                    </span>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white">مختبر محاكاة واختبار فلو المنهج ورصد الدرجة</h3>
                </div>
                <p class="text-xs text-slate-500">
                    يمكنك تجربة إدخال درجات افتراضية لمراحل المنهج المختلفة (الكويزات، امتحانات الكاتيجوريز، التكليفات، الفاينال) لمعاينة كيفية حساب الدرجة النهائية واختبار استحقاق الشهادة.
                </p>
            </div>

            <!-- Simulator Controls Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Sliders Controls -->
                <div class="space-y-6 bg-slate-50 dark:bg-slate-800/40 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-700/60">
                    <h4 class="text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider border-b border-slate-200/60 pb-2">
                        1. درجات المتدرب التجريبي في كل مرحلة (%):
                    </h4>

                    <!-- 1. Topic Quizzes Slider -->
                    <div>
                        <div class="flex items-center justify-between text-xs font-bold mb-1">
                            <span class="text-purple-700 dark:text-purple-400 flex items-center gap-1.5">
                                <i class="fas fa-bolt text-[11px]"></i> متوسط كويزات التوبيكس (Topic Quizzes)
                            </span>
                            <span class="font-mono font-black text-slate-900 dark:text-white" id="valSimQuizzes">85%</span>
                        </div>
                        <input type="range" id="simQuizzes" min="0" max="100" value="85" oninput="runLocalSimulation()"
                               class="w-full accent-purple-600 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                    </div>

                    <!-- 2. Category Exams Slider -->
                    <div>
                        <div class="flex items-center justify-between text-xs font-bold mb-1">
                            <span class="text-sky-700 dark:text-sky-400 flex items-center gap-1.5">
                                <i class="fas fa-layer-group text-[11px]"></i> متوسط امتحانات الكاتيجوريز (Category Exams)
                            </span>
                            <span class="font-mono font-black text-slate-900 dark:text-white" id="valSimCatExams">80%</span>
                        </div>
                        <input type="range" id="simCatExams" min="0" max="100" value="80" oninput="runLocalSimulation()"
                               class="w-full accent-sky-600 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                    </div>

                    <!-- 3. Assignments Slider -->
                    <div>
                        <div class="flex items-center justify-between text-xs font-bold mb-1">
                            <span class="text-amber-700 dark:text-amber-400 flex items-center gap-1.5">
                                <i class="fas fa-tasks text-[11px]"></i> متوسط التكليفات الدورية (Continuous Assignments)
                            </span>
                            <span class="font-mono font-black text-slate-900 dark:text-white" id="valSimAssignments">90%</span>
                        </div>
                        <input type="range" id="simAssignments" min="0" max="100" value="90" oninput="runLocalSimulation()"
                               class="w-full accent-amber-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                    </div>

                    <!-- 4. Final Exam Slider -->
                    <div>
                        <div class="flex items-center justify-between text-xs font-bold mb-1">
                            <span class="text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5">
                                <i class="fas fa-graduation-cap text-[11px]"></i> درجة امتحان الفاينال الشامل (Wave Final Exam)
                            </span>
                            <span class="font-mono font-black text-slate-900 dark:text-white" id="valSimFinalExam">75%</span>
                        </div>
                        <input type="range" id="simFinalExam" min="0" max="100" value="75" oninput="runLocalSimulation()"
                               class="w-full accent-emerald-600 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                    </div>

                    <div class="pt-3 border-t border-slate-200/60 flex items-center justify-between gap-3">
                        <button type="button" onclick="randomizeSimScores()" class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all flex items-center gap-1.5">
                            <i class="fas fa-dice"></i>
                            <span>درجات عشوائية</span>
                        </button>

                        <div class="text-xs font-bold text-slate-500">
                            حد النجاح المطلوب: <strong class="text-purple-600" id="lblSimPassingThreshold">60%</strong>
                        </div>
                    </div>
                </div>

                <!-- Simulation Result Card & Step Logs -->
                <div class="space-y-6">
                    <!-- Result Summary Card -->
                    <div class="bg-gradient-to-br from-purple-500/10 via-indigo-500/5 to-purple-500/10 rounded-3xl p-6 border-2 border-purple-500/20 space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-500">الدرجة النهائية المحسوبة (Composite Score):</span>
                            <span id="simResultBadge" class="px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-200">
                                مؤهل للاعتماد
                            </span>
                        </div>

                        <div class="flex items-baseline justify-between">
                            <div>
                                <span id="simTotalDegree" class="text-4xl font-black text-purple-700 dark:text-purple-400 font-mono">81.0</span>
                                <span class="text-sm font-bold text-slate-400">/ 100 درجة</span>
                            </div>
                            <div class="text-left font-mono">
                                <span id="simRatingText" class="text-xs font-black text-emerald-600 bg-emerald-50 dark:bg-emerald-950/40 px-3 py-1 rounded-xl border border-emerald-200/60">
                                    جيد جداً (Very Good)
                                </span>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-slate-200 dark:bg-slate-700 h-3 rounded-full overflow-hidden">
                            <div id="simProgressBar" class="bg-gradient-to-r from-purple-600 to-emerald-500 h-full transition-all duration-300" style="width: 81%"></div>
                        </div>

                        <!-- Contributions Breakdown Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2 text-center text-xs">
                            <div class="bg-white/80 dark:bg-slate-800 p-2.5 rounded-xl border border-purple-100 dark:border-slate-700 shadow-2xs">
                                <span class="text-[10px] text-slate-400 block">كويزات التوبيكس</span>
                                <strong id="simContribQuizzes" class="text-purple-700 font-mono font-black text-sm">21.3</strong>
                                <span class="text-[9px] text-slate-400 block">من 25 درجة</span>
                            </div>
                            <div class="bg-white/80 dark:bg-slate-800 p-2.5 rounded-xl border border-sky-100 dark:border-slate-700 shadow-2xs">
                                <span class="text-[10px] text-slate-400 block">امتحانات الكاتيجوريز</span>
                                <strong id="simContribCatExams" class="text-sky-700 font-mono font-black text-sm">20.0</strong>
                                <span class="text-[9px] text-slate-400 block">من 25 درجة</span>
                            </div>
                            <div class="bg-white/80 dark:bg-slate-800 p-2.5 rounded-xl border border-amber-100 dark:border-slate-700 shadow-2xs">
                                <span class="text-[10px] text-slate-400 block">التكليفات الدورية</span>
                                <strong id="simContribAssignments" class="text-amber-700 font-mono font-black text-sm">13.5</strong>
                                <span class="text-[9px] text-slate-400 block">من 15 درجة</span>
                            </div>
                            <div class="bg-white/80 dark:bg-slate-800 p-2.5 rounded-xl border border-emerald-100 dark:border-slate-700 shadow-2xs">
                                <span class="text-[10px] text-slate-400 block">الفاينال الشامل</span>
                                <strong id="simContribFinalExam" class="text-emerald-700 font-mono font-black text-sm">26.3</strong>
                                <span class="text-[9px] text-slate-400 block">من 35 درجة</span>
                            </div>
                        </div>

                        <!-- Mock Certificate Preview -->
                        <div id="simCertBox" class="bg-white/95 dark:bg-slate-800 p-4 rounded-2xl border border-emerald-200 dark:border-emerald-800/40 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold">
                                    <i class="fas fa-certificate text-lg"></i>
                                </div>
                                <div>
                                    <h5 class="text-xs font-black text-slate-800 dark:text-white">شهادة الاعتماد التجريبية (Simulation Cert)</h5>
                                    <span id="simCertCode" class="text-[11px] font-mono font-bold text-emerald-600 dark:text-emerald-400">WTTA-2026-SIM-4821</span>
                                </div>
                            </div>
                            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">مستحق للإصدار</span>
                        </div>
                    </div>

                    <!-- Step-by-Step Audit Log -->
                    <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700 space-y-2">
                        <h5 class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <i class="fas fa-list-ol text-purple-600"></i>
                            <span>سجل خطوات الاحتساب والمطابقة:</span>
                        </h5>
                        <ul id="simStepsList" class="space-y-1.5 text-[11px] text-slate-600 dark:text-slate-400 font-medium list-disc pr-4">
                            <!-- Populated dynamically -->
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: CONFIGURE WEIGHTS & SCORING DISTRIBUTION              -->
<!-- ============================================================ -->
<div id="weightsModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-lg overflow-hidden transform transition-all text-right" dir="rtl">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-purple-100 dark:bg-purple-950/60 text-purple-600 flex items-center justify-center">
                    <i class="fas fa-sliders-h"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white">توزيع أوزان درجات الشهادة للويف</h3>
                    <p class="text-xs text-slate-400">يجب أن يكون إجمالي الأوزان 100 درجة بالضبط.</p>
                </div>
            </div>
            <button onclick="closeWeightsModal()" type="button" class="w-8 h-8 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="weightsForm" onsubmit="saveCurriculumWeights(event)" class="p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-purple-700 dark:text-purple-300 mb-1">وزن كويزات التوبيكس (درجة)</label>
                    <input type="number" id="inpQuizzesWeight" min="0" max="100" required oninput="calcWeightsSum()"
                           class="w-full text-xs font-bold px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-sky-700 dark:text-sky-300 mb-1">وزن امتحانات الكاتيجوريز (درجة)</label>
                    <input type="number" id="inpCatExamsWeight" min="0" max="100" required oninput="calcWeightsSum()"
                           class="w-full text-xs font-bold px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-amber-700 dark:text-amber-300 mb-1">وزن التكليفات الدورية (درجة)</label>
                    <input type="number" id="inpAssignmentsWeight" min="0" max="100" required oninput="calcWeightsSum()"
                           class="w-full text-xs font-bold px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-emerald-700 dark:text-emerald-300 mb-1">وزن الفاينال الشامل (درجة)</label>
                    <input type="number" id="inpFinalExamWeight" min="0" max="100" required oninput="calcWeightsSum()"
                           class="w-full text-xs font-bold px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800" />
                </div>
            </div>

            <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">حد النجاح الأدنى للاعتماد (Passing %)</label>
                <input type="number" id="inpPassingThreshold" min="1" max="100" required
                       class="w-full text-xs font-bold px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800" />
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 flex items-center justify-between text-xs font-bold">
                <span>إجمالي الأوزان:</span>
                <span id="lblWeightsSum" class="font-mono text-sm text-emerald-600">100 / 100</span>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-3">
                <button onclick="closeWeightsModal()" type="button" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-100">إلغاء</button>
                <button id="btnSaveWeights" type="submit" class="px-6 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-black shadow-sm">
                    حفظ الأوزان للويف
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentFlowData = null;

    function switchFlowTab(tabKey) {
        document.querySelectorAll('.flow-nav-tab').forEach(btn => {
            btn.classList.remove('bg-purple-600', 'text-white', 'shadow-sm');
            btn.classList.add('text-slate-600', 'dark:text-slate-400', 'hover:text-slate-900', 'hover:bg-slate-50');
        });

        document.querySelectorAll('.flow-tab-content').forEach(c => c.classList.add('hidden'));

        const activeBtn = document.getElementById('tabBtn-' + tabKey);
        const activeContent = document.getElementById('tabContent-' + tabKey);

        if (activeBtn) {
            activeBtn.classList.add('bg-purple-600', 'text-white', 'shadow-sm');
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400', 'hover:text-slate-900', 'hover:bg-slate-50');
        }

        if (activeContent) {
            activeContent.classList.remove('hidden');
        }

        if (tabKey === 'simulator') {
            runLocalSimulation();
        }
    }

    async function loadCurriculumFlowData() {
        const waveId = document.getElementById('curriculumWaveSelect').value;
        if (!waveId) return;

        const container = document.getElementById('categoriesTreeContainer');
        container.innerHTML = `
            <div class="col-span-full p-12 text-center text-slate-400">
                <i class="fas fa-spinner fa-spin text-2xl mb-2 text-purple-600"></i>
                <p class="text-xs">جاري تحميل شجرة المنهج والتقييمات للويف...</p>
            </div>
        `;

        try {
            const res = await fetch(`/Admin/GetWaveCurriculumFlowData?waveId=${waveId}`);
            const data = await res.json();

            if (!data.success) {
                container.innerHTML = `<div class="col-span-full p-8 text-center text-rose-500 font-bold">${data.message}</div>`;
                return;
            }

            currentFlowData = data;
            renderCurriculumFlowUI(data);
        } catch (err) {
            container.innerHTML = `<div class="col-span-full p-8 text-center text-rose-500">حدث خطأ: ${err.message}</div>`;
        }
    }

    function renderCurriculumFlowUI(data) {
        // 1. KPIs
        document.getElementById('kpiCategoriesCount').innerText = data.summaryStats.totalCategories;
        document.getElementById('kpiTopicsCount').innerText = `${data.summaryStats.totalTopics} توبيك مسجل`;
        document.getElementById('kpiQuizzesCount').innerText = data.summaryStats.totalQuizzesConfigured;
        document.getElementById('kpiCategoryExamsCount').innerText = data.summaryStats.totalCategoryExamsConfigured;
        document.getElementById('kpiAssignmentsCount').innerText = data.summaryStats.totalAssignments;
        document.getElementById('kpiFinalExamStatus').innerText = data.summaryStats.hasWaveFinalExam ? 'جاهز ومجدول' : 'غير مجدول';
        document.getElementById('kpiTotalEnrolled').innerText = data.summaryStats.totalEnrolled;
        document.getElementById('kpiEligibleCount').innerText = data.summaryStats.eligibleCount;
        document.getElementById('kpiCertifiedText').innerText = `${data.summaryStats.certifiedCount} شهادة معتمدة`;

        // 2. Weights labels
        document.getElementById('lblQuizzesWeight').innerText = data.weights.quizzesWeight;
        document.getElementById('lblCatExamsWeight').innerText = data.weights.categoryExamsWeight;
        document.getElementById('lblAssignmentsWeight').innerText = data.weights.assignmentsWeight;
        document.getElementById('lblFinalExamWeight').innerText = data.weights.finalExamWeight;

        document.querySelectorAll('.header-q-weight').forEach(el => el.innerText = data.weights.quizzesWeight);
        document.querySelectorAll('.header-c-weight').forEach(el => el.innerText = data.weights.categoryExamsWeight);
        document.querySelectorAll('.header-a-weight').forEach(el => el.innerText = data.weights.assignmentsWeight);
        document.querySelectorAll('.header-f-weight').forEach(el => el.innerText = data.weights.finalExamWeight);

        // 3. Render Categories Tree
        renderCategoriesTree(data.categories, data.waveFinalExam, data.assignments);

        // 4. Render Gradebook
        document.getElementById('tabBadgeTraineesCount').innerText = data.trainees.length;
        renderCurriculumGradebook(data.trainees);
    }

    function renderCategoriesTree(categories, waveFinalExam, assignments) {
        const container = document.getElementById('categoriesTreeContainer');
        if (!categories || categories.length === 0) {
            container.innerHTML = `<div class="col-span-full p-8 text-center text-slate-400">لا توجد أقسام مسجلة لهذا الويف.</div>`;
            return;
        }

        let html = '';

        categories.forEach(cat => {
            const hasTopics = cat.hasTopics;

            html += `
                <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm space-y-4 hover:border-purple-500/40 transition-all flex flex-col justify-between">
                    <div>
                        <!-- Category Header -->
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                            <div class="flex items-center gap-2.5">
                                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 dark:bg-purple-950/40 dark:text-purple-300 flex items-center justify-center font-bold text-sm">
                                    <i class="fas fa-folder"></i>
                                </div>
                                <div>
                                    <h4 class="font-black text-slate-900 dark:text-white text-sm">${cat.categoryName}</h4>
                                    <span class="text-[10px] text-slate-400 font-medium">
                                        ${hasTopics ? `${cat.topicsCount} موضوعات فرعية (Topics)` : 'قسم مباشر (بدون موضوعات فرعية مثل Health Insurance)'}
                                    </span>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-xl text-[10px] font-black ${hasTopics ? 'bg-indigo-50 text-indigo-700' : 'bg-sky-50 text-sky-700'}">
                                ${hasTopics ? 'موضوعات + كويزات' : 'امتحان مباشر'}
                            </span>
                        </div>

                        <!-- Topics & Quizzes List -->
                        ${hasTopics ? `
                            <div class="space-y-2 mt-3">
                                <span class="text-[10px] font-bold text-slate-400 block uppercase tracking-wider">كويزات التوبيكس (Topic Quizzes):</span>
                                <div class="space-y-2">
                                    ${cat.topics.map(t => `
                                        <div class="flex items-center justify-between p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50 text-xs">
                                            <div class="flex items-center gap-2">
                                                <i class="fas fa-bookmark text-slate-400 text-[10px]"></i>
                                                <span class="font-bold text-slate-800 dark:text-slate-200">${t.topicName}</span>
                                            </div>
                                            <div>
                                                ${t.hasQuiz ? `
                                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40 text-[10px] font-bold">
                                                        <i class="fas fa-bolt text-[9px] text-purple-500"></i>
                                                        <span>${t.quiz.title} (${t.quiz.totalPoints} د)</span>
                                                    </span>
                                                ` : `
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-bold">
                                                        <i class="fas fa-exclamation-triangle text-[9px]"></i>
                                                        <span>لا يوجد كويز مسجل</span>
                                                    </span>
                                                `}
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}

                        <!-- Category Milestone / Direct Exam -->
                        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
                            <span class="text-[10px] font-bold text-slate-400 block uppercase tracking-wider mb-2">
                                ${hasTopics ? 'امتحان الفاينال للكاتيجوري (Category Final Exam):' : 'الامتحان المباشر للكاتيجوري (Direct Category Exam):'}
                            </span>
                            ${cat.categoryExam ? `
                                <div class="flex items-center justify-between p-3 rounded-2xl bg-sky-50/70 dark:bg-sky-950/20 border border-sky-200/60 dark:border-sky-800/40 text-xs">
                                    <div class="flex items-center gap-2 text-sky-900 dark:text-sky-300 font-bold">
                                        <i class="fas fa-graduation-cap text-sky-600"></i>
                                        <span>${cat.categoryExam.title}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] font-mono font-bold bg-white dark:bg-slate-800 text-sky-700 px-2 py-0.5 rounded-lg border border-sky-200/50">
                                            ${cat.categoryExam.totalPoints} درجة
                                        </span>
                                        <span class="text-[10px] font-mono text-slate-400">
                                            ${cat.categoryExam.attemptsCount} محاولة
                                        </span>
                                    </div>
                                </div>
                            ` : `
                                <div class="p-3 rounded-2xl bg-rose-50/70 text-rose-700 border border-rose-200/50 text-xs font-bold flex items-center justify-between">
                                    <div class="flex items-center gap-1.5">
                                        <i class="fas fa-exclamation-circle"></i>
                                        <span>غير مسجل امتحان لهذا القسم بعد</span>
                                    </div>
                                    <a href="@Url.Action("Create", "Exams")" class="text-[10px] underline font-black">جدولة امتحان</a>
                                </div>
                            `}
                        </div>
                    </div>
                </div>
            `;
        });

        // Append Comprehensive Wave Final Exam & Assignments block
        html += `
            <div class="col-span-full bg-gradient-to-r from-emerald-500/10 via-purple-500/5 to-indigo-500/10 rounded-3xl border-2 border-emerald-500/20 p-6 shadow-sm space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-emerald-200/60 pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-emerald-600 text-white flex items-center justify-center font-bold">
                            <i class="fas fa-award text-lg"></i>
                        </div>
                        <div>
                            <h4 class="font-black text-slate-900 dark:text-white text-base">الامتحان الفاينال الشامل للدورة (Comprehensive Wave Final Exam)</h4>
                            <p class="text-xs text-slate-500">يقيس تحصيل المتدرب الشامل في كافة الأقسام التخصصية في ختام الدورة.</p>
                        </div>
                    </div>
                    ${waveFinalExam ? `
                        <span class="px-3 py-1 rounded-xl bg-emerald-100 text-emerald-800 font-bold text-xs">
                            <i class="fas fa-check-circle mr-1"></i> جاهز ومجدول (${waveFinalExam.totalPoints} درجة)
                        </span>
                    ` : `
                        <span class="px-3 py-1 rounded-xl bg-amber-100 text-amber-800 font-bold text-xs">
                            <i class="fas fa-clock mr-1"></i> بانتظار الجدولة
                        </span>
                    `}
                </div>

                ${waveFinalExam ? `
                    <div class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-emerald-200/80 flex flex-wrap items-center justify-between gap-4 text-xs font-medium">
                        <div class="font-bold text-slate-800 dark:text-white text-sm">${waveFinalExam.title}</div>
                        <div class="flex items-center gap-4 text-slate-500 font-mono">
                            <span><i class="far fa-clock mr-1"></i>المدة: ${waveFinalExam.duration} دقيقة</span>
                            <span><i class="fas fa-question-circle mr-1"></i>الأسئلة: ${waveFinalExam.questionsCount} سؤال</span>
                            <span><i class="fas fa-users mr-1"></i>المكتملين: ${waveFinalExam.attemptsCount} متدرب</span>
                            <span class="text-emerald-600 font-bold"><i class="fas fa-chart-line mr-1"></i>المتوسط: ${waveFinalExam.averageScore}%</span>
                        </div>
                    </div>
                ` : `
                    <p class="text-xs text-slate-400">لم يتم ربط امتحان فاينال شامل بهذا الويف بعد. يمكنك جدولة امتحان من صفحة إدارة الامتحانات مع تحديد ويف الدورة.</p>
                `}
            </div>
        `;

        container.innerHTML = html;
    }

    function renderCurriculumGradebook(trainees) {
        const tbody = document.getElementById('curriculumGradebookTbody');
        if (!trainees || trainees.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-slate-400">لا يوجد متدربون مسجلون في هذا الويف.</td></tr>`;
            return;
        }

        let html = '';
        trainees.forEach(t => {
            const passBadge = t.isPassed
                ? `<span class="px-2.5 py-1 rounded-xl text-[10px] font-black bg-emerald-100 text-emerald-800 border border-emerald-200">مؤهل للشهادة</span>`
                : `<span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">أقل من النسبة</span>`;

            const certText = t.certificateCode
                ? `<div class="text-[9px] font-mono text-purple-600 font-bold mt-0.5">${t.certificateCode}</div>`
                : '';

            html += `
                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 gradebook-row"
                    data-name="${(t.fullName || '').toLowerCase()}" data-code="${(t.userCode || '').toLowerCase()}"
                    data-branch="${(t.branchName || '').toLowerCase()}" data-passed="${t.isPassed}" data-certified="${Boolean(t.certificateCode)}">
                    <td class="p-3.5">
                        <div class="font-bold text-slate-900 dark:text-white">${t.fullName || '-'}</div>
                        <div class="text-[10px] text-slate-400 font-mono">${t.userCode || ''} • ${t.email || ''}</div>
                    </td>
                    <td class="p-3.5">
                        <div class="font-medium text-slate-700 dark:text-slate-300">${t.branchName || '-'}</div>
                        <span class="inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600">${t.roleName || 'Pharmacist'}</span>
                    </td>
                    <td class="p-3.5 text-center">
                        <span class="font-black text-purple-600 text-xs font-mono">${t.quizzesAvg}%</span>
                        <div class="text-[9px] text-slate-400">(${t.quizzesTaken}/${t.totalQuizzes})</div>
                    </td>
                    <td class="p-3.5 text-center">
                        <span class="font-black text-sky-600 text-xs font-mono">${t.catExamsAvg}%</span>
                        <div class="text-[9px] text-slate-400">(${t.catExamsTaken}/${t.totalCatExams})</div>
                    </td>
                    <td class="p-3.5 text-center">
                        <span class="font-black text-amber-600 text-xs font-mono">${t.assignmentsAvg}%</span>
                        <div class="text-[9px] text-slate-400">(${t.assignmentsTaken}/${t.totalAssignments})</div>
                    </td>
                    <td class="p-3.5 text-center">
                        <span class="font-black text-emerald-600 text-xs font-mono">${t.finalExamScore}%</span>
                        <div class="text-[9px] text-slate-400">${t.finalTaken ? 'تم التقديم' : 'لم يقدم بعد'}</div>
                    </td>
                    <td class="p-3.5 text-center bg-purple-50/30 dark:bg-purple-950/10">
                        <span class="text-sm font-black text-purple-700 dark:text-purple-300 font-mono">${t.totalDegree}</span>
                    </td>
                    <td class="p-3.5 text-center">
                        ${passBadge}
                        ${certText}
                    </td>
                </tr>
            `;
        });

        tbody.innerHTML = html;
    }

    function filterTraineeGradebook() {
        const query = (document.getElementById('traineeGradebookSearch').value || '').toLowerCase();
        const filterStatus = document.getElementById('traineeStatusFilter').value;

        document.querySelectorAll('.gradebook-row').forEach(row => {
            const name = row.getAttribute('data-name');
            const code = row.getAttribute('data-code');
            const branch = row.getAttribute('data-branch');
            const isPassed = row.getAttribute('data-passed') === 'true';
            const isCertified = row.getAttribute('data-certified') === 'true';

            const matchesText = name.includes(query) || code.includes(query) || branch.includes(query);
            let matchesStatus = true;

            if (filterStatus === 'passed') matchesStatus = isPassed;
            else if (filterStatus === 'failed') matchesStatus = !isPassed;
            else if (filterStatus === 'certified') matchesStatus = isCertified;

            if (matchesText && matchesStatus) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // ==========================================
    // SIMULATOR FUNCTIONS
    // ==========================================
    function runLocalSimulation() {
        const qScore = parseFloat(document.getElementById('simQuizzes').value) || 0;
        const cScore = parseFloat(document.getElementById('simCatExams').value) || 0;
        const aScore = parseFloat(document.getElementById('simAssignments').value) || 0;
        const fScore = parseFloat(document.getElementById('simFinalExam').value) || 0;

        document.getElementById('valSimQuizzes').innerText = qScore + '%';
        document.getElementById('valSimCatExams').innerText = cScore + '%';
        document.getElementById('valSimAssignments').innerText = aScore + '%';
        document.getElementById('valSimFinalExam').innerText = fScore + '%';

        const qW = currentFlowData ? currentFlowData.weights.quizzesWeight : 25;
        const cW = currentFlowData ? currentFlowData.weights.categoryExamsWeight : 25;
        const aW = currentFlowData ? currentFlowData.weights.assignmentsWeight : 15;
        const fW = currentFlowData ? currentFlowData.weights.finalExamWeight : 35;
        const passP = currentFlowData ? currentFlowData.weights.passingPercentage : 60;

        const qContrib = Math.round((qScore * qW) / 100 * 10) / 10;
        const cContrib = Math.round((cScore * cW) / 100 * 10) / 10;
        const aContrib = Math.round((aScore * aW) / 100 * 10) / 10;
        const fContrib = Math.round((fScore * fW) / 100 * 10) / 10;

        const total = Math.round((qContrib + cContrib + aContrib + fContrib) * 10) / 10;

        document.getElementById('simContribQuizzes').innerText = qContrib;
        document.getElementById('simContribCatExams').innerText = cContrib;
        document.getElementById('simContribAssignments').innerText = aContrib;
        document.getElementById('simContribFinalExam').innerText = fContrib;
        document.getElementById('simTotalDegree').innerText = total;
        document.getElementById('simProgressBar').style.width = Math.min(100, total) + '%';

        const isPassed = total >= passP;
        const badge = document.getElementById('simResultBadge');
        const rating = document.getElementById('simRatingText');

        if (isPassed) {
            badge.className = 'px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-200';
            badge.innerText = 'مؤهل للاعتماد والشهادة (Passed)';

            let rText = 'مقبول (Pass)';
            if (total >= 85) rText = 'ممتاز (Excellent)';
            else if (total >= 75) rText = 'جيد جداً (Very Good)';
            else if (total >= 65) rText = 'جيد (Good)';

            rating.innerText = rText;
            rating.className = 'text-xs font-black text-emerald-600 bg-emerald-50 px-3 py-1 rounded-xl border border-emerald-200/60';

            document.getElementById('simCertBox').classList.remove('hidden');
        } else {
            badge.className = 'px-3 py-1 rounded-full text-xs font-black bg-rose-100 text-rose-800 border border-rose-200';
            badge.innerText = 'أقل من درجة النجاح (Under Threshold)';

            rating.innerText = 'راسب (Fail)';
            rating.className = 'text-xs font-black text-rose-600 bg-rose-50 px-3 py-1 rounded-xl border border-rose-200/60';

            document.getElementById('simCertBox').classList.add('hidden');
        }

        // Steps Log
        const logUl = document.getElementById('simStepsList');
        logUl.innerHTML = `
            <li>المرحلة 1: كويزات التوبيكس (${qScore}% × وزن ${qW}%) = <strong>${qContrib}</strong> درجة من 100.</li>
            <li>المرحلة 2: امتحانات الكاتيجوريز (${cScore}% × وزن ${cW}%) = <strong>${cContrib}</strong> درجة من 100.</li>
            <li>المرحلة 3: التكليفات الدورية (${aScore}% × وزن ${aW}%) = <strong>${aContrib}</strong> درجة من 100.</li>
            <li>المرحلة 4: الامتحان الفاينال الشامل (${fScore}% × وزن ${fW}%) = <strong>${fContrib}</strong> درجة من 100.</li>
            <li>المجموع التراكمي النهائي: <strong>${total} / 100 درجة</strong>.</li>
            <li class="${isPassed ? 'text-emerald-600 font-bold' : 'text-rose-600 font-bold'}">
                القرار الأكاديمي: ${isPassed ? `تم استيفاء حد النجاح (${passP}%) ⬅️ اعتماد الشهادة الرسمية.` : `الدرجة أقل من حد النجاح المطلوب (${passP}%).`}
            </li>
        `;
    }

    function randomizeSimScores() {
        document.getElementById('simQuizzes').value = Math.floor(Math.random() * 41) + 60;
        document.getElementById('simCatExams').value = Math.floor(Math.random() * 41) + 60;
        document.getElementById('simAssignments').value = Math.floor(Math.random() * 41) + 60;
        document.getElementById('simFinalExam').value = Math.floor(Math.random() * 41) + 60;
        runLocalSimulation();
    }

    // ==========================================
    // WEIGHTS MODAL
    // ==========================================
    function openWeightsModal() {
        if (!currentFlowData) return;
        const w = currentFlowData.weights;
        document.getElementById('inpQuizzesWeight').value = w.quizzesWeight;
        document.getElementById('inpCatExamsWeight').value = w.categoryExamsWeight;
        document.getElementById('inpAssignmentsWeight').value = w.assignmentsWeight;
        document.getElementById('inpFinalExamWeight').value = w.finalExamWeight;
        document.getElementById('inpPassingThreshold').value = w.passingPercentage;
        calcWeightsSum();
        document.getElementById('weightsModal').classList.remove('hidden');
    }

    function closeWeightsModal() {
        document.getElementById('weightsModal').classList.add('hidden');
    }

    function calcWeightsSum() {
        const q = parseFloat(document.getElementById('inpQuizzesWeight').value) || 0;
        const c = parseFloat(document.getElementById('inpCatExamsWeight').value) || 0;
        const a = parseFloat(document.getElementById('inpAssignmentsWeight').value) || 0;
        const f = parseFloat(document.getElementById('inpFinalExamWeight').value) || 0;
        const sum = q + c + a + f;

        const lbl = document.getElementById('lblWeightsSum');
        lbl.innerText = `${sum} / 100`;
        if (Math.abs(sum - 100) < 0.01) {
            lbl.className = 'font-mono text-sm text-emerald-600 font-black';
        } else {
            lbl.className = 'font-mono text-sm text-rose-600 font-black';
        }
    }

    async function saveCurriculumWeights(e) {
        e.preventDefault();
        const waveId = parseInt(document.getElementById('curriculumWaveSelect').value);
        const q = parseFloat(document.getElementById('inpQuizzesWeight').value) || 0;
        const c = parseFloat(document.getElementById('inpCatExamsWeight').value) || 0;
        const a = parseFloat(document.getElementById('inpAssignmentsWeight').value) || 0;
        const f = parseFloat(document.getElementById('inpFinalExamWeight').value) || 0;
        const pass = parseFloat(document.getElementById('inpPassingThreshold').value) || 60;

        if (Math.abs(q + c + a + f - 100) > 0.01) {
            alert('يجب أن يكون مجموع الأوزان 100 درجة بالضبط.');
            return;
        }

        const btn = document.getElementById('btnSaveWeights');
        btn.disabled = true;
        btn.innerText = 'جاري الحفظ...';

        try {
            const res = await fetch('/Admin/SaveCurriculumFlowWeights', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    waveId: waveId,
                    quizzesWeight: q,
                    categoryExamsWeight: c,
                    assignmentsWeight: a,
                    finalExamWeight: f,
                    passingPercentage: pass
                })
            });
            const data = await res.json();
            btn.disabled = false;
            btn.innerText = 'حفظ الأوزان للويف';

            if (data.success) {
                closeWeightsModal();
                alert(data.message);
                loadCurriculumFlowData();
            } else {
                alert(data.message || 'فشل الحفظ.');
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerText = 'حفظ الأوزان للويف';
            alert('حدث خطأ أثناء الحفظ.');
        }
    }

    function exportGradebookToExcel() {
        const table = document.getElementById('curriculumGradebookTable');
        let csv = [];
        for (let i = 0; i < table.rows.length; i++) {
            let row = [], cols = table.rows[i].cells;
            for (let j = 0; j < cols.length; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, '').replace(/(\s\s+)/gm, ' ');
                data = data.replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            csv.push(row.join(','));
        }
        const csvFile = new Blob(["\uFEFF" + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const downloadLink = document.createElement('a');
        downloadLink.download = `Wave_Curriculum_Gradebook_${document.getElementById('curriculumWaveSelect').value}.csv`;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = 'none';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadCurriculumFlowData();
    });
</script>

