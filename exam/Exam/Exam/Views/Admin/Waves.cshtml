                    popup: 'rounded-[32px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                    confirmButton: 'bg-amber-600 hover:bg-amber-700 text-white px-8 py-3.5 rounded-xl font-bold uppercase text-xs tracking-wider ml-2 shadow-md',
                    cancelButton: 'bg-white dark:bg-slate-800 hover:bg-slate-50 text-slate-400 font-bold uppercase text-xs px-8 py-3.5 rounded-xl border border-slate-200'
                },
                buttonsStyling: false,
                didOpen: () => {
                    renderModePillButtons('edit-mode-pills', 'edit-sw-mode', 'edit-sw-preview-code', 'edit-sw-preview-full', initialMode);
                },
                preConfirm: () => {
                    const name = document.getElementById('edit-sw-name').value;
                    const date = document.getElementById('edit-sw-date').value;
                    const endDate = document.getElementById('edit-sw-enddate').value;
                    const isActive = document.getElementById('edit-sw-active').value === 'true';
                    const finalMode = document.getElementById('edit-sw-mode').value || 'Offline (Off)';
                    const isOnline = finalMode.toLowerCase().includes('online');
                    if (!name || !name.trim()) {
                        Swal.showValidationMessage('اسم الويف مطلوب');
                        return false;
                    }
                    return { name: name.trim(), startDate: date || null, endDate: endDate || null, isOnline: isOnline, mode: finalMode.trim(), isActive: isActive };
                }
            });

            if (formValues) {
                try {
                    const res = await fetch('/Admin/EditWave', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ id: id, waveName: formValues.name, startDate: formValues.startDate, endDate: formValues.endDate, isOnline: formValues.isOnline, mode: formValues.mode, isActive: formValues.isActive })
                    });
                    const json = await res.json();
                    if (json.success) {
                        // Dynamically update the row in the table without reloading the page
                        const tr = $(`tr[data-waveid="${id}"]`);
                        if (tr.length) {
                            tr.find('td:nth-child(1) span.font-bold').text(formValues.name);
                            const isOnline = formValues.isOnline || formValues.mode.toLowerCase().includes('online');
                            const modeBadge = isOnline 
                                ? `<span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-800"><i class="fas fa-globe text-emerald-500 mr-1"></i>${formValues.mode}</span>`
                                : `<span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700"><i class="fas fa-building text-slate-400 mr-1"></i>${formValues.mode}</span>`;
                            tr.find('td:nth-child(2)').html(modeBadge);
                            
                            if (formValues.startDate) {
                                const d = new Date(formValues.startDate);
                                const formattedDate = d.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' });
                                tr.find('td:nth-child(3) span').text(formattedDate);
                            }
                            if (formValues.endDate) {
                                const d = new Date(formValues.endDate);
                                const formattedDate = d.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' });
                                tr.find('td:nth-child(4) span').text(formattedDate);
                            }
                            
                            const editBtn = tr.find('button[onclick^="editWave"]');
                            if (editBtn.length) {
                                editBtn.attr('onclick', `editWave(event, ${id}, '${formValues.name.replace(/'/g, "\\'")}', '${formValues.startDate || ""}', '${formValues.endDate || ""}', ${isOnline}, '${formValues.mode.replace(/'/g, "\\'")}')`);
                            }
                        }

                        showToast(json.message || 'تم تحديث بيانات الويف بنجاح', 'success');
                    } else {
                        showToast(json.message || 'تعذر تحديث بيانات الويف', 'error');
                    }
                } catch (e) {
                    console.error(e);
                    showToast('حدث خطأ أثناء التواصل مع السيرفر', 'error');
                }
            }
        }

        async function cloneWave(wid, wname) {
            event.stopPropagation();
            const { value: formValues } = await Swal.fire({
                title: 'Clone Batch',
                html:
                    '<div class="text-left space-y-4">' +
                    '<div class="bg-indigo-50 dark:bg-indigo-900/20 text-indigo-800 dark:text-indigo-300 p-4 rounded-xl text-xs font-medium mb-4"><i class="fas fa-info-circle mr-2"></i>This will duplicate the batch and all its underlying exams with new IDs, preserving the generation rules.</div>' +
                    `<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2">New Batch Name</label><input id="clone-sw-name" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-xl outline-none focus:border-brand-500 transition-all font-bold" value="${wname} - Copy"></div>` +
                    '<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2">New Start Date</label><input id="clone-sw-date" type="date" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-xl outline-none focus:border-brand-500 transition-all font-bold"></div>' +
                    '</div>',
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-copy mr-2"></i> Clone Batch',
                cancelButtonText: 'Cancel',
                preConfirm: () => {
                    return {
                        name: document.getElementById('clone-sw-name').value,
                        date: document.getElementById('clone-sw-date').value
                    }
                },
                customClass: {
                    popup: 'rounded-[32px]',
                    confirmButton: 'bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-bold uppercase text-xs tracking-widest',
                    cancelButton: 'text-slate-500 font-bold uppercase text-xs tracking-widest px-8 py-3'
                },
                buttonsStyling: false
            });

            if (formValues && formValues.name) {
                try {
                    const res = await fetch('/Admin/CloneWave', { 
                        method: 'POST', 
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, 
                        body: `waveId=${wid}&newWaveName=${encodeURIComponent(formValues.name)}&newStartDate=${formValues.date || ''}`
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast('تم استنساخ الويف بنجاح', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message || 'تعذر استنساخ الويف', 'error');
                    }
                } catch(e) {
                    showToast('حدث خطأ أثناء التواصل مع السيرفر', 'error');
                }
            }
        }

        async function deleteWave(wid, wname) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                html: `You are about to delete <b class="text-red-500">${wname}</b>.<br>This will set related records to NULL and cannot be undone!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'rounded-[32px]',
                    confirmButton: 'bg-red-600 hover:bg-red-700 text-white px-8 py-3 rounded-xl font-bold uppercase text-xs tracking-widest',
                    cancelButton: 'text-slate-500 font-bold uppercase text-xs tracking-widest px-8 py-3'
                },
                buttonsStyling: false,
                reverseButtons: true
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/Admin/DeleteWave?waveid=${wid}`, {
                        method: 'DELETE',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        const tr = $(`tr[data-waveid="${wid}"]`);
                        if ($.fn.DataTable && $.fn.DataTable.isDataTable('#wavesTable')) {
                            $('#wavesTable').DataTable().row(tr).remove().draw(false);
                        } else {
                            tr.fadeOut(300, function() { $(this).remove(); });
                        }
                        showToast(data.message || 'تم حذف الويف بنجاح', 'success');
                    } else {
                        showToast(data.message || 'فشل حذف الويف', 'error');
                    }
                } catch (error) {
                    showToast('فشل الاتصال بالسيرفر', 'error');
                }
            }
        }
        function escapeHtmlAttr(text) {
            if (!text) return '';
            return String(text).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

