                },
                buttonsStyling: false,
                didOpen: () => {
                    // Tab switching handler
                    window.switchAssignTab = function(tabName) {
                        const candidatesTab = document.getElementById('assignTabCandidates');
                        const emailTab = document.getElementById('assignTabEmail');
                        const btnCandidates = document.getElementById('tabBtnCandidates');
                        const btnEmail = document.getElementById('tabBtnEmail');

                        if (tabName === 'email') {
                            candidatesTab.classList.add('hidden');
                            emailTab.classList.remove('hidden');

                            btnCandidates.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 flex items-center gap-2';
                            btnEmail.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-600 text-white shadow-sm flex items-center gap-2';
                        } else {
                            emailTab.classList.add('hidden');
                            candidatesTab.classList.remove('hidden');

                            btnEmail.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 flex items-center gap-2';
                            btnCandidates.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-600 text-white shadow-sm flex items-center gap-2';
                        }
                    };

                    // Send email toggle handler
                    $('#sendEmailToggle').on('change', function() {
                        const enabled = this.checked;
                        const badge = $('#tabEmailStatus');
                        if (enabled) {
                            badge.removeClass('bg-slate-400').addClass('bg-emerald-500').text('ON');
                            $('#emailFieldsContainer').slideDown(200);
                        } else {
                            badge.removeClass('bg-emerald-500').addClass('bg-slate-400').text('OFF');
                            $('#emailFieldsContainer').slideUp(200);
                        }
                    });

                    // Insert placeholder into textarea at cursor position
                    window.insertPlaceholder = function(token) {
                        const textarea = document.getElementById('customEmailBody');
                        if (!textarea) return;
                        const start = textarea.selectionStart;
                        const end = textarea.selectionEnd;
                        const text = textarea.value;
                        textarea.value = text.substring(0, start) + token + text.substring(end);
                        textarea.focus();
                        textarea.selectionStart = textarea.selectionEnd = start + token.length;
                    };

                    // Toggle Live Preview
                    window.toggleEmailPreview = function() {
                        const previewBox = $('#emailPreviewBox');
                        const textarea = $('#customEmailBody');
                        const isHidden = previewBox.hasClass('hidden');

                        if (isHidden) {
                            const rawText = textarea.val() || '';
                            const sampleName = 'Ahmed Mohamed';
                            const waveTitle = wname;
                            const sampleDate = emailData?.startDate || 'October 15, 2026 - 10:00 AM';
                            const sampleLocation = emailData?.location || 'Offline in Main Branch';
                            const sampleUrl = 'http://41.33.149.186:5208';

                            let rendered = rawText
                                .replace(/{Name}/g, sampleName)
                                .replace(/{FullName}/g, sampleName)
                                .replace(/{UserName}/g, sampleName)
                                .replace(/{WaveName}/g, waveTitle)
                                .replace(/{StartDate}/g, sampleDate)
                                .replace(/{Location}/g, sampleLocation)
                                .replace(/{PortalLink}/g, `<a href="${sampleUrl}" class="text-brand-600 underline" target="_blank">${sampleUrl}</a>`);

                            rendered = rendered.replace(/\n/g, '<br/>');

                            previewBox.html(`
                                <div class="border-b border-slate-200 dark:border-slate-800 pb-2 mb-3">
                                    <p class="text-[10px] uppercase font-black tracking-widest text-slate-400">Preview with sample data (معاينة مع بيانات تجريبية):</p>
                                    <p class="font-bold text-slate-800 dark:text-white mt-1">Subject: ${$('#customEmailSubject').val()}</p>
                                </div>
                                <div dir="auto" class="text-slate-700 dark:text-slate-200 font-sans">${rendered}</div>
                            `);
                            previewBox.removeClass('hidden');
                            $('#previewBtnText').text('Hide Preview / إخفاء المعاينة');
                        } else {
                            previewBox.addClass('hidden');
                            $('#previewBtnText').text('Live Preview / معاينة الإيميل');
                        }
                    };

                    window._waveFilterFn = function(settings, data, dataIndex) {
                        if (settings.nTable.id !== 'swalUserTable') return true;
                        
                        const certChecked = $('#filterNoCert').is(':checked');
                        const assignChecked = $('#filterNotAssigned').is(':checked');
                        const selectedCity = ($('#filterCitySelect').val() || '').trim();
                        const selectedBranch = ($('#filterBranchSelect').val() || '').trim().toLowerCase();
                        const row = settings.aoData[dataIndex].nTr;
                        
                        if (certChecked) {
                            if ($(row).attr('data-has-cert') !== 'false') return false;
                        }
                        
                        if (assignChecked) {
                            if ($(row).attr('data-is-assigned') !== 'false') return false;
                        }

                        // City filter logic (handles exact city or outside mansoura preset)
                        if (selectedCity === '__outside_mansoura__') {
                            const rowCity = ($(row).attr('data-city') || '').trim();
                            if (rowCity === 'المنصورة') return false;
                        } else if (selectedCity) {
                            const rowCity = ($(row).attr('data-city') || '').trim();
                            if (rowCity !== selectedCity) return false;
                        }

                        // Branch filter logic
                        if (selectedBranch) {
                            const rowBranch = ($(row).attr('data-branch') || '').trim().toLowerCase();
                            if (rowBranch !== selectedBranch) return false;
                        }
                        
                        return true;
                    };
                    $.fn.dataTable.ext.search.push(window._waveFilterFn);

                    const table = $('#swalUserTable').DataTable({
                        pageLength: 5,
                        lengthMenu: [5, 10, 25, 50],
                        language: { search: "", searchPlaceholder: "Search User..." },
                        columnDefs: [{ orderable: false, targets: 0 }]
                    });
                    
                    function updateSelectedCount() {
                        const count = table.$('input.user-cb:checked').length;
                        $('#tabSelectedCount').text(count);
                    }

                    // City filter change handler (auto synchronizes branch dropdown)
                    $('#filterCitySelect').on('change', function() {
                        const selCity = $(this).val();
                        const branchSelect = $('#filterBranchSelect');
                        
                        let filteredBranches;
                        if (selCity === '__outside_mansoura__') {
                            filteredBranches = branches.filter(b => b.city !== 'المنصورة');
                        } else if (selCity) {
                            filteredBranches = branches.filter(b => b.city === selCity);
                        } else {
                            filteredBranches = branches;
                        }
                        
                        let branchOptionsHtml = `<option value="">جميع الفروع / All Branches (${filteredBranches.length})</option>`;
                        filteredBranches.forEach(b => {
                            branchOptionsHtml += `<option value="${escapeHtmlAttr(b.name)}" data-city="${escapeHtmlAttr(b.city)}">${b.name} (${b.count})</option>`;
                        });
                        branchSelect.html(branchOptionsHtml);
                        branchSelect.val('');

                        table.draw();
                    });

                    // Branch filter change handler
                    $('#filterBranchSelect').on('change', function() {
                        table.draw();
                    });

                    // Quick buttons: Select All Filtered and Deselect All
                    $('#btnSelectAllFiltered').on('click', function() {
                        const rows = table.rows({ search: 'applied' }).nodes();
                        $('input.user-cb:not(:disabled)', rows).prop('checked', true);
                        $('#selectAllSwal').prop('checked', true);
                        updateSelectedCount();
                    });

                    $('#btnDeselectAll').on('click', function() {
                        const rows = table.rows().nodes();
                        $('input.user-cb', rows).prop('checked', false);
                        $('#selectAllSwal').prop('checked', false);
                        updateSelectedCount();
                    });

                    $('#filterNoCert, #filterNotAssigned').on('change', function() {
                        table.draw();
                    });

                    $('#selectAllSwal').on('change', function() {
                        const rows = table.rows({ search: 'applied' }).nodes();
                        $('input.user-cb:not(:disabled)', rows).prop('checked', this.checked);
                        updateSelectedCount();
                    });

                    $('#swalUserTable tbody').on('change', 'input.user-cb', function() {
                        updateSelectedCount();
                    });

                    $('#swalUserTable tbody').on('click', 'tr', function(e) {
                        if ($(e.target).is('input[type="checkbox"]')) return;
                        const cb = $(this).find('input.user-cb');
                        if(cb.length && !cb.is(':disabled')) {
                            cb.prop('checked', !cb.prop('checked'));
                            updateSelectedCount();
                        }
                    });

                    $('.dataTables_filter input').addClass('bg-slate-50 border-slate-200 rounded-xl px-4 py-2 text-xs focus:ring-0 outline-none mb-4');
                },
                didClose: () => {
                    if (window._waveFilterFn) {
                        const idx = $.fn.dataTable.ext.search.indexOf(window._waveFilterFn);
                        if (idx !== -1) $.fn.dataTable.ext.search.splice(idx, 1);
                        window._waveFilterFn = null;
                    }
                    delete window.switchAssignTab;
                    delete window.insertPlaceholder;
                    delete window.toggleEmailPreview;
                },
                preConfirm: async () => {
                    const ids = [];
                    $('#swalUserTable').DataTable().$('input.user-cb:checked').each(function() {
                        ids.push($(this).val());
                    });
                    if(!ids.length) { 
                        Swal.showValidationMessage('Please select at least one User.'); 
                        return false; 
                    }

                    const sendEmail = $('#sendEmailToggle').is(':checked');
                    const customSubject = $('#customEmailSubject').val();
                    const customBody = $('#customEmailBody').val();
                    const saveAsDefault = $('#saveEmailDefaultCheck').is(':checked');

                    const payload = {
                        userIds: ids,
                        sendEmail: sendEmail,
                        customSubject: customSubject,
                        customBody: customBody,
                        saveAsDefault: saveAsDefault
                    };
                    
                    Swal.showLoading();
                    try {
                        const r = await fetch(`/Admin/AssignUsersToWave?waveId=${wid}`, { 
                            method: 'POST', 
                            headers: { 'Content-Type': 'application/json' }, 
                            body: JSON.stringify(payload) 
                        });
                        
                        if(r.ok) {
                            showToast(sendEmail ? 'Personnel assigned and emails dispatched.' : 'Personnel assigned successfully (Email disabled).', 'success');
                            
                            // Update the UI state inside the modal without closing it
                            const table = $('#swalUserTable').DataTable();
                            ids.forEach(id => {
                                const cb = $(`#swalUserTable input.user-cb[value="${id}"]`);
                                const row = cb.closest('tr');
                                
                                // Disable checkbox and uncheck
                                cb.prop('checked', false).prop('disabled', true);
                                
                                // Add assigned style
                                row.addClass('opacity-50 grayscale-[0.5]');
                                row.attr('data-is-assigned', 'true');
                                
                                // Append "Enrolled" badge if not already there
                                const nameSpan = row.find('span.font-bold.text-slate-900');
                                if (nameSpan.length && !row.find('.enrolled-badge').length) {
                                    nameSpan.after('<span class="enrolled-badge text-[7px] bg-slate-200 text-slate-500 px-1 rounded uppercase font-black ml-2">Enrolled</span>');
                                }
                            });
                            
                            // Uncheck select all header
                            $('#selectAllSwal').prop('checked', false);
                            $('#tabSelectedCount').text('0');
                            
                            // Re-filter and redraw table
                            table.draw();
                            
                            Swal.hideLoading();
                            return false; // Returning false prevents the modal from closing!
                        } else {
                            Swal.showValidationMessage('Failed to assign users. Please try again.');
                            Swal.hideLoading();
                            return false;
                        }
                    } catch (err) {
                        Swal.showValidationMessage('Server error occurred.');
                        Swal.hideLoading();
                        return false;
                    }
                }
            });
        }

