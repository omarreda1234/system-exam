                                            </label>
                                            <button type="button" onclick="window.toggleWzEmailPreview()" id="wzTogglePreviewBtn" class="text-xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400 flex items-center gap-1.5 transition-colors">
                                                <i class="fas fa-eye text-xs"></i> <span id="wzPreviewBtnText">معاينة حية للإيميل (Live Preview)</span>
                                            </button>
                                        </div>
                                        <textarea id="wzCustomEmailBody" rows="7" dir="auto" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3.5 text-xs text-slate-800 dark:text-slate-100 font-sans focus:ring-2 focus:ring-brand-500 focus:outline-none transition-all leading-relaxed"></textarea>

                                        <!-- Live Preview Box -->
                                        <div id="wzEmailPreviewBox" class="hidden p-4 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl mt-2 text-xs leading-relaxed max-h-56 overflow-y-auto"></div>
                                    </div>

                                    <!-- Checkbox to Save as Default -->
                                    <div class="flex items-center gap-2 pt-1">
                                        <input type="checkbox" id="wzSaveEmailDefaultCheck" class="w-4 h-4 accent-brand-500 rounded cursor-pointer" checked>
                                        <label for="wzSaveEmailDefaultCheck" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer select-none">
                                            حفظ هذا القالب كقالب افتراضي لجميع الويفات القادمة (Save as default template)
                                        </label>
                                    </div>
                                </div>

                                <!-- Step 3 Navigation Actions -->
                                <div class="pt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                    <button type="button" onclick="window.wzGoToStep(2)" class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all flex items-center gap-2">
                                        <i class="fas fa-arrow-right text-[11px]"></i>
                                        <span>السابق: تعديل المرشحين</span>
                                    </button>
                                    <button type="button" id="wzBtnFinishLaunch" onclick="window.wzSubmitFullWizard()" class="px-8 py-3 rounded-xl text-xs font-black bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white shadow-lg hover:shadow-xl transition-all flex items-center gap-2">
                                        <i class="fas fa-rocket text-sm"></i>
                                        <span>إنشاء الويف وتعيين المرشحين وإرسال الإيميل (Finish & Launch)</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `,
                    didOpen: () => {
                        renderModePillButtons('wz-create-mode-pills', 'wz-mode', 'wz-preview-code', 'wz-preview-full', initialMode);

                        // Set default email body and subject
                        $('#wzCustomEmailSubject').val('Welcome to {WaveName} - Registration Confirmed');
                        $('#wzCustomEmailBody').val(
`Dear {Name},

Welcome to {WaveName} of Pharmacy Basics Program — we’re glad to have you with us!

Your registration has been successfully confirmed. Here are your session details:
📅 Date & Time: {StartDate}
📍 Location: {Location}

A quick note before we start:
• Please arrive 10–15 minutes early to ensure a smooth check-in.
• Keep an eye on your email for any further updates or announcements.

If you have any questions or face any issues, feel free to reach out to us.
Looking forward to seeing you and having a great Training Program together!

Best regards,
Eltarshoubi Training Academy Team`
                        );

                        // Email Toggle Change Handler
                        $('#wzSendEmailToggle').on('change', function() {
                            if (this.checked) {
                                $('#wzEmailFieldsContainer').slideDown(200);
                            } else {
                                $('#wzEmailFieldsContainer').slideUp(200);
                            }
                        });

                        // Hide validation error on input
                        $('#wz-name').on('input', function() {
                            if ($(this).val().trim()) {
                                $('#wz-name-err').addClass('hidden');
                            }
                        });

                        // Date Helper: Calculate End Date from Start Date & target training days (excluding Friday)
                        function calcEndDateFromTrainingDays(startDateStr, targetDays) {
                            if (!startDateStr || !targetDays || targetDays <= 0) return null;
                            const parts = startDateStr.split('-');
                            const cur = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                            let counted = 0;
                            while (counted < targetDays) {
                                if (cur.getDay() !== 5) { // 5 is Friday
                                    counted++;
                                    if (counted >= targetDays) break;
                                }
                                cur.setDate(cur.getDate() + 1);
                            }
                            const y = cur.getFullYear();
                            const m = String(cur.getMonth() + 1).padStart(2, '0');
                            const d = String(cur.getDate()).padStart(2, '0');
                            return `${y}-${m}-${d}`;
                        }

                        // Date Helper: Count non-Friday training days between start and end
                        function countTrainingDays(startDateStr, endDateStr) {
                            if (!startDateStr || !endDateStr) return 0;
                            const p1 = startDateStr.split('-');
                            const p2 = endDateStr.split('-');
                            const start = new Date(parseInt(p1[0], 10), parseInt(p1[1], 10) - 1, parseInt(p1[2], 10));
                            const end = new Date(parseInt(p2[0], 10), parseInt(p2[1], 10) - 1, parseInt(p2[2], 10));
                            if (end < start) return 0;
                            let count = 0;
                            const cur = new Date(start);
                            while (cur <= end) {
                                if (cur.getDay() !== 5) {
                                    count++;
                                }
                                cur.setDate(cur.getDate() + 1);
                            }
                            return count;
                        }

                        // Dynamic Attendance Sessions Calculator & Preview
                        function updateWzSessionsPreview() {
                            const startVal = $('#wz-date').val();
                            let daysCount = parseInt($('#wz-days-count').val(), 10) || 12;

                            if (!startVal) {
                                $('#wz-sessions-badge').text('في انتظار تحديد تاريخ البدء');
                                $('#wz-sessions-desc').text(`حدد تاريخ البدء وسيتم جدولة ${daysCount} جلسة حضور يومياً من 09:00 ص إلى 12:00 م (عدا الجمعة).`);
                                return daysCount;
                            }

                            let endVal = $('#wz-enddate').val();
                            if (!endVal) {
                                endVal = calcEndDateFromTrainingDays(startVal, daysCount);
                                $('#wz-enddate').val(endVal);
                            }

                            const sessionCount = countTrainingDays(startVal, endVal);
                            $('#wz-sessions-badge').text(`${sessionCount} جلسة تدريب`);
                            $('#wz-sessions-desc').text(`يومياً من ${startVal} حتى ${endVal} من الساعة 09:00 ص إلى 12:00 م (3 ساعات) — مستثنى يوم الجمعة (إجازة أسبوعية).`);
                            return sessionCount;
                        }

                        window.setWzDurationDays = function(days, btn) {
                            $('#wz-days-count').val(days);
                            $('.wz-dur-btn').removeClass('active border-brand-500 bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-300')
                                            .addClass('border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300');
                            if (btn) {
                                $(btn).addClass('active border-brand-500 bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-300')
                                      .removeClass('border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300');
                            }
                            const startVal = $('#wz-date').val();
                            if (startVal) {
                                const newEnd = calcEndDateFromTrainingDays(startVal, days);
                                $('#wz-enddate').val(newEnd);
                            }
                            updateWzSessionsPreview();
                        };

                        // When Start Date changes:
                        $('#wz-date').on('change', function() {
                            const startVal = $(this).val();
                            const days = parseInt($('#wz-days-count').val(), 10) || 12;
                            if (startVal && days > 0) {
                                const newEnd = calcEndDateFromTrainingDays(startVal, days);
                                $('#wz-enddate').val(newEnd);
                            }
                            updateWzSessionsPreview();
                        });

                        // When Days input changes:
                        $('#wz-days-count').on('input change', function() {
                            const days = parseInt($(this).val(), 10) || 0;
                            const startVal = $('#wz-date').val();
                            if (startVal && days > 0) {
                                const newEnd = calcEndDateFromTrainingDays(startVal, days);
                                $('#wz-enddate').val(newEnd);
                            }
                            $('.wz-dur-btn').each(function() {
                                const d = parseInt($(this).text(), 10);
                                if (d === days) {
                                    $(this).addClass('active border-brand-500 bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-300')
                                           .removeClass('border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300');
                                } else {
                                    $(this).removeClass('active border-brand-500 bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-300')
                                           .addClass('border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300');
                                }
                            });
                            updateWzSessionsPreview();
                        });

                        // When End Date changes manually:
                        $('#wz-enddate').on('change', function() {
                            const startVal = $('#wz-date').val();
                            const endVal = $(this).val();
                            if (startVal && endVal) {
                                const days = countTrainingDays(startVal, endVal);
                                $('#wz-days-count').val(days);
                            }
                            updateWzSessionsPreview();
                        });

                        // Auto set default start date to today if empty
                        if (!$('#wz-date').val()) {
                            const todayIso = new Date().toISOString().split('T')[0];
                            $('#wz-date').val(todayIso);
                            const initialEnd = calcEndDateFromTrainingDays(todayIso, 12);
                            $('#wz-enddate').val(initialEnd);
                        }

                        // Initial preview setup
                        updateWzSessionsPreview();

                        // Navigation Step Handler (Free navigation between steps without blocking)
                        window.wzCurrentStep = 1;
                        window.wzGoToStep = async function(stepNum) {
                            if (stepNum === window.wzCurrentStep) return;

                            // 1. Instantly clear any error messages
                            $('#wz-name-err').addClass('hidden');

                            // 2. Instantly update step visibility (Immediate visual navigation)
                            $('#wzStep1, #wzStep2, #wzStep3').addClass('hidden');
                            $(`#wzStep${stepNum}`).removeClass('hidden');

                            // 3. Instantly update stepper breadcrumb UI
                            [1, 2, 3].forEach(n => {
                                const ind = $(`#wzStepIndicator${n}`);
                                const badge = $(`#wzStep${n}Badge`);
                                if (n === stepNum) {
                                    ind.removeClass('bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400 bg-emerald-600')
                                       .addClass('bg-brand-600 text-white shadow-sm');
                                    badge.html(n);
                                } else if (n < stepNum) {
                                    ind.removeClass('bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400 bg-brand-600')
                                       .addClass('bg-emerald-600 text-white shadow-xs');
                                    badge.html('<i class="fas fa-check text-[9px]"></i>');
                                } else {
                                    ind.removeClass('bg-brand-600 bg-emerald-600 text-white')
                                       .addClass('bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400');
                                    badge.html(n);
                                }
                            });

                            window.wzCurrentStep = stepNum;

                            // 4. Asynchronously handle Step 2 (Candidates table setup)
                            if (stepNum === 2) {
                                const currentName = $('#wz-name').val().trim() || 'ويف جديد (لم يُحدد الاسم بعد)';
                                const currentMode = $('#wz-mode').val() || 'Offline (Off)';
                                $('#wzStep2WaveSummary').text(`${currentName} • [${currentMode}]`);

                                if (!cachedCandidates) {
                                    $('#wzCandidatesTableContainer').html('<div class="py-12 text-center text-slate-400 font-bold"><i class="fas fa-spinner fa-spin text-2xl text-brand-500 mb-2"></i><br>جاري تحميل قائمة الموظفين والمرشحين...</div>');
                                    try {
                                        const raw = await candidatesPromise;
                                        cachedCandidates = (raw || []).filter(u => {
                                            const role = (u.roleName || u.RoleName || '').toLowerCase();
                                            return role === 'pharmacist' || role === 'assistant' || role === 'صيدلي' || role === 'مساعد صيدلي';
                                        }).map(u => ({
                                            id: u.id ?? u.Id,
                                            userName: u.userName ?? u.UserName,
                                            email: u.email ?? u.Email,
                                            userCode: u.userCode ?? u.UserCode ?? '--',
                                            branchName: (u.branchName ?? u.BranchName ?? 'GLOBAL').trim(),
                                            roleName: u.roleName ?? u.RoleName ?? 'User',
                                            certificateCode: u.certificateCode ?? u.CertificateCode ?? null,
                                            city: (u.city ?? u.City ?? 'المنصورة').trim(),
                                            isAssigned: false
                                        }));
                                    } catch (err) {
                                        cachedCandidates = [];
                                    }

                                    // Build city and branch lists
                                    const cityCounts = {};
                                    const branchCounts = {};
                                    const branchCityMap = {};
                                    cachedCandidates.forEach(u => {
                                        const c = u.city || 'المنصورة';
                                        const b = u.branchName || 'GLOBAL';
                                        cityCounts[c] = (cityCounts[c] || 0) + 1;
                                        branchCounts[b] = (branchCounts[b] || 0) + 1;
                                        branchCityMap[b] = c;
                                    });

                                    const cities = Object.keys(cityCounts).sort().map(c => ({ name: c, count: cityCounts[c] }));
                                    const branches = Object.keys(branchCounts).sort().map(b => ({ name: b, count: branchCounts[b], city: branchCityMap[b] }));
                                    window._wzBranchesList = branches;

                                    const mansouraCount = cityCounts['المنصورة'] || 0;
                                    const outsideMansouraCount = cachedCandidates.filter(u => u.city !== 'المنصورة').length;

                                    // Populate City dropdown
                                    let cityOpts = `<option value="">جميع المدن / All Cities (${cities.length})</option>`;
                                    if (mansouraCount > 0) {
                                        cityOpts += `<option value="المنصورة">📍 المنصورة (${mansouraCount} مرشح - فروع الأوفلاين)</option>`;
                                    }
                                    if (outsideMansouraCount > 0) {
                                        cityOpts += `<option value="__outside_mansoura__">🌐 كل الفروع خارج المنصورة (${outsideMansouraCount} مرشح - فروع الأونلاين)</option>`;
                                    }
                                    cityOpts += `<option disabled>──────────</option>`;
                                    cities.filter(c => c.name !== 'المنصورة').forEach(c => {
                                        cityOpts += `<option value="${escapeHtmlAttr(c.name)}">${c.name} (${c.count} مرشح)</option>`;
                                    });
                                    $('#wzFilterCitySelect').html(cityOpts);

                                    // Populate Branch dropdown
                                    let branchOpts = `<option value="">جميع الفروع / All Branches (${branches.length})</option>`;
                                    branches.forEach(b => {
                                        branchOpts += `<option value="${escapeHtmlAttr(b.name)}" data-city="${escapeHtmlAttr(b.city)}">${b.name} (${b.count})</option>`;
                                    });
                                    $('#wzFilterBranchSelect').html(branchOpts);

                                    // Populate Table HTML
                                    const tableHtml = `
                                        <table id="wzUserTable" class="saas-table display nowrap w-full text-xs text-right" dir="rtl">
                                            <thead>
                                                <tr class="bg-slate-50 dark:bg-slate-800">
                                                    <th class="w-10 text-center"><input type="checkbox" id="wzSelectAllTable" class="w-4 h-4 accent-brand-500"></th>
                                                    <th>الموظف / المرشح</th>
                                                    <th>الكود</th>
                                                    <th>الفرع / المدينة</th>
                                                    <th>الوظيفة</th>
                                                    <th>كود الشهادة</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${cachedCandidates.map(u => `
                                                    <tr class="cursor-pointer border-b border-slate-50 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors"
                                                        data-has-cert="${u.certificateCode ? 'true' : 'false'}"
                                                        data-is-assigned="false"
                                                        data-city="${escapeHtmlAttr(u.city)}"
                                                        data-branch="${escapeHtmlAttr(u.branchName.toLowerCase())}">
                                                        <td class="text-center"><input type="checkbox" class="wz-user-cb w-4 h-4 accent-brand-500" value="${u.id}"></td>
                                                        <td>
                                                            <div class="flex flex-col">
                                                                <span class="font-bold text-slate-900 dark:text-white">${u.userName}</span>
                                                                <span class="text-[9px] text-slate-400 font-mono" dir="ltr">${u.email}</span>
                                                            </div>
                                                        </td>
                                                        <td class="font-bold text-slate-500 font-mono">${u.userCode}</td>
                                                        <td>
                                                            <div class="flex flex-col">
                                                                <span class="font-bold text-slate-700 dark:text-slate-200">${u.branchName}</span>
                                                                <span class="text-[10px] font-bold text-sky-600 dark:text-sky-400 flex items-center gap-1 mt-0.5">
                                                                    <i class="fas fa-map-marker-alt text-[8px]"></i>
                                                                    ${u.city}
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td><span class="text-[8px] font-bold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-600 dark:text-slate-300 uppercase">${u.roleName}</span></td>
                                                        <td class="font-mono text-[9px] text-brand-600">${u.certificateCode || '<span class="text-slate-300">--</span>'}</td>
                                                    </tr>
                                                `).join('')}
                                            </tbody>
                                        </table>
                                    `;
                                    $('#wzCandidatesTableContainer').html(tableHtml);

                                    // Custom DataTables Filter
                                    window._wzFilterFn = function(settings, data, dataIndex) {
                                        if (settings.nTable.id !== 'wzUserTable') return true;
                                        const certChecked = $('#wzFilterNoCert').is(':checked');
                                        const assignChecked = $('#wzFilterNotAssigned').is(':checked');
                                        const selectedCity = ($('#wzFilterCitySelect').val() || '').trim();
                                        const selectedBranch = ($('#wzFilterBranchSelect').val() || '').trim().toLowerCase();
                                        const row = settings.aoData[dataIndex].nTr;
                                        
                                        if (certChecked && $(row).attr('data-has-cert') !== 'false') return false;
                                        if (assignChecked && $(row).attr('data-is-assigned') !== 'false') return false;

                                        if (selectedCity === '__outside_mansoura__') {
                                            const rowCity = ($(row).attr('data-city') || '').trim();
                                            if (rowCity === 'المنصورة') return false;
                                        } else if (selectedCity) {
                                            const rowCity = ($(row).attr('data-city') || '').trim();
                                            if (rowCity !== selectedCity) return false;
                                        }

                                        if (selectedBranch) {
                                            const rowBranch = ($(row).attr('data-branch') || '').trim().toLowerCase();
                                            if (rowBranch !== selectedBranch) return false;
                                        }
                                        return true;
                                    };
                                    $.fn.dataTable.ext.search.push(window._wzFilterFn);

                                    if ($.fn.DataTable.isDataTable('#wzUserTable')) {
                                        $('#wzUserTable').DataTable().destroy();
                                    }

                                    wzTable = $('#wzUserTable').DataTable({
                                        pageLength: 5,
                                        lengthMenu: [5, 10, 25, 50],
                                        language: { search: "", searchPlaceholder: "Search User..." },
                                        columnDefs: [{ orderable: false, targets: 0 }]
                                    });

                                    // Auto preselect based on Step 1 Mode!
                                    const modeNormalized = currentMode.toLowerCase();
                                    if (modeNormalized.includes('off') || modeNormalized.includes('offline') || modeNormalized.includes('onsite')) {
                                        $('#wzFilterCitySelect').val('المنصورة').trigger('change');
                                    } else if (modeNormalized.includes('online') || modeNormalized.includes('on')) {
                                        $('#wzFilterCitySelect').val('__outside_mansoura__').trigger('change');
                                    }
                                }

                                // Adjust column sizes once visible
                                setTimeout(() => {
                                    if (wzTable) wzTable.columns.adjust().draw();
                                }, 50);
                            }

                            // 5. Asynchronously handle Step 3 (Summary card population)
                            if (stepNum === 3) {
                                const selCount = wzTable ? wzTable.$('input.wz-user-cb:checked').length : 0;
                                const currentName = $('#wz-name').val().trim() || 'ويف جديد (لم يُحدد الاسم بعد)';
                                const currentMode = $('#wz-mode').val() || 'Offline (Off)';
                                const currentDate = $('#wz-date').val() || 'غير محدد';
                                const daysCount = parseInt($('#wz-days-count').val(), 10) || 12;
                                const endDate = $('#wz-enddate').val() || '';

                                $('#wzRevName').text(currentName);
                                $('#wzRevMode').text(currentMode);
                                $('#wzRevDate').text(`${currentDate} (${daysCount} يوم تدريب حتى ${endDate})`);
                                $('#wzRevCount').text(`${selCount} مرشح تم تحديدهم`);

                                if (selCount === 0) {
                                    $('#wzRevCount').removeClass('text-emerald-600').addClass('text-amber-500').text('0 مرشح (سيتم إنشاء الويف فارغة)');
                                } else {
                                    $('#wzRevCount').removeClass('text-amber-500').addClass('text-emerald-600').text(`${selCount} مرشح تم تحديدهم`);
                                }
                            }
                        };

                        // Selection Count Updater
                        function updateWzSelectedCount() {
                            if (!wzTable) return;
                            const count = wzTable.$('input.wz-user-cb:checked').length;
                            $('#wzSelectedCounter').text(count);
                            const badge = $('#wzBadgeCandidateCount');
                            if (count > 0) {
                                badge.removeClass('hidden').text(count);
                            } else {
                                badge.addClass('hidden');
                            }
                        }

                        // City filter change in wizard
                        $(document).on('change', '#wzFilterCitySelect', function() {
                            const selCity = $(this).val();
                            const branchSelect = $('#wzFilterBranchSelect');
                            const branches = window._wzBranchesList || [];
                            
                            let filteredBranches;
                            if (selCity === '__outside_mansoura__') {
                                filteredBranches = branches.filter(b => b.city !== 'المنصورة');
                            } else if (selCity) {
                                filteredBranches = branches.filter(b => b.city === selCity);
                            } else {
                                filteredBranches = branches;
