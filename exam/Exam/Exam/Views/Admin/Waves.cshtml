                    `<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2 text-right">تاريخ البدء (Start Date):</label><input id="edit-sw-date" type="date" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl outline-none focus:border-amber-500 transition-all font-bold text-sm" value="${currentDate}"></div>` +
                    `<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2 text-right">تاريخ الانتهاء (End Date):</label><input id="edit-sw-enddate" type="date" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl outline-none focus:border-amber-500 transition-all font-bold text-sm" value="${currentEndDate}"></div>` +
