                                    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 bg-slate-50 dark:bg-slate-800/60 p-3 rounded-2xl border border-slate-200/80 dark:border-slate-700">
                                        <div class="flex items-center gap-2 text-xs font-bold text-slate-600 dark:text-slate-300">
                                            <span class="px-2.5 py-1 rounded-xl bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-brand-600 shadow-xs">
                                                Selected: <strong id="selectedEnrolledCounter">0</strong> of ${users.length}
                                            </span>
                                            <span class="text-[11px] text-slate-400 font-normal">Select candidates to email specifically, or leave unselected to email all.</span>
                                        </div>
                                        <button type="button" onclick="window.switchEnrolledModalTab('email')" class="text-xs font-bold text-emerald-700 hover:text-white bg-emerald-50 hover:bg-emerald-600 border border-emerald-200 hover:border-emerald-600 px-3.5 py-1.5 rounded-xl transition-all shadow-xs flex items-center gap-1.5">
                                            <i class="fas fa-paper-plane text-xs"></i> Customize & Send Email
                                        </button>
                                    </div>

                                    <table id="swalWaveDetailsTable" class="saas-table display nowrap w-full text-xs">
                                        <thead>
                                            <tr class="bg-slate-50">
                                                <th class="w-10"><input type="checkbox" id="selectAllEnrolledList" class="w-4 h-4 accent-brand-500"></th>
                                                <th>User</th>
                                                <th>Code</th>
                                                <th>Role</th>
                                                <th>Branch</th>
                                                <th class="text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${users.map(u => `
                                                <tr class="border-b border-slate-50 cursor-pointer">
                                                    <td><input type="checkbox" class="enrolled-user-cb w-4 h-4 accent-brand-500" value="${u.id ?? u.Id}"></td>
                                                    <td>
                                                        <div class="flex flex-col">
                                                            <span class="font-bold text-slate-900 dark:text-white">${u.userName ?? u.UserName}</span>
                                                            <span class="text-[10px] text-slate-400 font-medium">${u.email ?? u.Email}</span>
                                                        </div>
                                                    </td>
                                                    <td class="font-bold text-slate-500">${u.userCode ?? u.UserCode ?? '--'}</td>
                                                    <td>
                                                        <span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase bg-slate-100 text-slate-500 border border-slate-200">
                                                            ${u.roleName ?? u.RoleName ?? 'User'}
                                                        </span>
                                                    </td>
                                                    <td class="font-bold text-slate-400 text-[10px] uppercase">${u.branchName ?? u.BranchName ?? 'N/A'}</td>
                                                    <td class="text-right">
                                                        ${canDeleteWaveAssign ? `
                                                            <button class="p-2 text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg remove-user-btn" 
                                                                    data-waveid="${wid}" 
                                                                    data-userid="${u.id ?? u.Id}"
                                                                    data-username="${u.userName ?? u.UserName}">
                                                                <i class="fas fa-user-minus"></i>
                                                            </button>
                                                        ` : '--'}
                                                    </td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                    ${users.length === 0 ? '<div class="p-12 text-center text-slate-400 font-bold uppercase tracking-widest">No personnel enrolled in this batch</div>' : ''}
                                </div>

                                <!-- TAB 2: CUSTOMIZE & SEND EMAIL -->
                                <div id="enrolledTabEmail" class="hidden space-y-4">
                                    <div class="p-3.5 bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/40 rounded-2xl flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-600 flex items-center justify-center text-base">
                                                <i class="fas fa-envelope-open-text"></i>
                                            </div>
                                            <div>
                                                <p class="text-xs font-black text-emerald-900 dark:text-emerald-200 uppercase tracking-wide">
                                                    Dispatch Target: <span id="enrolledEmailTargetDesc">All (${users.length}) Enrolled Personnel</span>
                                                </p>
                                                <p class="text-[11px] text-emerald-700/80 dark:text-emerald-400">
                                                    يمكنك إرسال وتخصيص الرسالة الآن لجميع متدربي الويف أو للمتدربين المحددين فقط.
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Subject -->
                                    <div>
                                        <label class="block text-xs font-black text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                                            Email Subject / عنوان الرسالة:
                                        </label>
                                        <input type="text" id="enrolledEmailSubject" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none transition-all" value="${escapeHtmlAttr(initialSubject)}">
                                    </div>

                                    <!-- Placeholders Toolbar -->
                                    <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60 p-3 rounded-xl">
                                        <div class="flex items-center justify-between mb-1.5">
                                            <span class="text-[11px] font-bold text-slate-600 dark:text-slate-300 flex items-center gap-1.5">
                                                <i class="fas fa-tags text-brand-500"></i> Placeholders (اضغط لإدراج المتغير التلقائي في الرسالة):
                                            </span>
                                        </div>
                                        <div class="flex flex-wrap gap-1.5">
                                            <button type="button" onclick="window.insertEnrolledPlaceholder('{Name}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{Name} (اسم المتدرب)</button>
                                            <button type="button" onclick="window.insertEnrolledPlaceholder('{WaveName}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{WaveName} (اسم الويف)</button>
                                            <button type="button" onclick="window.insertEnrolledPlaceholder('{StartDate}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{StartDate} (تاريخ البدء)</button>
                                            <button type="button" onclick="window.insertEnrolledPlaceholder('{Location}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{Location} (مكان التدريب)</button>
                                            <button type="button" onclick="window.insertEnrolledPlaceholder('{PortalLink}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{PortalLink} (رابط المنصة)</button>
                                        </div>
                                    </div>

                                    <!-- Body Textarea -->
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <label class="block text-xs font-black text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                                                Email Message Body / نص رسالة الإيميل:
                                            </label>
                                            <button type="button" onclick="window.toggleEnrolledEmailPreview()" id="toggleEnrolledPreviewBtn" class="text-xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400 flex items-center gap-1.5 transition-colors">
                                                <i class="fas fa-eye text-xs"></i> <span id="enrolledPreviewBtnText">Live Preview / معاينة الإيميل</span>
                                            </button>
                                        </div>
                                        <textarea id="enrolledEmailBody" rows="9" dir="auto" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3.5 text-xs text-slate-800 dark:text-slate-100 font-sans focus:ring-2 focus:ring-brand-500 focus:outline-none transition-all leading-relaxed">${escapeHtmlAttr(initialBody)}</textarea>

                                        <!-- Live Preview Render Box -->
                                        <div id="enrolledEmailPreviewBox" class="hidden p-4 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl mt-2 text-xs leading-relaxed max-h-60 overflow-y-auto"></div>
                                    </div>

                                    <!-- Checkbox to Save as Default -->
                                    <div class="flex items-center gap-2 pt-1">
                                        <input type="checkbox" id="enrolledSaveDefaultCheck" class="w-4 h-4 accent-brand-500 rounded cursor-pointer" checked>
                                        <label for="enrolledSaveDefaultCheck" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer select-none">
                                            حفظ هذا القالب كقالب افتراضي لـ <b>${wname}</b> (Save as default template for this Wave)
                                        </label>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center">
                                        <button type="button" onclick="window.switchEnrolledModalTab('list')" class="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 font-bold text-xs uppercase tracking-wider flex items-center gap-1.5">
                                            <i class="fas fa-arrow-left"></i> Back to Personnel List / العودة للقائمة
                                        </button>
                                        <button type="button" onclick="window.sendWavePersonnelEmail()" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/30 transition-all flex items-center gap-2">
                                            <i class="fas fa-paper-plane text-xs"></i> <span>Send Email Now / إرسال الإيميل الآن</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `,
                        width: '1000px',
                        showConfirmButton: false,
                        showCloseButton: true,
                        didOpen: () => {
                            const table = $('#swalWaveDetailsTable').DataTable({
                                pageLength: 5,
                                lengthMenu: [5, 10, 25, 50],
                                language: { search: "", searchPlaceholder: "Filter personnel..." },
                                columnDefs: [{ orderable: false, targets: 0 }]
                            });
                            $('.dataTables_filter input').addClass('bg-slate-50 border-slate-200 rounded-xl px-4 py-2 text-xs focus:ring-0 outline-none mb-4');

                            function updateEnrolledSelectedCount() {
                                const selectedCount = table.$('input.enrolled-user-cb:checked').length;
                                $('#selectedEnrolledCounter').text(selectedCount);
                                if (selectedCount > 0) {
                                    $('#badgeTargetCount').text(`${selectedCount} Selected`);
                                    $('#enrolledEmailTargetDesc').text(`${selectedCount} Selected Candidate(s)`);
                                } else {
                                    $('#badgeTargetCount').text(`All (${users.length})`);
                                    $('#enrolledEmailTargetDesc').text(`All (${users.length}) Enrolled Personnel`);
                                }
                            }

                            $('#selectAllEnrolledList').on('change', function() {
                                const rows = table.rows({ search: 'applied' }).nodes();
                                $('input.enrolled-user-cb', rows).prop('checked', this.checked);
                                updateEnrolledSelectedCount();
                            });

                            $('#swalWaveDetailsTable tbody').on('change', 'input.enrolled-user-cb', function() {
                                updateEnrolledSelectedCount();
                            });

                            $('#swalWaveDetailsTable tbody').on('click', 'tr', function(e) {
                                if ($(e.target).is('input[type="checkbox"]') || $(e.target).closest('button').length) return;
                                const cb = $(this).find('input.enrolled-user-cb');
                                if (cb.length) {
                                    cb.prop('checked', !cb.prop('checked'));
                                    updateEnrolledSelectedCount();
                                }
                            });

                            // Tab switching
                            window.switchEnrolledModalTab = function(tabName) {
                                const listTab = document.getElementById('enrolledTabList');
                                const emailTab = document.getElementById('enrolledTabEmail');
                                const btnList = document.getElementById('tabBtnEnrolledList');
                                const btnEmail = document.getElementById('tabBtnEnrolledEmail');

                                if (tabName === 'email') {
                                    listTab.classList.add('hidden');
                                    emailTab.classList.remove('hidden');

                                    btnList.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 flex items-center gap-2';
                                    btnEmail.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-600 text-white shadow-sm flex items-center gap-2';
                                } else {
                                    emailTab.classList.add('hidden');
                                    listTab.classList.remove('hidden');

                                    btnEmail.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 flex items-center gap-2';
                                    btnList.className = 'px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-600 text-white shadow-sm flex items-center gap-2';
                                }
                            };

                            // Placeholders helper
                            window.insertEnrolledPlaceholder = function(token) {
                                const textarea = document.getElementById('enrolledEmailBody');
                                if (!textarea) return;
                                const start = textarea.selectionStart;
                                const end = textarea.selectionEnd;
                                const text = textarea.value;
                                textarea.value = text.substring(0, start) + token + text.substring(end);
                                textarea.focus();
                                textarea.selectionStart = textarea.selectionEnd = start + token.length;
                            };

                            // Toggle preview
                            window.toggleEnrolledEmailPreview = function() {
                                const previewBox = $('#enrolledEmailPreviewBox');
                                const textarea = $('#enrolledEmailBody');
                                const isHidden = previewBox.hasClass('hidden');

                                if (isHidden) {
                                    const rawText = textarea.val() || '';
                                    const sampleName = users.length > 0 ? (users[0].userName ?? users[0].UserName) : 'Ahmed Mohamed';
                                    const waveTitle = wname;
                                    const sampleDate = emailData?.startDate || 'October 15, 2026 - 10:00 AM';
                                    const sampleLocation = emailData?.location || 'Offline in Main Branch';
                                    const sampleUrl = 'http://41.33.149.186:5208';

                                    let rendered = rawText
                                        .replace(/{Name}/g, sampleName)
                                        .replace(/{FullName}/g, sampleName)
                                        .replace(/{UserName}/g, sampleName)
                                        .replace(/{WaveName}/g, waveTitle)
                                        .replace(/{StartDate}/g, sampleDate)
                                        .replace(/{Location}/g, sampleLocation)
                                        .replace(/{PortalLink}/g, `<a href="${sampleUrl}" class="text-brand-600 underline" target="_blank">${sampleUrl}</a>`);

                                    rendered = rendered.replace(/\n/g, '<br/>');

                                    previewBox.html(`
                                        <div class="border-b border-slate-200 dark:border-slate-800 pb-2 mb-3">
                                            <p class="text-[10px] uppercase font-black tracking-widest text-slate-400">Preview with sample data (معاينة مع بيانات تجريبية):</p>
                                            <p class="font-bold text-slate-800 dark:text-white mt-1">Subject: ${$('#enrolledEmailSubject').val()}</p>
                                        </div>
                                        <div dir="auto" class="text-slate-700 dark:text-slate-200 font-sans">${rendered}</div>
                                    `);
                                    previewBox.removeClass('hidden');
                                    $('#enrolledPreviewBtnText').text('Hide Preview / إخفاء المعاينة');
                                } else {
                                    previewBox.addClass('hidden');
                                    $('#enrolledPreviewBtnText').text('Live Preview / معاينة الإيميل');
                                }
                            };

                            // Send email logic
                            window.sendWavePersonnelEmail = async function() {
                                const selectedIds = [];
                                table.$('input.enrolled-user-cb:checked').each(function() {
                                    selectedIds.push($(this).val());
                                });

                                const subject = $('#enrolledEmailSubject').val();
                                const body = $('#enrolledEmailBody').val();
                                const saveDefault = $('#enrolledSaveDefaultCheck').is(':checked');

                                const targetDesc = selectedIds.length > 0 
                                    ? `${selectedIds.length} متدرب محدد` 
                                    : `جميع متدربي الويف (${users.length} متدرب)`;

                                const confirmResult = await Swal.fire({
                                    title: 'تأكيد إرسال الإيميل؟',
                                    text: `هل أنت متأكد من رغبتك في إرسال هذا الإيميل المخصص إلى ${targetDesc}؟`,
                                    icon: 'question',
                                    showCancelButton: true,
                                    confirmButtonText: 'نعم، أرسل الآن',
                                    cancelButtonText: 'إلغاء',
                                    customClass: {
                                        confirmButton: 'bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl font-bold uppercase text-xs mr-2',
                                        cancelButton: 'text-slate-500 font-bold uppercase text-xs px-6 py-2.5'
                                    },
                                    buttonsStyling: false
                                });

                                if (!confirmResult.isConfirmed) return;

                                Swal.showLoading();
                                try {
                                    const response = await fetch(`/Admin/SendCustomEmailToWavePersonnel?waveId=${wid}`, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            userIds: selectedIds.length > 0 ? selectedIds : null,
                                            customSubject: subject,
                                            customBody: body,
                                            saveAsDefault: saveDefault
                                        })
                                    });

                                    const resData = await response.json();
                                    if (resData.success) {
                                        showToast(resData.message || 'تم إرسال الإيميلات بنجاح.', 'success');
                                        Swal.close();
                                    } else {
                                        showToast(resData.message || 'تعذر إرسال الإيميلات.', 'error');
                                        Swal.hideLoading();
                                    }
                                } catch(err) {
                                    showToast('حدث خطأ أثناء التواصل مع السيرفر.', 'error');
                                    Swal.hideLoading();
                                }
                            };
                            
                            // Remove logic
                            $(document).off('click', '.remove-user-btn').on('click', '.remove-user-btn', function() {
                                const uid = $(this).data('userid');
                                const uname = $(this).data('username');
                                const waveId = $(this).data('waveid');
                                
                                Swal.fire({
                                    title: 'Remove User?',
                                    text: `Remove ${uname} from this batch?`,
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonText: 'Yes, Remove',
                                    customClass: {
                                        popup: 'rounded-[28px]',
                                        confirmButton: 'bg-rose-600 text-white px-6 py-2 rounded-lg font-bold mr-2',
                                        cancelButton: 'bg-slate-200 text-slate-700 px-6 py-2 rounded-lg font-bold'
                                    },
                                    buttonsStyling: false
                                }).then(async (r) => {
                                    if(r.isConfirmed) {
                                        try {
                                            const res = await fetch('/Admin/RemoveUserFromWave', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                                body: `waveId=${waveId}&userId=${uid}`
                                            });
                                            const data = await res.json();
                                            if(data.success) {
                                                table.row($(`button[data-userid="${uid}"]`).parents('tr')).remove().draw();
                                                showToast('تمت إزالة المستخدم بنجاح', 'success');
                                                updateEnrolledSelectedCount();
                                            } else {
                                                showToast(data.message || 'تعذر إزالة المستخدم', 'error');
                                            }
                                        } catch(e) {
                                            showToast('حدث خطأ أثناء التواصل مع السيرفر', 'error');
                                        }
                                    }
                                });
                            });
                        },
                        didClose: () => {
                            delete window.switchEnrolledModalTab;
                            delete window.insertEnrolledPlaceholder;
                            delete window.toggleEnrolledEmailPreview;
                            delete window.sendWavePersonnelEmail;
                        }
                    });
                } catch (err) {
                    showToast('فشل تحميل قائمة الطلاب', 'error');
                }
            }
        async function toggleWaveStatus(evt, waveId, targetIsActive) {
            if (evt) evt.stopPropagation();
            const btn = evt ? evt.currentTarget : null;
            try {
                const res = await fetch(`/Admin/ToggleWaveStatus?id=${waveId}&isActive=${targetIsActive}`, {
                    method: 'POST'
                });
                const json = await res.json();
                if (json.success) {
                    showToast(json.message, 'success');
                    if (btn) {
                        const nextTarget = !targetIsActive;
                        btn.setAttribute('onclick', `toggleWaveStatus(event, ${waveId}, ${nextTarget})`);
                        if (targetIsActive) {
                            btn.innerHTML = `
                                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-800 flex items-center gap-1.5 w-fit">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Active / شغال
                                </span>
                            `;
                        } else {
                            btn.innerHTML = `
                                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700 flex items-center gap-1.5 w-fit">
                                    <i class="fas fa-check-circle text-slate-400"></i>
                                    Done / انتهت
                                </span>
                            `;
                        }
                    }
                } else {
                    showToast(json.message || 'تعذر تغيير حالة الويف', 'error');
                }
            } catch (e) {
                showToast('حدث خطأ أثناء التواصل مع السيرفر', 'error');
            }
        }
    </script>
}
