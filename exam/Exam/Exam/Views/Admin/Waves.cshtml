                        '<div class="bg-brand-50/80 dark:bg-brand-950/30 border border-brand-200 dark:border-brand-800/50 rounded-2xl p-3 text-right">' +
                        '<div class="text-[11px] font-bold text-brand-800 dark:text-brand-300 flex items-center justify-between">' +
                        '<span><i class="fas fa-certificate text-brand-500 ml-1"></i> الرمز المستخرج داخل القوسين للسيريال:</span>' +
                        '<span id="sw-preview-code" class="font-mono bg-brand-200 dark:bg-brand-900/60 text-brand-900 dark:text-brand-100 px-2 py-0.5 rounded font-black text-xs">Off</span>' +
                        '</div>' +
                        '<div class="text-[10px] text-slate-500 dark:text-slate-400 mt-1.5 flex items-center justify-between font-mono" dir="ltr">' +
                        '<span class="text-slate-400">Preview:</span>' +
                        '<code id="sw-preview-full" class="font-bold text-brand-700 dark:text-brand-400">WTTA-2026-001-PB-Off-XXXX</code>' +
                        '</div>' +
                        '</div>' +
                        '<div class="grid grid-cols-2 gap-3 mt-4 text-right">' +
                        '<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2 text-right">تاريخ البدء (Start Date):</label><input id="sw-date" type="date" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl outline-none focus:border-brand-500 transition-all font-bold text-sm"></div>' +
                        '<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2 text-right">تاريخ الانتهاء (End Date):</label><input id="sw-enddate" type="date" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl outline-none focus:border-brand-500 transition-all font-bold text-sm"></div>' +
                        '</div>' +
                        '</div>',
                    focusConfirm: false,
                    showCancelButton: true,
                    confirmButtonText: 'إنشاء الويف <i class="fas fa-plus-circle mr-1"></i>',
                    cancelButtonText: 'إلغاء',
                    customClass: {
                        popup: 'rounded-[32px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                        confirmButton: 'bg-brand-600 hover:bg-brand-700 text-white px-8 py-3.5 rounded-xl font-bold uppercase text-xs tracking-wider ml-2 shadow-md',
                        cancelButton: 'bg-white dark:bg-slate-800 hover:bg-slate-50 text-slate-400 font-bold uppercase text-xs px-8 py-3.5 rounded-xl border border-slate-200'
                    },
                    buttonsStyling: false,
                    didOpen: () => {
                        renderModePillButtons('create-mode-pills', 'sw-mode', 'sw-preview-code', 'sw-preview-full', initialMode);
                    },
                    preConfirm: () => {
                        const name = document.getElementById('sw-name').value;
                        const date = document.getElementById('sw-date').value;
                        const endDate = document.getElementById('sw-enddate').value;
                        const finalMode = document.getElementById('sw-mode').value || 'Offline (Off)';
                        const isOnline = finalMode.toLowerCase().includes('online');
                        if (!name || !name.trim()) {
                            Swal.showValidationMessage('اسم الويف مطلوب');
                            return false;
                        }
                        return { name: name.trim(), date: date || null, endDate: endDate || null, isOnline: isOnline, mode: finalMode.trim() };
                    }
                });

                if (formValues && formValues.name) {
                    try {
                        const res = await fetch('/Admin/CreateWave', { 
                            method: 'POST', 
                            headers: { 'Content-Type': 'application/json' }, 
                            body: JSON.stringify({ WaveName: formValues.name, StartDate: formValues.date || null, EndDate: formValues.endDate || null, IsOnline: formValues.isOnline, Mode: formValues.mode }) 
                        });
                        if(res.ok) {
                            showToast('تم إنشاء الويف بنجاح', 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showToast('تعذر إنشاء الويف', 'error');
                        }
                    } catch(e) {
                        showToast('حدث خطأ أثناء التواصل مع السيرفر', 'error');
                    }
                }
            });

            // Double-click on row navigates to Wave details
            $('#wavesTable tbody').on('dblclick', 'tr', function() {
                const wid = $(this).data('waveid');
                const wname = $(this).find('span.font-bold').text();
                if (wid) {
                    viewWavePersonnel(wid, wname);
                }
            });

            async function viewWavePersonnel(wid, wname) {
                Swal.fire({ title: 'Loading Personnel...', didOpen: () => Swal.showLoading() });
                
                try {
                    const res = await fetch(`/Admin/GetUsersByWaveId?waveId=${wid}`);
                    const users = await res.json();

                    Swal.fire({
                        title: `<div class="text-left border-b border-slate-100 pb-4"><p class="text-[10px] font-bold text-brand-600 uppercase tracking-[0.2em] mb-1">Enrolled Personnel in</p><p class="text-2xl font-black italic uppercase text-slate-900">${wname}</p></div>`,
                        html: `
                            <div class="mt-8 text-left">
                                <table id="swalWaveDetailsTable" class="saas-table display nowrap w-full text-xs">
                                    <thead>
                                        <tr class="bg-slate-50">
                                            <th>User</th>
                                            <th>Code</th>
                                            <th>Role</th>
                                            <th>Branch</th>
                                            <th class="text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${users.map(u => `
                                            <tr class="border-b border-slate-50">
                                                <td>
                                                    <div class="flex flex-col">
                                                        <span class="font-bold text-slate-900">${u.userName ?? u.UserName}</span>
                                                        <span class="text-[10px] text-slate-400 font-medium">${u.email ?? u.Email}</span>
                                                    </div>
                                                </td>
                                                <td class="font-bold text-slate-500">${u.userCode ?? u.UserCode ?? '--'}</td>
                                                <td>
                                                    <span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase bg-slate-100 text-slate-500 border border-slate-200">
                                                        ${u.roleName ?? u.RoleName ?? 'User'}
                                                    </span>
                                                </td>
                                                <td class="font-bold text-slate-400 text-[10px] uppercase">${u.branchName ?? u.BranchName ?? 'N/A'}</td>
                                                <td class="text-right">
                                                    ${canDeleteWaveAssign ? `
                                                        <button class="p-2 text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg remove-user-btn" 
                                                                data-waveid="${wid}" 
                                                                data-userid="${u.id ?? u.Id}"
                                                                data-username="${u.userName ?? u.UserName}">
                                                            <i class="fas fa-user-minus"></i>
                                                        </button>
                                                    ` : '--'}
                                                </td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                                ${users.length === 0 ? '<div class="p-12 text-center text-slate-400 font-bold uppercase tracking-widest">No personnel enrolled in this batch</div>' : ''}
                            </div>
                        `,
                        width: '900px',
                        showConfirmButton: false,
                        showCloseButton: true,
                        didOpen: () => {
                            const table = $('#swalWaveDetailsTable').DataTable({
                                pageLength: 5,
                                lengthMenu: [5, 10, 25],
                                language: { search: "", searchPlaceholder: "Filter personnel..." }
                            });
                            $('.dataTables_filter input').addClass('bg-slate-50 border-slate-200 rounded-xl px-4 py-2 text-xs focus:ring-0 outline-none mb-4');
                            
                            // Remove logic
                            $(document).off('click', '.remove-user-btn').on('click', '.remove-user-btn', function() {
                                const uid = $(this).data('userid');
                                const uname = $(this).data('username');
                                const waveId = $(this).data('waveid');
                                
                                Swal.fire({
                                    title: 'Remove User?',
                                    text: `Remove ${uname} from this batch?`,
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonText: 'Yes, Remove',
                                    customClass: {
                                        popup: 'rounded-[28px]',
                                        confirmButton: 'bg-rose-600 text-white px-6 py-2 rounded-lg font-bold mr-2',
                                        cancelButton: 'bg-slate-200 text-slate-700 px-6 py-2 rounded-lg font-bold'
                                    },
                                    buttonsStyling: false
                                }).then(async (r) => {
                                    if(r.isConfirmed) {
                                        try {
                                            const res = await fetch('/Admin/RemoveUserFromWave', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                                body: `waveId=${waveId}&userId=${uid}`
                                            });
                                            const data = await res.json();
                                            if(data.success) {
                                                table.row($(`button[data-userid="${uid}"]`).parents('tr')).remove().draw();
                                                showToast('تمت إزالة المستخدم بنجاح', 'success');
                                            } else {
                                                showToast(data.message || 'تعذر إزالة المستخدم', 'error');
                                            }
                                        } catch(e) {
                                            showToast('حدث خطأ أثناء التواصل مع السيرفر', 'error');
                                        }
                                    }
                                });
                            });
                        }
                    });
                } catch (err) {
                    showToast('فشل تحميل قائمة الطلاب', 'error');
                }
            }
        });
    </script>
}
