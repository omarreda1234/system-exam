                                            <button type="button" onclick="window.insertWzPlaceholder('{Location}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{Location} (مكان التدريب)</button>
                                            <button type="button" onclick="window.insertWzPlaceholder('{PortalLink}')" class="px-2.5 py-1 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 rounded-lg text-[11px] font-mono font-bold transition-all shadow-xs">{PortalLink} (رابط المنصة)</button>
