@model IEnumerable<Exam.DTOs.WaveDto>
@inject Exam.Services.IExamService ExamService
@{
    ViewData["Title"] = "Training Batches";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var userRoles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    bool HasWavesEditPermission()
    {
        if (userRoles.Contains("Admin")) return true;
        return ExamService.HasSpecificPermissionAsync(userRoles, "Admin", "Waves", "edit").GetAwaiter().GetResult();
    }

    bool HasWavesDeletePermission()
    {
        if (userRoles.Contains("Admin")) return true;
        return ExamService.HasSpecificPermissionAsync(userRoles, "Admin", "Waves", "delete").GetAwaiter().GetResult();
    }

    bool HasRemoveUserFromWavePermission()
    {
        if (userRoles.Contains("Admin")) return true;
        return ExamService.HasSpecificPermissionAsync(userRoles, "Admin", "RemoveUserFromWave", "delete").GetAwaiter().GetResult();
    }
}

@Html.AntiForgeryToken()

<!-- Header -->
<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-8 mb-8 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h2 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] mb-1">Batch Management</h2>
            <p class="text-xl font-bold">Training Cycles</p>
        </div>
        
        <div class="flex items-center gap-3 flex-wrap">
            <a href="/Admin/SmartWaveProposal" class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white px-6 py-3 rounded-2xl transition-all shadow-lg shadow-indigo-600/25 font-bold uppercase text-xs tracking-widest flex items-center gap-2.5 active:scale-95 group">
                <i class="fas fa-wand-magic-sparkles text-amber-300"></i>
                <span>Smart Wave Planner / مقترح الويفات الذكي</span>
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Human Resources"))
            {
                <button id="createWaveButton" class="bg-brand-600 hover:bg-brand-700 text-white px-8 py-3 rounded-2xl transition-all shadow-lg font-bold uppercase text-xs tracking-widest flex items-center gap-3 active:scale-95 group">
                    <i class="fas fa-plus group-hover:rotate-90 transition-transform"></i>
                    Create New Batch
                </button>
            }
        </div>
    </div>
</div>

<!-- Table -->
<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table id="wavesTable" class="saas-table datatable">
            <thead>
                <tr>
                    <th class="pl-8">Batch Name</th>
                    <th>Status</th>
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th class="text-right pr-8">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var wave in Model) {
                    <tr data-waveid="@wave.Id" class="cursor-pointer" title="Double-click to view details">
                        <td class="pl-8">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-400"><i class="fas fa-water"></i></div>
                                <span class="font-bold text-slate-900 dark:text-white">@wave.WaveName</span>
                            </div>
                        </td>
                        <td>
                            <button type="button" onclick="toggleWaveStatus(event, @wave.Id, @((!wave.IsActive).ToString().ToLower()))" class="cursor-pointer transition-transform hover:scale-105 inline-block" title="انقر لتغيير حالة الويف (Active / Done)">
                                @if (wave.IsActive)
                                {
                                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-800 flex items-center gap-1.5 w-fit">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                        Active / شغال
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700 flex items-center gap-1.5 w-fit">
                                        <i class="fas fa-check-circle text-slate-400"></i>
                                        Done / انتهت
                                    </span>
                                }
                            </button>
                        </td>
                        <td>
                            <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider @(wave.IsOnline || (wave.Mode != null && wave.Mode.ToLower() == "online") ? "bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-800" : "bg-slate-100 text-slate-600 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700")">
                                <i class="fas @(wave.IsOnline || (wave.Mode != null && wave.Mode.ToLower() == "online") ? "fa-globe text-emerald-500 mr-1" : "fa-building text-slate-400 mr-1")"></i>
                                @(!string.IsNullOrEmpty(wave.Mode) ? wave.Mode : (wave.IsOnline ? "Online" : "Off"))
                            </span>
                        </td>
                        <td><span class="text-xs font-medium text-slate-500 uppercase">@(wave.StartDate?.ToString("MMMM dd, yyyy") ?? "-")</span></td>
                        <td><span class="text-xs font-medium text-slate-500 uppercase">@(wave.EndDate?.ToString("MMMM dd, yyyy") ?? "-")</span></td>
                        <td class="text-right pr-8">
                            <div class="flex items-center justify-end gap-2">
                                @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Human Resources"))
                                {
                                    <button onclick="openAssignModal(@wave.Id, '@wave.WaveName')" class="bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 text-slate-500 hover:text-white px-6 py-2.5 rounded-xl transition-all border border-slate-200 dark:border-slate-700 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 group">
                                        <i class="fas fa-user-plus text-xs"></i>
                                        Assign User
                                    </button>
                                    <button onclick="openImportExcelModal(@wave.Id, '@wave.WaveName')" class="bg-emerald-50 dark:bg-emerald-950/20 hover:bg-emerald-600 text-emerald-600 hover:text-white px-6 py-2.5 rounded-xl transition-all border border-emerald-100 dark:border-emerald-900/30 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 group">
                                        <i class="fas fa-file-excel text-xs"></i>
                                        Import Excel
                                    </button>
                                    <a href="/Attendance/ManageSessions?waveId=@wave.Id" class="bg-sky-50 dark:bg-sky-950/20 hover:bg-sky-600 text-sky-600 hover:text-white px-4 py-2.5 rounded-xl transition-all border border-sky-100 dark:border-sky-900/30 text-[10px] font-bold uppercase tracking-widest flex items-center gap-1.5 group" title="جلسات ومحاضرات الحضور (Attendance Sessions)">
                                        <i class="fas fa-calendar-check text-xs"></i>
                                        Sessions
                                    </a>
                                }
                                @if (HasWavesEditPermission())
                                {
                                    <button onclick="editWave(event, @wave.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(wave.WaveName))', '@(wave.StartDate.HasValue ? wave.StartDate.Value.ToString("yyyy-MM-dd") : "")', '@(wave.EndDate.HasValue ? wave.EndDate.Value.ToString("yyyy-MM-dd") : "")', @(wave.IsOnline.ToString().ToLower()), '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(wave.Mode ?? (wave.IsOnline ? "Online" : "Off")))', @(wave.IsActive.ToString().ToLower()))" class="bg-amber-50 hover:bg-amber-600 text-amber-600 hover:text-white px-4 py-2.5 rounded-xl transition-all border border-amber-100 hover:border-amber-600 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 group">
                                        <i class="fas fa-edit text-xs"></i>
                                        Edit
                                    </button>
                                }
                                @if (HasWavesDeletePermission())
                                {
                                    <button onclick="cloneWave(@wave.Id, '@wave.WaveName')" class="bg-indigo-50 hover:bg-indigo-600 text-indigo-500 hover:text-white px-4 py-2.5 rounded-xl transition-all border border-indigo-100 hover:border-indigo-600 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 group">
                                        <i class="fas fa-copy text-xs"></i>
                                        Clone
                                    </button>
                                    <button onclick="deleteWave(@wave.Id, '@wave.WaveName')" class="bg-red-50 hover:bg-red-600 text-red-500 hover:text-white px-4 py-2.5 rounded-xl transition-all border border-red-100 hover:border-red-600 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 group">
                                        <i class="fas fa-trash-alt text-xs"></i>
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script>
    <script>
        const isAdmin = @(User.IsInRole("Admin").ToString().ToLower());
        const canDeleteWaveAssign = @(HasRemoveUserFromWavePermission().ToString().ToLower());

        function showToast(message, type = 'success', duration = 3500) {
            let container = document.getElementById('toast-notification-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-notification-container';
                container.className = 'fixed top-5 right-5 z-[999999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center justify-between gap-3 px-4 py-3.5 rounded-2xl shadow-2xl backdrop-blur-md border text-xs font-bold transition-all duration-300 transform translate-x-full opacity-0 ${
                type === 'success'
                    ? 'bg-emerald-600/95 text-white border-emerald-400/30 shadow-emerald-900/20'
                    : type === 'error'
                    ? 'bg-rose-600/95 text-white border-rose-400/30 shadow-rose-900/20'
                    : type === 'warning'
                    ? 'bg-amber-600/95 text-white border-amber-400/30 shadow-amber-900/20'
                    : 'bg-slate-900/95 text-white border-slate-700/50 shadow-slate-950/30'
            }`;

            const icon = type === 'success' ? 'fa-circle-check text-emerald-200' 
                       : type === 'error' ? 'fa-circle-exclamation text-rose-200' 
                       : type === 'warning' ? 'fa-triangle-exclamation text-amber-200' 
                       : 'fa-circle-info text-sky-200';

            toast.innerHTML = `
                <div class="flex items-center gap-2.5">
                    <i class="fas ${icon} text-base"></i>
                    <span class="leading-snug">${message}</span>
                </div>
                <button type="button" class="text-white/70 hover:text-white transition-colors p-1" onclick="this.parentElement.remove()">
                    <i class="fas fa-times text-xs"></i>
                </button>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-full', 'opacity-0');
                toast.classList.add('translate-x-0', 'opacity-100');
            });

            setTimeout(() => {
                toast.classList.remove('translate-x-0', 'opacity-100');
                toast.classList.add('translate-x-full', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, duration);
        }

        const defaultModes = ['Offline (Off)', 'Online (ON)', 'Onsite (ONS)', 'Hybrid (HYB)', 'VIP (VIP)'];

        function getCustomModes() {
            try {
                const stored = localStorage.getItem('custom_batch_modes');
                return stored ? JSON.parse(stored) : [];
            } catch(e) {
                return [];
            }
        }

        function saveCustomMode(mode) {
            if (!mode || !mode.trim()) return;
            const custom = getCustomModes();
            if (!custom.includes(mode.trim()) && !defaultModes.includes(mode.trim())) {
                custom.push(mode.trim());
                localStorage.setItem('custom_batch_modes', JSON.stringify(custom));
            }
        }

        function removeCustomMode(mode) {
            if (!mode) return;
            let custom = getCustomModes();
            custom = custom.filter(m => m.trim().toLowerCase() !== mode.trim().toLowerCase());
            localStorage.setItem('custom_batch_modes', JSON.stringify(custom));
        }

        function renderModePillButtons(containerId, inputId, codeSpanId, fullCodeId, activeMode) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const allModes = [...new Set([...defaultModes, ...getCustomModes()])];
            let html = '<span class="text-[10px] font-bold text-slate-400">خيارات سريعة:</span>';
            allModes.forEach(m => {
                const isSelected = activeMode && activeMode.trim().toLowerCase() === m.trim().toLowerCase();
                const btnClass = isSelected 
                    ? 'px-2.5 py-1 text-[11px] font-bold bg-amber-500 text-white rounded-lg shadow-sm border border-amber-600 transition-colors'
                    : 'px-2.5 py-1 text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-lg hover:bg-amber-100 dark:hover:bg-amber-950/40 hover:text-amber-700 border border-slate-200 dark:border-slate-700 transition-colors';
                html += `<button type="button" onclick="setSwMode('${inputId}', '${m.replace(/'/g, "\\'")}', '${codeSpanId}', '${fullCodeId}', '${containerId}')" class="${btnClass}">${m}</button>`;
            });
            container.innerHTML = html;
        }

        function extractModePreview(mode) {
            if (!mode || !mode.trim()) return 'Off';
            const match = mode.match(/\(([^)]+)\)/);
            if (match && match[1] && match[1].trim()) {
                return match[1].trim();
            }
            if (mode.trim().toLowerCase() === 'online') return 'ON';
            if (mode.trim().toLowerCase() === 'offline') return 'Off';
            if (mode.trim().toLowerCase() === 'onsite') return 'ONS';
            return mode.trim();
        }

        function updateModeSerialPreview(inputId, codeSpanId, fullCodeId) {
            const input = document.getElementById(inputId);
            const val = input ? input.value : '';
            const code = extractModePreview(val);
            const span = document.getElementById(codeSpanId);
            const full = document.getElementById(fullCodeId);
            if (span) span.innerText = code;
            if (full) full.innerText = `WTTA-2026-001-PB-${code}-XXXX`;
        }

        function setSwMode(inputId, modeValue, codeSpanId, fullCodeId, containerId) {
            const input = document.getElementById(inputId);
            if (input) {
                input.value = modeValue;
                updateModeSerialPreview(inputId, codeSpanId, fullCodeId);
                if (containerId) {
                    renderModePillButtons(containerId, inputId, codeSpanId, fullCodeId, modeValue);
                }
            }
        }

        async function promptAddNewMode(inputId, codeSpanId, fullCodeId, containerId) {
            const { value: newMode } = await Swal.fire({
                title: '<div class="text-base font-black uppercase text-emerald-600">إضافة نمط حالة جديد (Add Mode)</div>',
                html: '<p class="text-xs text-slate-500 mb-3">اكتب مسمى الحالة مع الرمز داخل الأقواس <code>(...)</code> ليظهر بالسيريال:</p>',
                input: 'text',
                inputPlaceholder: 'مثال: Onsite (ONS) أو Weekend (WKND) أو VIP (VIP)...',
                showCancelButton: true,
                confirmButtonText: 'إضافة وتطبيق <i class="fas fa-plus ml-1"></i>',
                cancelButtonText: 'إلغاء',
                customClass: {
                    popup: 'rounded-[28px]',
                    confirmButton: 'bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-6 rounded-xl text-xs uppercase ml-2 shadow-md',
                    cancelButton: 'bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold py-2.5 px-6 rounded-xl text-xs uppercase'
                },
                buttonsStyling: false,
                inputValidator: (val) => {
                    if (!val || !val.trim()) return 'يرجى كتابة مسمى الحالة!';
                }
            });

            if (newMode && newMode.trim()) {
                const trimmed = newMode.trim();
                saveCustomMode(trimmed);
                setSwMode(inputId, trimmed, codeSpanId, fullCodeId, containerId);
                showToast(`تمت إضافة نمط (${trimmed}) وتطبيقه بنجاح`, 'success');
            }
        }

        async function promptEditCurrentMode(inputId, codeSpanId, fullCodeId, containerId) {
            const input = document.getElementById(inputId);
            const currentVal = input ? input.value.trim() : '';
            if (!currentVal) {
                showToast('يرجى اختيار أو كتابة حالة أولاً لتعديلها', 'warning');
                return;
            }

            const { value: editedMode } = await Swal.fire({
                title: '<div class="text-base font-black uppercase text-amber-600">تعديل مسمى الحالة (Edit Mode)</div>',
                html: `<p class="text-xs text-slate-500 mb-3">المسمى الحالي: <b>${currentVal}</b></p>`,
                input: 'text',
                inputValue: currentVal,
                showCancelButton: true,
                confirmButtonText: 'حفظ التعديل <i class="fas fa-check ml-1"></i>',
                cancelButtonText: 'إلغاء',
                customClass: {
                    popup: 'rounded-[28px]',
                    confirmButton: 'bg-amber-600 hover:bg-amber-700 text-white font-bold py-2.5 px-6 rounded-xl text-xs uppercase ml-2 shadow-md',
                    cancelButton: 'bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold py-2.5 px-6 rounded-xl text-xs uppercase'
                },
                buttonsStyling: false,
                inputValidator: (val) => {
                    if (!val || !val.trim()) return 'يرجى كتابة المسمى الجديد!';
                }
            });

            if (editedMode && editedMode.trim()) {
                const trimmed = editedMode.trim();
                removeCustomMode(currentVal);
                saveCustomMode(trimmed);
                setSwMode(inputId, trimmed, codeSpanId, fullCodeId, containerId);

                // Update in database in background
                try {
                    const apiRes = await fetch('/Admin/RenameWaveMode', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `oldMode=${encodeURIComponent(currentVal)}&newMode=${encodeURIComponent(trimmed)}`
                    });
                    const data = await apiRes.json();
                    if (data.success) {
                        showToast(`تم تعديل مسمى الحالة من (${currentVal}) إلى (${trimmed}) وتحديث السيريال بنجاح`, 'success');
                    } else {
                        showToast(data.message || 'تم تحديث المسمى محلياً', 'info');
                    }
                } catch(e) {
                    showToast(`تم تعديل مسمى الحالة محلياً إلى (${trimmed})`, 'success');
                }
            }
        }

        async function promptDeleteCurrentMode(inputId, codeSpanId, fullCodeId, containerId) {
            const input = document.getElementById(inputId);
            const currentVal = input ? input.value.trim() : '';
            if (!currentVal) {
                showToast('لا توجد حالة محددة لمسحها', 'warning');
                return;
            }

            const result = await Swal.fire({
                title: '<div class="text-base font-black uppercase text-rose-600">مسح / تفريغ الحالة (Delete / Clear)</div>',
                html: `هل تريد مسح نمط (<b>${currentVal}</b>)؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'مسح وتفريغ <i class="fas fa-trash-alt ml-1"></i>',
                cancelButtonText: 'إلغاء',
                customClass: {
                    popup: 'rounded-[28px]',
                    confirmButton: 'bg-rose-600 hover:bg-rose-700 text-white font-bold py-2.5 px-6 rounded-xl text-xs uppercase ml-2 shadow-md',
                    cancelButton: 'bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold py-2.5 px-6 rounded-xl text-xs uppercase'
                },
                buttonsStyling: false
            });

            if (result.isConfirmed) {
                removeCustomMode(currentVal);
                setSwMode(inputId, 'Offline (Off)', codeSpanId, fullCodeId, containerId);
                try {
                    fetch('/Admin/DeleteWaveMode', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `mode=${encodeURIComponent(currentVal)}`
                    });
                } catch(e) {}
                showToast(`تم مسح نمط (${currentVal}) وتفريغ الحقل بنجاح`, 'success');
            }
        }

        async function editWave(evt, id, currentName, currentDate, currentEndDate, currentIsOnline, currentMode, currentIsActive) {
            if (evt) evt.stopPropagation();
            const initialMode = currentMode || (currentIsOnline ? 'Online (ON)' : 'Offline (Off)');
            const initialExtracted = extractModePreview(initialMode);
            if (currentIsActive === undefined || currentIsActive === null) currentIsActive = true;

            const { value: formValues } = await Swal.fire({
                title: '<div class="text-lg font-black uppercase text-slate-800 dark:text-slate-100">تعديل الويف (Edit Batch)</div>',
                html:
                    '<div class="text-right space-y-4" dir="rtl">' +
                    `<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2 text-right">اسم الويف (Batch Name):</label><input id="edit-sw-name" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl outline-none focus:border-amber-500 transition-all font-bold text-sm" value="${currentName}"></div>` +
                    `<div><label class="block text-xs font-bold text-slate-500 uppercase mb-2 text-right">حالة الويف (Activity Status):</label>` +
                    `<select id="edit-sw-active" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl outline-none focus:border-amber-500 transition-all font-bold text-sm">` +
                    `<option value="true" ${currentIsActive ? 'selected' : ''}>Active / نشط (شغال)</option>` +
                    `<option value="false" ${!currentIsActive ? 'selected' : ''}>Done / منتهي (انتهت)</option>` +
                    `</select></div>` +
                    `<div class="space-y-2">` +
                    `<div class="flex items-center justify-between mb-1">` +
                    `<label class="block text-xs font-bold text-slate-500 uppercase text-right">حالة السيريال / نوع الويف (Mode):</label>` +
                    `<div class="flex items-center gap-1">` +
                    `<button type="button" onclick="promptAddNewMode('edit-sw-mode', 'edit-sw-preview-code', 'edit-sw-preview-full', 'edit-mode-pills')" class="w-7 h-7 flex items-center justify-center text-xs font-bold text-emerald-600 bg-emerald-50 dark:bg-emerald-950/50 hover:bg-emerald-100 rounded-lg transition-colors border border-emerald-200 dark:border-emerald-800" title="إضافة نمط جديد"><i class="fas fa-plus"></i></button>` +
                    `<button type="button" onclick="promptEditCurrentMode('edit-sw-mode', 'edit-sw-preview-code', 'edit-sw-preview-full', 'edit-mode-pills')" class="w-7 h-7 flex items-center justify-center text-xs font-bold text-amber-600 bg-amber-50 dark:bg-amber-950/50 hover:bg-amber-100 rounded-lg transition-colors border border-amber-200 dark:border-amber-800" title="تعديل مسمى الحالة"><i class="fas fa-pen"></i></button>` +
                    `<button type="button" onclick="promptDeleteCurrentMode('edit-sw-mode', 'edit-sw-preview-code', 'edit-sw-preview-full', 'edit-mode-pills')" class="w-7 h-7 flex items-center justify-center text-xs font-bold text-rose-600 bg-rose-50 dark:bg-rose-950/50 hover:bg-rose-100 rounded-lg transition-colors border border-rose-200 dark:border-rose-800" title="مسح الحالة"><i class="fas fa-trash-alt"></i></button>` +
                    `</div>` +
                    `</div>` +
