@model IEnumerable<Exam.DTOs.WaveStudentResultDto>
@{
    ViewData["Title"] = "Wave Performance Tracker";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var waves = ViewBag.Waves as IEnumerable<Exam.DTOs.WaveDto> ?? Enumerable.Empty<Exam.DTOs.WaveDto>();
    var branches = ViewBag.Branches as IEnumerable<Exam.DTOs.BranchDto> ?? Enumerable.Empty<Exam.DTOs.BranchDto>();
    var selectedWaveId = ViewBag.SelectedWaveId as int? ?? 0;
    var selectedBranchId = ViewBag.SelectedBranchId as int? ?? 0;

    // Summary stats
    var total      = Model.Count();
    var completed  = Model.Count(s => s.WaveStatus != "INCOMPLETE");
    var incomplete = Model.Count(s => s.WaveStatus == "INCOMPLETE");
    
    var completedList = Model.Where(s => s.WaveStatus != "INCOMPLETE").ToList();
    var avgPct = completedList.Any() ? completedList.Average(s => s.TotalAvailable > 0 ? (double)(s.TotalScore / s.TotalAvailable) * 100 : 0.0) : 0.0;
}

<!-- Header / Filter Row -->
<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-8 mb-8 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
            <h2 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] mb-1">Wave Analytics</h2>
            <div class="flex items-center gap-3">
                <p class="text-xl font-bold">Wave Performance Tracker</p>
                <span class="bg-violet-100 text-violet-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border border-violet-200">
                    Final Exam Mode
                </span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-4">
            <!-- Multi-Select Branch Dropdown -->
            <div class="space-y-1 relative inline-block text-left" id="multiSelectBranchWrapperWavey">
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">Branch (الفرع)</label>
                <button type="button" id="btnMultiSelectBranchWavey" onclick="toggleBranchDropdownWavey()"
                        class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2 text-xs font-bold text-slate-700 dark:text-slate-300 outline-none focus:border-brand-500 transition-all min-w-[200px] shadow-sm flex items-center justify-between gap-2">
                    <span id="lblBranchSelectedWavey" class="truncate">All Branches</span>
                    <i class="fas fa-chevron-down text-[10px] text-slate-400"></i>
                </button>

                <!-- Dropdown Menu -->
                <div id="dropdownBranchMenuWavey" class="hidden absolute left-0 mt-2 w-64 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl z-50 p-3 space-y-2">
                    <div class="relative">
                        <input type="text" id="branchSearchInputWavey" placeholder="Search branch..." oninput="filterBranchOptionsWavey(this.value)" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-1.5 text-xs font-bold outline-none focus:border-brand-500 text-slate-800 dark:text-slate-200" />
                    </div>
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                        <span class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Filter Branches</span>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="selectAllBranchesWavey(true)" class="text-[10px] font-extrabold text-brand-600 hover:underline">All</button>
                            <span class="text-slate-300">|</span>
                            <button type="button" onclick="selectAllBranchesWavey(false)" class="text-[10px] font-extrabold text-rose-500 hover:underline">Clear</button>
                        </div>
                    </div>
                    <div class="max-h-56 overflow-y-auto space-y-1 pr-1 custom-scrollbar">
                        @foreach (var b in branches)
                        {
                            <label class="branch-option-label-wavey flex items-center gap-2.5 p-1.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer select-none text-xs font-bold text-slate-700 dark:text-slate-300">
                                <input type="checkbox" value="@b.BranchName.ToUpper()" class="chk-branch-wavey rounded border-slate-300 text-brand-600 focus:ring-brand-500" onchange="onBranchFilterChangeWavey()" />
                                <span class="truncate">@b.BranchName</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <!-- Year & Month Filters -->
            <div class="space-y-1">
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">Year</label>
                <select id="yearFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2 text-xs font-bold w-[100px]">
                    <option value="0">Year</option>
                    @for (int y = DateTime.Now.Year; y >= 2024; y--)
                    {
                        <option value="@y" selected="@(ViewBag.SelectedYear == y ? "selected" : null)">@y</option>
                    }
                </select>
            </div>

            <div class="space-y-1">
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">Month</label>
                <select id="monthFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2 text-xs font-bold w-[120px]">
                    <option value="0">Month</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(ViewBag.SelectedMonth == m ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>

            <div class="space-y-1">
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">Training Wave</label>
                <select id="waveFilter" class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2 text-xs font-bold text-slate-700 dark:text-slate-300 outline-none focus:border-brand-500 transition-all min-w-[200px] shadow-sm">
                    <option value="-1" selected="@(selectedWaveId == -1 ? "selected" : null)">All Waves (كل الويفات)</option>
                    @foreach (var w in waves)
                    {
                        <option value="@w.Id" selected="@(w.Id == selectedWaveId ? "selected" : null)">
                            @w.WaveName.ToUpper() @(w.StartDate.HasValue ? $"({w.StartDate.Value.ToString("MMM yyyy")})" : "")
                        </option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2 mt-auto">
                <button id="btnExport" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-6 py-3 rounded-2xl text-[10px] font-black tracking-widest uppercase transition-all flex items-center gap-2">
                    <i class="fas fa-file-excel"></i> Export Results
                </button>
                <button id="btnShowUnassignedModal" class="bg-rose-50 text-rose-600 hover:bg-rose-100 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 px-6 py-3 rounded-2xl text-[10px] font-black tracking-widest uppercase transition-all flex items-center gap-2">
                    <i class="fas fa-user-slash text-rose-500"></i> Unassigned Users (عرض غير المسجلين)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[24px] p-5 shadow-sm flex flex-col gap-1">
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Total Students</span>
        <span class="text-3xl font-black text-slate-900 dark:text-white">@total</span>
    </div>
    <div class="bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 rounded-[24px] p-5 shadow-sm flex flex-col gap-1">
        <span class="text-[10px] font-black text-emerald-600 uppercase tracking-widest">Completed</span>
        <span class="text-3xl font-black text-emerald-700">@completed</span>
        <span class="text-[9px] font-bold text-emerald-500">Submitted attempts</span>
    </div>
    <div class="bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 rounded-[24px] p-5 shadow-sm flex flex-col gap-1">
        <span class="text-[10px] font-black text-amber-600 uppercase tracking-widest">Incomplete</span>
        <span class="text-3xl font-black text-amber-700">@incomplete</span>
        <span class="text-[9px] font-bold text-amber-500">Pending attempts</span>
    </div>
    <div class="bg-indigo-50 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 rounded-[24px] p-5 shadow-sm flex flex-col gap-1">
        <span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest">Avg. Percentage</span>
        <span class="text-3xl font-black text-indigo-700">@avgPct.ToString("0.0")%</span>
        <span class="text-[9px] font-bold text-indigo-500">Average score percentage</span>
    </div>
</div>

<!-- Results Table -->
<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] p-6 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="datatable saas-table" id="waveResultsTable">
            <thead>
                <tr>
                    <th class="min-w-[240px]">Personnel</th>
                    <th>Branch</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Start Time</th>
                    <th>Finish Time</th>
                    <th>Time (M)</th>
                    <th>Score</th>
                    <th>Percentage</th>
                    <th class="text-right px-8">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-12 text-slate-400">
                            <div class="flex flex-col items-center justify-center gap-3">
                                <div class="w-16 h-16 bg-slate-50 dark:bg-slate-900 rounded-full flex items-center justify-center text-slate-400 dark:text-slate-600 shadow-inner">
                                    <i class="fas fa-inbox text-2xl"></i>
                                </div>
                                <span class="font-bold text-sm">No records found for this branch or wave</span>
                                <p class="text-xs text-slate-400 max-w-xs leading-relaxed">Ensure the selected wave contains exams and that students from your branch are assigned to it.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    <tr data-wave-id="@s.WaveId" data-wave-name="@(s.WaveName ?? "")" data-branch-name="@(s.BranchName ?? "")">
                        <td>
                            <span class="hidden wave-name-val">@(s.WaveName ?? "")</span>
                            <span class="hidden branch-name-val">@(s.BranchName ?? "")</span>
                            <div class="flex items-center gap-3 px-2 py-2 flex-nowrap">
                                <div class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-400 font-bold uppercase">
                                    @(s.StudentName.Length > 0 ? s.StudentName.Substring(0, 1) : "?")
                                </div>
                                <div class="flex flex-col">
                                    <span class="font-bold text-slate-900 dark:text-white leading-tight">@s.StudentName</span>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">@s.StudentEmail</span>
                                    <span class="text-[9px] font-bold text-slate-300 uppercase">@s.UserCode</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-[10px] font-black text-slate-400 uppercase">@(string.IsNullOrEmpty(s.BranchName) ? "--" : s.BranchName)</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(s.RoleName))
                            {
                                bool isPharm = s.RoleName.ToLower().Contains("pharmacist") || s.RoleName.Contains("صيدل");
                                <span class="px-2 py-0.5 rounded-lg text-[9px] font-black uppercase @(isPharm ? "bg-purple-50 text-purple-600 border border-purple-200" : "bg-sky-50 text-sky-600 border border-sky-200")">
                                    @(isPharm ? "Pharmacist" : "Assistant")
                                </span>
                            }
                            else
                            {
                                <span class="text-slate-400 text-xs">--</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(s.Status))
                            {
                                var statusLower = s.Status.ToLower();
                                var isCompleted = statusLower.StartsWith("completed");
                                var isInProgress = statusLower.StartsWith("inprogress");
                                var statusClass = isCompleted ? "text-emerald-600 bg-emerald-500/10" : isInProgress ? "text-amber-600 bg-amber-500/10" : "text-slate-500 bg-slate-400/10";
                                <div class="flex items-center gap-1.5 px-3 py-1 rounded-full @statusClass w-fit">
                                    <span class="text-[10px] font-black uppercase">@s.Status.ToUpper()</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-slate-400 text-xs">--</span>
                            }
                        </td>
                        <td>
                            @if (s.ActualStartTime.HasValue)
                            {
                                <div class="flex flex-col text-center">
                                    <span class="text-[9px] text-slate-400 font-bold mb-0.5">@s.ActualStartTime.Value.ToString("dd MMM yyyy")</span>
                                    <span class="text-[10px] font-bold text-slate-500 uppercase">@s.ActualStartTime.Value.ToString("hh:mm tt")</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-slate-300 dark:text-slate-700 text-xs">--</span>
                            }
                        </td>
                        <td>
                            @if (s.ActualEndTime.HasValue)
                            {
                                <div class="flex flex-col text-center">
                                    <span class="text-[9px] text-slate-400 font-bold mb-0.5">@s.ActualEndTime.Value.ToString("dd MMM yyyy")</span>
                                    <span class="text-[10px] font-bold text-slate-500 uppercase">@s.ActualEndTime.Value.ToString("hh:mm tt")</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-slate-300 dark:text-slate-700 text-xs">--</span>
                            }
                        </td>
                        <td>
                            @if (s.DurationInMinutes > 0)
                            {
                                <span class="text-xs font-bold text-slate-500">@s.DurationInMinutes m</span>
                            }
                            else if (s.ActualStartTime.HasValue && s.ActualEndTime.HasValue)
                            {
                                var dur = (int)(s.ActualEndTime.Value - s.ActualStartTime.Value).TotalMinutes;
                                <span class="text-xs font-bold text-slate-500">@(dur > 0 ? dur : 1) m</span>
                            }
                            else
                            {
                                <span class="text-slate-300 dark:text-slate-700 text-xs">--</span>
                            }
                        </td>
                        <td>
                            <div class="flex flex-col">
                                <span class="text-brand-600 dark:text-brand-400 text-sm font-bold font-mono">
                                    @s.TotalScore.ToString("0") / @s.TotalAvailable.ToString("0")
                                </span>
                            </div>
                        </td>
                        <td>
                            @{
                                double pct = s.TotalAvailable > 0 ? (double)(s.TotalScore / s.TotalAvailable) * 100 : 0;
                                string pctColor = pct >= 75 ? "text-emerald-600" : pct >= 70 ? "text-blue-600" : "text-rose-500";
                            }
                            <span class="font-black text-sm @pctColor">@pct.ToString("0.0")%</span>
                        </td>

                        <td class="text-right px-8">
                            <div class="flex items-center justify-end gap-2">
                                @if (s.ExamId.HasValue)
                                {
                                    @if (s.WaveStatus != "INCOMPLETE")
                                    {
                                        <button type="button" 
                                                class="p-2.5 text-slate-400 hover:text-indigo-600 bg-slate-50 dark:bg-slate-800 rounded-xl" 
                                                onclick="viewIndividualExamReview(@s.ExamId, '@s.UserId', '@s.StudentName - @s.WaveName')" 
                                                title="View User Question Answers">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    }
                                    @if (s.WaveStatus != "INCOMPLETE" || s.TotalScore > 0 || s.ExamsCompleted > 0 || (!string.IsNullOrEmpty(s.Status) && s.Status != "Not Started"))
                                    {
                                        <button type="button" 
                                                class="p-2.5 text-slate-400 hover:text-rose-600 bg-slate-50 dark:bg-slate-800 rounded-xl" 
                                                onclick="wipeStudentWaveExamDataDirect(@s.ExamId, '@s.UserId', @s.WaveId, '@s.StudentName')" 
                                                title="Delete & Reset Attempt">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 dark:text-slate-700 text-xs">-</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-300 dark:text-slate-700 text-xs">-</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function toggleBranchDropdownWavey() {
            $('#dropdownBranchMenuWavey').toggleClass('hidden');
            $('#dropdownWaveMenuWavey').addClass('hidden');
        }

        function toggleWaveDropdownWavey() {
            $('#dropdownWaveMenuWavey').toggleClass('hidden');
            $('#dropdownBranchMenuWavey').addClass('hidden');
        }

        $(document).click(function(e) {
            if (!$(e.target).closest('#multiSelectBranchWrapperWavey').length) {
                $('#dropdownBranchMenuWavey').addClass('hidden');
            }
            if (!$(e.target).closest('#multiSelectWaveWrapperWavey').length) {
                $('#dropdownWaveMenuWavey').addClass('hidden');
            }
        });

        function filterBranchOptionsWavey(query) {
            const q = (query || '').toLowerCase().trim();
            $('.branch-option-label-wavey').each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.includes(q));
            });
        }

        function filterWaveOptionsWavey(query) {
            const q = (query || '').toLowerCase().trim();
            $('.wave-option-label-wavey').each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.includes(q));
            });
        }

        function selectAllBranchesWavey(checkAll) {
            $('.branch-option-label-wavey:visible .chk-branch-wavey').prop('checked', checkAll);
            onBranchFilterChangeWavey();
        }

        function selectAllWavesWavey(checkAll) {
            $('.wave-option-label-wavey:visible .chk-wave-wavey').prop('checked', checkAll);
            onWaveFilterChangeWavey();
        }

        function getSelectedBranchesWavey() {
            let checked = [];
            $('.chk-branch-wavey:checked').each(function() {
                checked.push($(this).val().toUpperCase());
            });
            return checked;
        }

        function getSelectedWavesWavey() {
            let checked = [];
            $('.chk-wave-wavey:checked').each(function() {
                checked.push($(this).val().toUpperCase());
            });
            return checked;
        }

        function onBranchFilterChangeWavey() {
            let selected = getSelectedBranchesWavey();
            let total = $('.chk-branch-wavey').length;
            if (selected.length === 0 || selected.length === total) {
                $('#lblBranchSelectedWavey').html('<span class="text-slate-500">All Branches</span>');
            } else if (selected.length === 1) {
                $('#lblBranchSelectedWavey').html(`<span class="text-brand-600 font-extrabold">${selected[0]}</span>`);
            } else {
                $('#lblBranchSelectedWavey').html(`<span class="px-2 py-0.5 rounded-full bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-400 font-extrabold text-[10px]">${selected.length} Selected</span>`);
            }
            if (window.waveyTable) window.waveyTable.draw();
        }

        function onWaveFilterChangeWavey() {
            let selected = getSelectedWavesWavey();
            let total = $('.chk-wave-wavey').length;
            if (selected.length === 0 || selected.length === total) {
                $('#lblWaveSelectedWavey').html('<span class="text-slate-500">All Waves</span>');
            } else if (selected.length === 1) {
                let waveName = $('.chk-wave-wavey:checked').attr('data-wave-name') || selected[0];
                $('#lblWaveSelectedWavey').html(`<span class="text-brand-600 font-extrabold">${waveName}</span>`);
            } else {
                $('#lblWaveSelectedWavey').html(`<span class="px-2 py-0.5 rounded-full bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-400 font-extrabold text-[10px]">${selected.length} Selected</span>`);
            }
            if (window.waveyTable) window.waveyTable.draw();
        }

        const normStrWavey = s => (s || '').toString().toLowerCase().replace(/[\s\-_]/g, '');

        // DataTables Custom Multi-Select Filter for Wave & Branch
        $.fn.dataTable.ext.search.push(
            function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'waveResultsTable') return true;
                
                const selBranches = getSelectedBranchesWavey();
                const tr = settings.aoData[dataIndex] ? settings.aoData[dataIndex].nTr : null;
                const rowBranch = (data[1] || '') + ' ' + (data[0] || '') + ' ' + (tr ? $(tr).attr('data-branch-name') || '' : '');

                let branchMatch = (selBranches.length === 0 || selBranches.length === $('.chk-branch-wavey').length);
                if (!branchMatch) {
                    const nRowBranch = normStrWavey(rowBranch);
                    branchMatch = selBranches.some(b => {
                        const nb = normStrWavey(b);
                        return nRowBranch.includes(nb) || nb.includes(nRowBranch);
                    });
                }

                return branchMatch;
            }
        );

        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('#waveResultsTable')) {
                window.waveyTable = $('#waveResultsTable').DataTable();
            } else {
                window.waveyTable = $('#waveResultsTable').DataTable({
                    pageLength: 25,
                    responsive: true,
                    language: { search: "", searchPlaceholder: "Search student, branch..." }
                });
            }
        });

        // Wave / Year / Month change → reload page with parameters
        $('#waveFilter, #yearFilter, #monthFilter').change(function () {
            const waveId = $('#waveFilter').val();
            const year  = $('#yearFilter').val();
            const month = $('#monthFilter').val();
            let url = '/Admin/WaveyResults?waveId=' + waveId + '&year=' + year + '&month=' + month;
            if (window.location.search.includes('iframe=true')) url += '&iframe=true';
            window.location = url;
        });

        // Export
        $('#btnExport').on('click', function () {
            window.location = '/Admin/ExportWaveResultsToExcel?year=' + $('#yearFilter').val() + '&month=' + $('#monthFilter').val();
        });

        $('#btnShowUnassignedModal').on('click', function () {
            const waveId = $('#waveFilter').val() || -1;
            const branchId = $('#branchFilter').val() || 0;

            Swal.fire({
                title: 'Loading Users...',
                html: '<div class="py-10 text-center"><i class="fas fa-spinner fa-spin text-4xl text-rose-500"></i><p class="mt-3 text-xs font-bold text-slate-500">Fetching unassigned trainees...</p></div>',
                showConfirmButton: false,
                allowOutsideClick: false,
                background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000'
            });

            $.get('/Admin/GetUnassignedUsersList', { waveId: waveId, branchId: branchId }, function (res) {
                if (!res.success) {
                    Swal.fire('Error', res.message || 'Failed to load list', 'error');
                    return;
                }

                let userRowsHtml = '';
                if (res.users && res.users.length > 0) {
                    res.users.forEach((u, i) => {
                        userRowsHtml += `
                            <tr class="border-b border-slate-100 dark:border-slate-800/60 hover:bg-slate-50 dark:hover:bg-slate-800/40 text-xs">
                                <td class="py-2.5 px-3 font-mono text-slate-400 text-center">${i + 1}</td>
                                <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-slate-100">${u.userName || u.UserName || '-'}</td>
                                <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400 font-mono">${u.userCode || u.UserCode || '-'}</td>
                                <td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">${u.email || u.Email || '-'}</td>
                                <td class="py-2.5 px-3 font-semibold text-violet-600 dark:text-violet-400">${u.roleName || u.RoleName || 'Trainee'}</td>
                                <td class="py-2.5 px-3 font-bold text-slate-700 dark:text-slate-300">${u.branchName || u.BranchName || 'GLOBAL'}</td>
                            </tr>
                        `;
                    });
                } else {
                    userRowsHtml = `<tr><td colspan="6" class="py-8 text-center text-slate-400 font-bold">No unassigned trainees found for current filters.</td></tr>`;
                }

                const modalHtml = `
                    <div class="text-left space-y-4">
                        <div class="flex items-center justify-between gap-4 pb-2 border-b border-slate-200 dark:border-slate-800">
                            <div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-rose-500">Unassigned Personnel List</span>
                                <h3 class="text-base font-extrabold text-slate-900 dark:text-white">المتدربين غير المسجلين في الويفات</h3>
                            </div>
                            <span class="bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300 px-3 py-1 rounded-full text-xs font-black">
                                ${res.count} Users
                            </span>
                        </div>

                        <div class="flex items-center gap-3">
                            <input id="modalSearchInput" type="text" placeholder="Search by name, email, code or branch..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2 text-xs font-bold outline-none focus:border-rose-500 transition-all text-slate-800 dark:text-slate-200" />
                            <a href="/Admin/ExportUnassignedUsersToExcel?waveId=${waveId}&branchId=${branchId}" class="bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap flex items-center gap-1.5 shadow-md shadow-rose-600/20">
                                <i class="fas fa-file-excel"></i> Export Excel
                            </a>
                        </div>

                        <div class="overflow-y-auto max-h-[50vh] border border-slate-200 dark:border-slate-800 rounded-2xl">
                            <table class="w-full text-left border-collapse" id="unassignedModalTable">
                                <thead class="sticky top-0 bg-slate-100 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 text-[10px] font-black uppercase text-slate-500">
                                    <tr>
                                        <th class="py-2.5 px-3 text-center">#</th>
                                        <th class="py-2.5 px-3">Name</th>
                                        <th class="py-2.5 px-3">Code</th>
                                        <th class="py-2.5 px-3">Email</th>
                                        <th class="py-2.5 px-3">Role</th>
                                        <th class="py-2.5 px-3">Branch</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${userRowsHtml}
                                </tbody>
                            </table>
                        </div>
                    </div>
                `;

                Swal.fire({
                    html: modalHtml,
                    width: '850px',
                    showConfirmButton: true,
                    confirmButtonText: 'Close / إغلاق',
                    confirmButtonColor: '#64748b',
                    background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                    color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
                    didOpen: () => {
                        $('#modalSearchInput').on('input', function() {
                            const q = $(this).val().toLowerCase().trim();
                            $('#unassignedModalTable tbody tr').each(function() {
                                const text = $(this).text().toLowerCase();
                                $(this).toggle(text.indexOf(q) > -1);
                            });
                        });
                    }
                });
            });
        });

        // View wave breakdown details
        $(document).on('click', '.view-wave-details', function() {
            const id = $(this).data('student-id');
            const waveId = $(this).data('wave-id');
            Swal.fire({
                title: 'Student Wave Performance Breakdown',
                width: '70%',
                showConfirmButton: false,
                showCloseButton: true,
                background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
                html: '<div id="swalWaveDetails" style="text-align:left; max-height: 75vh; overflow-y: auto;"><div class="py-10 text-center"><i class="fas fa-sync fa-spin text-3xl text-brand-500"></i></div></div>',
                didOpen: () => { 
                    $.get('/Admin/GetStudentWaveDetails', { studentId: id, waveId: waveId })
                     .done(h => $('#swalWaveDetails').html(h))
                     .fail(() => $('#swalWaveDetails').html('<div class="p-8 text-rose-500">Failed to load data.</div>'));
                }
            });
        });

        // View individual exam review
        function viewIndividualExamReview(examId, studentId, examTitle) {
            Swal.fire({
                title: `Review: ${examTitle}`,
                width: '80%',
                showConfirmButton: false,
                showCloseButton: true,
                background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
                html: '<div id="swalIndividualReview" style="text-align:left; max-height: 70vh; overflow-y: auto;"><div class="py-10 text-center"><i class="fas fa-sync fa-spin text-3xl text-brand-500"></i></div></div>',
                didOpen: () => { 
                    $.get('/Admin/GetStudentExamReview', { examId: examId, studentId: studentId })
                     .done(h => $('#swalIndividualReview').html(h))
                     .fail(() => $('#swalIndividualReview').html('<div class="p-8 text-rose-500">Failed to load data.</div>'));
                }
            });
        }

        // Wipe / delete student exam attempt inside a wave
        function wipeStudentWaveExamData(examId, studentId, waveId, examTitle) {
            Swal.fire({
                title: 'Are you absolutely sure?',
                text: `This will PERMANENTLY delete all answers and attempts for ${examTitle}. The student will need to take the exam again.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Wipe Everything!',
                cancelButtonText: 'Cancel',
                background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Wiping Data...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.post('/Admin/WipeStudentData', { examId: examId, studentId: studentId }, function(res) {
                        if (res.success) {
                            Swal.fire({
                                title: 'Success!',
                                text: res.message,
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                // Refresh the details modal content in-place first, and then reload the parent page on close
                                $('#swalWaveDetails').html('<div class="py-10 text-center"><i class="fas fa-sync fa-spin text-3xl text-brand-500"></i></div>');
                                $.get('/Admin/GetStudentWaveDetails', { studentId: studentId, waveId: waveId })
                                 .done(h => {
                                     $('#swalWaveDetails').html(h);
                                     // Also hook a reload to reload the parent page when the Swal modal closes so scores remain synchronized
                                     const swalCloseButton = document.querySelector('.swal2-close');
                                     if (swalCloseButton) {
                                         swalCloseButton.addEventListener('click', () => {
                                             location.reload();
                                         }, { once: true });
                                     }
                                 })
                                 .fail(() => $('#swalWaveDetails').html('<div class="p-8 text-rose-500">Failed to load data.</div>'));
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }

        // Direct wipe from the main Wave results table
        function wipeStudentWaveExamDataDirect(examId, studentId, waveId, studentName) {
            Swal.fire({
                title: 'Are you absolutely sure?',
                text: `This will PERMANENTLY delete all answers and attempts for ${studentName}. The student will need to take the exam again.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Wipe Everything!',
                cancelButtonText: 'Cancel',
                background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Wiping Data...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.post('/Admin/WipeStudentData', { examId: examId, studentId: studentId }, function(res) {
                        if (res.success) {
                            Swal.fire({
                                title: 'Success!',
                                text: res.message,
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}
