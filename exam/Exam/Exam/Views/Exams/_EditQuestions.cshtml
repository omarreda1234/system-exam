@model Exam.DTOs.ExamDetailsDto
@{
    var distinctTopics = Model.Questions
        .Where(q => q.TopicId.HasValue && q.TopicId.Value > 0 && !string.IsNullOrWhiteSpace(q.TopicName))
        .GroupBy(q => q.TopicId.Value)
        .Select(g => new { 
            TopicId = g.Key, 
            TopicName = g.First().TopicName, 
            CategoryId = g.First().CategoryId 
        })
        .OrderBy(t => t.TopicName)
        .ToList();

    var examPoints = Model.Questions.Select(q => q.Points).Distinct().ToList();
    var availablePoints = examPoints.Union(new[] { 1, 2, 3 }).Distinct().OrderBy(p => p).ToList();
}

<div class="p-2 custom-scrollbar">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <h5 class="text-2xl font-black text-slate-900 dark:text-white italic tracking-tighter uppercase">Questions Library</h5>
                <span id="filterCountBadge" class="text-[10px] font-black uppercase tracking-widest text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg">@Model.Questions.Count Questions</span>
            </div>
            <p class="text-[10px] font-bold text-brand-500 uppercase tracking-[0.3em]">Exam: @Model.Title.ToUpper()</p>
        </div>

        <!-- Floating Add Button -->
        <button type="button" id="addQuestionBtnInModal" class="fixed bottom-10 right-10 z-[9999] w-16 h-16 bg-brand-600 hover:bg-brand-700 text-white rounded-full shadow-2xl shadow-brand-500/40 flex items-center justify-center transition-all hover:scale-110 active:scale-95 group border-4 border-white dark:border-slate-900">
            <i class="fas fa-plus text-xl transition-transform group-hover:rotate-90"></i>
            <span class="absolute right-full mr-4 bg-slate-900/90 backdrop-blur-md text-white text-[10px] font-black uppercase tracking-[0.2em] px-4 py-2 rounded-xl opacity-0 group-hover:opacity-100 pointer-events-none transition-all translate-x-2 group-hover:translate-x-0 whitespace-nowrap shadow-xl">
                Add Question
            </span>
        </button>

        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Category Filter -->
            <div class="relative">
                <select id="categoryFilter" class="pr-8 pl-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none transition-all appearance-none cursor-pointer min-w-[140px]">
                    <option value="">ALL CATEGORIES</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<Exam.DTOs.CategoryDto>)ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.CategoryName.ToUpper()</option>
                        }
                    }
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 pointer-events-none"></i>
            </div>

            <!-- Topic Filter -->
            <div class="relative">
                <select id="topicFilter" class="pr-8 pl-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none transition-all appearance-none cursor-pointer min-w-[140px]">
                    <option value="">ALL TOPICS</option>
                    @foreach (var top in distinctTopics)
                    {
                        <option value="@top.TopicId" data-category-id="@top.CategoryId">@top.TopicName.ToUpper()</option>
                    }
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 pointer-events-none"></i>
            </div>

            <!-- Difficulty Filter -->
            <div class="relative">
                <select id="difficultyFilter" class="pr-8 pl-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none transition-all appearance-none cursor-pointer min-w-[130px]">
                    <option value="">ALL DIFFICULTIES</option>
                    <option value="1">EASY</option>
                    <option value="2">MEDIUM</option>
                    <option value="3">HARD</option>
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 pointer-events-none"></i>
            </div>

            <!-- Points Filter -->
            <div class="relative">
                <select id="pointsFilter" class="pr-8 pl-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none transition-all appearance-none cursor-pointer min-w-[110px]">
                    <option value="">ALL POINTS</option>
                    @foreach (var pt in availablePoints)
                    {
                        <option value="@pt">@pt @(pt == 1 ? "POINT" : "POINTS")</option>
                    }
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 pointer-events-none"></i>
            </div>

            <!-- Search Bar -->
            <div class="relative">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="questionSearch" placeholder="Search questions..." class="pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none w-44 md:w-56 transition-all" />
            </div>

            <!-- Reset Filters -->
            <button type="button" id="resetFiltersBtn" class="hidden text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 px-3 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5" title="Reset all filters">
                <i class="fas fa-times-circle"></i> Clear
            </button>

            @if (Model.Questions.Any())
            {
                <button type="button" id="deleteAllQuestionsBtn" class="bg-rose-50 hover:bg-rose-500 text-rose-500 hover:text-white px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-sm border border-rose-100 dark:border-rose-900/30 dark:bg-rose-500/10 flex items-center gap-2">
                    <i class="fas fa-trash-alt"></i> <span id="deleteAllBtnText">Delete All</span>
                </button>
            }
        </div>
    </div>

    @if (!Model.Questions.Any())
    {
        <div class="text-center py-20 bg-slate-50 dark:bg-slate-900 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-[32px] mx-4">
            <div class="w-16 h-16 bg-white dark:bg-slate-950 rounded-full shadow-sm flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-layer-group text-slate-400 text-2xl"></i>
            </div>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest">No questions found for this exam.</p>
        </div>
    }

    <!-- Empty filtered results notice -->
    <div id="noQuestionsMatchNotice" class="hidden text-center py-16 bg-slate-50 dark:bg-slate-900 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-[32px] mx-4 my-6">
        <div class="w-14 h-14 bg-white dark:bg-slate-950 rounded-full shadow-sm flex items-center justify-center mx-auto mb-4 text-slate-400">
            <i class="fas fa-filter text-xl text-brand-500"></i>
        </div>
        <p class="text-slate-700 dark:text-slate-300 text-sm font-black uppercase tracking-tight mb-1">No matching questions found</p>
        <p class="text-slate-400 text-xs font-semibold">Try adjusting your filters or search keywords.</p>
    </div>

    <!-- Pagination Bar (Top) -->
    <div id="topPaginationBar" class="flex flex-wrap items-center justify-between gap-4 px-4 py-3 mb-6 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl">
        <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-slate-500 dark:text-slate-400">
                Showing <span id="pageStartCount" class="font-black text-brand-600 dark:text-brand-400">0</span> - <span id="pageEndCount" class="font-black text-brand-600 dark:text-brand-400">0</span> of <span id="pageTotalCount" class="font-black">@Model.Questions.Count</span> Questions
            </span>
            <div class="h-4 w-[1px] bg-slate-200 dark:bg-slate-800 hidden sm:block"></div>
            <div class="flex items-center gap-1.5 text-xs font-bold text-slate-500">
                <span class="hidden sm:inline">Per page:</span>
                <select id="pageSizeSelect" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-1 text-xs font-bold text-slate-700 dark:text-slate-300 outline-none cursor-pointer">
                    <option value="15" selected>15</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="0">All</option>
                </select>
            </div>
        </div>
        <div class="pagination-controls flex items-center gap-1">
        </div>
    </div>

    <div class="space-y-8 px-4 pb-8">
        @foreach (var q in Model.Questions)
        {
            var rawSearch = $"{q.QuestionId} {q.QuestionText} {string.Join(" ", q.Choices.Select(c => c.ChoiceText))}".ToLower();
            <div class="question-panel bg-white dark:bg-slate-900 shadow-sm border border-slate-200 dark:border-slate-800 rounded-[32px] overflow-hidden group/q hover:border-brand-500/30 transition-all"
                 data-question-id="@q.QuestionId"
                 data-category-id="@q.CategoryId"
                 data-topic-id="@(q.TopicId?.ToString() ?? "")"
                 data-difficulty="@(q.Difficulty == 0 ? 1 : q.Difficulty)"
                 data-points="@q.Points"
                 data-search-text="@rawSearch">
                <div class="p-8">
                    <form class="update-question-form relative">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="examId" value="@Model.ExamId" />
                        <input type="hidden" name="questionId" value="@q.QuestionId" />

                        <div class="flex items-center justify-between mb-8">
                            <div class="flex items-center gap-3">
                                <div class="w-2 h-2 rounded-full bg-brand-500 shadow-sm shadow-brand-500/50"></div>
                                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">Question ID: @q.QuestionId</span>
                            </div>
                            <button type="button" class="text-[9px] font-bold text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 px-4 py-2 rounded-xl transition-colors uppercase tracking-widest delete-question" data-question-id="@q.QuestionId">
                                <i class="fas fa-trash-alt mr-1"></i> Delete Question
                            </button>
                        </div>

                        <div class="grid grid-cols-12 gap-8 mb-8">
                            <div class="col-span-12 lg:col-span-12">
                                <label class="block text-[9px] font-bold text-brand-500 uppercase tracking-widest mb-3 px-1">Question Text</label>
                                <textarea name="questionText" rows="3" class="block w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-[24px] p-6 text-xl font-black text-slate-900 dark:text-white focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 transition-all outline-none resize-y min-h-[120px]" oninput="this.style.height = ''; this.style.height = (this.scrollHeight + 10) + 'px'">@q.QuestionText</textarea>
                            </div>
                            <div class="col-span-12 md:col-span-4">
                                <label class="block text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-3 px-1">Category</label>
                                <select name="categoryId" class="cat-selector block w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-[20px] px-5 py-4 text-xs font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none transition-all" data-current-topic="@(q.TopicId.HasValue ? q.TopicId.Value.ToString() : "")">
                                     @if (ViewBag.Categories != null)
                                     {
                                         foreach (var cat in (IEnumerable<Exam.DTOs.CategoryDto>)ViewBag.Categories)
                                         {
                                             <option value="@cat.Id" selected="@(cat.Id == q.CategoryId)">@cat.CategoryName.ToUpper()</option>
                                         }
                                     }
                                 </select>
                            </div>
                            <div class="col-span-12 md:col-span-5">
                                <label class="block text-[9px] font-bold text-emerald-500 uppercase tracking-widest mb-3 px-1">Topic / Lecture</label>
                                <select name="topicId" class="topic-selector block w-full bg-slate-50 dark:bg-slate-950 border border-emerald-500/20 rounded-[20px] px-5 py-4 text-[10px] font-bold text-slate-700 dark:text-slate-300 focus:border-brand-500 outline-none transition-all">
                                    <option value="">ALL TOPICS</option>
                                    @if (q.TopicId.HasValue && q.TopicId.Value > 0 && !string.IsNullOrWhiteSpace(q.TopicName))
                                    {
                                        <option value="@q.TopicId.Value" selected>@q.TopicName.ToUpper()</option>
                                    }
                                </select>
                            </div>
                            <div class="col-span-12 md:col-span-3">
                                <label class="block text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-3 px-1">Points</label>
                                <input type="number" name="points" value="@q.Points" class="block w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-[20px] px-5 py-4 text-xs font-black text-brand-600 focus:border-brand-500 outline-none" />
                            </div>
                        </div>
                        
                        <div class="flex flex-wrap items-center justify-between gap-6">
                            <div class="flex items-center gap-1.5 p-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl w-fit">
                                @foreach (var lvl in new[] { (1, "Easy", "E"), (2, "Medium", "M"), (3, "Hard", "H") }) {
                                    <label class="cursor-pointer">
                                        <input type="radio" name="difficulty" value="@lvl.Item1" class="peer hidden" @(q.Difficulty == lvl.Item1 || (lvl.Item1 == 1 && q.Difficulty == 0) ? "checked" : "") />
                                        <span class="px-6 py-2 rounded-xl text-[10px] font-black italic peer-checked:bg-white dark:peer-checked:bg-slate-800 peer-checked:shadow-sm peer-checked:text-brand-600 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-all block uppercase tracking-tighter">@lvl.Item2</span>
                                    </label>
                                }
                            </div>
                            <button type="button" class="bg-brand-50 dark:bg-brand-500/10 hover:bg-brand-600 border border-brand-500/10 text-brand-600 hover:text-white px-8 py-3.5 rounded-2xl font-black italic uppercase text-[10px] tracking-widest transition-all save-question shadow-sm">
                                Save Question
                            </button>
                        </div>
                    </form>

                    <div class="mt-8 mb-6 h-[1px] bg-slate-100 dark:bg-slate-800"></div>
                    
                    <div class="space-y-4">
                        <div class="flex items-center justify-between mb-4">
                            <h6 class="text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">Answer Choices</h6>
                            <button type="button" class="text-[9px] font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 transition-colors add-choice px-3 py-1.5 bg-brand-50 dark:bg-brand-500/10 rounded-lg" data-question-id="@q.QuestionId">
                                + Add Choice
                            </button>
                        </div>

                        <div class="choices grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var c in q.Choices)
                            {
                                <form class="update-choice-form flex items-center gap-4 bg-slate-50 dark:bg-slate-950 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500/30 transition-all group/choice shadow-sm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="choiceId" value="@c.ChoiceId" />
                                    <input type="hidden" name="questionId" value="@q.QuestionId" />

                                    <label class="relative flex items-center cursor-pointer">
                                        <input type="checkbox" name="isCorrect" value="true" class="peer hidden" @(c.IsCorrect ? "checked" : "") />
                                        <div class="w-6 h-6 bg-white dark:bg-slate-900 border-2 border-slate-300 dark:border-slate-700 rounded-xl flex items-center justify-center peer-checked:bg-emerald-500 peer-checked:border-emerald-500 transition-all shadow-sm">
                                            <i class="fas fa-check text-[10px] text-white opacity-0 peer-checked:opacity-100 transition-opacity"></i>
                                        </div>
                                    </label>

                                    <input type="text" name="choiceText" value="@c.ChoiceText" class="block flex-1 bg-transparent border-0 text-base font-black text-slate-900 dark:text-white focus:ring-0 outline-none w-full" />

                                    <div class="flex items-center gap-1 opacity-50 group-hover/choice:opacity-100 transition-opacity">
                                        <button type="button" class="p-2 text-brand-500 bg-brand-50 dark:bg-brand-500/10 hover:bg-brand-600 hover:text-white rounded-lg transition-all save-choice" title="Save Choice">
                                            <i class="fas fa-save text-xs"></i>
                                        </button>
                                        <button type="button" class="p-2 text-rose-500 bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-600 hover:text-white rounded-lg transition-all delete-choice" data-choice-id="@c.ChoiceId" title="Delete Choice">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                    </div>
                                </form>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Bar (Bottom) -->
    <div id="bottomPaginationBar" class="flex flex-wrap items-center justify-between gap-4 px-4 py-3 mt-6 mb-8 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl">
        <div class="text-xs font-bold text-slate-500 dark:text-slate-400">
            Page <span class="currentPageNum font-black text-brand-600 dark:text-brand-400">1</span> of <span class="totalPageNum font-black">1</span>
        </div>
        <div class="pagination-controls flex items-center gap-1">
        </div>
    </div>
</div>

<script>
    (function () {
        var examId = @Model.ExamId;
        $(document).off('focusin.bs.modal');

        function antiForgery() { return $('input[name="__RequestVerificationToken"]').first().val(); }

        const topicCache = {};
        const pendingTopicRequests = {};
        let allFilterTopics = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(distinctTopics.Select(t => new { id = t.TopicId.ToString(), name = t.TopicName, categoryId = t.CategoryId.ToString() })));

        function updateTopicFilterDropdown() {
            const selectedCat = ($('#categoryFilter').val() || '').toString();
            const currentSelectedTopic = ($('#topicFilter').val() || '').toString();
            
            let html = '<option value="">ALL TOPICS</option>';
            const filtered = allFilterTopics.filter(t => !selectedCat || t.categoryId.toString() === selectedCat);
            
            const seen = new Set();
            const unique = [];
            filtered.forEach(t => {
                if (!seen.has(t.id.toString())) {
                    seen.add(t.id.toString());
                    unique.push(t);
                }
            });

            unique.sort((a, b) => a.name.localeCompare(b.name));
            unique.forEach(t => {
                html += `<option value="${t.id}">${t.name.toUpperCase()}</option>`;
            });
            
            $('#topicFilter').html(html);
            if (currentSelectedTopic && unique.some(t => t.id.toString() === currentSelectedTopic)) {
                $('#topicFilter').val(currentSelectedTopic);
            } else {
                $('#topicFilter').val('');
            }
        }

        async function loadTopicsForSelector($catSelector, $topicSelector, selectedTopicId) {
            const catId = $catSelector.val();
            if (!catId) return;

            $topicSelector.prop('disabled', true);
            try {
                let topics;
                if (topicCache[catId]) {
                    topics = topicCache[catId];
                } else {
                    if (!pendingTopicRequests[catId]) {
                        pendingTopicRequests[catId] = $.get(`/Admin/GetTopicsByCategoryId?categoryId=${catId}`);
                    }
                    topics = await pendingTopicRequests[catId];
                    topicCache[catId] = topics;
                }

                $topicSelector.empty().append('<option value="">ALL TOPICS</option>');
                
                if (topics && Array.isArray(topics)) {
                    topics.forEach(t => {
                        const tId = t.id !== undefined ? t.id : t.Id;
                        const tName = t.topicName || t.TopicName || "Unnamed Topic";
                        if (tId !== undefined) {
                            $topicSelector.append($('<option></option>').val(tId).text(tName.toUpperCase()));
                        }
                    });
                }

                if (selectedTopicId) {
                    const targetId = selectedTopicId.toString();
                    $topicSelector.val(targetId);
                    if ($topicSelector.val() != targetId) {
                        $topicSelector.find(`option[value="${targetId}"]`).prop('selected', true);
                    }
                }
            } catch (err) { 
                console.error("Topic load failed", err); 
            } finally {
                $topicSelector.prop('disabled', false);
            }
        }

        // Lazy load full topics for a question's selector when clicked/focused
        $(document).on('focus click', '.topic-selector', function() {
            const $top = $(this);
            if ($top.data('populated')) return;
            const $panel = $top.closest('.question-panel');
            const catId = $panel.find('.cat-selector').val() || $panel.attr('data-category-id');
            const currentVal = $top.val() || $panel.attr('data-topic-id') || '';
            if (catId) {
                loadTopicsForSelector($panel.find('.cat-selector'), $top, currentVal).then(() => {
                    $top.data('populated', true);
                });
            }
        });

        // Keep question panel data attributes in sync with inputs
        $(document).on('change', '.cat-selector', function() {
            const $cat = $(this);
            const $panel = $cat.closest('.question-panel');
            const catVal = $cat.val() || '';
            $panel.attr('data-category-id', catVal);
            const qId = $panel.attr('data-question-id');
            const qIdx = questionData.findIndex(q => q.id === qId);
            if (qIdx !== -1) questionData[qIdx].catId = catVal;

            const $top = $cat.closest('.grid').find('.topic-selector');
            $top.data('populated', false);
            loadTopicsForSelector($cat, $top, null);

            if ($('#categoryFilter').val()) {
                filterAndPaginate(1);
            }
        });

        $(document).on('change', '.topic-selector', function() {
            const val = $(this).val() || '';
            const $panel = $(this).closest('.question-panel');
            $panel.attr('data-topic-id', val);
            const qId = $panel.attr('data-question-id');
            const qIdx = questionData.findIndex(q => q.id === qId);
            if (qIdx !== -1) questionData[qIdx].topicId = val;

            if ($('#topicFilter').val()) {
                filterAndPaginate(1);
            }
        });

        $(document).on('input change', 'input[name="points"]', function() {
            const val = $(this).val() || '';
            const $panel = $(this).closest('.question-panel');
            $panel.attr('data-points', val);
            const qId = $panel.attr('data-question-id');
            const qIdx = questionData.findIndex(q => q.id === qId);
            if (qIdx !== -1) questionData[qIdx].points = val;

            if ($('#pointsFilter').val()) {
                filterAndPaginate(1);
            }
        });

        $(document).on('change', 'input[name="difficulty"]', function() {
            const val = $(this).val() || '';
            const $panel = $(this).closest('.question-panel');
            $panel.attr('data-difficulty', val);
            const qId = $panel.attr('data-question-id');
            const qIdx = questionData.findIndex(q => q.id === qId);
            if (qIdx !== -1) questionData[qIdx].diff = val;

            if ($('#difficultyFilter').val()) {
                filterAndPaginate(1);
            }
        });

        function triggerRefresh(scrollToBottom) {
            var $body = $('#qModalBody');
            var scrollPos = $body.scrollTop();
            
            $.ajax({
                url: '@Url.Action("GetDetails", "Exams", new { id = Model.ExamId })',
                method: 'GET',
                success: function(response) {
                    $body.html(response);
                    if (scrollToBottom === true) {
                        $body.animate({ scrollTop: $body[0].scrollHeight }, 500);
                    } else {
                        $body.scrollTop(scrollPos);
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire('Refresh Failed', 'Error: ' + (error || status), 'error');
                }
            });
        }

        // In-modal non-intrusive toast notification
        function showInModalToast(message, type) {
            $('.in-modal-toast-notice').remove();
            var isSuccess = type === 'success';
            var bgClass = isSuccess ? 'bg-emerald-600 text-white shadow-emerald-500/20' : 'bg-rose-600 text-white shadow-rose-500/20';
            var iconClass = isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle';
            
            var $toast = $(`
                <div class="in-modal-toast-notice fixed top-6 right-8 z-[999999] flex items-center gap-2.5 px-5 py-3 rounded-2xl shadow-2xl ${bgClass} text-xs font-black uppercase tracking-wider transition-all transform -translate-y-2 opacity-0 pointer-events-none">
                    <i class="fas ${iconClass} text-sm"></i>
                    <span>${message}</span>
                </div>
            `);
            $('body').append($toast);
            
            setTimeout(function() {
                $toast.removeClass('-translate-y-2 opacity-0').addClass('translate-y-0 opacity-100');
            }, 10);
            
            setTimeout(function() {
                $toast.removeClass('translate-y-0 opacity-100').addClass('-translate-y-2 opacity-0');
                setTimeout(function() { $toast.remove(); }, 300);
            }, 2200);
        }

        // --- Fast In-Memory Indexing & Client-Side Pagination ---
        let currentPage = 1;
        let pageSize = 15;
        let questionData = [];
        let filteredIndices = [];

        const $allPanels = $('.question-panel');
        $allPanels.each(function(idx) {
            const $p = $(this);
            questionData.push({
                index: idx,
                el: this,
                id: ($p.attr('data-question-id') || '').toString(),
                catId: ($p.attr('data-category-id') || '').toString(),
                topicId: ($p.attr('data-topic-id') || '').toString(),
                diff: ($p.attr('data-difficulty') || '1').toString(),
                points: ($p.attr('data-points') || '').toString(),
                searchText: ($p.attr('data-search-text') || '').toLowerCase()
            });
        });

        function renderPaginationControls(startItem, endItem, totalFiltered, totalPages) {
            $('#pageStartCount').text(totalFiltered > 0 ? startItem : 0);
            $('#pageEndCount').text(endItem);
            $('#pageTotalCount').text(totalFiltered);
            $('.currentPageNum').text(currentPage);
            $('.totalPageNum').text(totalPages || 1);

            if (totalPages <= 1) {
                $('.pagination-controls').html('');
                return;
            }

            let btnsHtml = '';
            // Prev
            btnsHtml += `<button type="button" class="page-btn-prev px-2.5 py-1 rounded-lg text-xs font-bold border transition-all ${currentPage === 1 ? 'opacity-40 pointer-events-none border-slate-200 dark:border-slate-800 text-slate-400' : 'hover:bg-brand-500 hover:text-white border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300'}"><i class="fas fa-chevron-left text-[10px]"></i></button>`;

            // Page numbers
            const maxVisiblePages = 5;
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
            if (endPage - startPage < maxVisiblePages - 1) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            if (startPage > 1) {
                btnsHtml += `<button type="button" class="page-num-btn px-2.5 py-1 rounded-lg text-xs font-bold border border-slate-200 dark:border-slate-800 hover:bg-brand-500 hover:text-white" data-page="1">1</button>`;
                if (startPage > 2) btnsHtml += `<span class="px-1 text-slate-400 text-xs font-bold">...</span>`;
            }

            for (let p = startPage; p <= endPage; p++) {
                const isActive = p === currentPage;
                const activeClass = isActive 
                    ? 'bg-brand-600 text-white border-brand-600 shadow-sm' 
                    : 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white';
                btnsHtml += `<button type="button" class="page-num-btn px-2.5 py-1 rounded-lg text-xs font-bold border ${activeClass} transition-all" data-page="${p}">${p}</button>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) btnsHtml += `<span class="px-1 text-slate-400 text-xs font-bold">...</span>`;
                btnsHtml += `<button type="button" class="page-num-btn px-2.5 py-1 rounded-lg text-xs font-bold border border-slate-200 dark:border-slate-800 hover:bg-brand-500 hover:text-white" data-page="${totalPages}">${totalPages}</button>`;
            }

            // Next
            btnsHtml += `<button type="button" class="page-btn-next px-2.5 py-1 rounded-lg text-xs font-bold border transition-all ${currentPage === totalPages ? 'opacity-40 pointer-events-none border-slate-200 dark:border-slate-800 text-slate-400' : 'hover:bg-brand-500 hover:text-white border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300'}"><i class="fas fa-chevron-right text-[10px]"></i></button>`;

            $('.pagination-controls').html(btnsHtml);
        }

        function filterAndPaginate(targetPage = 1, scrollToTop = false) {
            currentPage = targetPage;
            const term = ($('#questionSearch').val() || '').toLowerCase().trim();
            const selectedCat = ($('#categoryFilter').val() || '').toString();
            const selectedTopic = ($('#topicFilter').val() || '').toString();
            const selectedDiff = ($('#difficultyFilter').val() || '').toString();
            const selectedPoints = ($('#pointsFilter').val() || '').toString();

            const hasActiveFilters = term !== '' || selectedCat !== '' || selectedTopic !== '' || selectedDiff !== '' || selectedPoints !== '';
            if (hasActiveFilters) {
                $('#resetFiltersBtn').removeClass('hidden');
            } else {
                $('#resetFiltersBtn').addClass('hidden');
            }

            filteredIndices = [];
            for (let i = 0; i < questionData.length; i++) {
                const q = questionData[i];
                if (term && !q.searchText.includes(term)) continue;
                if (selectedCat && q.catId !== selectedCat) continue;
                if (selectedTopic && q.topicId !== selectedTopic) continue;
                if (selectedDiff && q.diff !== selectedDiff) continue;
                if (selectedPoints && q.points !== selectedPoints) continue;
                filteredIndices.push(i);
            }

            const totalFiltered = filteredIndices.length;
            const totalCount = questionData.length;

            if (totalFiltered === 0 && totalCount > 0) {
                $('#noQuestionsMatchNotice').removeClass('hidden');
                $allPanels.hide();
                renderPaginationControls(0, 0, 0, 0);
            } else {
                $('#noQuestionsMatchNotice').addClass('hidden');

                const effPageSize = pageSize <= 0 ? totalFiltered : pageSize;
                const totalPages = effPageSize > 0 ? Math.ceil(totalFiltered / effPageSize) : 1;
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIdx = (currentPage - 1) * effPageSize;
                const endIdx = Math.min(startIdx + effPageSize, totalFiltered);

                const visibleSet = new Set();
                for (let j = startIdx; j < endIdx; j++) {
                    visibleSet.add(filteredIndices[j]);
                }

                $allPanels.each(function(idx) {
                    if (visibleSet.has(idx)) {
                        this.style.display = '';
                    } else {
                        this.style.display = 'none';
                    }
                });

                renderPaginationControls(startIdx + 1, endIdx, totalFiltered, totalPages);
            }

            if (totalCount > 0) {
                $('#filterCountBadge').text(hasActiveFilters ? `Showing ${totalFiltered} of ${totalCount}` : `${totalCount} Questions`);
                if (hasActiveFilters && totalFiltered < totalCount) {
                    $('#deleteAllBtnText').text(`Delete Filtered (${totalFiltered})`);
                } else {
                    $('#deleteAllBtnText').text('Delete All');
                }
            }

            if (scrollToTop) {
                $('#qModalBody').animate({ scrollTop: 0 }, 150);
            }
        }

        // Pagination Navigation Click Handlers
        $(document).on('click', '.page-num-btn', function() {
            const p = parseInt($(this).data('page'));
            if (p && p !== currentPage) {
                filterAndPaginate(p, true);
            }
        });

        $(document).on('click', '.page-btn-prev', function() {
            if (currentPage > 1) {
                filterAndPaginate(currentPage - 1, true);
            }
        });

        $(document).on('click', '.page-btn-next', function() {
            const effPageSize = pageSize <= 0 ? filteredIndices.length : pageSize;
            const totalPages = Math.ceil(filteredIndices.length / effPageSize);
            if (currentPage < totalPages) {
                filterAndPaginate(currentPage + 1, true);
            }
        });

        $('#pageSizeSelect').on('change', function() {
            pageSize = parseInt($(this).val()) || 15;
            filterAndPaginate(1, true);
        });

        // Debounced Search Input (prevents freezes during fast typing)
        let searchDebounceTimer = null;
        $('#questionSearch').on('input', function() {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(function() {
                filterAndPaginate(1);
            }, 180);
        });

        $('#categoryFilter').on('change', function() {
            const catId = $(this).val();
            if (catId && !allFilterTopics.some(t => t.categoryId === catId.toString())) {
                $.get(`/Admin/GetTopicsByCategoryId?categoryId=${catId}`).then(topics => {
                    if (topics && Array.isArray(topics)) {
                        topics.forEach(t => {
                            const tId = (t.id !== undefined ? t.id : t.Id)?.toString();
                            const tName = t.topicName || t.TopicName || "Unnamed Topic";
                            if (tId && !allFilterTopics.some(x => x.id === tId)) {
                                allFilterTopics.push({ id: tId, name: tName, categoryId: catId.toString() });
                            }
                        });
                        updateTopicFilterDropdown();
                    }
                });
            }
            updateTopicFilterDropdown();
            filterAndPaginate(1);
        });

        $('#topicFilter, #difficultyFilter, #pointsFilter').on('change', function() {
            filterAndPaginate(1);
        });

        $('#resetFiltersBtn').on('click', function() {
            $('#categoryFilter').val('');
            $('#difficultyFilter').val('');
            $('#pointsFilter').val('');
            $('#questionSearch').val('');
            updateTopicFilterDropdown();
            $('#topicFilter').val('');
            filterAndPaginate(1);
        });

        // Question / Choice Actions
        $(document).on('click', '.save-question', function () {
            var $btn = $(this);
            var $form = $btn.closest('form');
            var $panel = $btn.closest('.question-panel');
            var qId = $panel.attr('data-question-id');
            var origHtml = $btn.html();
            
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Saving...');

            $.post('@Url.Action("UpdateQuestion", "Exams")', $form.serialize())
                .done(function () { 
                    var catVal = $form.find('select[name="categoryId"]').val() || '';
                    var topVal = $form.find('select[name="topicId"]').val() || '';
                    var diffVal = $form.find('input[name="difficulty"]:checked').val() || '1';
                    var ptsVal = $form.find('input[name="points"]').val() || '';
                    
                    $panel.attr('data-category-id', catVal);
                    $panel.attr('data-topic-id', topVal);
                    $panel.attr('data-difficulty', diffVal);
                    $panel.attr('data-points', ptsVal);

                    var qIdx = questionData.findIndex(q => q.id === qId);
                    if (qIdx !== -1) {
                        questionData[qIdx].catId = catVal;
                        questionData[qIdx].topicId = topVal;
                        questionData[qIdx].diff = diffVal;
                        questionData[qIdx].points = ptsVal;
                        var qText = $form.find('textarea[name="questionText"]').val() || '';
                        var cText = $panel.find('.choices input[name="choiceText"]').map(function(){ return $(this).val(); }).get().join(' ');
                        questionData[qIdx].searchText = (qId + ' ' + qText + ' ' + cText).toLowerCase();
                    }

                    $btn.removeClass('bg-brand-50 text-brand-600 border-brand-500/10 hover:bg-brand-600')
                        .addClass('bg-emerald-600 text-white border-emerald-600 shadow-md')
                        .html('<i class="fas fa-check mr-1.5"></i> Saved!');

                    showInModalToast('Question updated successfully', 'success');

                    setTimeout(function() {
                        $btn.prop('disabled', false)
                            .removeClass('bg-emerald-600 text-white border-emerald-600 shadow-md')
                            .addClass('bg-brand-50 text-brand-600 border-brand-500/10 hover:bg-brand-600')
                            .html(origHtml);
                    }, 1800);
                })
                .fail(function(xhr) { 
                    $btn.prop('disabled', false).html(origHtml);
                    var msg = xhr.responseJSON ? xhr.responseJSON.message : "Database update failed";
                    showInModalToast(msg, 'error');
                });
        });

        $(document).on('click', '.save-choice', function () {
            var $btn = $(this);
            var form = $btn.closest('form');
            var $panel = $btn.closest('.question-panel');
            var qId = $panel.attr('data-question-id');
            var isChecked = form.find('input[name="isCorrect"]').is(':checked');
            var data = form.serializeArray();
            data = data.filter(function(item) { return item.name !== 'isCorrect'; });
            data.push({ name: 'isCorrect', value: isChecked });

            var origHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin text-xs"></i>');

            $.post('@Url.Action("UpdateChoice", "Exams")', data)
                .done(function () { 
                    $btn.removeClass('text-brand-500 bg-brand-50')
                        .addClass('text-emerald-600 bg-emerald-50 dark:bg-emerald-950')
                        .html('<i class="fas fa-check text-xs"></i>');
                    
                    var qIdx = questionData.findIndex(q => q.id === qId);
                    if (qIdx !== -1) {
                        var qText = $panel.find('textarea[name="questionText"]').val() || '';
                        var cText = $panel.find('.choices input[name="choiceText"]').map(function(){ return $(this).val(); }).get().join(' ');
                        questionData[qIdx].searchText = (qId + ' ' + qText + ' ' + cText).toLowerCase();
                    }

                    showInModalToast('Choice saved', 'success');

                    setTimeout(function() {
                        $btn.prop('disabled', false)
                            .removeClass('text-emerald-600 bg-emerald-50 dark:bg-emerald-950')
                            .addClass('text-brand-500 bg-brand-50')
                            .html(origHtml);
                    }, 1500);
                })
                .fail(function(xhr) {
                    $btn.prop('disabled', false).html(origHtml);
                    var msg = xhr.responseJSON ? xhr.responseJSON.message : "Choice update failed";
                    showInModalToast(msg, 'error');
                });
        });

        $(document).on('click', '.delete-choice', function () {
            var $btn = $(this);
            var $choiceForm = $btn.closest('.update-choice-form');
            var $panel = $btn.closest('.question-panel');
            var qId = $panel.attr('data-question-id');
            var cId = $btn.data('choice-id');
            
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin text-xs"></i>');
            $.post('@Url.Action("DeleteChoice", "Exams")', { choiceId: cId, __RequestVerificationToken: antiForgery() })
                .done(function() { 
                    $choiceForm.fadeOut(200, function() { 
                        $(this).remove(); 
                        var qIdx = questionData.findIndex(q => q.id === qId);
                        if (qIdx !== -1) {
                            var qText = $panel.find('textarea[name="questionText"]').val() || '';
                            var cText = $panel.find('.choices input[name="choiceText"]').map(function(){ return $(this).val(); }).get().join(' ');
                            questionData[qIdx].searchText = (qId + ' ' + qText + ' ' + cText).toLowerCase();
                        }
                    });
                    showInModalToast('Choice removed', 'success');
                })
                .fail(function() {
                    $btn.prop('disabled', false).html('<i class="fas fa-trash text-xs"></i>');
                    showInModalToast('Failed to delete choice', 'error');
                });
        });

        $(document).on('click', '.delete-question', function () {
            var qId = $(this).data('question-id');
            var $panel = $(this).closest('.question-panel');
            Swal.fire({
                title: 'Delete Question?',
                text: "This question and all its choices will be permanently removed.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Confirm Deletion',
                confirmButtonColor: '#e11d48',
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteQuestion", "Exams")', { questionId: qId, __RequestVerificationToken: antiForgery() })
                        .done(function() {
                            $panel.fadeOut(250, function() { 
                                $(this).remove(); 
                                const qIdx = questionData.findIndex(q => q.id === qId.toString());
                                if (qIdx !== -1) questionData.splice(qIdx, 1);
                                filterAndPaginate(currentPage);
                            });
                            showInModalToast('Question deleted successfully', 'success');
                        })
                        .fail(function() {
                            showInModalToast('Failed to delete question', 'error');
                        });
                }
            });
        });

        $(document).on('click', '.add-choice', function () {
            var qId = $(this).data('question-id');
            var $panel = $(this).closest('.question-panel');
            var $choicesContainer = $(this).closest('.p-8').find('.choices');
            var choiceText = prompt("Enter new choice text:");
            if (choiceText && choiceText.trim() !== '') {
                $.post('@Url.Action("AddChoice", "Exams")', { 
                    questionId: qId, 
                    choiceText: choiceText.trim(), 
                    isCorrect: false, 
                    __RequestVerificationToken: antiForgery() 
                }).done(function(res) {
                    if (res && res.success) {
                        var cId = res.choiceId;
                        var newChoiceHtml = `
                            <form class="update-choice-form flex items-center gap-4 bg-slate-50 dark:bg-slate-950 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500/30 transition-all group/choice shadow-sm">
                                <input type="hidden" name="__RequestVerificationToken" value="${antiForgery()}" />
                                <input type="hidden" name="choiceId" value="${cId}" />
                                <input type="hidden" name="questionId" value="${qId}" />

                                <label class="relative flex items-center cursor-pointer">
                                    <input type="checkbox" name="isCorrect" value="true" class="peer hidden" />
                                    <div class="w-6 h-6 bg-white dark:bg-slate-900 border-2 border-slate-300 dark:border-slate-700 rounded-xl flex items-center justify-center peer-checked:bg-emerald-500 peer-checked:border-emerald-500 transition-all shadow-sm">
                                        <i class="fas fa-check text-[10px] text-white opacity-0 peer-checked:opacity-100 transition-opacity"></i>
                                    </div>
                                </label>

                                <input type="text" name="choiceText" value="${$('<div>').text(choiceText.trim()).html()}" class="block flex-1 bg-transparent border-0 text-base font-black text-slate-900 dark:text-white focus:ring-0 outline-none w-full" />

                                <div class="flex items-center gap-1 opacity-50 group-hover/choice:opacity-100 transition-opacity">
                                    <button type="button" class="p-2 text-brand-500 bg-brand-50 dark:bg-brand-500/10 hover:bg-brand-600 hover:text-white rounded-lg transition-all save-choice" title="Save Choice">
                                        <i class="fas fa-save text-xs"></i>
                                    </button>
                                    <button type="button" class="p-2 text-rose-500 bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-600 hover:text-white rounded-lg transition-all delete-choice" data-choice-id="${cId}" title="Delete Choice">
                                        <i class="fas fa-trash text-xs"></i>
                                    </button>
                                </div>
                            </form>
                        `;
                        $choicesContainer.append(newChoiceHtml);
                        var qIdx = questionData.findIndex(q => q.id === qId.toString());
                        if (qIdx !== -1) {
                            var qText = $panel.find('textarea[name="questionText"]').val() || '';
                            var cText = $panel.find('.choices input[name="choiceText"]').map(function(){ return $(this).val(); }).get().join(' ');
                            questionData[qIdx].searchText = (qId + ' ' + qText + ' ' + cText).toLowerCase();
                        }
                        showInModalToast('Choice added successfully', 'success');
                    } else {
                        showInModalToast(res.message || 'Failed to add choice', 'error');
                    }
                }).fail(function() {
                    showInModalToast('Network error adding choice', 'error');
                });
            }
        });

        $('#addQuestionBtnInModal').on('click', function () {
            let optionsHtml = '';
            @if (ViewBag.Categories != null) { foreach (var cat in (IEnumerable<Exam.DTOs.CategoryDto>)ViewBag.Categories) { <text>optionsHtml += `<option value="@cat.Id">@cat.CategoryName.ToUpper()</option>`;</text> } }

            Swal.fire({
                title: '<span class="text-slate-900 dark:text-white font-black uppercase tracking-tight">Add New Question</span>',
                html: `
                    <div class="text-left space-y-4 px-1">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Question Category</label>
                            <select id="q-type" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-brand-500 transition-all shadow-sm">${optionsHtml}</select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-500 uppercase tracking-widest mb-2">Topic / Lecture</label>
                            <select id="q-topic" class="w-full bg-slate-50 dark:bg-slate-950 border border-emerald-500/30 rounded-2xl px-5 py-4 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-brand-500 transition-all shadow-sm">
                                <option value="">ALL TOPICS (Default)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Question Text</label>
                            <input id="q-text" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold text-slate-900 dark:text-white outline-none focus:border-brand-500 transition-all shadow-sm" placeholder="Enter question description...">
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Points</label>
                                <input id="q-points" type="number" value="1" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-black text-brand-600 dark:text-brand-400 outline-none focus:border-brand-500 transition-all shadow-sm">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Difficulty</label>
                                <div class="flex h-[54px] bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl p-1 gap-1 shadow-sm" id="difficulty-group">
                                    <button type="button" data-val="1" class="diff-btn flex-1 rounded-xl text-[10px] font-black italic transition-all">Easy</button>
                                    <button type="button" data-val="2" class="diff-btn flex-1 rounded-xl text-[10px] font-black italic transition-all">Mid</button>
                                    <button type="button" data-val="3" class="diff-btn flex-1 rounded-xl text-[10px] font-black italic transition-all">Hard</button>
                                </div>
                                <input type="hidden" id="q-difficulty" value="1" />
                            </div>
                        </div>
                    </div>`,
                customClass: {
                    popup: 'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[32px] shadow-sm',
                    confirmButton: 'bg-brand-600 hover:bg-brand-700 text-white px-8 py-3 rounded-2xl font-black italic uppercase text-xs tracking-widest shadow-xl flex-1 md:flex-none text-center',
                    cancelButton: 'text-slate-500 hover:bg-slate-100 hover:dark:bg-slate-800 px-8 py-3 rounded-2xl font-black uppercase text-xs tracking-widest flex-1 md:flex-none text-center',
                    actions: 'flex flex-row flex-wrap gap-3 w-full justify-center mt-6'
                },
                buttonsStyling: false,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Add Question',
                didOpen: () => {
                    const btns = document.querySelectorAll('.diff-btn');
                    function setDiff(b) {
                        const v = b.dataset.val;
                        btns.forEach(x => x.classList.remove('bg-brand-500', 'text-white'));
                        b.classList.add('bg-brand-500', 'text-white');
                        document.getElementById('q-difficulty').value = v;
                    }
                    setDiff(btns[0]);
                    btns.forEach(b => b.onclick = () => setDiff(b));

                    const $qType = $('#q-type');
                    const $qTopic = $('#q-topic');
                    $qType.on('change', () => loadTopicsForSelector($qType, $qTopic, null));
                    loadTopicsForSelector($qType, $qTopic, null);
                },
                preConfirm: () => {
                    const tid = document.getElementById('q-type').value;
                    const txt = document.getElementById('q-text').value;
                    const topicId = document.getElementById('q-topic').value;
                    if (!tid || !txt) { Swal.showValidationMessage('Incomplete parameters detected.'); return false; }
                    return { tid, txt, pts: document.getElementById('q-points').value, diff: document.getElementById('q-difficulty').value, topicId: topicId };
                }
            }).then((r) => { 
                if (r.isConfirmed) {
                    $.post('@Url.Action("AddQuestion", "Exams")', { 
                        examId: examId, 
                        questionText: r.value.txt, 
                        points: r.value.pts, 
                        questionTypeId: r.value.tid, 
                        difficulty: r.value.diff, 
                        topicId: r.value.topicId, 
                        __RequestVerificationToken: antiForgery() 
                    }).done(function() { 
                        triggerRefresh(true); 
                    }); 
                } 
            });
        });

        // Delete Filtered or All Questions
        $('#deleteAllQuestionsBtn').on('click', function() {
            var visibleIds = [];
            filteredIndices.forEach(idx => {
                if (questionData[idx] && questionData[idx].id) {
                    visibleIds.push(questionData[idx].id);
                }
            });

            if (visibleIds.length === 0) {
                Swal.fire({
                    icon: 'info',
                    title: 'No Questions Found',
                    text: 'There are no questions matching your current filter to delete.',
                    background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                    color: document.documentElement.classList.contains('dark') ? '#fff' : '#000'
                });
                return;
            }

            var totalCount = questionData.length;
            var isFiltered = visibleIds.length < totalCount;
            var confirmTitle = isFiltered ? `Delete ${visibleIds.length} Filtered Question(s)?` : 'Are you absolutely sure?';
            var confirmText = isFiltered 
                ? `This will permanently delete ONLY the ${visibleIds.length} currently filtered questions from this exam across all pages!`
                : "This will wipe ALL questions and choices from this exam permanently!";
            var confirmBtnText = isFiltered
                ? `<i class="fas fa-trash-alt mr-2"></i> Yes, Delete (${visibleIds.length}) Questions`
                : '<i class="fas fa-trash-alt mr-2"></i> Yes, DELETE ALL';

            Swal.fire({
                title: confirmTitle,
                text: confirmText,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#334155',
                confirmButtonText: confirmBtnText,
                background: document.documentElement.classList.contains('dark') ? '#0f172a' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteAllQuestions", "Exams")', {
                        examId: examId,
                        questionIds: visibleIds.join(','),
                        __RequestVerificationToken: antiForgery()
                    }).done(function (res) {
                        if(res.success) {
                            Swal.fire({ 
                                icon: 'success', 
                                title: isFiltered ? 'Deleted' : 'Wiped', 
                                text: isFiltered ? `${visibleIds.length} filtered questions have been deleted.` : 'All questions have been deleted.', 
                                timer: 2000, 
                                showConfirmButton: false 
                            });
                            triggerRefresh();
                        } else {
                            Swal.fire('Error', res.message || 'Failed to delete questions.', 'error');
                        }
                    }).fail(function () { 
                        Swal.fire('Error', 'Network or Server error occurred.', 'error'); 
                    });
                }
            });
        });

        // Initial Filter & Pagination Run
        filterAndPaginate(1);
    })();
</script>