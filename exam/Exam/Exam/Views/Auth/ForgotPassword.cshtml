@model Exam.DTOs.ForgotPasswordDTO
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-[70vh] flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Recover Password</h1>
            <p class="mt-2 text-sm font-bold text-slate-500 uppercase tracking-widest">Enter your email to receive recovery link</p>
        </div>

        <div class="bg-white border border-slate-200 rounded-[32px] shadow-xl shadow-slate-200/50 overflow-hidden relative">
            <div class="absolute top-0 left-0 w-full h-1.5 bg-indigo-600"></div>
            <div class="p-8 sm:p-10">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="text-center py-4">
                        <div class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4 border border-emerald-100 shadow-sm animate-bounce">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <h3 class="text-lg font-black text-slate-800 mb-2">تم الإرسال بنجاح</h3>
                        <p class="text-xs font-semibold text-slate-600 leading-relaxed mb-4">
                            @TempData["SuccessMessage"]
                        </p>

                        <!-- Spam Folder Alert Tip -->
                        <div class="mb-6 p-3.5 bg-amber-50/90 border border-amber-200/90 rounded-2xl text-amber-900 text-xs font-medium flex items-start gap-2.5 text-right" dir="rtl">
                            <i class="fas fa-exclamation-triangle text-amber-600 text-sm mt-0.5 shrink-0"></i>
                            <div>
                                <span class="font-bold text-amber-950 block mb-0.5">تنبيه هام لصندوق البريد:</span>
                                <span>إذا لم تجد الرسالة في صندوق الوارد الرئيسي، يرجى فحص مجلد <b>الرسائل غير المرغوب فيها (Spam / Junk)</b> أو الترويجات، واضغط على <b>"ليس بريداً عشوائياً" (Report Not Spam)</b>.</span>
                            </div>
                        </div>

                        <a asp-action="Login" class="inline-flex items-center justify-center w-full bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3.5 rounded-xl transition-all text-xs font-black uppercase tracking-widest shadow-md shadow-indigo-500/20 active:scale-95">
                            <i class="fas fa-arrow-left mr-2"></i> العودة لتسجيل الدخول
                        </a>
                    </div>
                }
                else
                {
                    <form id="forgotPasswordForm" asp-action="ForgotPassword" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-rose-600 text-[11px] font-bold tracking-wide bg-rose-50 p-3 rounded-xl border border-rose-100 text-center"></div>
                        <div class="space-y-1.5">
                            <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-widest ml-1">Account Email</label>
                            <input asp-for="Email" id="inputForgotEmail" class="block w-full border-slate-200 bg-slate-50 text-slate-900 font-medium rounded-xl shadow-sm focus:border-indigo-500 focus:bg-white focus:ring-indigo-500 px-4 py-3.5 transition-colors" placeholder="email@example.com" required />
                            <span asp-validation-for="Email" class="text-rose-500 text-[10px] font-bold tracking-widest uppercase ml-1 block mt-1"></span>
                        </div>

                        <div class="pt-4">
                            <button type="submit" id="btnSubmitForgot" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-4 rounded-xl transition-all text-sm font-black uppercase tracking-widest shadow-lg shadow-indigo-500/30 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer">
                                <span id="btnSubmitText">Send Reset Link</span>
                                <i id="btnSubmitIcon" class="fas fa-paper-plane text-xs"></i>
                                <span id="btnSubmitSpinner" class="hidden items-center gap-2">
                                    <i class="fas fa-circle-notch fa-spin text-base"></i>
                                    <span>جاري الإرسال...</span>
                                </span>
                            </button>
                        </div>
                    </form>
                    <div class="mt-8 text-center">
                        <a asp-action="Login" class="text-xs font-bold text-slate-400 hover:text-indigo-600 uppercase tracking-widest transition-colors"><i class="fas fa-arrow-left mr-2"></i> Back to Login</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('#forgotPasswordForm').on('submit', function (e) {
                var form = $(this);
                if (form.valid()) {
                    var btn = document.getElementById('btnSubmitForgot');
                    var text = document.getElementById('btnSubmitText');
                    var icon = document.getElementById('btnSubmitIcon');
                    var spinner = document.getElementById('btnSubmitSpinner');

                    if (btn) {
                        btn.disabled = true;
                        btn.classList.add('opacity-80', 'cursor-not-allowed', 'pointer-events-none');
                    }
                    if (text) text.classList.add('hidden');
                    if (icon) icon.classList.add('hidden');
                    if (spinner) {
                        spinner.classList.remove('hidden');
                        spinner.classList.add('flex');
                    }
                }
            });
        });
    </script>
}
