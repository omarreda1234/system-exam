<!-- Notification Bell Component with Real-Time Branch Approvals -->
<div class="relative inline-block text-left" id="notificationBellWrapper">
    <!-- Bell Button -->
    <button id="notificationBellBtn" type="button" 
            class="relative p-2.5 rounded-xl text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all focus:outline-none select-none"
            title="الإشعارات والترشيحات المعلقة" aria-label="Notifications">
        <i id="bellIcon" class="fas fa-bell text-lg"></i>
        <!-- Glowing Red Counter Badge -->
        <span id="notifBadge" class="hidden absolute -top-1 -right-1 min-w-[20px] h-5 px-1.5 bg-gradient-to-r from-rose-500 to-red-600 text-white text-[10px] font-black rounded-full flex items-center justify-center shadow-lg shadow-rose-500/40 border-2 border-white dark:border-slate-900 transition-transform duration-300 transform scale-100">
            0
        </span>
    </button>

    <!-- Notification Dropdown Menu -->
    <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200/80 dark:border-slate-800 py-3 z-[9999] backdrop-blur-md">
        <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs font-black uppercase tracking-wider text-slate-800 dark:text-white">مركز التنبيهات</span>
            </div>
            <button type="button" onclick="markAllNotificationsAsRead()" class="text-[11px] font-bold text-brand-600 dark:text-brand-400 hover:underline">
                تحديد الكل كمقروء
            </button>
        </div>

        <!-- Pending Branch Nominations Alert Banner -->
        <div id="pendingNominationsBanner" class="hidden m-3 p-3.5 bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border border-amber-500/30 rounded-xl flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-md shadow-amber-500/30">
                    <i class="fas fa-user-clock"></i>
                </div>
                <div class="truncate">
                    <p class="text-xs font-black text-amber-900 dark:text-amber-200 truncate">مرشحين بانتظار اعتمادك</p>
                    <p id="pendingNominationsText" class="text-[10px] text-amber-700 dark:text-amber-400 font-medium">0 موظف بانتظار القرار</p>
                </div>
            </div>
            <button type="button" onclick="openBranchNominationsModal()" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 active:scale-95 text-white rounded-lg text-xs font-black shadow-md shadow-amber-600/20 transition-all whitespace-nowrap">
                مراجعة
            </button>
        </div>

        <!-- Notification List -->
        <div id="notifListContainer" class="max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/60 custom-scrollbar">
            <div class="p-6 text-center text-xs text-slate-400">
                <i class="fas fa-spinner fa-spin text-lg mb-2 text-brand-500 block"></i>
                جاري فحص الإشعارات...
            </div>
        </div>

        <!-- Admin Audit History Link -->
        <div id="adminHistoryLink" class="hidden px-4 py-2 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 text-center">
            <a href="/Admin/NominationHistory" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center justify-center gap-1.5">
                <i class="fas fa-history text-xs"></i> سجل قرارات وترشيحات الفروع (Audit History)
            </a>
        </div>
    </div>
</div>

<!-- Modal: Branch Candidates Approval / Review (Dual Tabs: Waves & Companies) -->
<div id="branchNominationsModal" class="hidden fixed inset-0 z-[10000] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fadeIn">
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden">
        <!-- Modal Header -->
        <div class="p-5 sm:p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/30">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xl shadow-sm">
                    <i class="fas fa-users-cog"></i>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">مراجعة مرشحي الفرع للدورات وجلسات الشركات</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">يمكنك الموافقة على المرشح أو الرفض مع ذكر السبب أو استبداله بزميل آخر من نفس الفرع.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="openBranchExemptionsModal()" class="px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 font-bold text-xs flex items-center gap-1.5 transition-all" title="تحديد الفروع المعفاة من موافقة المدير (اعتماد فوري)">
                    <i class="fas fa-sliders-h"></i> استثناءات الفروع
                </button>
                <button type="button" onclick="closeBranchNominationsModal()" class="w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                    <i class="fas fa-times text-base"></i>
                </button>
            </div>
        </div>

        <!-- Tabs: Waves vs Company Sessions -->
        <div class="flex border-b border-slate-100 dark:border-slate-800 px-6 pt-3 bg-white dark:bg-slate-900 gap-2">
            <button type="button" onclick="switchNominationTab('wave')" id="tabBtnWaveNom" class="pb-3 px-4 text-xs font-black uppercase tracking-wider text-brand-600 border-b-2 border-brand-600 flex items-center gap-2 transition-all">
                <i class="fas fa-layer-group"></i> دورات الويف (Waves) 
                <span id="waveCountBadge" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-400">0</span>
            </button>
            <button type="button" onclick="switchNominationTab('company')" id="tabBtnCompanyNom" class="pb-3 px-4 text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 border-b-2 border-transparent flex items-center gap-2 transition-all">
                <i class="fas fa-building"></i> جلسات الشركات (Company Sessions) 
                <span id="companyCountBadge" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400">0</span>
            </button>
        </div>

        <!-- Modal Body (Nominations List) -->
        <div class="p-5 sm:p-6 overflow-y-auto flex-1 custom-scrollbar" id="nominationsListWrapper">
            <div class="text-center py-10 text-slate-400">
                <i class="fas fa-spinner fa-spin text-2xl text-brand-500 mb-3 block"></i>
                جاري استدعاء قائمة المرشحين...
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-4 px-6 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/20 flex justify-between items-center text-xs text-slate-400">
            <span id="nominationsCountFooter">0 طلب ترشيح معلق</span>
            <button type="button" onclick="closeBranchNominationsModal()" class="px-5 py-2 rounded-xl bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold transition-all">
                إغلاق
            </button>
        </div>
    </div>
</div>

<!-- Modal: Replace Candidate (Works for both Wave Candidates & Company Trainees) -->
<div id="replaceCandidateModal" class="hidden fixed inset-0 z-[10001] flex items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm animate-fadeIn">
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-lg p-6">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg">
                <i class="fas fa-exchange-alt"></i>
            </div>
            <div>
                <h4 class="text-base font-black text-slate-900 dark:text-white">استبدال الموظف بزميل من الفرع</h4>
                <p class="text-xs text-slate-400" id="replaceModalSubtitle">اختر زميل بديل متاح من نفس الفرع</p>
            </div>
        </div>

        <input type="hidden" id="replaceUserWaveId" />
        <input type="hidden" id="replaceWaveId" />
        <input type="hidden" id="replaceBranchId" />
        <input type="hidden" id="replaceSessionId" />
        <input type="hidden" id="replaceCompanyId" />
        <input type="hidden" id="replaceBranchName" />
        <input type="hidden" id="replaceType" value="wave" />

        <div class="space-y-4">
            <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-100 dark:border-slate-800">
                <span class="text-[10px] text-slate-400 uppercase font-black">المرشح الحالي:</span>
                <p id="currentCandidateName" class="text-sm font-black text-slate-800 dark:text-white mt-0.5">--</p>
            </div>

            <div>
                <label class="block text-xs font-black text-slate-700 dark:text-slate-300 mb-1.5">اختر الزميل البديل من الفرع:</label>
                <select id="colleagueSelect" class="w-full px-4 py-3 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500/20">
                    <option value="">جاري البحث عن الزملاء المتاحين بالفرع...</option>
                </select>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-2.5">
            <button type="button" onclick="closeReplaceModal()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 transition-all">
                إلغاء
            </button>
            <button type="button" onclick="submitReplaceNomination()" class="px-5 py-2.5 rounded-xl text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-2">
                <i class="fas fa-check"></i> تأكيد الاستبدال
            </button>
        </div>
    </div>
</div>

<!-- Modal: Branch Approval Exemptions (Bypass Approval / ناس استثنائيين) -->
<div id="branchExemptionsModal" class="hidden fixed inset-0 z-[10002] flex items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm animate-fadeIn">
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-xl max-h-[85vh] flex flex-col overflow-hidden">
        <div class="p-5 sm:p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-amber-50/50 dark:bg-amber-950/20">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg">
                    <i class="fas fa-bolt"></i>
                </div>
                <div>
                    <h4 class="text-base font-black text-slate-900 dark:text-white">إعدادات الفروع المعفاة من موافقة المدير</h4>
                    <p class="text-xs text-slate-400">الفروع المفعلة يتم اعتماد ترشيحات موظفيها فوراً دون انتظار موافقة مدير الفرع</p>
                </div>
            </div>
            <button type="button" onclick="closeBranchExemptionsModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="p-5 overflow-y-auto flex-1 custom-scrollbar space-y-2" id="branchExemptionsList">
            <div class="text-center py-8 text-slate-400 text-xs">جاري تحميل الفروع...</div>
        </div>

        <div class="p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/20 flex justify-end">
            <button type="button" onclick="closeBranchExemptionsModal()" class="px-5 py-2 rounded-xl bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-xs transition-all">
                تم
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        let notifState = {
            unreadCount: 0,
            pendingNominationsCount: 0,
            pendingWaveCount: 0,
            pendingCompanyCount: 0,
            waveNominations: [],
            companyNominations: [],
            currentTab: 'wave',
            notifications: []
        };

        const bellBtn = document.getElementById('notificationBellBtn');
        const notifDropdown = document.getElementById('notificationDropdown');
        const notifBadge = document.getElementById('notifBadge');
        const bellIcon = document.getElementById('bellIcon');

        // Toggle dropdown
        if (bellBtn) {
            bellBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (notifDropdown.classList.contains('hidden')) {
                    notifDropdown.classList.remove('hidden');
                    loadHeaderNotifications();
                } else {
                    notifDropdown.classList.add('hidden');
                }
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            if (notifDropdown && !notifDropdown.contains(e.target) && e.target !== bellBtn && !bellBtn.contains(e.target)) {
                notifDropdown.classList.add('hidden');
            }
        });

        // Fetch Header Notifications & Badges
        window.loadHeaderNotifications = async function () {
            try {
                const res = await fetch('/Notification/GetHeaderNotifications');
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                notifState.unreadCount = data.unreadCount || 0;
                notifState.pendingNominationsCount = data.pendingNominationsCount || 0;
                notifState.pendingWaveCount = data.pendingWaveCount || 0;
                notifState.pendingCompanyCount = data.pendingCompanyCount || 0;
                notifState.notifications = data.notifications || [];

                // Update badge
                if (notifState.unreadCount > 0) {
                    notifBadge.textContent = notifState.unreadCount > 99 ? '99+' : notifState.unreadCount;
                    notifBadge.classList.remove('hidden');
                    notifBadge.classList.add('flex');
                    bellIcon.classList.add('animate-bounce');
                    setTimeout(() => bellIcon.classList.remove('animate-bounce'), 2500);
                } else {
                    notifBadge.classList.add('hidden');
                    notifBadge.classList.remove('flex');
                }

                // Update pending nominations banner (STRICT: ONLY FOR BRANCH APPROVERS)
                const banner = document.getElementById('pendingNominationsBanner');
                const text = document.getElementById('pendingNominationsText');
                if (data.isBranchApprover && notifState.pendingNominationsCount > 0) {
                    banner.classList.remove('hidden');
                    banner.classList.add('flex');
                    text.textContent = `لديك ${notifState.pendingNominationsCount} موظف من فرعك بانتظار الاعتماد (${notifState.pendingWaveCount} ويف + ${notifState.pendingCompanyCount} شركات)`;
                } else {
                    banner.classList.add('hidden');
                    banner.classList.remove('flex');
                }

                // Admin Audit History link
                const adminLink = document.getElementById('adminHistoryLink');
                if (adminLink) {
                    if (data.isAdmin) {
                        adminLink.classList.remove('hidden');
                    } else {
                        adminLink.classList.add('hidden');
                    }
                }

                // Render list
                const list = document.getElementById('notifListContainer');
                if (!notifState.notifications || notifState.notifications.length === 0) {
                    list.innerHTML = `
                        <div class="p-6 text-center text-xs text-slate-400">
                            <i class="far fa-bell-slash text-2xl mb-2 opacity-50 block"></i>
                            لا توجد إشعارات جديدة حالياً
                        </div>`;
                } else {
                    list.innerHTML = notifState.notifications.map(n => `
                        <div id="notif-item-${n.id}" class="p-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all flex items-start gap-3 cursor-pointer group relative ${n.isRead ? 'opacity-70' : 'bg-brand-50/20'}"
                             onclick="handleNotificationClick(${n.id}, '${n.linkUrl || ''}')">
                            <div class="w-8 h-8 rounded-xl ${n.type === 'WaveNomination' ? 'bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-400' : 'bg-brand-100 text-brand-600 dark:bg-brand-900/40 dark:text-brand-400'} flex items-center justify-center text-xs shrink-0 mt-0.5">
                                <i class="${n.type === 'WaveNomination' ? 'fas fa-user-clock' : 'fas fa-bell'}"></i>
                            </div>
                            <div class="flex-1 min-w-0 text-right">
                                <p class="text-xs font-black text-slate-800 dark:text-white leading-tight">${n.title}</p>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">${n.message}</p>
                                <span class="text-[9px] text-slate-400 mt-1 block">${n.createdAt}</span>
                            </div>
                            <div class="flex flex-col items-center gap-1.5 shrink-0 mt-0.5">
                                <button type="button" 
                                        onclick="deleteNotification(event, ${n.id})" 
                                        class="w-6 h-6 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center justify-center transition-all opacity-80 hover:opacity-100" 
                                        title="حذف الإشعار">
                                    <i class="fas fa-times text-xs"></i>
                                </button>
                                ${!n.isRead ? '<span class="w-2 h-2 rounded-full bg-brand-500"></span>' : ''}
                            </div>
                        </div>
                    `).join('');
                }
            } catch (err) {
                console.error('Failed to load notifications', err);
            }
        };

        window.deleteNotification = async function (e, id) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }

            const item = document.getElementById(`notif-item-${id}`);
            if (item) {
                item.style.transition = 'all 0.25s ease';
                item.style.opacity = '0';
                item.style.transform = 'translateX(20px)';
            }

            try {
                const res = await fetch(`/Notification/DeleteNotification?id=${id}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    if (item) item.remove();
                    notifState.notifications = notifState.notifications.filter(x => x.id !== id);
                    if (notifState.notifications.length === 0) {
                        const list = document.getElementById('notifListContainer');
                        if (list) {
                            list.innerHTML = `
                                <div class="p-6 text-center text-xs text-slate-400">
                                    <i class="far fa-bell-slash text-2xl mb-2 opacity-50 block"></i>
                                    لا توجد إشعارات جديدة حالياً
                                </div>`;
                        }
                    }
                    loadHeaderNotifications();
                } else {
                    if (item) {
                        item.style.opacity = '1';
                        item.style.transform = 'none';
                    }
                    alert(data.message || 'فشل حذف الإشعار');
                }
            } catch {
                if (item) {
                    item.style.opacity = '1';
                    item.style.transform = 'none';
                }
            }
        };

        window.handleNotificationClick = async function (id, url) {
            try {
                await fetch(`/Notification/MarkAsRead?id=${id}`, { method: 'POST' });
                if (url && url !== '#' && url !== '') {
                    window.location.href = url;
                } else {
                    loadHeaderNotifications();
                }
            } catch { }
        };

        window.markAllNotificationsAsRead = async function () {
            try {
                await fetch('/Notification/MarkAsRead', { method: 'POST' });
                loadHeaderNotifications();
            } catch { }
        };

        // Open Branch Nominations Modal & Render
        window.openBranchNominationsModal = async function () {
            const modal = document.getElementById('branchNominationsModal');
            const wrapper = document.getElementById('nominationsListWrapper');
            
            modal.classList.remove('hidden');
            wrapper.innerHTML = `
                <div class="text-center py-10 text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl text-brand-500 mb-3 block"></i>
                    جاري استدعاء المرشحين المعلقين...
                </div>`;

            try {
                const res = await fetch('/Notification/GetPendingBranchNominations');
                const data = await res.json();

                if (!data.success) {
                    wrapper.innerHTML = `<div class="text-center py-10 text-rose-500 font-bold">حدث خطأ: ${data.message}</div>`;
                    return;
                }

                notifState.waveNominations = data.waveNominations || [];
                notifState.companyNominations = data.companyNominations || [];

                document.getElementById('waveCountBadge').textContent = notifState.waveNominations.length;
                document.getElementById('companyCountBadge').textContent = notifState.companyNominations.length;

                // Auto switch tab if wave is empty but company has pending
                if (notifState.waveNominations.length === 0 && notifState.companyNominations.length > 0) {
                    notifState.currentTab = 'company';
                } else if (notifState.waveNominations.length > 0 && notifState.companyNominations.length === 0) {
                    notifState.currentTab = 'wave';
                }

                switchNominationTab(notifState.currentTab);
            } catch (err) {
                wrapper.innerHTML = `<div class="text-center py-10 text-rose-500 font-bold">حدث خطأ أثناء تحميل البيانات: ${err.message}</div>`;
            }
        };

        window.switchNominationTab = function (tab) {
            notifState.currentTab = tab;
            const btnWave = document.getElementById('tabBtnWaveNom');
            const btnCompany = document.getElementById('tabBtnCompanyNom');

            if (tab === 'wave') {
                btnWave.classList.add('text-brand-600', 'border-brand-600');
                btnWave.classList.remove('text-slate-400', 'border-transparent');
                btnCompany.classList.remove('text-indigo-600', 'border-indigo-600');
                btnCompany.classList.add('text-slate-400', 'border-transparent');
            } else {
                btnCompany.classList.add('text-indigo-600', 'border-indigo-600');
                btnCompany.classList.remove('text-slate-400', 'border-transparent');
                btnWave.classList.remove('text-brand-600', 'border-brand-600');
                btnWave.classList.add('text-slate-400', 'border-transparent');
            }

            renderCurrentNominationsTab();
        };

        function renderCurrentNominationsTab() {
            const wrapper = document.getElementById('nominationsListWrapper');
            const footerCount = document.getElementById('nominationsCountFooter');
            const isWave = notifState.currentTab === 'wave';
            const list = isWave ? notifState.waveNominations : notifState.companyNominations;

            footerCount.textContent = `${list.length} طلب ترشيح معلق (${isWave ? 'دورات الويف' : 'جلسات الشركات'})`;

            if (list.length === 0) {
                wrapper.innerHTML = `
                    <div class="text-center py-16">
                        <div class="w-16 h-16 rounded-3xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-500 flex items-center justify-center mx-auto mb-4 text-2xl">
                            <i class="fas fa-check-double"></i>
                        </div>
                        <h4 class="text-base font-black text-slate-800 dark:text-white">لا توجد ترشيحات معلقة في هذا القسم</h4>
                        <p class="text-xs text-slate-400 mt-1">تمت مراجعة واعتماد جميع ترشيحات موظفي الفرع بنجاح.</p>
                    </div>`;
                return;
            }

            if (isWave) {
                wrapper.innerHTML = `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        ${list.map(n => `
                            <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 shadow-sm hover:shadow-md transition-all flex flex-col justify-between" id="nomCard_${n.userWaveId}">
                                <div>
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-500 text-white font-black flex items-center justify-center text-sm shadow-md shadow-brand-500/20">
                                                ${(n.studentName || 'U')[0]}
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-black text-slate-900 dark:text-white leading-tight">${n.studentName}</h4>
                                                <p class="text-[11px] text-slate-400 font-mono">الكود: ${n.userCode} | ${n.branchName}</p>
                                            </div>
                                        </div>
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                            معلق (Pending)
                                        </span>
                                    </div>

                                    <div class="p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl text-xs space-y-1 mb-4 border border-slate-100 dark:border-slate-800">
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">الدورة التدريبية:</span>
                                            <span class="font-bold text-slate-800 dark:text-white">${n.waveName}</span>
                                        </div>
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">تاريخ البدء:</span>
                                            <span class="font-mono text-brand-600 dark:text-brand-400">${n.startDate}</span>
                                        </div>
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">الهاتف / الإيميل:</span>
                                            <span class="text-slate-500 dark:text-slate-400">${n.phoneNumber}</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons: Accept / Reject / Replace -->
                                <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/60">
                                    <button type="button" onclick="actionNomination(${n.userWaveId}, 'accept', 'wave', '${n.studentName}')"
                                            class="py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-1.5" title="موافقة واعتماد">
                                        <i class="fas fa-check"></i> موافقة
                                    </button>

                                    <button type="button" onclick="actionNominationPrompt(${n.userWaveId}, 'reject', 'wave', '${n.studentName}')"
                                            class="py-2 px-3 rounded-xl bg-rose-500 hover:bg-rose-600 active:scale-95 text-white font-black text-xs shadow-md shadow-rose-500/20 transition-all flex items-center justify-center gap-1.5" title="اعتذار أو رفض">
                                        <i class="fas fa-times"></i> رفض
                                    </button>

                                    <button type="button" onclick="openReplaceModal(${n.userWaveId}, ${n.waveId}, ${n.branchId || 0}, '${n.studentName}')"
                                            class="py-2 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-black text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5" title="استبدال بزميل آخر">
                                        <i class="fas fa-exchange-alt"></i> استبدال
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>`;
            } else {
                // Company Session Nominations
                wrapper.innerHTML = `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        ${list.map(c => `
                            <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 shadow-sm hover:shadow-md transition-all flex flex-col justify-between" id="nomCompanyCard_${c.companySessionTraineeId}">
                                <div>
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white font-black flex items-center justify-center text-sm shadow-md shadow-indigo-500/20">
                                                ${(c.traineeName || 'T')[0]}
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-black text-slate-900 dark:text-white leading-tight">${c.traineeName}</h4>
                                                <p class="text-[11px] text-slate-400 font-mono">الكود: ${c.userCode} | الفرع: ${c.branchName} | ${c.jobTitle}</p>
                                            </div>
                                        </div>
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                            معلق (Pending)
                                        </span>
                                    </div>

                                    <div class="p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl text-xs space-y-1 mb-4 border border-slate-100 dark:border-slate-800">
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">الشركة:</span>
                                            <span class="font-bold text-slate-800 dark:text-white">${c.companyName}</span>
                                        </div>
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">المحاضرة / الجلسة:</span>
                                            <span class="font-bold text-indigo-600 dark:text-indigo-400">${c.sessionName}</span>
                                        </div>
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">التاريخ والوقت:</span>
                                            <span class="font-mono text-slate-700 dark:text-slate-200">${c.sessionDate} (${c.sessionTime})</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons: Accept / Reject / Replace -->
                                <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/60">
                                    <button type="button" onclick="actionNomination(${c.companySessionTraineeId}, 'accept', 'company', '${c.traineeName}')"
                                            class="py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-1.5" title="موافقة واعتماد">
                                        <i class="fas fa-check"></i> موافقة
                                    </button>

                                    <button type="button" onclick="actionNominationPrompt(${c.companySessionTraineeId}, 'reject', 'company', '${c.traineeName}')"
                                            class="py-2 px-3 rounded-xl bg-rose-500 hover:bg-rose-600 active:scale-95 text-white font-black text-xs shadow-md shadow-rose-500/20 transition-all flex items-center justify-center gap-1.5" title="اعتذار أو رفض">
                                        <i class="fas fa-times"></i> رفض
                                    </button>

                                    <button type="button" onclick="openReplaceCompanyModal(${c.companySessionTraineeId}, ${c.sessionId}, ${c.companyId || 0}, '${c.branchName}', '${c.traineeName}')"
                                            class="py-2 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-black text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5" title="استبدال بزميل آخر">
                                        <i class="fas fa-exchange-alt"></i> استبدال
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>`;
            }
        }

        window.closeBranchNominationsModal = function () {
            document.getElementById('branchNominationsModal').classList.add('hidden');
            loadHeaderNotifications();
        };

        // Unified Action: Accept / Reject
        window.actionNomination = async function (id, action, type, name) {
            if (typeof Swal !== 'undefined') {
                const confirm = await Swal.fire({
                    title: 'تأكيد الاعتماد',
                    text: `هل توافق على ترشيح (${name}) لحضور هذا التدريب؟`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، موافقة',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#10b981'
                });
                if (!confirm.isConfirmed) return;
            }

            try {
                const res = await fetch('/Notification/ActionNomination', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userWaveId: id, action: action, type: type })
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'success', title: 'تم الاعتماد بنجاح', text: data.message, timer: 2000 });
                    }
                    openBranchNominationsModal();
                } else {
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'خطأ', text: data.message });
                }
            } catch (err) {
                alert('فشل الاتصال: ' + err.message);
            }
        };

        window.actionNominationPrompt = async function (id, action, type, name) {
            let reason = '';
            if (typeof Swal !== 'undefined') {
                const { value: text, isConfirmed } = await Swal.fire({
                    title: `اعتذار عن ترشيح: ${name}`,
                    text: 'يرجى كتابة سبب الرفض أو الاعتذار لتوثيقه وإرساله للإدارة:',
                    input: 'textarea',
                    inputPlaceholder: 'مثال: الموظف في إجازة سنوية / لديه مهام طارئة بالفرع...',
                    inputValidator: (val) => {
                        if (!val || !val.trim()) {
                            return 'سبب الرفض إلزامي!';
                        }
                    },
                    showCancelButton: true,
                    confirmButtonText: 'تأكيد الرفض',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#ef4444'
                });
                if (!isConfirmed || !text) return;
                reason = text.trim();
            } else {
                reason = prompt(`يرجى كتابة سبب رفض ترشيح (${name}):`);
                if (!reason) return;
            }

            try {
                const res = await fetch('/Notification/ActionNomination', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userWaveId: id, action: action, reason: reason, type: type })
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'success', title: 'تم تسجيل الاعتذار', text: data.message, timer: 2000 });
                    }
                    openBranchNominationsModal();
                } else {
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'خطأ', text: data.message });
                }
            } catch (err) {
                alert('فشل الاتصال: ' + err.message);
            }
        };

        // Open Replace for Waves
        window.openReplaceModal = async function (userWaveId, waveId, branchId, studentName) {
            document.getElementById('replaceType').value = 'wave';
            document.getElementById('replaceUserWaveId').value = userWaveId;
            document.getElementById('replaceWaveId').value = waveId;
            document.getElementById('replaceBranchId').value = branchId;
            document.getElementById('currentCandidateName').textContent = studentName;
            document.getElementById('replaceModalSubtitle').textContent = 'اختر زميل بديل متاح من نفس الفرع لدورة الويف';

            const select = document.getElementById('colleagueSelect');
            select.innerHTML = '<option value="">جاري البحث عن الزملاء بالفرع...</option>';
            document.getElementById('replaceCandidateModal').classList.remove('hidden');

            try {
                const res = await fetch(`/Notification/GetAvailableBranchColleagues?branchId=${branchId}&waveId=${waveId}`);
                const data = await res.json();

                if (data.success && data.colleagues && data.colleagues.length > 0) {
                    select.innerHTML = '<option value="">-- اختر الزميل البديل --</option>' +
                        data.colleagues.map(c => `
                            <option value="${c.id}">${c.fullName} (${c.userCode}) - ${c.roleName}</option>
                        `).join('');
                } else {
                    select.innerHTML = '<option value="">لا يوجد زملاء آخرين متاحين بالفرع</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">فشل تحميل قائمة الزملاء</option>';
            }
        };

        // Open Replace for Company Sessions
        window.openReplaceCompanyModal = async function (cstId, sessionId, companyId, branchName, traineeName) {
            document.getElementById('replaceType').value = 'company';
            document.getElementById('replaceUserWaveId').value = cstId;
            document.getElementById('replaceSessionId').value = sessionId;
            document.getElementById('replaceCompanyId').value = companyId;
            document.getElementById('replaceBranchName').value = branchName;
            document.getElementById('currentCandidateName').textContent = traineeName;
            document.getElementById('replaceModalSubtitle').textContent = `اختر متدرب بديل من فرع (${branchName}) للسيشن`;

            const select = document.getElementById('colleagueSelect');
            select.innerHTML = '<option value="">جاري البحث عن الزملاء المتاحين بالفرع...</option>';
            document.getElementById('replaceCandidateModal').classList.remove('hidden');

            try {
                const res = await fetch(`/Notification/GetAvailableCompanyColleagues?sessionId=${sessionId}&companyId=${companyId}&branchName=${encodeURIComponent(branchName)}`);
                const data = await res.json();

                if (data.success && data.colleagues && data.colleagues.length > 0) {
                    select.innerHTML = '<option value="">-- اختر الزميل البديل من الفرع --</option>' +
                        data.colleagues.map(c => `
                            <option value="${c.value || c.id}">${c.fullName} (${c.userCode}) - ${c.jobTitle}</option>
                        `).join('');
                } else {
                    select.innerHTML = '<option value="">لا يوجد زملاء متاحين بالفرع للترشيح</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">فشل تحميل قائمة المتدربين</option>';
            }
        };

        window.closeReplaceModal = function () {
            document.getElementById('replaceCandidateModal').classList.add('hidden');
        };

        window.submitReplaceNomination = async function () {
            const type = document.getElementById('replaceType').value;
            const userWaveId = parseInt(document.getElementById('replaceUserWaveId').value);
            const selectedVal = document.getElementById('colleagueSelect').value;

            if (!selectedVal) {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار زميل بديل أولاً.' });
                else alert('يرجى اختيار زميل بديل أولاً.');
                return;
            }

            const payload = {
                userWaveId: userWaveId,
                action: 'replace',
                type: type
            };

            if (type === 'company') {
                if (/^[0-9]+$/.test(selectedVal)) {
                    payload.replacementTraineeId = parseInt(selectedVal);
                } else {
                    payload.replacementUserId = selectedVal;
                }
            } else {
                payload.replacementUserId = selectedVal;
            }

            try {
                const res = await fetch('/Notification/ActionNomination', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    closeReplaceModal();
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'success', title: 'تم الاستبدال بنجاح', text: data.message, timer: 2000 });
                    }
                    openBranchNominationsModal();
                } else {
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'خطأ', text: data.message });
                }
            } catch (err) {
                alert('فشل الاتصال: ' + err.message);
            }
        };

        // Branch Exemptions Modal Logic
        window.openBranchExemptionsModal = async function () {
            const modal = document.getElementById('branchExemptionsModal');
            const list = document.getElementById('branchExemptionsList');
            modal.classList.remove('hidden');
            list.innerHTML = '<div class="text-center py-8 text-slate-400 text-xs"><i class="fas fa-spinner fa-spin text-lg mb-2 block"></i>جاري تحميل إعدادات الفروع...</div>';

            try {
                const res = await fetch('/Notification/GetBranchesApprovalSettings');
                const data = await res.json();
                if (data.success && data.branches) {
                    list.innerHTML = data.branches.map(b => `
                        <div class="flex items-center justify-between p-3.5 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800">
                            <div>
                                <h5 class="text-xs font-black text-slate-800 dark:text-white">${b.branchName}</h5>
                                <span class="text-[10px] text-slate-400 font-mono">${b.bypassApproval ? 'معفى (اعتماد مباشر)' : 'يتطلب موافقة المدير'}</span>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only peer" ${b.bypassApproval ? 'checked' : ''} onchange="toggleBranchBypass(${b.id}, this)">
                                <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                            </label>
                        </div>
                    `).join('');
                } else {
                    list.innerHTML = '<div class="text-center py-6 text-rose-500 text-xs">تعذر تحميل بيانات الفروع</div>';
                }
            } catch (e) {
                list.innerHTML = `<div class="text-center py-6 text-rose-500 text-xs">${e.message}</div>`;
            }
        };

        window.toggleBranchBypass = async function (branchId, checkbox) {
            try {
                const res = await fetch(`/Notification/ToggleBranchBypassApproval?branchId=${branchId}&bypass=${checkbox.checked}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000, icon: 'success', title: data.message });
                    }
                } else {
                    checkbox.checked = !checkbox.checked;
                    alert('خطأ: ' + data.message);
                }
            } catch (e) {
                checkbox.checked = !checkbox.checked;
                alert('فشل الاتصال: ' + e.message);
            }
        };

        window.closeBranchExemptionsModal = function () {
            document.getElementById('branchExemptionsModal').classList.add('hidden');
        };

        // Initial Load on Page Ready
        document.addEventListener('DOMContentLoaded', function () {
            loadHeaderNotifications();

            // Setup SignalR connection if available
            if (typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", function (message) {
                    loadHeaderNotifications();
                });

                connection.start().catch(err => console.log('SignalR Notification Hub Connection Error: ', err));
            }

            // Polling interval (every 30 seconds as fallback)
            setInterval(loadHeaderNotifications, 30000);
        });
    })();
</script>
