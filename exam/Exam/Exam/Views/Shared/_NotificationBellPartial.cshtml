        window.closeBranchNominationsModal = function () {
            document.getElementById('branchNominationsModal').classList.add('hidden');
            loadHeaderNotifications();
        };

        window.refreshBranchNominationsModal = async function () {
            const icon = document.getElementById('iconRefreshBranchNominations');
            if (icon) icon.classList.add('fa-spin');
            await openBranchNominationsModal();
            if (icon) icon.classList.remove('fa-spin');
            showAppToast('info', 'Updated 🔄', 'Pending candidates list refreshed successfully.');
        };

        window.toggleRejectBox = function (type, id, show) {
            const box = document.getElementById(`rejectBox_${type}_${id}`);
            if (box) {
                if (show) {
                    box.classList.remove('hidden');
                    const input = document.getElementById(`rejectInput_${type}_${id}`);
                    if (input) input.focus();
                } else {
                    box.classList.add('hidden');
                }
            }
        };

        window.confirmInlineReject = async function (id, type, name) {
            const input = document.getElementById(`rejectInput_${type}_${id}`);
            const reason = input ? input.value.trim() : '';
            if (!reason) {
                showAppToast('warning', 'Reason Required', 'Please enter a rejection reason before confirming.');
                if (input) input.focus();
                return;
            }

            try {
                const res = await fetch('/Notification/ActionNomination', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userWaveId: id, action: 'reject', reason: reason, type: type })
                });
                const data = await res.json();
                if (data.success) {
                    showAppToast('success', 'Nomination Rejected ❌', data.message || `Nomination for ${name} has been rejected.`);
                    removeNominationCardFromDOM(type, id);
                } else {
                    showAppToast('error', 'Rejection Failed', data.message || 'Could not reject nomination.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        // Unified Action: Accept
        window.actionNomination = async function (id, action, type, name) {
            try {
                const res = await fetch('/Notification/ActionNomination', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userWaveId: id, action: action, type: type })
                });
                const data = await res.json();
                if (data.success) {
                    showAppToast('success', 'Approved Successfully ✅', data.message || `Nomination for ${name} approved successfully.`);
                    removeNominationCardFromDOM(type, id);
                } else {
                    showAppToast('error', 'Approval Failed', data.message || 'Could not approve nomination.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        function removeNominationCardFromDOM(type, id) {
            const cardId = type === 'company' ? `nomCompanyCard_${id}` : `nomCard_${id}`;
            const card = document.getElementById(cardId);
            if (card) {
                card.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                card.style.opacity = '0';
                card.style.transform = 'translateY(-12px) scale(0.97)';
                setTimeout(() => {
                    if (card) card.remove();
                    if (type === 'wave') {
                        notifState.waveNominations = notifState.waveNominations.filter(x => x.userWaveId !== id);
                    } else {
                        notifState.companyNominations = notifState.companyNominations.filter(x => x.companySessionTraineeId !== id);
                    }
                    updateTabAndBadgeCounts();
                    renderCurrentNominationsTab();
                }, 300);
            } else {
                const modal = document.getElementById('branchNominationsModal');
                if (modal && !modal.classList.contains('hidden')) {
                    openBranchNominationsModal();
                }
            }
            loadHeaderNotifications();
        }

        let currentAvailableColleagues = [];
        let selectedColleagueKeys = new Set();
        let currentReplaceContext = {
            type: 'wave',
            userWaveId: 0,
            waveId: 0,
            branchId: 0,
            sessionId: 0,
            companyId: 0,
            branchName: '',
            allBranches: false
        };

        function normalizeArabic(text) {
            if (!text) return '';
            return String(text)
                .toLowerCase()
                .replace(/[\u064B-\u065F\u0670]/g, '') // remove diacritics
                .replace(/[إأآا]/g, 'ا')
                .replace(/ة/g, 'ه')
                .replace(/ى/g, 'ي')
                .replace(/_/g, ' ')
                .trim();
        }

        window.filterColleaguesList = function (text) {
            renderColleaguesChecklist(text);
        };

        window.onToggleAllBranches = function (isChecked) {
            currentReplaceContext.allBranches = isChecked;
            loadAvailableColleaguesForCurrentReplace();
        };

        window.selectAllColleaguesToggle = function () {
            const allKeys = currentAvailableColleagues.map(c => String(c.value || c.Value || c.id || c.Id));
            const allSelected = allKeys.length > 0 && allKeys.every(k => selectedColleagueKeys.has(k));
            if (allSelected) {
                selectedColleagueKeys.clear();
            } else {
                allKeys.forEach(k => selectedColleagueKeys.add(k));
            }
            renderColleaguesChecklist(document.getElementById('colleagueSearchInput')?.value || '');
        };

        window.toggleColleagueSelection = function (val) {
            val = String(val);
            if (selectedColleagueKeys.has(val)) {
                selectedColleagueKeys.delete(val);
            } else {
                selectedColleagueKeys.add(val);
            }
            renderColleaguesChecklist(document.getElementById('colleagueSearchInput')?.value || '');
        };

        function updateSelectedCountBadge() {
            const badge = document.getElementById('selectedColleaguesBadge');
            if (badge) {
                badge.textContent = `${selectedColleagueKeys.size} محدد`;
            }
        }

        function renderColleaguesChecklist(filterText = '') {
            const container = document.getElementById('colleaguesListContainer');
            if (!container) return;

            if (!currentAvailableColleagues || currentAvailableColleagues.length === 0) {
                const branchTitle = currentReplaceContext.branchName ? `بفرع (${currentReplaceContext.branchName})` : 'بالفرع';
                container.innerHTML = `<div class="text-center py-6 text-slate-400 text-xs font-medium">لا يوجد زملاء آخرين متاحين ${branchTitle}</div>`;
                updateSelectedCountBadge();
                return;
            }

            const rawTerm = (filterText || '').trim();
            const normTerm = normalizeArabic(rawTerm);

            const filtered = currentAvailableColleagues.filter(c => {
                if (!normTerm) return true;
                const rawName = String(c.fullName || c.FullName || '');
                const rawCode = String(c.userCode || c.UserCode || '');
                const rawRole = String(c.jobTitle || c.JobTitle || c.roleName || c.RoleName || '');
                const rawBranch = String(c.branchName || c.BranchName || '');

                const normName = normalizeArabic(rawName);
                const normRole = normalizeArabic(rawRole);
                const normBranch = normalizeArabic(rawBranch);
                const code = rawCode.toLowerCase();

                return normName.includes(normTerm)
                    || rawName.toLowerCase().includes(rawTerm.toLowerCase())
                    || code.includes(rawTerm.toLowerCase())
                    || normRole.includes(normTerm)
                    || normBranch.includes(normTerm);
            });

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-6 text-slate-400 text-xs">لا توجد نتائج مطابقة لبحثك "${rawTerm}"</div>`;
                updateSelectedCountBadge();
                return;
            }

            container.innerHTML = filtered.map(c => {
                const val = String(c.value || c.Value || c.id || c.Id);
                const name = c.fullName || c.FullName || 'زميل';
                const code = c.userCode || c.UserCode || '--';
                const role = c.jobTitle || c.JobTitle || c.roleName || c.RoleName || 'صيدلي';
                const branch = c.branchName || c.BranchName || '';
                const isActive = c.isActive !== false && c.IsActive !== false;
                const isChecked = selectedColleagueKeys.has(val);

                return `
                    <div onclick="toggleColleagueSelection('${val}')" 
                         class="flex items-center justify-between p-2.5 rounded-xl border transition-all cursor-pointer select-none ${isChecked ? 'bg-indigo-50/80 dark:bg-indigo-950/40 border-indigo-400 dark:border-indigo-600 shadow-sm' : 'bg-white dark:bg-slate-900 border-slate-200/80 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60'}">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <input type="checkbox" value="${val}" ${isChecked ? 'checked' : ''} onclick="event.stopPropagation(); toggleColleagueSelection('${val}')"
                                   class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 dark:border-slate-600 cursor-pointer" />
                            <div class="truncate">
                                <div class="flex items-center gap-2 truncate">
                                    <h6 class="text-xs font-black text-slate-900 dark:text-white truncate">${name}</h6>
                                    ${!isActive ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400 border border-rose-200/60">غير مفعّل (سيتم تفعيله)</span>' : ''}
                                </div>
                                <p class="text-[10px] text-slate-400 font-mono mt-0.5">
                                    كود: ${code} | ${role} ${branch ? `| فرع: ${branch}` : ''}
                                </p>
                            </div>
                        </div>
                        ${isChecked ? '<span class="text-[11px] font-black text-indigo-600 dark:text-indigo-400 shrink-0"><i class="fas fa-check-circle"></i></span>' : ''}
                    </div>
                `;
            }).join('');

            updateSelectedCountBadge();
        }

        async function loadAvailableColleaguesForCurrentReplace() {
            const container = document.getElementById('colleaguesListContainer');
            container.innerHTML = '<div class="text-center py-6 text-slate-400 text-xs font-medium"><i class="fas fa-spinner fa-spin mr-1"></i> جاري البحث عن زملاء الفرع المتاحين...</div>';

            try {
                let url = '';
                const params = new URLSearchParams();

                if (currentReplaceContext.type === 'company') {
                    if (currentReplaceContext.sessionId) params.append('sessionId', currentReplaceContext.sessionId);
                    if (currentReplaceContext.companyId) params.append('companyId', currentReplaceContext.companyId);
                    if (currentReplaceContext.branchId > 0) params.append('branchId', currentReplaceContext.branchId);
                    if (currentReplaceContext.branchName) params.append('branchName', currentReplaceContext.branchName);
                    if (currentReplaceContext.excludeUserId) params.append('excludeUserId', currentReplaceContext.excludeUserId);
                    if (currentReplaceContext.excludeUserCode) params.append('excludeUserCode', currentReplaceContext.excludeUserCode);
                    url = `/Notification/GetAvailableCompanyColleagues?${params.toString()}`;
                } else {
                    if (currentReplaceContext.waveId) params.append('waveId', currentReplaceContext.waveId);
                    if (currentReplaceContext.branchId > 0) params.append('branchId', currentReplaceContext.branchId);
                    if (currentReplaceContext.branchName) params.append('branchName', currentReplaceContext.branchName);
                    if (currentReplaceContext.excludeUserId) params.append('excludeUserId', currentReplaceContext.excludeUserId);
                    if (currentReplaceContext.excludeUserCode) params.append('excludeUserCode', currentReplaceContext.excludeUserCode);
                    url = `/Notification/GetAvailableBranchColleagues?${params.toString()}`;
                }

                const res = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                if (!res.ok) {
                    throw new Error(`تعذر الاتصال بالخادم (${res.status})`);
                }

                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error('الخادم لم يُرجع بيانات JSON صالحة.');
                }

                const data = await res.json();
                const list = Array.isArray(data.colleagues) ? data.colleagues : (data.colleagues?.$values || []);

                if (data.success && list.length > 0) {
                    currentAvailableColleagues = list;
                    const searchVal = document.getElementById('colleagueSearchInput')?.value || '';
                    renderColleaguesChecklist(searchVal);
                } else {
                    currentAvailableColleagues = [];
                    const branchTitle = currentReplaceContext.branchName ? `بفرع (${currentReplaceContext.branchName})` : 'بالفرع';
                    container.innerHTML = `<div class="text-center py-6 text-slate-400 text-xs font-medium">لا يوجد زملاء آخرين متاحين ${branchTitle}</div>`;
                    updateSelectedCountBadge();
                }
            } catch (err) {
                container.innerHTML = `<div class="text-center py-6 text-rose-500 text-xs font-bold">فشل تحميل قائمة الزملاء: ${err.message}</div>`;
            }
        }

        // Open Replace for Waves
        window.openReplaceModal = async function (userWaveId, waveId, branchId, studentName, branchName = '', userCode = '', userId = '') {
            currentReplaceContext = {
                type: 'wave',
                userWaveId: userWaveId,
                waveId: waveId,
                branchId: branchId,
                sessionId: 0,
                companyId: 0,
                branchName: branchName,
                allBranches: false,
                excludeUserCode: userCode,
                excludeUserId: userId
            };

            const chkAll = document.getElementById('chkReplaceAllBranches');
            if (chkAll) chkAll.checked = false;

            document.getElementById('replaceType').value = 'wave';
            document.getElementById('replaceUserWaveId').value = userWaveId;
            document.getElementById('replaceWaveId').value = waveId;
            document.getElementById('replaceBranchId').value = branchId;
            document.getElementById('replaceBranchName').value = branchName || '';
            document.getElementById('currentCandidateName').textContent = studentName;
            document.getElementById('replaceModalSubtitle').textContent = branchName 
                ? `اختر زميل بديل (أو أكثر) متاح من فرع (${branchName}) لدورة الويف`
                : 'اختر زميل بديل (أو أكثر) متاح من نفس الفرع لدورة الويف';

            currentAvailableColleagues = [];
            selectedColleagueKeys.clear();
            if (document.getElementById('colleagueSearchInput')) document.getElementById('colleagueSearchInput').value = '';

            const replaceModal = ensureModalInBody('replaceCandidateModal');
            if (replaceModal) replaceModal.classList.remove('hidden');
            await loadAvailableColleaguesForCurrentReplace();
        };

        // Open Replace for Company Sessions
        window.openReplaceCompanyModal = async function (cstId, sessionId, companyId, branchName, traineeName, branchId = 0, userCode = '', userId = '') {
            currentReplaceContext = {
                type: 'company',
                userWaveId: cstId,
                waveId: 0,
                branchId: branchId,
                sessionId: sessionId,
                companyId: companyId,
                branchName: branchName,
                allBranches: false,
                excludeUserCode: userCode,
                excludeUserId: userId
            };

            const chkAll = document.getElementById('chkReplaceAllBranches');
            if (chkAll) chkAll.checked = false;

            document.getElementById('replaceType').value = 'company';
            document.getElementById('replaceUserWaveId').value = cstId;
            document.getElementById('replaceSessionId').value = sessionId;
            document.getElementById('replaceCompanyId').value = companyId;
            document.getElementById('replaceBranchName').value = branchName;
            document.getElementById('replaceBranchId').value = branchId;
            document.getElementById('currentCandidateName').textContent = traineeName;
            document.getElementById('replaceModalSubtitle').textContent = branchName
                ? `اختر متدرب بديل (أو أكثر) من فرع (${branchName}) للسيشن`
                : 'اختر متدرب بديل (أو أكثر) من نفس الفرع للسيشن';

            currentAvailableColleagues = [];
            selectedColleagueKeys.clear();
            if (document.getElementById('colleagueSearchInput')) document.getElementById('colleagueSearchInput').value = '';

            const replaceCompanyModal = ensureModalInBody('replaceCandidateModal');
            if (replaceCompanyModal) replaceCompanyModal.classList.remove('hidden');
            await loadAvailableColleaguesForCurrentReplace();
        };

        window.closeReplaceModal = function () {
            const m = document.getElementById('replaceCandidateModal');
            if (m) m.classList.add('hidden');
        };

        window.submitReplaceNomination = async function () {
            const type = document.getElementById('replaceType').value;
            const userWaveId = parseInt(document.getElementById('replaceUserWaveId').value);
            const selectedValues = Array.from(selectedColleagueKeys);

            if (selectedValues.length === 0) {
                showAppToast('warning', 'Notice', 'Please select at least one replacement colleague from the list.');
                return;
            }

            const payload = {
                userWaveId: userWaveId,
                action: 'replace',
                type: type,
                replacementUserIds: selectedValues,
                replacementUserId: selectedValues[0]
            };

            if (type === 'company') {
                const numericIds = selectedValues.filter(v => /^[0-9]+$/.test(v)).map(v => parseInt(v));
                if (numericIds.length > 0) {
                    payload.replacementTraineeIds = numericIds;
                    payload.replacementTraineeId = numericIds[0];
                }
            }

            try {
                const res = await fetch('/Notification/ActionNomination', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    closeReplaceModal();
                    showAppToast('success', 'Replaced & Approved 🔄', data.message || 'Replacement colleague approved successfully.');
                    removeNominationCardFromDOM(type, userWaveId);
                    if (typeof window.loadSessionTraineesData === 'function' && typeof sessionTraineesState !== 'undefined' && sessionTraineesState.sessionId) {
                        window.loadSessionTraineesData(sessionTraineesState.sessionId);
                    }
                } else {
                    showAppToast('error', 'Replacement Failed', data.message || 'Could not replace candidate.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        // Branch Exemptions Modal Logic
        window.openBranchExemptionsModal = async function () {
            const modal = ensureModalInBody('branchExemptionsModal');
            const list = document.getElementById('branchExemptionsList');
            if (modal) modal.classList.remove('hidden');
            list.innerHTML = '<div class="text-center py-8 text-slate-400 text-xs"><i class="fas fa-spinner fa-spin text-lg mb-2 block"></i>جاري تحميل إعدادات الفروع...</div>';

            try {
                const res = await fetch('/Notification/GetBranchesApprovalSettings');
                const data = await res.json();
                if (data.success && data.branches) {
                    list.innerHTML = data.branches.map(b => `
                        <div class="flex items-center justify-between p-3.5 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800">
                            <div>
                                <h5 class="text-xs font-black text-slate-800 dark:text-white">${b.branchName}</h5>
                                <span class="text-[10px] text-slate-400 font-mono">${b.bypassApproval ? 'معفى (اعتماد مباشر)' : 'يتطلب موافقة المدير'}</span>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only peer" ${b.bypassApproval ? 'checked' : ''} onchange="toggleBranchBypass(${b.id}, this)">
                                <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                            </label>
                        </div>
                    `).join('');
                } else {
                    list.innerHTML = '<div class="text-center py-6 text-rose-500 text-xs">تعذر تحميل بيانات الفروع</div>';
                }
            } catch (e) {
                list.innerHTML = `<div class="text-center py-6 text-rose-500 text-xs">${e.message}</div>`;
            }
        };

        window.toggleBranchBypass = async function (branchId, checkbox) {
            try {
                const res = await fetch(`/Notification/ToggleBranchBypassApproval?branchId=${branchId}&bypass=${checkbox.checked}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showAppToast('success', 'Branch Settings', data.message || 'Branch exemption status updated successfully.');
                } else {
                    checkbox.checked = !checkbox.checked;
                    showAppToast('error', 'Save Failed', data.message || 'Could not save branch settings.');
                }
            } catch (e) {
                checkbox.checked = !checkbox.checked;
                showAppToast('error', 'Connection Error', e.message);
            }
        };

        window.closeBranchExemptionsModal = function () {
            document.getElementById('branchExemptionsModal').classList.add('hidden');
        };

        // Initial Load on Page Ready
        document.addEventListener('DOMContentLoaded', function () {
            loadHeaderNotifications();

            // Setup SignalR connection if available
            if (typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", function (message) {
                    loadHeaderNotifications();
                });

                connection.start().catch(err => console.log('SignalR Notification Hub Connection Error: ', err));
            }

            // Polling interval (every 30 seconds as fallback)
            setInterval(loadHeaderNotifications, 30000);
        });
    })();
</script>
