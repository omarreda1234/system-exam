<script>
    (function () {
        if (!window.showAppToast) {
            window.showAppToast = function (type, title, message) {
                let container = document.getElementById('appGlobalToastContainer');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'appGlobalToastContainer';
                    container.className = 'fixed top-5 left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 z-[999999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0';
                    document.body.appendChild(container);
                }

                const toast = document.createElement('div');
                toast.className = 'pointer-events-auto transform translate-y-[-16px] opacity-0 transition-all duration-300 ease-out flex items-start gap-3 p-4 rounded-2xl shadow-2xl backdrop-blur-xl border text-xs select-none';

                let iconHtml = '';
                let bgBorder = '';
                let progressBg = '';

                const t = (type || 'info').toLowerCase();
                if (t === 'success') {
                    bgBorder = 'bg-slate-900/95 text-emerald-100 border-emerald-500/40 shadow-emerald-950/40';
                    iconHtml = '<div class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-check-circle"></i></div>';
                    progressBg = 'bg-emerald-400';
                } else if (t === 'error' || t === 'danger') {
                    bgBorder = 'bg-slate-900/95 text-rose-100 border-rose-500/40 shadow-rose-950/40';
                    iconHtml = '<div class="w-7 h-7 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-circle"></i></div>';
                    progressBg = 'bg-rose-400';
                } else if (t === 'warning') {
                    bgBorder = 'bg-slate-900/95 text-amber-100 border-amber-500/40 shadow-amber-950/40';
                    iconHtml = '<div class="w-7 h-7 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-triangle"></i></div>';
                    progressBg = 'bg-amber-400';
                } else {
                    bgBorder = 'bg-slate-900/95 text-indigo-100 border-indigo-500/40 shadow-indigo-950/40';
                    iconHtml = '<div class="w-7 h-7 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-info-circle"></i></div>';
                    progressBg = 'bg-indigo-400';
                }

                toast.className += ' ' + bgBorder;
                toast.innerHTML = `
                    ${iconHtml}
                    <div class="flex-1 min-w-0 pr-1">
                        <h5 class="font-black text-xs text-white leading-snug">${title || ''}</h5>
                        ${message ? `<p class="text-[11px] opacity-80 mt-0.5 leading-normal break-words">${message}</p>` : ''}
                    </div>
                    <button type="button" class="text-white/40 hover:text-white transition-colors text-xs p-1 shrink-0" onclick="this.parentElement.remove()">
                        <i class="fas fa-times"></i>
                    </button>
                    <div class="absolute bottom-0 left-0 right-0 h-1 rounded-b-2xl overflow-hidden bg-white/10">
                        <div class="h-full ${progressBg} transition-all ease-linear" style="width: 100%; transition-duration: 3500ms;"></div>
                    </div>
                `;

                container.appendChild(toast);

                requestAnimationFrame(() => {
                    toast.classList.remove('translate-y-[-16px]', 'opacity-0');
                    toast.classList.add('translate-y-0', 'opacity-100');
                    const progressBar = toast.querySelector(`.${progressBg}`);
                    if (progressBar) {
                        requestAnimationFrame(() => {
                            progressBar.style.width = '0%';
                        });
                    }
                });

                setTimeout(() => {
                    toast.classList.remove('translate-y-0', 'opacity-100');
                    toast.classList.add('translate-y-[-8px]', 'opacity-0');
                    setTimeout(() => toast.remove(), 300);
                }, 3500);
            };
        }

        let notifState = {
            unreadCount: 0,
            pendingNominationsCount: 0,
            pendingWaveCount: 0,
            pendingCompanyCount: 0,
            waveNominations: [],
            companyNominations: [],
            currentTab: 'wave',
            currentStatusFilter: 'pending',
            notifications: []
        };

        const bellBtn = document.getElementById('notificationBellBtn');
        const notifDropdown = document.getElementById('notificationDropdown');
        const notifBadge = document.getElementById('notifBadge');
        const bellIcon = document.getElementById('bellIcon');

        // Toggle dropdown
        if (bellBtn) {
            bellBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (notifDropdown.classList.contains('hidden')) {
                    notifDropdown.classList.remove('hidden');
                    loadHeaderNotifications();
                } else {
                    notifDropdown.classList.add('hidden');
                }
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            if (notifDropdown && !notifDropdown.contains(e.target) && e.target !== bellBtn && !bellBtn.contains(e.target)) {
                notifDropdown.classList.add('hidden');
            }
        });

        // Fetch Header Notifications & Badges
        window.loadHeaderNotifications = async function () {
            try {
                const res = await fetch('/Notification/GetHeaderNotifications');
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                notifState.unreadCount = data.unreadCount || 0;
                notifState.pendingNominationsCount = data.pendingNominationsCount || 0;
                notifState.pendingWaveCount = data.pendingWaveCount || 0;
                notifState.pendingCompanyCount = data.pendingCompanyCount || 0;
                notifState.notifications = data.notifications || [];

                // Update badge
                if (notifState.unreadCount > 0) {
                    notifBadge.textContent = notifState.unreadCount > 99 ? '99+' : notifState.unreadCount;
                    notifBadge.classList.remove('hidden');
                    notifBadge.classList.add('flex');
                    bellIcon.classList.add('animate-bounce');
                    setTimeout(() => bellIcon.classList.remove('animate-bounce'), 2500);
                } else {
                    notifBadge.classList.add('hidden');
                    notifBadge.classList.remove('flex');
                }

                // Update pending nominations banner (STRICT: ONLY FOR BRANCH APPROVERS)
                const banner = document.getElementById('pendingNominationsBanner');
                const text = document.getElementById('pendingNominationsText');
                if (data.isBranchApprover && notifState.pendingNominationsCount > 0) {
                    banner.classList.remove('hidden');
                    banner.classList.add('flex');
                    text.textContent = `لديك ${notifState.pendingNominationsCount} موظف من فرعك بانتظار الاعتماد (${notifState.pendingWaveCount} ويف + ${notifState.pendingCompanyCount} شركات)`;
                } else {
                    banner.classList.add('hidden');
                    banner.classList.remove('flex');
                }

                // Admin Audit History link
                const adminLink = document.getElementById('adminHistoryLink');
                if (adminLink) {
                    if (data.isAdmin) {
                        adminLink.classList.remove('hidden');
                    } else {
                        adminLink.classList.add('hidden');
                    }
                }

                // Render list
                const list = document.getElementById('notifListContainer');
                if (!notifState.notifications || notifState.notifications.length === 0) {
                    list.innerHTML = `
                        <div class="p-6 text-center text-xs text-slate-400">
                            <i class="far fa-bell-slash text-2xl mb-2 opacity-50 block"></i>
                            لا توجد إشعارات جديدة حالياً
                        </div>`;
                } else {
                    list.innerHTML = notifState.notifications.map(n => `
                        <div id="notif-item-${n.id}" class="p-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all flex items-start gap-3 cursor-pointer group relative ${n.isRead ? 'opacity-70' : 'bg-brand-50/20'}"
                             onclick="handleNotificationClick(${n.id}, '${n.linkUrl || ''}')">
                            <div class="w-8 h-8 rounded-xl ${n.type === 'WaveNomination' ? 'bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-400' : 'bg-brand-100 text-brand-600 dark:bg-brand-900/40 dark:text-brand-400'} flex items-center justify-center text-xs shrink-0 mt-0.5">
                                <i class="${n.type === 'WaveNomination' ? 'fas fa-user-clock' : 'fas fa-bell'}"></i>
                            </div>
                            <div class="flex-1 min-w-0 text-right">
                                <p class="text-xs font-black text-slate-800 dark:text-white leading-tight">${n.title}</p>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">${n.message}</p>
                                <span class="text-[9px] text-slate-400 mt-1 block">${n.createdAt}</span>
                            </div>
                            <div class="flex flex-col items-center gap-1.5 shrink-0 mt-0.5">
                                <button type="button" 
                                        onclick="deleteNotification(event, ${n.id})" 
                                        class="w-6 h-6 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center justify-center transition-all opacity-80 hover:opacity-100" 
                                        title="حذف الإشعار">
                                    <i class="fas fa-times text-xs"></i>
                                </button>
                                ${!n.isRead ? '<span class="w-2 h-2 rounded-full bg-brand-500"></span>' : ''}
                            </div>
                        </div>
                    `).join('');
                }
            } catch (err) {
                console.error('Failed to load notifications', err);
            }
        };

        window.deleteNotification = async function (e, id) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }

            const item = document.getElementById(`notif-item-${id}`);
            if (item) {
                item.style.transition = 'all 0.25s ease';
                item.style.opacity = '0';
                item.style.transform = 'translateX(20px)';
            }

            try {
                const res = await fetch(`/Notification/DeleteNotification?id=${id}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    if (item) item.remove();
                    notifState.notifications = notifState.notifications.filter(x => x.id !== id);
                    if (notifState.notifications.length === 0) {
                        const list = document.getElementById('notifListContainer');
                        if (list) {
                            list.innerHTML = `
                                <div class="p-6 text-center text-xs text-slate-400">
                                    <i class="far fa-bell-slash text-2xl mb-2 opacity-50 block"></i>
                                    لا توجد إشعارات جديدة حالياً
                                </div>`;
                        }
                    }
                    showAppToast('info', 'تم الحذف', 'تم حذف الإشعار.');
                    loadHeaderNotifications();
                } else {
                    if (item) {
                        item.style.opacity = '1';
                        item.style.transform = 'none';
                    }
                    showAppToast('error', 'خطأ', data.message || 'فشل حذف الإشعار');
                }
            } catch {
                if (item) {
                    item.style.opacity = '1';
                    item.style.transform = 'none';
                }
            }
        };

        window.deleteAllNotifications = async function () {
            if (!notifState.notifications || notifState.notifications.length === 0) {
                showAppToast('info', 'تنبيه', 'لا توجد إشعارات لحذفها حالياً.');
                return;
            }

            const list = document.getElementById('notifListContainer');
            if (list) {
                list.style.transition = 'all 0.25s ease';
                list.style.opacity = '0.3';
            }

            try {
                const res = await fetch('/Notification/DeleteAllNotifications', { 
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    notifState.notifications = [];
                    if (list) {
                        list.innerHTML = `
                            <div class="p-6 text-center text-xs text-slate-400">
                                <i class="far fa-bell-slash text-2xl mb-2 opacity-50 block"></i>
                                تم مسح جميع الإشعارات بنجاح
                            </div>`;
                        list.style.opacity = '1';
                    }
                    showAppToast('success', 'تم المسح 🗑️', data.message || 'تم مسح جميع الإشعارات بنجاح.');
                    loadHeaderNotifications();
                } else {
                    if (list) list.style.opacity = '1';
                    showAppToast('error', 'فشل المسح', data.message || 'تعذر مسح الإشعارات.');
                }
            } catch (err) {
                if (list) list.style.opacity = '1';
                showAppToast('error', 'خطأ في الاتصال', err.message);
            }
        };

        window.handleNotificationClick = async function (id, url) {
            try {
                await fetch(`/Notification/MarkAsRead?id=${id}`, { method: 'POST' });
                if (url && url !== '#' && url !== '') {
                    window.location.href = url;
                } else {
                    loadHeaderNotifications();
                }
            } catch { }
        };

        window.markAllNotificationsAsRead = async function () {
            // Optimistic instant UI update
            if (notifState.notifications && notifState.notifications.length > 0) {
                notifState.notifications.forEach(n => n.isRead = true);
                const dots = document.querySelectorAll('#notifListContainer span.bg-brand-500');
                dots.forEach(d => d.remove());
                const items = document.querySelectorAll('#notifListContainer [id^="notif-item-"]');
                items.forEach(i => {
                    i.classList.remove('bg-brand-50/20');
                    i.classList.add('opacity-70');
                });
            }

            try {
                const res = await fetch('/Notification/MarkAsRead', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showAppToast('success', 'تم التحديث ✅', data.message || 'تم تحديد جميع الإشعارات كمقروءة.');
                }
                loadHeaderNotifications();
            } catch (err) {
                showAppToast('error', 'خطأ في الاتصال', err.message);
            }
        };

        function ensureModalInBody(modalId) {
            const modal = document.getElementById(modalId);
            if (modal && modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
            return modal;
        }

        function updateTabAndBadgeCounts() {
            const wavePending = (notifState.waveNominations || []).filter(x => (x.approvalStatus || 'Pending').toLowerCase() === 'pending').length;
            const companyPending = (notifState.companyNominations || []).filter(x => (x.approvalStatus || 'Pending').toLowerCase() === 'pending').length;

            const badgeWave = document.getElementById('waveCountBadge');
            const badgeCompany = document.getElementById('companyCountBadge');

            if (badgeWave) {
                badgeWave.textContent = wavePending > 0 ? `${wavePending} معلق` : `${(notifState.waveNominations || []).length}`;
            }
            if (badgeCompany) {
                badgeCompany.textContent = companyPending > 0 ? `${companyPending} معلق` : `${(notifState.companyNominations || []).length}`;
            }
        }

        // Open Branch Nominations Modal & Render
        window.openBranchNominationsModal = async function () {
            const modal = ensureModalInBody('branchNominationsModal');
            const wrapper = document.getElementById('nominationsListWrapper');
            
            if (modal) modal.classList.remove('hidden');
            wrapper.innerHTML = `
                <div class="text-center py-10 text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl text-brand-500 mb-3 block"></i>
                    جاري استدعاء قائمة المرشحين...
                </div>`;

            try {
                const res = await fetch('/Notification/GetPendingBranchNominations?status=all');
                const data = await res.json();

                if (!data.success) {
                    wrapper.innerHTML = `<div class="text-center py-10 text-rose-500 font-bold">حدث خطأ: ${data.message}</div>`;
                    return;
                }

                notifState.waveNominations = data.waveNominations || [];
                notifState.companyNominations = data.companyNominations || [];

                updateTabAndBadgeCounts();

                // Auto switch tab if wave is empty but company has items
                if (notifState.waveNominations.length === 0 && notifState.companyNominations.length > 0) {
                    notifState.currentTab = 'company';
                } else if (notifState.waveNominations.length > 0 && notifState.companyNominations.length === 0) {
                    notifState.currentTab = 'wave';
                }

                switchNominationTab(notifState.currentTab);
            } catch (err) {
                wrapper.innerHTML = `<div class="text-center py-10 text-rose-500 font-bold">حدث خطأ أثناء تحميل البيانات: ${err.message}</div>`;
            }
        };

        window.switchNominationTab = function (tab) {
            notifState.currentTab = tab;
            const btnWave = document.getElementById('tabBtnWaveNom');
            const btnCompany = document.getElementById('tabBtnCompanyNom');

            if (tab === 'wave') {
                btnWave.classList.add('text-brand-600', 'border-brand-600');
                btnWave.classList.remove('text-slate-400', 'border-transparent');
                btnCompany.classList.remove('text-indigo-600', 'border-indigo-600');
                btnCompany.classList.add('text-slate-400', 'border-transparent');
            } else {
                btnCompany.classList.add('text-indigo-600', 'border-indigo-600');
                btnCompany.classList.remove('text-slate-400', 'border-transparent');
                btnWave.classList.remove('text-brand-600', 'border-brand-600');
                btnWave.classList.add('text-slate-400', 'border-transparent');
            }

            renderCurrentNominationsTab();
        };

        window.switchNominationStatusFilter = function (filter) {
            notifState.currentStatusFilter = filter;
            const btnPending = document.getElementById('btnFilterPending');
            const btnApproved = document.getElementById('btnFilterApproved');
            const btnAll = document.getElementById('btnFilterAll');

            const inactiveClass = 'px-3 py-1 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1.5';
            if (btnPending) btnPending.className = inactiveClass;
            if (btnApproved) btnApproved.className = inactiveClass;
            if (btnAll) btnAll.className = inactiveClass;

            if (filter === 'pending') {
                if (btnPending) btnPending.className = 'px-3 py-1 rounded-xl text-xs font-black bg-amber-500 text-white shadow-sm transition-all flex items-center gap-1.5';
            } else if (filter === 'approved') {
                if (btnApproved) btnApproved.className = 'px-3 py-1 rounded-xl text-xs font-black bg-emerald-600 text-white shadow-sm transition-all flex items-center gap-1.5';
            } else {
                if (btnAll) btnAll.className = 'px-3 py-1 rounded-xl text-xs font-black bg-slate-800 text-white dark:bg-white dark:text-slate-900 shadow-sm transition-all flex items-center gap-1.5';
            }

            renderCurrentNominationsTab();
        };

        function renderCurrentNominationsTab() {
            const wrapper = document.getElementById('nominationsListWrapper');
            const footerCount = document.getElementById('nominationsCountFooter');
            const isWave = notifState.currentTab === 'wave';
            const rawList = isWave ? notifState.waveNominations : notifState.companyNominations;

            const filter = notifState.currentStatusFilter || 'pending';
            let list = rawList;
            if (filter === 'pending') {
                list = rawList.filter(x => (x.approvalStatus || 'Pending').toLowerCase() === 'pending');
            } else if (filter === 'approved') {
                list = rawList.filter(x => (x.approvalStatus || '').toLowerCase() === 'approved');
            }

            const filterLabel = filter === 'pending' ? 'بانتظار الاعتماد' : (filter === 'approved' ? 'معتمدين' : 'الكل');
            footerCount.textContent = `${list.length} مرشح (${filterLabel}) - ${isWave ? 'دورات الويف' : 'جلسات الشركات'}`;

            if (list.length === 0) {
                const emptyMsg = filter === 'approved' 
                    ? 'لا يوجد مرشحين معتمدين قادمين حالياً في هذا القسم.' 
                    : (filter === 'pending' ? 'تمت مراجعة واعتماد جميع ترشيحات موظفي الفرع بنجاح.' : 'لا توجد بيانات متاحة في هذا القسم.');
                wrapper.innerHTML = `
                    <div class="text-center py-16">
                        <div class="w-16 h-16 rounded-3xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-500 flex items-center justify-center mx-auto mb-4 text-2xl">
                            <i class="fas fa-check-double"></i>
                        </div>
                        <h4 class="text-base font-black text-slate-800 dark:text-white">لا توجد سجلات مطابقة</h4>
                        <p class="text-xs text-slate-400 mt-1">${emptyMsg}</p>
                    </div>`;
                return;
            }

            if (isWave) {
                wrapper.innerHTML = `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        ${list.map(n => {
                            const isApproved = (n.approvalStatus || '').toLowerCase() === 'approved';
                            return `
                            <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border ${isApproved ? 'border-emerald-200 dark:border-emerald-800/60' : 'border-slate-200/80 dark:border-slate-700'} shadow-sm hover:shadow-md transition-all flex flex-col justify-between" id="nomCard_${n.userWaveId}">
                                <div>
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr ${isApproved ? 'from-emerald-600 to-teal-500' : 'from-brand-600 to-emerald-500'} text-white font-black flex items-center justify-center text-sm shadow-md">
                                                ${(n.studentName || 'U')[0]}
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-black text-slate-900 dark:text-white leading-tight">${n.studentName}</h4>
                                                <p class="text-[11px] text-slate-400 font-mono">الكود: ${n.userCode} | ${n.branchName}</p>
                                            </div>
                                        </div>
                                        ${isApproved 
                                            ? `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 flex items-center gap-1">
                                                 <i class="fas fa-check-circle"></i> معتمد (Approved)
                                               </span>`
                                            : `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                                 معلق (Pending)
                                               </span>`
                                        }
                                    </div>

                                    <div class="p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl text-xs space-y-1 mb-4 border border-slate-100 dark:border-slate-800">
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">الدورة التدريبية:</span>
                                            <span class="font-bold text-slate-800 dark:text-white">${n.waveName}</span>
                                        </div>
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">تاريخ البدء:</span>
                                            <span class="font-mono text-brand-600 dark:text-brand-400">${n.startDate}</span>
                                        </div>
                                        <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                            <span class="text-slate-400">الهاتف / الإيميل:</span>
                                            <span class="text-slate-500 dark:text-slate-400">${n.phoneNumber}</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                ${isApproved ? `
                                    <div class="flex items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/60">
                                        <button type="button" onclick="openReplaceModal(${n.userWaveId}, ${n.waveId}, ${n.branchId || 0}, '${n.studentName}', '${n.branchName || ''}', '${n.userCode || ''}', '${n.userId || ''}')"
                                                class="flex-1 py-2 px-3 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 active:scale-95 text-white font-black text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5" title="استبدال بزميل آخر (ظرف طارئ)">
                                            <i class="fas fa-exchange-alt"></i> استبدال بزميل بديل (ظرف طارئ)
                                        </button>
                                        <button type="button" onclick="toggleRejectBox('wave', ${n.userWaveId}, true)"
                                                class="py-2 px-3 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 dark:bg-rose-950/40 dark:hover:bg-rose-900/60 font-bold text-xs transition-all flex items-center justify-center gap-1" title="اعتذار">
                                            <i class="fas fa-times"></i> اعتذار
                                        </button>
                                    </div>
                                ` : `
                                    <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-100 dark:border-slate-700/60">
                                        <button type="button" onclick="actionNomination(${n.userWaveId}, 'accept', 'wave', '${n.studentName}')"
                                                class="py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-1.5" title="موافقة واعتماد">
                                            <i class="fas fa-check"></i> موافقة
                                        </button>

                                        <button type="button" onclick="toggleRejectBox('wave', ${n.userWaveId}, true)"
                                                class="py-2 px-3 rounded-xl bg-rose-500 hover:bg-rose-600 active:scale-95 text-white font-black text-xs shadow-md shadow-rose-500/20 transition-all flex items-center justify-center gap-1.5" title="اعتذار أو رفض">
                                            <i class="fas fa-times"></i> رفض
                                        </button>

                                        <button type="button" onclick="openReplaceModal(${n.userWaveId}, ${n.waveId}, ${n.branchId || 0}, '${n.studentName}', '${n.branchName || ''}', '${n.userCode || ''}', '${n.userId || ''}')"
                                                class="py-2 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-black text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5" title="استبدال بزميل آخر">
                                            <i class="fas fa-exchange-alt"></i> استبدال
                                        </button>
                                    </div>
                                `}

                                <!-- Inline Rejection Form Drawer (No SweetAlert, Direct Toast) -->
                                <div id="rejectBox_wave_${n.userWaveId}" class="hidden mt-3 p-3 rounded-xl bg-rose-50/80 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 transition-all">
                                    <label class="block text-[11px] font-bold text-rose-800 dark:text-rose-300 mb-1.5">
                                        سبب الاعتذار أو الرفض (إلزامي):
                                    </label>
                                    <div class="flex gap-2">
                                        <input type="text" id="rejectInput_wave_${n.userWaveId}" placeholder="مثال: الموظف في إجازة / ضغط عمل بالفرع..." 
                                               class="flex-1 px-3 py-1.5 text-xs rounded-lg border border-rose-300 dark:border-rose-800 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20" 
                                               onkeydown="if(event.key==='Enter') confirmInlineReject(${n.userWaveId}, 'wave', '${n.studentName}')" />
                                        <button type="button" onclick="confirmInlineReject(${n.userWaveId}, 'wave', '${n.studentName}')" 
                                                class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 active:scale-95 text-white font-black text-xs shadow-sm transition-all flex items-center gap-1">
                                            <i class="fas fa-check"></i> تأكيد
                                        </button>
                                        <button type="button" onclick="toggleRejectBox('wave', ${n.userWaveId}, false)" 
                                                class="px-2.5 py-1.5 rounded-lg text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 text-xs font-bold transition-all">
                                            إلغاء
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;}).join('')}
                    </div>`;
            } else {
                // Company Session Nominations
                wrapper.innerHTML = `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        ${list.map(c => {
                            const isApproved = (c.approvalStatus || '').toLowerCase() === 'approved';
                            return `
                            <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border ${isApproved ? 'border-emerald-200 dark:border-emerald-800/60' : 'border-slate-200/80 dark:border-slate-700'} shadow-sm hover:shadow-md transition-all flex flex-col justify-between" id="nomCompanyCard_${c.companySessionTraineeId}">
                                <div>
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr ${isApproved ? 'from-emerald-600 to-teal-500' : 'from-indigo-600 to-purple-600'} text-white font-black flex items-center justify-center text-sm shadow-md">
                                                ${(c.traineeName || 'T')[0]}
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-black text-slate-900 dark:text-white leading-tight">${c.traineeName}</h4>
                                                <p class="text-[11px] text-slate-400 font-mono">الكود: ${c.userCode} | الفرع: ${c.branchName} | ${c.jobTitle}</p>
                                            </div>
