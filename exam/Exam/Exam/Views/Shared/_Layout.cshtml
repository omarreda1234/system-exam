@inject Exam.Services.IExamService ExamService
<!DOCTYPE html>
<html lang="en" translate="no" class="notranslate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate">
    <title>@ViewData["Title"] - Eltarshoubi Training Academy</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/logo-circle.png" />
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Comfortaa:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons & Styling -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <script src="~/lib/tailwind/tailwindcss.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#edf4f3',
                            100: '#d1e4e2',
                            200: '#a8cdca',
                            300: '#75b0ab',
                            400: '#48918a',
                            500: '#2a766f',
                            600: '#01443c',
                            700: '#013831',
                            800: '#012c27',
                            900: '#011f1c',
                            950: '#00120f',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        .nav-link {
            @@apply flex items-center px-4 py-2 text-xs font-bold text-slate-500 hover:text-brand-600 transition-all uppercase tracking-widest;
        }
        .nav-link.active {
            @@apply text-brand-600;
        }
        .glass-nav {
            @@apply bg-white/80 backdrop-blur-xl border-b border-slate-100;
        }

        /* Splash Screen Premium Animations */
        #splash-screen {
            position: fixed;
            inset: 0;
            background-color: #ffffff;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 1;
            visibility: visible;
            transition: opacity 0.8s cubic-bezier(0.85, 0, 0.15, 1), transform 0.8s cubic-bezier(0.85, 0, 0.15, 1), visibility 0.8s;
        }

        #splash-screen.fade-out {
            opacity: 0;
            transform: translateY(-100%);
            visibility: hidden;
        }

        .letter-path {
            stroke: #0f172a;
            stroke-width: 5.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            fill: none;
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: drawLetter 0.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        .accent-path {
            fill: none;
            stroke: #0f172a;
            stroke-width: 5.5;
            stroke-linecap: round;
            opacity: 0;
            animation: dropAccent 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .accent-dot {
            fill: #0f172a;
            opacity: 0;
            animation: dropAccent 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .sub-letter {
            stroke: #01443c;
            stroke-width: 1.5;
            fill: rgba(1, 68, 60, 0);
            stroke-dasharray: 120;
            stroke-dashoffset: 120;
            animation: drawSubLetter 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards, fillSubLetter 0.5s ease forwards;
        }

        @@keyframes drawSubLetter {
            to {
                stroke-dashoffset: 0;
            }
        }

        @@keyframes fillSubLetter {
            to {
                fill: rgba(1, 68, 60, 1);
            }
        }

        @@keyframes drawLetter {
            to {
                stroke-dashoffset: 0;
            }
        }

        @@keyframes dropAccent {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body class="bg-white text-slate-900 font-sans selection:bg-brand-100 selection:text-brand-700">
    <!-- Splash Screen Overlay -->
    <div id="splash-screen" class="fixed inset-0 bg-white z-[999999] flex flex-col items-center justify-center select-none" style="display: none;">
        <div class="flex flex-col items-center text-center px-4">
            <!-- Logo Box -->
            <div id="splash-logo-box" class="w-24 h-24 bg-white rounded-full overflow-hidden flex items-center justify-center p-2 border border-slate-100 shadow-xl shadow-slate-200/50 mb-8 opacity-0 scale-90 transition-all duration-[1000ms] ease-out">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo" class="w-full h-full object-cover" />
            </div>
            
            <!-- SVG Title with Clean Geometric Comfortaa-like Draw-In Animation -->
            <div class="w-full max-w-[620px] aspect-[500/230]">
                <svg viewBox="0 0 500 230" class="w-full h-full text-slate-900 dark:text-slate-900">
                    <!-- E -->
                    <path class="letter-path" style="animation-delay: 0s;" pathLength="100" d="M 85,85 C 65,85 55,95 55,115 C 55,135 65,145 85,145" />
                    <path class="accent-path" style="animation-delay: 0.1s;" d="M 55,115 L 75,115" />
                    
                    <!-- l -->
                    <path class="letter-path" style="animation-delay: 0.1s;" pathLength="100" d="M 105,80 L 105,145" />
                    
                    <!-- t -->
                    <path class="letter-path" style="animation-delay: 0.2s;" pathLength="100" d="M 125,90 L 125,145" />
                    <path class="accent-path" style="animation-delay: 0.35s;" d="M 117,105 L 133,105" />
                    
                    <!-- a -->
                    <path class="letter-path" style="animation-delay: 0.3s;" pathLength="100" d="M 170,125 C 170,112 150,112 150,125 C 150,138 170,138 170,125" />
                    <path class="letter-path" style="animation-delay: 0.38s;" pathLength="100" d="M 170,115 L 170,145" />
                    
                    <!-- r -->
                    <path class="letter-path" style="animation-delay: 0.4s;" pathLength="100" d="M 190,145 L 190,115" />
                    <path class="letter-path" style="animation-delay: 0.48s;" pathLength="100" d="M 190,125 C 190,118 202,118 205,120" />
                    
                    <!-- s -->
                    <path class="letter-path" style="animation-delay: 0.5s;" pathLength="100" d="M 235,118 C 222,115 220,128 235,132 C 248,135 242,148 228,145" />
                    
                    <!-- h -->
                    <path class="letter-path" style="animation-delay: 0.6s;" pathLength="100" d="M 260,80 L 260,145" />
                    <path class="letter-path" style="animation-delay: 0.68s;" pathLength="100" d="M 260,128 C 265,116 278,116 278,145" />
                    
                    <!-- o -->
                    <path class="letter-path" style="animation-delay: 0.7s;" pathLength="100" d="M 315,130 C 315,115 295,115 295,130 C 295,145 315,145 315,130" />
                    
                    <!-- u -->
                    <path class="letter-path" style="animation-delay: 0.8s;" pathLength="100" d="M 335,115 L 335,138 C 335,145 350,145 350,138" />
                    <path class="letter-path" style="animation-delay: 0.88s;" pathLength="100" d="M 350,115 L 350,145" />
                    
                    <!-- b -->
                    <path class="letter-path" style="animation-delay: 0.9s;" pathLength="100" d="M 372,80 L 372,145" />
                    <path class="letter-path" style="animation-delay: 0.98s;" pathLength="100" d="M 372,130 C 372,115 392,115 392,130 C 392,145 372,145 372,130" />
                    
                    <!-- i -->
                    <path class="letter-path" style="animation-delay: 1.0s;" pathLength="100" d="M 412,115 L 412,145" />
                    <circle class="accent-dot" style="animation-delay: 1.15s;" cx="412" cy="98" r="4.5" />

                    <!-- Handwriting/Draw-In Subtitle using Plus Jakarta Sans Font outlines -->
                    <text x="250" y="215" text-anchor="middle" font-family="'Plus Jakarta Sans', 'Inter', sans-serif" font-size="20" font-weight="800" letter-spacing="0.35em" fill="none">
                        <tspan class="sub-letter" style="animation-delay: 1.1s, 1.3s;">T</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.15s, 1.35s;">R</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.2s, 1.4s;">A</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.25s, 1.45s;">I</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.3s, 1.5s;">N</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.35s, 1.55s;">I</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.4s, 1.6s;">N</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.45s, 1.65s;">G</tspan>
                        <tspan> </tspan>
                        <!-- dx="18" to force a clear visual separation between the two words -->
                        <tspan class="sub-letter" dx="18" style="animation-delay: 1.55s, 1.75s;">A</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.6s, 1.8s;">C</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.65s, 1.85s;">A</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.7s, 1.9s;">D</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.75s, 1.95s;">E</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.8s, 2.0s;">M</tspan>
                        <tspan class="sub-letter" style="animation-delay: 1.85s, 2.05s;">Y</tspan>
                    </text>
                </svg>
            </div>
        </div>
    </div>

    <script>
        (function() {
            const isReload = performance.getEntriesByType("navigation")[0]?.type === "reload";
            const isSplashShown = sessionStorage.getItem('splash-shown') && !isReload && !window.location.search.includes('splash=true');
            const splash = document.getElementById('splash-screen');
            
            if (isSplashShown) {
                splash.style.display = 'none';
            } else {
                splash.style.display = 'flex';
                document.body.style.overflow = 'hidden';
                


                setTimeout(() => {
                    const logoBox = document.getElementById('splash-logo-box');
                    if (logoBox) {
                        logoBox.style.opacity = '1';
                        logoBox.style.transform = 'scale(1)';
                    }
                }, 100);
                
                setTimeout(() => {
                    splash.classList.add('fade-out');
                    document.body.style.overflow = '';
                    setTimeout(() => {
                        splash.remove();
                    }, 800);
                    sessionStorage.setItem('splash-shown', 'true');
                }, 2600);
            }
        })();
    </script>

    
    @if (ViewData["HideNavbar"] as bool? != true)
    {
    <header class="sticky top-0 z-50 glass-nav">
        <nav class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <!-- Logo area -->
            <a href="/" class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center p-1 border border-slate-100 shadow-sm">
                    <img src="~/images/logo.jpeg" alt="Logo" class="w-full h-full object-contain" />
                </div>
                <div class="hidden sm:block">
                    <span class="text-sm font-black tracking-tight block leading-none text-slate-900 uppercase">Eltarshoubi</span>
                    <span class="text-[9px] font-bold text-brand-600 tracking-[0.2em] uppercase">Academy</span>
                </div>
            </a>

            <!-- Center Nav Links -->
            <div class="hidden lg:flex items-center gap-2 p-1 bg-slate-100/50 rounded-2xl border border-slate-200/50">
                <a href="/" class="rounded-xl px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 hover:bg-white hover:text-slate-900 hover:shadow-sm transition-all">Home</a>
                <a href="#about" class="rounded-xl px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 hover:bg-white hover:text-slate-900 hover:shadow-sm transition-all">About</a>
                <a href="#program" class="rounded-xl px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 hover:bg-white hover:text-slate-900 hover:shadow-sm transition-all">Program</a>
            </div>

            @{
                var layoutUserRoles = User.Claims
                    .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                    .Select(c => c.Value)
                    .ToList();

                bool hasAdminAccess = User.Identity.IsAuthenticated && 
                    (ExamService != null && ExamService.HasPermissionAsync(layoutUserRoles, "Admin", "Index").GetAwaiter().GetResult());

                bool hasAttendanceAccess = User.Identity.IsAuthenticated && 
                    (User.IsInRole("Admin") || User.IsInRole("Reception") || User.IsInRole("SoftSkills Specialist") || 
                    (ExamService != null && ExamService.HasPermissionAsync(layoutUserRoles, "Attendance", "Index").GetAwaiter().GetResult()));

                bool hasProgramDashAccess = User.Identity.IsAuthenticated && 
                    (User.IsInRole("Admin") || User.IsInRole("pharmacist") || User.IsInRole("assistant") || User.IsInRole("صيدلي") || User.IsInRole("مساعد صيدلي") || User.IsInRole("Pharmacist") || User.IsInRole("Assistant") || User.IsInRole("Doctor") ||
                    (ExamService != null && ExamService.HasPermissionAsync(layoutUserRoles, "Materials", "Index").GetAwaiter().GetResult()));
            }

            <div class="flex items-center gap-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="hidden md:flex items-center gap-2 mr-4 border-r border-slate-100 pr-4">
                        @if (hasAdminAccess)
                        {
                            <a href="@Url.Action("Index", "Admin")" class="text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-xl bg-brand-600 text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700 transition-all">
                                <i class="fas fa-chart-pie mr-2"></i>Examination Dash
                            </a>
                        }
                        @if (hasAttendanceAccess)
                        {
                            <a href="@Url.Action("Index", "Attendance")" class="text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20 hover:bg-indigo-700 transition-all">
                                <i class="fas fa-calendar-check mr-2"></i>Attendance
                            </a>
                        }
                        @if (hasAdminAccess && hasProgramDashAccess)
                        {
                            <a href="@Url.Action("Index", "Materials")" class="text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition-all">
                                <i class="fas fa-project-diagram mr-2"></i>Program Dash
                            </a>
                        }
                        <a href="@Url.Action("Profile", "Home")" class="text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-xl bg-emerald-600 text-white shadow-lg shadow-emerald-600/20 hover:bg-emerald-700 transition-all flex items-center">
                            <i class="fas fa-id-badge mr-2"></i>My Profile
                        </a>
                    </div>

                    <div class="flex items-center gap-3 relative">
                        <partial name="_NotificationBellPartial" />
                        @{
                            string roleDisplay = "Trainee Node";
                            if (User.IsInRole("Admin")) roleDisplay = "Administrator";
                            else if (User.IsInRole("HR") || User.IsInRole("Human Resources")) roleDisplay = "Human Resources";
                            else if (User.IsInRole("Reception")) roleDisplay = "Receptionist";
                            else if (User.IsInRole("Branch Manager")) roleDisplay = "Branch Manager";
                            else if (User.IsInRole("Branch Supervisor")) roleDisplay = "Branch Supervisor";
                            else if (User.IsInRole("SoftSkills Specialist")) roleDisplay = "Soft Skills Specialist";
                        }
                        <button id="profileDropdownBtn" class="w-8 h-8 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 hover:bg-brand-100 dark:hover:bg-brand-500/20 font-black text-xs transition-all focus:outline-none focus:ring-2 focus:ring-brand-500/20">
                            @(User.Identity.Name?[0].ToString().ToUpper() ?? "U")
                        </button>
                        
                        <!-- Dropdown Menu -->
                        <div id="profileDropdown" class="hidden absolute right-0 top-10 mt-2 w-64 bg-white rounded-2xl shadow-xl border border-slate-100 py-3 z-50 transition-all duration-300">
                            <div class="px-4 py-3 border-b border-slate-50 mb-2">
                                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest leading-none">Active Session</p>
                                <p class="text-xs font-black text-slate-800 truncate mt-1.5 mb-0.5">@User.Identity.Name</p>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-brand-50 text-brand-600 uppercase tracking-wider mt-1">
                                    <i class="fas fa-shield-alt mr-1"></i> @roleDisplay
                                </span>
                            </div>
                            <div class="px-2 pb-1 border-b border-slate-50 mb-1">
                                <a href="@Url.Action("Profile", "Home")" class="w-full flex items-center gap-2.5 px-3 py-2 text-left text-xs font-bold text-slate-700 hover:bg-brand-50 hover:text-brand-700 rounded-xl transition-all">
                                    <i class="fas fa-id-card text-brand-600"></i>
                                    <span>My Profile & Certs</span>
                                </a>
                                @if (hasAdminAccess)
                                {
                                    <a href="@Url.Action("NominationHistory", "Admin")" class="w-full flex items-center gap-2.5 px-3 py-2 text-left text-xs font-bold text-slate-700 hover:bg-brand-50 hover:text-brand-700 rounded-xl transition-all">
                                        <i class="fas fa-history text-indigo-600"></i>
                                        <span>سجل ترشيحات الفروع</span>
                                    </a>
                                }
                            </div>
                            <div class="px-2">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="w-full">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-left text-xs font-bold text-rose-500 hover:bg-rose-50 rounded-xl transition-all">
                                        <i class="fas fa-power-off text-sm"></i>
                                        <span>Sign Out</span>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-xs font-black uppercase tracking-widest text-slate-400 hover:text-rose-500 transition-colors">
                                <i class="fas fa-power-off"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-brand-600/20 transition-all">
                            sign in
                    </a>
                }
                <!-- Mobile Menu Button -->
                <button id="mobileMenuBtn" class="lg:hidden ml-2 w-10 h-10 flex items-center justify-center text-slate-600 bg-slate-50 rounded-xl border border-slate-200 hover:bg-slate-100 transition-colors">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
        <!-- Mobile Menu Panel -->
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-t border-slate-100 px-6 py-6 shadow-2xl absolute w-full left-0 top-20">
            <div class="flex flex-col gap-6">
                <a href="/" class="text-sm font-black uppercase tracking-widest text-slate-700 hover:text-brand-600">Home</a>
                <a href="/#about" class="text-sm font-black uppercase tracking-widest text-slate-700 hover:text-brand-600">About</a>
                <a href="/#program" class="text-sm font-black uppercase tracking-widest text-slate-700 hover:text-brand-600">Program</a>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="h-px bg-slate-100 w-full my-2"></div>
                    @if (hasAdminAccess)
                    {
                        <a href="@Url.Action("Index", "Admin")" class="text-xs font-black uppercase tracking-widest text-brand-600"><i class="fas fa-chart-pie mr-2"></i> Examination Dash</a>
                    }
                    @if (hasAttendanceAccess)
                    {
                        <a href="@Url.Action("Index", "Attendance")" class="text-xs font-black uppercase tracking-widest text-indigo-600"><i class="fas fa-calendar-check mr-2"></i> Attendance</a>
                    }
                    @if (hasProgramDashAccess)
                    {
                        <a href="@Url.Action("Index", "Materials")" class="text-xs font-black uppercase tracking-widest text-slate-900"><i class="fas fa-project-diagram mr-2"></i> Program Dash</a>
                    }

                    @if (User.IsInRole("pharmacist") || User.IsInRole("assistant") || User.IsInRole("صيدلي") || User.IsInRole("مساعد صيدلي") || User.IsInRole("Pharmacist") || User.IsInRole("Assistant") || User.IsInRole("Doctor"))
                    {
                        <a href="@Url.Action("Index", "Materials")" class="text-xs font-black uppercase tracking-widest text-emerald-600"><i class="fas fa-project-diagram mr-2"></i> Program Dash</a>
                    }
                    <a href="@Url.Action("Profile", "Home")" class="text-xs font-black uppercase tracking-widest text-slate-900"><i class="fas fa-id-card mr-2 text-brand-600"></i> My Profile</a>

                    @if (User.IsInRole("pharmacist") || User.IsInRole("assistant") || User.IsInRole("صيدلي") || User.IsInRole("مساعد صيدلي") || User.IsInRole("Pharmacist") || User.IsInRole("Assistant") || User.IsInRole("Doctor"))
                    {
                        <a href="@Url.Action("StudentExams", "Home")" class="text-xs font-black uppercase tracking-widest text-brand-600"><i class="fas fa-file-signature mr-2"></i> My Exams</a>
                        <a href="@Url.Action("Index", "Assignments")" class="text-xs font-black uppercase tracking-widest text-indigo-600"><i class="fas fa-tasks mr-2"></i> My Assignments</a>
                    }
                }
            </div>
        </div>
    </header>
    }

    <main>
        @RenderBody()
    </main>

    @if (ViewData["HideNavbar"] as bool? != true)
    {
    <footer class="bg-slate-950 text-slate-400 pt-20 pb-10 mt-20">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-20 text-center md:text-left">
                <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center justify-center md:justify-start gap-3 mb-6">
                        <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center text-white">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                            <span class="text-lg font-black text-white tracking-tight uppercase">Eltarshoubi Academy</span>
                    </div>
                    <p class="text-sm leading-relaxed max-w-sm mx-auto md:mx-0">
                        Bridging academia and clinical excellence through innovation. Empowering practitioners since 2008.
                    </p>
                </div>
                <div>
                    <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-6">Resources</h4>
                    <ul class="space-y-4 text-[10px] font-bold uppercase tracking-widest">
                        <li><a href="#" class="hover:text-brand-600 transition-colors">Privacy Policy</a></li>
                        <li><a href="#" class="hover:text-brand-600 transition-colors">Accreditation</a></li>
                        <li><a href="#" class="hover:text-brand-600 transition-colors">Terms of Service</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-6">Connect</h4>
                    <div class="flex justify-center md:justify-start gap-4">
                        <a href="#" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-brand-600 transition-all hover:-translate-y-1">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-brand-600 transition-all hover:-translate-y-1">
                            <i class="fab fa-twitter"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="pt-10 border-t border-white/10 text-center text-[9px] font-black tracking-[0.3em] uppercase opacity-40">
                &copy; @DateTime.Now.Year Eltarshouby Medical Training Academy.
            </div>
        </div>
    </footer>
    }

    <script src="~/lib/jquery-3.6.0/jquery.min.js"></script>
    <script src="~/lib/sweetalert2-11/sweetalert2.all.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
        <script>
            (function () {
                var successMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? ""));
                var errorMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString() ?? ""));
                
                // Do not show duplicate popup on ForgotPassword page as it already renders a dedicated success screen
                var isForgotPassword = window.location.pathname.toLowerCase().indexOf('forgotpassword') !== -1;

                if (successMsg && !isForgotPassword) { 
                    Swal.fire({ 
                        icon: 'success', 
                        title: 'تمت العملية بنجاح', 
                        text: successMsg, 
                        timer: 3500, 
                        showConfirmButton: false,
                        background: '#fff' 
                    }); 
                }
                if (errorMsg) { 
                    Swal.fire({ 
                        icon: 'error', 
                        title: 'تنبيه', 
                        text: errorMsg, 
                        background: '#fff' 
                    }); 
                }
 
                // Mobile Menu Toggle
                $('#mobileMenuBtn').on('click', function() {
                    $('#mobileMenu').slideToggle('fast');
                });

                // Profile Dropdown Toggle
                $('#profileDropdownBtn').on('click', function(e) {
                    e.stopPropagation();
                    $('#profileDropdown').toggleClass('hidden');
                });

                $(document).on('click', function(e) {
                    if (!$(e.target).closest('#profileDropdownBtn, #profileDropdown').length) {
                        $('#profileDropdown').addClass('hidden');
                    }
                });
            })();
        </script>

    <!-- Global Modern Professional Custom Dropdown System -->
    <script>
        (function() {
            let $activeDropdown = null;
            let $activeTrigger = null;
            let $activeSelect = null;

            function normalizeArabic(str) {
                if (!str) return '';
                return str.toString()
                    .replace(/[\u064B-\u065F\u0670]/g, '')
                    .replace(/[إأآا]/g, 'ا')
                    .replace(/ى/g, 'ي')
                    .replace(/ة/g, 'ه')
                    .replace(/[\u0660-\u0669]/g, function(d) {
                        return d.charCodeAt(0) - 1632;
                    })
                    .toLowerCase();
            }

            function getOrCreatePortal(targetParent) {
                let $portal = $('#globalCustomDropdownPortal');
                if (!$portal.length) {
                    $portal = $(`
                        <div id="globalCustomDropdownPortal" class="hidden fixed z-[999999] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl p-2.5 transition-all text-slate-800 dark:text-slate-100 font-sans" style="width: 280px; max-width: 90vw;">
                            <div class="relative mb-2">
                                <i class="fas fa-search absolute left-3 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="globalDropdownSearchInput" placeholder="بحث / Search..." class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700/80 rounded-xl pl-8 pr-3 py-1.5 text-xs font-bold outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-slate-800 dark:text-slate-200 placeholder:text-slate-400" autocomplete="off" />
                            </div>
                            <div id="globalDropdownItemsList" class="max-h-60 overflow-y-auto space-y-1 custom-scrollbar pr-0.5">
                                <!-- Dynamically populated items -->
                            </div>
                            <div id="globalDropdownEmptyState" class="hidden py-4 text-center text-xs font-bold text-slate-400">
                                <i class="fas fa-search mr-1"></i> لا توجد نتائج مطابقة
                            </div>
                        </div>
                    `);
                    
                    // Search filtering
                    $portal.on('input', '#globalDropdownSearchInput', function() {
                        const q = normalizeArabic($(this).val().trim());
                        let visibleCount = 0;
                        $portal.find('.dropdown-option-item').each(function() {
                            const text = $(this).data('search-text') || '';
                            const matches = !q || text.includes(q);
                            $(this).toggle(matches);
                            if (matches) visibleCount++;
                        });
                        $('#globalDropdownEmptyState').toggle(visibleCount === 0);
                    });

                    // Item click
                    $portal.on('click', '.dropdown-option-item', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const val = $(this).data('value');
                        const text = $(this).data('text');

                        if ($activeSelect && $activeSelect.length) {
                            $activeSelect.val(val);
                            
                            // Native event dispatch for frameworks
                            if ($activeSelect[0]) {
                                $activeSelect[0].dispatchEvent(new Event('change', { bubbles: true }));
                            }
                            $activeSelect.trigger('change');

                            // Update trigger button label
                            if ($activeTrigger && $activeTrigger.length) {
                                $activeTrigger.find('.trigger-label').text(text);
                            }

                            // If inside ajax-update-form, submit the form
                            const $form = $activeSelect.closest('form.ajax-update-form');
                            if ($form.length) {
                                $form.trigger('submit');
                            }
                        }
                        closeCustomDropdown();
                    });

                    // Keyboard navigation
                    $portal.on('keydown', '#globalDropdownSearchInput', function(e) {
                        const $visibleItems = $portal.find('.dropdown-option-item:visible');
                        if (!$visibleItems.length) return;
                        
                        let $focused = $visibleItems.filter('.keyboard-focus');
                        if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            if (!$focused.length || $focused.is($visibleItems.last())) {
                                $visibleItems.removeClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800');
                                $visibleItems.first().addClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800')[0].scrollIntoView({ block: 'nearest' });
                            } else {
                                const next = $visibleItems.eq($visibleItems.index($focused) + 1);
                                $visibleItems.removeClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800');
                                next.addClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800')[0].scrollIntoView({ block: 'nearest' });
                            }
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            if (!$focused.length || $focused.is($visibleItems.first())) {
                                $visibleItems.removeClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800');
                                $visibleItems.last().addClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800')[0].scrollIntoView({ block: 'nearest' });
                            } else {
                                const prev = $visibleItems.eq($visibleItems.index($focused) - 1);
                                $visibleItems.removeClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800');
                                prev.addClass('keyboard-focus bg-brand-50/50 dark:bg-slate-800')[0].scrollIntoView({ block: 'nearest' });
                            }
                        } else if (e.key === 'Enter') {
                            e.preventDefault();
                            if ($focused.length) {
                                $focused.trigger('click');
                            } else if ($visibleItems.length === 1) {
                                $visibleItems.first().trigger('click');
                            }
                        }
                    });

                    // Outside click to close
                    $(document).on('mousedown pointerdown', function(e) {
                        if ($portal.is(':visible')) {
                            if (!$(e.target).closest('#globalCustomDropdownPortal').length && !$(e.target).closest('.custom-select-trigger').length) {
                                closeCustomDropdown();
                            }
                        }
                    });

                    // Escape to close
                    $(document).on('keydown', function(e) {
                        if (e.key === 'Escape' && $portal.is(':visible')) {
                            closeCustomDropdown();
                        }
                    });

                    // Scroll tracking
                    window.addEventListener('scroll', function() {
                        if ($portal.is(':visible') && $activeTrigger) {
                            positionPortal($activeTrigger, $portal);
                        }
                    }, true);

                    // Resize tracking
                    window.addEventListener('resize', function() {
                        if ($portal.is(':visible') && $activeTrigger) {
                            positionPortal($activeTrigger, $portal);
                        }
                    });
                }

                // If inside a SweetAlert modal, append inside modal to preserve focus trap
                const modalContainer = targetParent ? $(targetParent).closest('.swal2-popup')[0] : null;
                const desiredParent = modalContainer || document.body;
                if ($portal.parent()[0] !== desiredParent) {
                    $portal.appendTo(desiredParent);
                }

                return $portal;
            }

            function positionPortal($trigger, $portal) {
                if (!$trigger || !$trigger.length || !document.body.contains($trigger[0])) {
                    closeCustomDropdown();
                    return;
                }
                const rect = $trigger[0].getBoundingClientRect();
                const portalWidth = Math.min(380, Math.max(rect.width, 260));
                $portal.css('width', portalWidth + 'px');

                let left = rect.left;
                if (left + portalWidth > window.innerWidth - 12) {
                    left = Math.max(12, window.innerWidth - portalWidth - 12);
                }
                if (left < 12) left = 12;

                $portal.removeClass('hidden');
                const portalHeight = $portal.outerHeight() || 280;

                let top = rect.bottom + 6;
                if (top + portalHeight > window.innerHeight - 10 && rect.top > portalHeight + 10) {
                    top = rect.top - portalHeight - 6;
                }

                $portal.css({
                    top: Math.round(top) + 'px',
                    left: Math.round(left) + 'px'
                });
            }

            function openCustomDropdown($select, $trigger) {
                if (!$select || !$select.length || !$trigger || !$trigger.length) return;
                
                // If this same trigger is already active and portal visible, close it
                if ($activeTrigger && $activeTrigger[0] === $trigger[0] && $('#globalCustomDropdownPortal').is(':visible')) {
                    closeCustomDropdown();
                    return;
                }

                closeCustomDropdown();

                const $portal = getOrCreatePortal($trigger[0]);
                $activeDropdown = $portal;
                $activeTrigger = $trigger;
                $activeSelect = $select;

                // Animate chevron
                $trigger.find('.fa-chevron-down').addClass('rotate-180 text-brand-500');

                $('#globalDropdownSearchInput').val('');
                $('#globalDropdownEmptyState').addClass('hidden');

                const currentVal = String($select.val() || '');
                const $itemsList = $('#globalDropdownItemsList');
                $itemsList.empty();

                $select.find('option').each(function() {
                    const optVal = $(this).val();
                    const optText = $(this).text().trim();
                    const isSelected = String(optVal) === currentVal;
                    const normalizedText = normalizeArabic(optText);

                    let selectedClass = isSelected 
                        ? 'bg-brand-50 text-brand-700 dark:bg-brand-950/60 dark:text-brand-300 font-extrabold border-brand-200 dark:border-brand-800' 
                        : 'border-transparent hover:bg-slate-100 dark:hover:bg-slate-800/80 text-slate-700 dark:text-slate-200';

                    const $item = $(`
                        <div class="dropdown-option-item flex items-center justify-between p-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer select-none mb-1 ${selectedClass}"
                             data-value="${optVal}"
                             data-text="${optText.replace(/"/g, '&quot;')}"
                             data-search-text="${normalizedText}">
                            <span class="truncate flex-1">${optText}</span>
                            ${isSelected ? '<i class="fas fa-check text-brand-600 dark:text-brand-400 text-xs shrink-0 ml-2"></i>' : ''}
                        </div>
                    `);
                    $itemsList.append($item);
                });

                positionPortal($trigger, $portal);

                setTimeout(() => {
                    $('#globalDropdownSearchInput').focus();
                }, 40);
            }

            function closeCustomDropdown() {
                const $portal = $('#globalCustomDropdownPortal');
                if ($portal.length) {
                    $portal.addClass('hidden');
                }
                if ($activeTrigger && $activeTrigger.length) {
                    $activeTrigger.find('.fa-chevron-down').removeClass('rotate-180 text-brand-500');
                }
                $activeDropdown = null;
                $activeTrigger = null;
                $activeSelect = null;
            }

            window.enhanceSelectToProfessional = function($select, customBtnClasses) {
                if (!$select || !$select.length) return;
                
                let $trigger = $select.siblings('.custom-select-trigger');
                const selectedOpt = $select.find('option:selected');
                const selectedText = selectedOpt.length ? selectedOpt.text().trim() : ($select.find('option').first().text().trim() || '-- Select --');

                if ($trigger.length) {
                    $trigger.find('.trigger-label').text(selectedText);
                    return;
                }

                $select.addClass('hidden');

                let btnClasses = customBtnClasses || 'w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 py-2.5 px-3.5 rounded-xl text-xs font-bold';
                const isDisabled = $select.prop('disabled');
                const disabledClasses = isDisabled ? 'opacity-60 cursor-not-allowed pointer-events-none' : 'cursor-pointer hover:border-brand-500';

                $trigger = $(`
                    <button type="button" class="custom-select-trigger group flex items-center justify-between gap-2 shadow-2xs transition-all outline-none select-none ${btnClasses} ${disabledClasses}">
                        <span class="trigger-label truncate text-left rtl:text-right flex-1">${selectedText}</span>
                        <i class="fas fa-chevron-down text-[10px] text-slate-400 group-hover:text-brand-500 transition-transform shrink-0"></i>
                    </button>
                `);

                $select.after($trigger);
            };

            // Global Delegated Click Handler for all custom-select-triggers
            $(document).on('click', '.custom-select-trigger', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const $trigger = $(this);
                const $select = $trigger.siblings('select').length ? $trigger.siblings('select') : $trigger.parent().find('select');
                if (!$select.length) return;
                if ($select.prop('disabled')) return;
                openCustomDropdown($select, $trigger);
            });

            window.openCustomDropdown = openCustomDropdown;
            window.closeCustomDropdown = closeCustomDropdown;
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




