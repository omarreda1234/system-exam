            btn.title = "حذف قالب محفوظ أو استعراض القوالب للحذف";
        };

        window.loadCompanyInjectionRules = async function (companyId) {
            const select = document.getElementById('injectionRuleSelect');
            if (!select) return;
            try {
                const res = await fetch(`/Attendance/GetCompanyInjectionRules?companyId=${companyId || 0}`);
                const data = await res.json();
                if (data.success && data.data) {
                    injectionState.savedRules = data.data;
                    const prevVal = select.value;
                    select.innerHTML = '<option value="">-- Select Saved Rule Preset --</option>' +
                        data.data.map(r => `<option value="${r.id}">${r.ruleName}</option>`).join('');
                    if (prevVal && data.data.some(r => r.id == prevVal)) {
                        select.value = prevVal;
                    }
                }
            } catch (err) {
                console.error('Failed to load rules:', err);
            }
            if (typeof updateDeleteRuleButtonState === 'function') updateDeleteRuleButtonState();
        };

        window.applySelectedInjectionRule = function () {
            const select = document.getElementById('injectionRuleSelect');
            const ruleId = parseInt(select.value);
            if (typeof updateDeleteRuleButtonState === 'function') updateDeleteRuleButtonState();

            if (!ruleId) {
                return;
            }

            const rule = injectionState.savedRules.find(r => r.id === ruleId);
            if (!rule) return;

            try {
                const ruleData = typeof rule.departmentQuotasJson === 'string' ? JSON.parse(rule.departmentQuotasJson) : rule.departmentQuotasJson;

                const pharmInput = document.getElementById('inputQuotaPharmacist');
                const assistInput = document.getElementById('inputQuotaAssistant');
                if (pharmInput) pharmInput.value = 0;
                if (assistInput) assistInput.value = 0;
                document.querySelectorAll('.dept-quota-input').forEach(input => input.value = '');

                let hasBranchQuotas = false;
                let hasDeptQuotas = false;

                if (ruleData) {
                    // 1. Branch Staff Quotas
                    if (ruleData.pharmacistQuota !== undefined || ruleData.assistantQuota !== undefined) {
                        const pVal = ruleData.pharmacistQuota || 0;
                        const aVal = ruleData.assistantQuota || 0;
                        if (pharmInput) pharmInput.value = pVal;
                        if (assistInput) assistInput.value = aVal;
                        if (pVal > 0 || aVal > 0) hasBranchQuotas = true;
                    }

                    // 2. Department Quotas
                    const quotas = Array.isArray(ruleData) ? ruleData : (ruleData.departmentQuotas || []);
                    quotas.forEach(q => {
                        const input = document.querySelector(`.dept-quota-input[data-dept-id="${q.departmentId || q.DepartmentId}"]`);
                        if (input) {
                            const val = q.quota || q.Quota || 0;
                            input.value = val;
                            if (val > 0) hasDeptQuotas = true;
                        }
                    });

                    // 3. Branches & Shifts Filters
                    injectionState.selectedBranchIds = ruleData.branchIds || [];
                    injectionState.selectedShiftIds = ruleData.shiftIds || [];
                    renderInjectionBranches();
                    renderInjectionShifts();
                    updateBranchFilterUI();
                    updateShiftFilterUI();
                    fetchLiveAvailableStaffCounts();
                }

                if (hasBranchQuotas && hasDeptQuotas) {
                    switchInjectionMode('combined');
                } else if (hasDeptQuotas) {
                    switchInjectionMode('departments');
                } else {
                    switchInjectionMode('branchStaff');
                }

                updateInjectionHeadcount();
                showAppToast('info', 'Rule Applied', `تم تطبيق قالب: ${rule.ruleName}`);
            } catch (err) {
                showAppToast('error', 'Error', 'Failed to read rule data.');
            }
        };

        window.promptSaveCurrentInjectionRule = async function () {
            const pharmQuota = parseInt(document.getElementById('inputQuotaPharmacist')?.value) || 0;
            const assistQuota = parseInt(document.getElementById('inputQuotaAssistant')?.value) || 0;

            const quotas = [];
            document.querySelectorAll('.dept-quota-input').forEach(input => {
                const val = parseInt(input.value) || 0;
                if (val > 0) {
                    quotas.push({
                        departmentId: parseInt(input.dataset.deptId),
                        departmentName: input.dataset.deptName,
                        quota: val
                    });
