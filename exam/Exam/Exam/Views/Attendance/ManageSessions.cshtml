        window.updateDeleteRuleButtonState = function () {
            const select = document.getElementById('injectionRuleSelect');
            const btn = document.getElementById('btnDeleteSelectedRule');
            const btnText = document.getElementById('btnDeleteSelectedRuleText');
            if (!btn) return;

            btn.classList.remove('hidden');

            const ruleId = select ? parseInt(select.value) : 0;
            if (ruleId && injectionState.savedRules) {
                const rule = injectionState.savedRules.find(r => r.id === ruleId);
                if (rule) {
                    btn.className = "px-3.5 py-2.5 bg-rose-600 hover:bg-rose-700 border border-rose-600 text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0 cursor-pointer";
