@model IEnumerable<dynamic>
@{
    var wave = ViewBag.Wave;
    var company = ViewBag.Company;
    bool isCompany = ViewBag.IsCompany == true;
    
    var title = isCompany ? company.Name : wave.WaveName;
    var subtitle = isCompany ? "Company Training Sessions" : "Wave Training Sessions";
    ViewData["Title"] = $"Manage Sessions - {title}";
}

<div class="min-h-screen bg-slate-50/50 dark:bg-slate-950/20 pb-20">
    <!-- Header -->
    <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-24 pb-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
                    <a href="@Url.Action("Index")" class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-400 hover:text-brand-600 hover:bg-brand-50 transition-all shrink-0">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase">@title</h1>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mt-1">@subtitle</p>
                    </div>
                </div>
                
                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    @if (!User.IsInRole("Reception"))
                    {
                        <a href="@Url.Action("ExportAttendance", new { waveId = isCompany ? null : (int?)wave.Id, companyId = isCompany ? (int?)company.Id : null })" class="flex-1 md:flex-none justify-center bg-emerald-600 text-white px-8 py-4 md:py-3 rounded-2xl transition-all text-xs font-black uppercase shadow-lg shadow-emerald-600/20 hover:bg-emerald-700 flex items-center gap-3">
                            <i class="fas fa-file-excel"></i> Export Attendance Report
                        </a>
                        <button onclick="$('#addSessionModal').removeClass('hidden').addClass('flex')" class="flex-1 md:flex-none justify-center bg-brand-600 text-white px-8 py-4 md:py-3 rounded-2xl transition-all text-xs font-black uppercase shadow-lg shadow-brand-600/20 hover:bg-brand-700 flex items-center gap-3">
                            <i class="fas fa-plus"></i> Add New Session
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions List -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-8">
        <div class="grid grid-cols-1 gap-4">
            @foreach (var session in Model)
            {
                <div class="saas-card flex flex-col sm:flex-row sm:items-center justify-between gap-6 group hover:border-brand-500/30 transition-all">
                    <div class="flex items-center gap-4 sm:gap-6">
                        <div class="w-14 h-14 sm:w-16 sm:h-16 bg-slate-50 dark:bg-slate-800 rounded-2xl flex flex-col items-center justify-center border border-slate-100 dark:border-slate-800 shrink-0">
                            <span class="text-[9px] sm:text-[10px] font-black text-brand-600 uppercase">@session.SessionDate.ToString("MMM")</span>
                            <span class="text-lg sm:text-xl font-black text-slate-900 dark:text-white">@session.SessionDate.ToString("dd")</span>
                        </div>
                        <div>
                            <h3 class="font-black text-slate-900 dark:text-white uppercase text-xs sm:text-sm">@session.SessionName</h3>
                            <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-1">
                                <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                                    <i class="far fa-clock text-brand-500"></i> @session.SessionDate.ToString("dddd")
                                    @if (session.StartTime != null && session.EndTime != null)
                                    {
                                        <span class="text-slate-600 dark:text-slate-300 font-extrabold bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-lg border border-slate-200 dark:border-slate-700">
                                            @(((TimeSpan)session.StartTime).ToString(@"hh\:mm")) - @(((TimeSpan)session.EndTime).ToString(@"hh\:mm"))
                                        </span>
                                    }
                                </span>
                                @if (isCompany)
                                {
                                    var specificAssigned = session.SpecificAssignedCount != null ? (int)session.SpecificAssignedCount : 0;
                                    var totalPool = session.TotalTraineesCount != null ? (int)session.TotalTraineesCount : 0;
                                    int enrolledCount = specificAssigned > 0 ? specificAssigned : totalPool;
                                    int present = Convert.ToInt32(session.PresentCount);
                                    int pendingCount = 0;
                                    try { pendingCount = session.PendingAssignedCount != null ? Convert.ToInt32(session.PendingAssignedCount) : 0; } catch {}

                                    if (specificAssigned > 0 || pendingCount > 0)
                                    {
                                        <span id="session-badge-@session.Id" class="text-[9px] sm:text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest bg-indigo-50 dark:bg-indigo-950/40 px-2.5 py-0.5 rounded-full border border-indigo-200 dark:border-indigo-800" title="المتدربين المسجلين في هذه الجلسة">
                                            <i class="fas fa-users mr-1"></i> @specificAssigned Session Trainees @(pendingCount > 0 ? $"({pendingCount} معلق)" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span id="session-badge-@session.Id" class="text-[9px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 rounded-full" title="متدربي الشركة بالكامل">
                                            <i class="fas fa-building mr-1"></i> Company Pool (@totalPool)
                                        </span>
                                    }

                                    if (present > 0)
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest bg-emerald-50 dark:bg-emerald-950/30 px-2.5 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800" title="عدد الحاضرين المسجلين في شيت الغياب">
                                            <i class="fas fa-user-check mr-1"></i> الحضور الفعلي: @present من @enrolledCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-slate-100/70 dark:bg-slate-800/50 px-2.5 py-0.5 rounded-full border border-slate-200/50 dark:border-slate-700/50" title="لم يتم تسجيل حضور للسيشن بعد في شيت الغياب">
                                            <i class="far fa-clock mr-1"></i> لم يسجل حضور بعد (0 من @enrolledCount)
                                        </span>
                                    }
                                }
                                else
                                {
                                    int present = Convert.ToInt32(session.PresentCount);
                                    if (present > 0)
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest bg-emerald-50 dark:bg-emerald-950/20 px-2.5 py-0.5 rounded-full border border-emerald-200/60">
                                            <i class="fas fa-user-check mr-1"></i> @present Trainees Attended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-slate-100 dark:bg-slate-800/60 px-2.5 py-0.5 rounded-full">
                                            <i class="far fa-clock mr-1"></i> 0 Attended (لم يسجل حضور)
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2 border-t sm:border-t-0 pt-4 sm:pt-0 border-slate-100 dark:border-slate-800">
                        @if (isCompany)
                        {
                            <button onclick="openManageSessionTrainees(@session.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(session.SessionName))', @(company?.Id ?? 0))" 
                                    class="flex-1 sm:flex-none text-center bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 sm:py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5" 
                                    title="تعيين متدربي السيشن وتفعيل إشعارات n8n">
                                <i class="fas fa-users-cog"></i> Manage Trainees
                            </button>
                        }
                        <a href="@Url.Action("TakeAttendance", new { sessionId = session.Id })" class="flex-1 sm:flex-none text-center bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white px-6 py-3 sm:py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-600 transition-all">
                            Take Attendance
                        </a>
                        <a href="@Url.Action("ExportSessionAttendance", new { sessionId = session.Id })" class="flex-1 sm:flex-none text-center bg-emerald-50 hover:bg-emerald-600 text-emerald-600 hover:text-white px-5 py-3 sm:py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest border border-emerald-100 dark:border-emerald-950/30 transition-all flex items-center justify-center gap-1.5" title="Export Excel">
                            <i class="fas fa-file-excel"></i> Export Excel
                        </a>
                        @if (!User.IsInRole("Reception"))
                        {
                            <button onclick="editSession(@session.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(session.SessionName))', '@session.SessionDate.ToString("yyyy-MM-dd")', '@(session.StartTime != null ? ((TimeSpan)session.StartTime).ToString(@"hh\:mm") : "09:00")', '@(session.EndTime != null ? ((TimeSpan)session.EndTime).ToString(@"hh\:mm") : "12:00")')" class="w-12 h-12 sm:w-10 sm:h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center hover:bg-amber-500 hover:text-white transition-all border border-amber-100 dark:border-amber-950/30" title="تعديل وقت وتاريخ المحاضرة (Edit Session)">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                            <button onclick="deleteSession(@session.Id)" class="w-12 h-12 sm:w-10 sm:h-10 bg-rose-50 text-rose-500 rounded-xl flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all border border-rose-100 dark:border-rose-950/30" title="Delete Session">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="bg-white dark:bg-slate-900 rounded-[32px] p-20 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 shadow-sm">
                    <p class="text-slate-400 font-bold uppercase text-[10px] tracking-widest">No sessions defined for this training ciclo yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal -->
<div id="addSessionModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-6">
    <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-[32px] p-8 shadow-2xl border border-slate-200 dark:border-slate-800">
        <div class="flex justify-between items-center mb-8">
            <h3 class="text-xl font-black text-slate-900 dark:text-white uppercase">New Session</h3>
            <button onclick="$('#addSessionModal').addClass('hidden').removeClass('flex')" class="text-slate-400 hover:text-rose-500 transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <form asp-action="CreateSession" method="post" class="space-y-5">
            @if (isCompany)
            {
                <input type="hidden" name="companyId" value="@company.Id" />
            }
            else
            {
                <input type="hidden" name="waveId" value="@wave.Id" />
            }
            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Session Date / تاريخ المحاضرة</label>
                <input type="text" id="sessionDatePicker" name="sessionDate" placeholder="dd/mm/yyyy" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Start Time / وقت البداية</label>
                    <input type="time" name="startTime" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-4 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">End Time / وقت النهاية</label>
                    <input type="time" name="endTime" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-4 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
                </div>
            </div>

            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Session Name / Label</label>
                <input type="text" name="sessionName" placeholder="e.g. Day 1: Product Intro" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
            </div>
            <button type="submit" class="w-full bg-brand-600 text-white py-4 rounded-2xl font-black uppercase text-xs tracking-widest shadow-lg shadow-brand-600/20 hover:bg-brand-700 transition-all mt-4">
                Confirm & Create
            </button>
        </form>
    </div>
</div>

@if (isCompany)
{
    <!-- Modal: Manage Session Trainees (Assignment per Session) -->
    <div id="sessionTraineesModal" class="hidden fixed inset-0 z-[105] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
        <div class="bg-white dark:bg-slate-900 rounded-[32px] shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden">
            <!-- Modal Header -->
            <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/60 dark:bg-slate-800/40">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl shadow-sm">
                        <i class="fas fa-users-cog"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white uppercase" id="modalSessionTitle">Manage Session Trainees</h3>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400 uppercase border border-indigo-200 dark:border-indigo-800">Session Level</span>
                        </div>
                        <p class="text-xs text-slate-400 font-medium mt-0.5">تحديد متدربي هذه السيشن وتفعيل إشعارات المنصة وإرسال الإيميلات عبر n8n API</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="btnRefreshSessionTrainees" onclick="refreshCurrentSessionTrainees()" class="px-3.5 py-1.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 text-indigo-600 dark:text-indigo-400 font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm active:scale-95" title="تحديث قائمة المتدربين فورياً">
                        <i class="fas fa-sync-alt" id="iconRefreshSessionTrainees"></i>
                        <span>تحديث</span>
                    </button>
                    <button type="button" onclick="closeManageSessionTrainees()" class="w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                        <i class="fas fa-times text-base"></i>
                    </button>
                </div>
            </div>

            <!-- Tabs -->
            <div class="flex border-b border-slate-100 dark:border-slate-800 px-6 pt-3 bg-white dark:bg-slate-900 gap-2">
                <button type="button" onclick="switchTraineesTab('current')" id="tabBtnCurrent" class="pb-3 px-4 text-xs font-black uppercase tracking-wider text-indigo-600 border-b-2 border-indigo-600 flex items-center gap-2 transition-all">
                    <i class="fas fa-user-check"></i> المتدربين المعينين (<span id="assignedCountBadge">0</span>)
                </button>
                <button type="button" onclick="switchTraineesTab('assign')" id="tabBtnAssign" class="pb-3 px-4 text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 border-b-2 border-transparent flex items-center gap-2 transition-all">
                    <i class="fas fa-user-plus"></i> تعيين متدربين للسيشن
                </button>
                <button type="button" onclick="switchTraineesTab('excel')" id="tabBtnExcel" class="pb-3 px-4 text-xs font-black uppercase tracking-wider text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 border-b-2 border-transparent flex items-center gap-2 transition-all">
                    <i class="fas fa-file-excel"></i> استيراد شيت إكسيل للسيشن
                </button>
            </div>

            <!-- Modal Content Area -->
            <div class="p-6 overflow-y-auto flex-1 custom-scrollbar">
                <input type="hidden" id="currentSessionId" />

                <!-- Tab 1: Current Assigned -->
                <div id="tabContentCurrent" class="space-y-4">
                    <div id="assignedTraineesList" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Tab 2: Assign from Pool / Search -->
                <div id="tabContentAssign" class="hidden space-y-4">
                    <div class="space-y-2.5 bg-slate-50 dark:bg-slate-800/40 p-4 rounded-2xl border border-slate-100 dark:border-slate-800">
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                            <div class="relative w-full flex-1">
                                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="traineeSearchInput" onkeyup="filterTraineePool()" placeholder="ابحث بالاسم أو كود الموظف، أو الصق عدة أكواد مفصولة بـ ( , ) أو ( | ) مثل: 5061, 5063, 5065..." class="w-full pl-10 pr-10 py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold outline-none focus:border-indigo-500 text-slate-900 dark:text-white transition-all shadow-inner" autocomplete="off" />
                                <div id="searchSpinner" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-indigo-500">
                                    <i class="fas fa-spinner fa-spin text-sm"></i>
                                </div>
                            </div>
                            <div class="flex items-center gap-2.5 shrink-0">
                                <button type="button" onclick="clearSearchInput()" class="px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white text-xs font-bold transition-all flex items-center gap-1.5">
                                    <i class="fas fa-times text-[10px]"></i> مسح
                                </button>
                                <span id="selectedPoolCount" class="text-xs font-mono font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40 px-3.5 py-2 rounded-xl border border-indigo-200/50 dark:border-indigo-900/50">0 محدد</span>
                            </div>
                        </div>
                        <p class="text-[11px] text-slate-400 font-bold flex items-center gap-1.5 pt-0.5">
                            <i class="fas fa-lightbulb text-amber-500 text-xs"></i>
                            <span>بحث فردي أو جماعي: اكتب الاسم أو الكود، أو الصق عدة أكواد مفصولة بـ <strong>( , )</strong> أو <strong>( | )</strong> للتعيين الجماعي المباشر.</span>
                        </p>
                    </div>

                    <!-- Selected Candidates Queue Tray -->
                    <div id="selectedTrayContainer" class="hidden p-3.5 bg-indigo-50/50 dark:bg-indigo-950/20 border border-indigo-100 dark:border-indigo-900/40 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-indigo-900 dark:text-indigo-300 flex items-center gap-1.5">
                                <i class="fas fa-user-check text-indigo-600"></i>
                                المتدربين المحددين للتعيين (<span id="trayCount" class="font-mono">0</span>)
                            </span>
                            <button type="button" onclick="clearAllSelected()" class="text-[11px] font-bold text-rose-500 hover:underline">
                                مسح الكل
                            </button>
                        </div>
                        <div id="selectedChipsList" class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto custom-scrollbar p-0.5">
                            <!-- Populated via JS -->
                        </div>
                    </div>

                    <!-- Options for Notification, n8n Email & Branch Exemption -->
                    <div class="p-4 bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-800/60 rounded-2xl space-y-2.5">
                        <label class="flex items-center gap-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 cursor-pointer">
                            <input type="checkbox" id="chkSendNotification" checked class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500" />
                            <span>🔔 إرسال إشعار فوري للمتدربين على المنصة (In-App Notification)</span>
                        </label>
                        <label class="flex items-center gap-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 cursor-pointer">
                            <input type="checkbox" id="chkSendN8nEmail" checked class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500" />
                            <span>⚡ إرسال بيانات المتدربين والسيشن إلى <strong>n8n Webhook API</strong> لإرسال الإيميلات والأتمتة</span>
                        </label>
                        <label class="flex items-center gap-2.5 text-xs font-bold text-amber-700 dark:text-amber-300 cursor-pointer pt-2 border-t border-emerald-200/60 dark:border-emerald-800/60">
                            <input type="checkbox" id="chkBypassApproval" class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500" />
                            <span>⚡ <strong>اعتماد فوري واستثنائي (Bypass Approval):</strong> تأكيد ترشيح المتدربين فوراً بدون انتظار موافقة مدير الفرع</span>
                        </label>
                    </div>

                    <!-- Search Results Header & Quick Selection -->
                    <div id="searchResultsHeader" class="hidden flex items-center justify-between px-2 pt-1">
                        <span id="searchResultCountText" class="text-xs font-black text-slate-600 dark:text-slate-300"></span>
                        <button type="button" id="btnSelectAllSearchResults" onclick="toggleSelectAllSearchResults()" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1">
                            <i class="fas fa-check-double text-[11px]"></i> <span>تحديد كل نتائج البحث</span>
                        </button>
                    </div>

                    <div id="traineePoolList" class="max-h-80 overflow-y-auto space-y-1.5 custom-scrollbar pr-1">
                        <!-- Rendered by JS like Trainee 360 -->
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="button" onclick="saveTraineesAssignment()" class="px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-2">
                            <i class="fas fa-check"></i> حفظ تعيين المتدربين للسيشن
                        </button>
                    </div>
                </div>

                <!-- Tab 3: Excel Direct Import -->
                <div id="tabContentExcel" class="hidden space-y-5">
                    <div class="p-6 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-2xl text-center bg-slate-50/50 dark:bg-slate-800/20">
                        <i class="fas fa-file-excel text-4xl text-emerald-500 mb-3 block"></i>
                        <h4 class="text-sm font-black text-slate-800 dark:text-white">رفع شيت إكسيل لمتدربي هذه السيشن مباشرة</h4>
                        <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">
                            الأعمدة المطلوبة: FullName, UserCode, JobTitle, BranchName, Email, Phone.
                            سيتم ربطهم بهذه السيشن تلقائياً وإرسال بياناتهم إلى n8n API.
                        </p>
                        <input type="file" id="sessionExcelFile" accept=".xlsx, .xls" class="mt-4 text-xs font-bold text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-black file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer" />
                        
                        <div class="mt-4 flex items-center justify-center">
                            <label class="flex items-center gap-2.5 text-xs font-bold text-amber-700 dark:text-amber-300 cursor-pointer bg-amber-500/10 border border-amber-500/30 px-4 py-2.5 rounded-xl">
                                <input type="checkbox" id="chkExcelBypassApproval" class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500" />
                                <span>⚡ اعتماد فوري لمتدربي الشيت وتخطي موافقة مدير الفرع (Direct Confirm)</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex justify-end">
                        <button type="button" onclick="uploadSessionExcelDirect()" class="px-6 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-2">
                            <i class="fas fa-cloud-upload-alt"></i> رفع وتسكين المتدربين في السيشن
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- Flatpickr CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        $(function() {
            flatpickr("#sessionDatePicker", {
                altInput: true,
                altFormat: "d/m/Y",
                dateFormat: "Y-m-d",
                altInputClass: "w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white"
            });
        });

        async function editSession(id, currentName, currentDate, currentStart, currentEnd) {
            const { value: formValues } = await Swal.fire({
                title: '<div class="text-base font-black uppercase text-slate-800 dark:text-white">تعديل المحاضرة / الجلسة (Edit Session)</div>',
                html: `
                    <div class="text-right space-y-4" dir="rtl">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">مسمى المحاضرة / Label:</label>
                            <input id="sw-edit-name" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentName || ''}" placeholder="e.g. Session 1">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">تاريخ المحاضرة (Date):</label>
                            <input id="sw-edit-date" type="date" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentDate}">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">وقت البداية (Start):</label>
                                <input id="sw-edit-start" type="time" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentStart}">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">وقت النهاية (End):</label>
                                <input id="sw-edit-end" type="time" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentEnd}">
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'حفظ التعديلات',
                cancelButtonText: 'إلغاء',
                customClass: {
                    popup: 'rounded-[28px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                    confirmButton: 'bg-brand-600 hover:bg-brand-700 text-white px-6 py-2.5 rounded-xl font-bold text-xs uppercase shadow-md mr-2',
                    cancelButton: 'bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-500 font-bold text-xs px-6 py-2.5 rounded-xl'
                },
                buttonsStyling: false,
                preConfirm: () => {
                    const name = document.getElementById('sw-edit-name').value;
                    const date = document.getElementById('sw-edit-date').value;
                    const start = document.getElementById('sw-edit-start').value;
                    const end = document.getElementById('sw-edit-end').value;
                    if (!name || !name.trim()) {
                        Swal.showValidationMessage('اسم المحاضرة مطلوب');
                        return false;
                    }
                    if (!date) {
                        Swal.showValidationMessage('تاريخ المحاضرة مطلوب');
                        return false;
                    }
                    return { name: name.trim(), date, start, end };
                }
            });

            if (formValues) {
                Swal.showLoading();
                try {
                    const fd = new FormData();
                    fd.append('sessionId', id);
                    fd.append('sessionName', formValues.name);
                    fd.append('sessionDate', formValues.date);
                    if (formValues.start) fd.append('startTime', formValues.start);
                    if (formValues.end) fd.append('endTime', formValues.end);

                    const res = await fetch('@Url.Action("UpdateSession")', {
                        method: 'POST',
                        body: fd
                    });
                    const json = await res.json();
                    if (json.success) {
                        location.reload();
                    } else {
                        Swal.fire('خطأ', json.message || 'تعذر تعديل المحاضرة', 'error');
                    }
                } catch(e) {
                    Swal.fire('خطأ', 'حدث خطأ أثناء التواصل مع السيرفر', 'error');
                }
            }
        }

        function deleteSession(id) {
            Swal.fire({
                title: 'Delete Session?',
                text: "All attendance records for this day will be permanently removed.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: 'Yes, Delete it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteSession")', { sessionId: id }, function(res) {
                        if (res.success) {
                            location.reload();
                        }
                    });
                }
            });
        }

        // ==========================================
        // Session Trainees Management Logic (n8n API & In-App Notifications)
        // ==========================================
        let sessionTraineesState = {
            sessionId: 0,
            hasModified: false,
            assignedTrainees: [],
            selectedCandidates: new Map(),
            currentResults: []
        };

        window.showAppToast = function (type, title, message) {
            let container = document.getElementById('appGlobalToastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'appGlobalToastContainer';
                container.className = 'fixed top-5 left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 z-[999999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto transform translate-y-[-16px] opacity-0 transition-all duration-300 ease-out flex items-start gap-3 p-4 rounded-2xl shadow-2xl backdrop-blur-xl border text-xs select-none';

            let iconHtml = '';
            let bgBorder = '';
            let progressBg = '';

            const t = (type || 'info').toLowerCase();
            if (t === 'success') {
                bgBorder = 'bg-slate-900/95 text-emerald-100 border-emerald-500/40 shadow-emerald-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-check-circle"></i></div>';
                progressBg = 'bg-emerald-400';
            } else if (t === 'error' || t === 'danger') {
                bgBorder = 'bg-slate-900/95 text-rose-100 border-rose-500/40 shadow-rose-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-circle"></i></div>';
                progressBg = 'bg-rose-400';
            } else if (t === 'warning') {
                bgBorder = 'bg-slate-900/95 text-amber-100 border-amber-500/40 shadow-amber-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-triangle"></i></div>';
                progressBg = 'bg-amber-400';
            } else {
                bgBorder = 'bg-slate-900/95 text-indigo-100 border-indigo-500/40 shadow-indigo-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-info-circle"></i></div>';
                progressBg = 'bg-indigo-400';
            }

            toast.className += ' ' + bgBorder;
            toast.innerHTML = `
                ${iconHtml}
                <div class="flex-1 min-w-0 pr-1">
                    <h5 class="font-black text-xs text-white leading-snug">${title || ''}</h5>
                    ${message ? `<p class="text-[11px] opacity-80 mt-0.5 leading-normal break-words">${message}</p>` : ''}
                </div>
                <button type="button" class="text-white/40 hover:text-white transition-colors text-xs p-1 shrink-0" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
                <div class="absolute bottom-0 left-0 right-0 h-1 rounded-b-2xl overflow-hidden bg-white/10">
                    <div class="h-full ${progressBg} transition-all ease-linear" style="width: 100%; transition-duration: 3500ms;"></div>
                </div>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-[-16px]', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
                const progressBar = toast.querySelector(`.${progressBg}`);
                if (progressBar) {
                    requestAnimationFrame(() => {
                        progressBar.style.width = '0%';
                    });
                }
            });

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-[-8px]', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        };

        function showToast(icon, title, message) {
            showAppToast(icon, title, message);
        }

        window.refreshCurrentSessionTrainees = async function () {
            const icon = document.getElementById('iconRefreshSessionTrainees');
            if (icon) icon.classList.add('fa-spin');
            if (sessionTraineesState.sessionId) {
                await loadSessionTraineesData(sessionTraineesState.sessionId);
            }
            if (icon) icon.classList.remove('fa-spin');
            showAppToast('info', 'Updated', 'Session trainees and their statuses have been refreshed.');
        };

        window.openManageSessionTrainees = function (sessionId, sessionName, companyId) {
            sessionTraineesState.sessionId = sessionId;
            sessionTraineesState.hasModified = false;
            sessionTraineesState.selectedCandidates.clear();
            sessionTraineesState.currentResults = [];
            document.getElementById('currentSessionId').value = sessionId;
            document.getElementById('modalSessionTitle').textContent = `Manage Trainees - ${sessionName}`;
            document.getElementById('sessionTraineesModal').classList.remove('hidden');
            clearSearchInput();
            updateSelectedUi();
            switchTraineesTab('current');
            loadSessionTraineesData(sessionId);
        };

        window.closeManageSessionTrainees = function () {
            document.getElementById('sessionTraineesModal').classList.add('hidden');
            if (sessionTraineesState.sessionId && sessionTraineesState.assignedTrainees) {
                const sessionBadge = document.getElementById(`session-badge-${sessionTraineesState.sessionId}`);
                if (sessionBadge) {
                    const approvedCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'approved').length;
                    const pendingCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'pending').length;
                    let badgeText = `${approvedCount} Session Trainees`;
                    if (pendingCount > 0) badgeText += ` (${pendingCount} معلق)`;
                    sessionBadge.className = 'text-[9px] sm:text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest bg-indigo-50 dark:bg-indigo-950/40 px-2 py-0.5 rounded-full border border-indigo-200 dark:border-indigo-800';
                    sessionBadge.innerHTML = `<i class="fas fa-users mr-1"></i> ${badgeText}`;
                }
            }
        };

        window.switchTraineesTab = function (tab) {
            const tabs = ['current', 'assign', 'excel'];
            tabs.forEach(t => {
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                const content = document.getElementById('tabContent' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn && content) {
                    if (t === tab) {
                        btn.classList.add('text-indigo-600', 'border-indigo-600');
                        btn.classList.remove('text-slate-400', 'border-transparent');
                        content.classList.remove('hidden');
                    } else {
                        btn.classList.remove('text-indigo-600', 'border-indigo-600');
                        btn.classList.add('text-slate-400', 'border-transparent');
                        content.classList.add('hidden');
                    }
                }
            });
        };

        window.loadSessionTraineesData = async function (sessionId) {
            const listWrapper = document.getElementById('assignedTraineesList');
            const countBadge = document.getElementById('assignedCountBadge');

            listWrapper.innerHTML = `
                <div class="text-center py-10 text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl text-indigo-500 mb-2 block"></i>
                    جاري تحميل متدربي السيشن...
                </div>`;

            try {
                const res = await fetch(`/Attendance/GetSessionTrainees?sessionId=${sessionId}`);
                const data = await res.json();

                if (!data.success) {
                    listWrapper.innerHTML = `<div class="text-center py-6 text-rose-500 font-bold">${data.message}</div>`;
                    return;
                }

                sessionTraineesState.assignedTrainees = data.assignedTrainees || [];
                countBadge.textContent = sessionTraineesState.assignedTrainees.length;

                // Sync badge on outer session card in real-time
                const sessionBadge = document.getElementById(`session-badge-${sessionId}`);
                if (sessionBadge) {
                    const approvedCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'approved').length;
                    const pendingCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'pending').length;
                    if (approvedCount > 0 || pendingCount > 0) {
                        let badgeText = `${approvedCount} Session Trainees`;
                        if (pendingCount > 0) badgeText += ` (${pendingCount} معلق)`;
                        sessionBadge.className = 'text-[9px] sm:text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest bg-indigo-50 dark:bg-indigo-950/40 px-2 py-0.5 rounded-full border border-indigo-200 dark:border-indigo-800';
                        sessionBadge.innerHTML = `<i class="fas fa-users mr-1"></i> ${badgeText}`;
                    }
                }

                // 1. Render Current Assigned Trainees with Approval Badges
                if (sessionTraineesState.assignedTrainees.length === 0) {
                    listWrapper.innerHTML = `
                        <div class="p-8 text-center bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800">
                            <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/40 text-amber-500 flex items-center justify-center mx-auto mb-3 text-xl">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <h4 class="text-xs font-black uppercase text-slate-800 dark:text-white">لم يتم تخصيص متدربين محددين لهذه السيشن بعد</h4>
                            <p class="text-[11px] text-slate-400 mt-1 max-w-md mx-auto">
                                يمكنك البحث عن موظفين أو متدربين وتسكينهم في هذه السيشن مباشرة عبر تبويب "تعيين متدربين للسيشن" أو رفع شيت إكسيل.
                            </p>
                            <button type="button" onclick="switchTraineesTab('assign')" class="mt-4 px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700 transition-all">
                                <i class="fas fa-user-plus mr-1"></i> تخصيص متدربين للسيشن الآن
                            </button>
                        </div>`;
                } else {
                    listWrapper.innerHTML = sessionTraineesState.assignedTrainees.map(t => {
                        const traineeId = t.traineeId || t.TraineeId || t.id || t.Id;
                        const fullName = t.fullName || t.FullName || 'Trainee';
                        const userCode = t.userCode || t.UserCode || '--';
                        const branchName = t.branchName || t.BranchName || 'عام';
                        const jobTitle = t.jobTitle || t.JobTitle || 'Trainee';
                        const status = (t.approvalStatus || t.ApprovalStatus || 'Approved').toLowerCase();
                        let badgeHtml = '';
                        if (status === 'approved') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 flex items-center gap-1"><i class="fas fa-check-circle"></i> معتمد (Approved)</span>`;
                        } else if (status === 'pending') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800 flex items-center gap-1"><i class="fas fa-clock"></i> معلق بانتظار الفرع (Pending)</span>`;
                        } else if (status === 'rejected') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800 flex items-center gap-1" title="سبب الرفض: ${t.rejectionReason || t.RejectionReason || 'بدون سبب'}"><i class="fas fa-times-circle"></i> تم الاعتذار: ${t.rejectionReason || t.RejectionReason || 'بدون سبب'}</span>`;
                        } else if (status === 'replaced') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 flex items-center gap-1"><i class="fas fa-exchange-alt"></i> تم الاستبدال (Replaced)</span>`;
                        }

                        return `
                        <div class="p-3.5 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-indigo-100 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 font-black flex items-center justify-center text-xs">
                                    ${(fullName || 'T')[0]}
                                </div>
                                <div>
                                    <h4 class="text-xs font-black text-slate-800 dark:text-white leading-tight">${fullName}</h4>
                                    <p class="text-[10px] text-slate-400 font-mono mt-0.5">الكود: ${userCode} | الفرع: ${branchName} | ${jobTitle}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                ${badgeHtml}
                                <button type="button" onclick="removeTraineeFromSession(${sessionId}, ${traineeId}, '${encodeURIComponent(fullName)}')" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white flex items-center justify-center text-xs transition-all" title="إزالة من هذه السيشن">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                    `}).join('');
                }

                renderEmptySearchState();
            } catch (err) {
                listWrapper.innerHTML = `<div class="text-center py-6 text-rose-500 font-bold">فشل جلب البيانات: ${err.message}</div>`;
            }
        };

        window.renderEmptySearchState = function () {
            const poolWrapper = document.getElementById('traineePoolList');
            const header = document.getElementById('searchResultsHeader');
            if (header) header.classList.add('hidden');
            if (!poolWrapper) return;

            poolWrapper.innerHTML = `
                <div class="p-8 text-center bg-slate-50/50 dark:bg-slate-800/20 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-500 flex items-center justify-center mx-auto mb-2 text-xl">
                        <i class="fas fa-id-card-clip"></i>
                    </div>
                    <h4 class="text-xs font-black text-slate-800 dark:text-white">ابحث عن المتدربين لإضافتهم للسيشن</h4>
                    <p class="text-[11px] text-slate-400 mt-1 max-w-sm mx-auto">
                        اكتب كود أو اسم المتدرب، أو الصق عدة أكواد مفصولة بفاصلة <strong>( , )</strong> أو <strong>( | )</strong> للبحث الجماعي الفوري.
                    </p>
                </div>`;
        };

        let searchDebounceTimeout = null;
        window.filterTraineePool = function () {
            const input = document.getElementById('traineeSearchInput');
            const q = input.value.trim();
            clearTimeout(searchDebounceTimeout);

            if (!q) {
                document.getElementById('searchSpinner').classList.add('hidden');
                renderEmptySearchState();
                return;
            }

            document.getElementById('searchSpinner').classList.remove('hidden');

            searchDebounceTimeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/Attendance/SearchSessionCandidates?sessionId=${sessionTraineesState.sessionId}&query=${encodeURIComponent(q)}`);
                    const data = await res.json();
                    document.getElementById('searchSpinner').classList.add('hidden');

                    if (data.success && data.candidates) {
                        sessionTraineesState.currentResults = data.candidates;
                        renderSearchResults(data.candidates, data.isMultiCode);
                    } else {
                        document.getElementById('traineePoolList').innerHTML = `<div class="p-6 text-center text-xs text-rose-500 font-bold">${data.message || 'حدث خطأ في البحث'}</div>`;
                    }
                } catch(err) {
                    document.getElementById('searchSpinner').classList.add('hidden');
                    console.error('Search error:', err);
                }
            }, 250);
        };

        window.renderSearchResults = function (candidates, isMultiCode) {
            const poolWrapper = document.getElementById('traineePoolList');
            const header = document.getElementById('searchResultsHeader');
            const countText = document.getElementById('searchResultCountText');

            if (!candidates || candidates.length === 0) {
                header.classList.add('hidden');
                poolWrapper.innerHTML = `
                    <div class="p-8 text-center bg-slate-50/50 dark:bg-slate-800/20 rounded-2xl border border-slate-100 dark:border-slate-800">
                        <i class="fas fa-user-slash text-2xl text-slate-400 mb-2 block"></i>
                        <h4 class="text-xs font-black text-slate-700 dark:text-slate-300">لم يتم العثور على أي متدرب مطابق</h4>
                        <p class="text-[10px] text-slate-400 mt-1">تأكد من كتابة الأكواد بشكل صحيح أو جرب البحث بالاسم أو الفرع.</p>
                    </div>`;
                return;
            }

            header.classList.remove('hidden');
            countText.textContent = `تم العثور على (${candidates.length}) ${isMultiCode ? 'متدرب مطابق للأكواد' : 'نتيجة مطابقة'}`;

            // If multi-code search, auto-select them all for convenience!
            if (isMultiCode) {
                candidates.forEach(c => {
                    const key = c.candidateKey || c.CandidateKey || (c.companyTraineeId || c.CompanyTraineeId ? `CT_${c.companyTraineeId || c.CompanyTraineeId}` : `U_${c.userId || c.UserId}`);
                    const fn = c.fullName || c.FullName || c.userName || c.UserName || 'Trainee';
                    const cd = c.userCode || c.UserCode || '--';
                    const br = c.branchName || c.BranchName || 'بدون فرع';
                    sessionTraineesState.selectedCandidates.set(key, {
                        key: key,
                        fullName: fn,
                        userCode: cd,
                        branchName: br
                    });
                });
                updateSelectedUi();
            }

            poolWrapper.innerHTML = candidates.map(t => {
                const key = t.candidateKey || t.CandidateKey || (t.companyTraineeId || t.CompanyTraineeId ? `CT_${t.companyTraineeId || t.CompanyTraineeId}` : `U_${t.userId || t.UserId}`);
                const isSelected = sessionTraineesState.selectedCandidates.has(key);
                const isExempt = (t.isBranchExempt == 1 || t.IsBranchExempt == 1 || t.isBranchExempt === true || t.IsBranchExempt === true);
                const fullName = t.fullName || t.FullName || t.userName || t.UserName || 'Trainee';
                const role = t.jobTitle || t.JobTitle || 'Trainee';
                const branch = t.branchName || t.BranchName || 'بدون فرع';
                const code = t.userCode || t.UserCode || '--';

                return `
                    <div onclick="toggleCandidateSelection('${key}', '${encodeURIComponent(fullName)}', '${code}', '${encodeURIComponent(branch)}')" 
                         id="candidate-row-${key}"
                         class="p-3 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer flex items-center justify-between rounded-xl border ${isSelected ? 'border-indigo-500 bg-indigo-50/20 dark:bg-indigo-950/30' : 'border-slate-100 dark:border-slate-800'} transition-all select-none">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-xs shrink-0">
                                <i class="fas fa-user"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs font-black text-slate-900 dark:text-white leading-tight">${fullName}</span>
                                    ${isExempt ? '<span class="px-1.5 py-0.2 rounded text-[8px] font-black bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400 border border-amber-300/50">معفى</span>' : ''}
                                </div>
                                <div class="text-[10px] text-slate-500 dark:text-slate-400 font-bold">${role} - Branch: ${branch}</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[10px] font-black text-indigo-600 dark:text-indigo-400 border border-slate-200/50 dark:border-slate-700/50">Code: ${code}</span>
                            <input type="checkbox" id="chk-${key}" ${isSelected ? 'checked' : ''} class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 pointer-events-none" />
                        </div>
                    </div>
                `;
            }).join('');
        };

        window.toggleCandidateSelection = function (key, encodedName, code, encodedBranch) {
            if (sessionTraineesState.selectedCandidates.has(key)) {
                sessionTraineesState.selectedCandidates.delete(key);
            } else {
                sessionTraineesState.selectedCandidates.set(key, {
                    key: key,
                    fullName: decodeURIComponent(encodedName || ''),
                    userCode: code || '--',
                    branchName: decodeURIComponent(encodedBranch || '')
                });
            }

            const row = document.getElementById(`candidate-row-${key}`);
            const chk = document.getElementById(`chk-${key}`);
            const isSelected = sessionTraineesState.selectedCandidates.has(key);
            if (row) {
                if (isSelected) {
                    row.classList.add('border-indigo-500', 'bg-indigo-50/20', 'dark:bg-indigo-950/30');
                    row.classList.remove('border-slate-100', 'dark:border-slate-800');
                } else {
                    row.classList.remove('border-indigo-500', 'bg-indigo-50/20', 'dark:bg-indigo-950/30');
                    row.classList.add('border-slate-100', 'dark:border-slate-800');
                }
            }
            if (chk) chk.checked = isSelected;

            updateSelectedUi();
        };

        window.removeSelectedKey = function (key) {
            sessionTraineesState.selectedCandidates.delete(key);
            const row = document.getElementById(`candidate-row-${key}`);
            const chk = document.getElementById(`chk-${key}`);
            if (row) {
                row.classList.remove('border-indigo-500', 'bg-indigo-50/20', 'dark:bg-indigo-950/30');
                row.classList.add('border-slate-100', 'dark:border-slate-800');
            }
            if (chk) chk.checked = false;
            updateSelectedUi();
        };

        window.clearAllSelected = function () {
            sessionTraineesState.selectedCandidates.clear();
            document.querySelectorAll('#traineePoolList input[type="checkbox"]').forEach(c => c.checked = false);
            document.querySelectorAll('#traineePoolList > div').forEach(row => {
                row.classList.remove('border-indigo-500', 'bg-indigo-50/20', 'dark:bg-indigo-950/30');
                row.classList.add('border-slate-100', 'dark:border-slate-800');
            });
            updateSelectedUi();
        };

        window.toggleSelectAllSearchResults = function () {
            const results = sessionTraineesState.currentResults || [];
            if (results.length === 0) return;

            const allSelected = results.every(c => {
                const key = c.candidateKey || c.CandidateKey || (c.companyTraineeId || c.CompanyTraineeId ? `CT_${c.companyTraineeId || c.CompanyTraineeId}` : `U_${c.userId || c.UserId}`);
                return sessionTraineesState.selectedCandidates.has(key);
            });

            results.forEach(c => {
                const key = c.candidateKey || c.CandidateKey || (c.companyTraineeId || c.CompanyTraineeId ? `CT_${c.companyTraineeId || c.CompanyTraineeId}` : `U_${c.userId || c.UserId}`);
                if (allSelected) {
                    sessionTraineesState.selectedCandidates.delete(key);
                } else {
                    const fn = c.fullName || c.FullName || c.userName || c.UserName || 'Trainee';
                    const cd = c.userCode || c.UserCode || '--';
                    const br = c.branchName || c.BranchName || 'بدون فرع';
                    sessionTraineesState.selectedCandidates.set(key, {
                        key: key,
                        fullName: fn,
                        userCode: cd,
                        branchName: br
                    });
                }
            });

            renderSearchResults(results, false);
            updateSelectedUi();
        };

        window.updateSelectedUi = function () {
            const count = sessionTraineesState.selectedCandidates.size;
            const badge = document.getElementById('selectedPoolCount');
            const tray = document.getElementById('selectedTrayContainer');
            const trayCount = document.getElementById('trayCount');
            const chipsList = document.getElementById('selectedChipsList');

            if (badge) badge.textContent = `${count} محدد`;
            if (trayCount) trayCount.textContent = count;

            if (count > 0) {
                tray.classList.remove('hidden');
                chipsList.innerHTML = Array.from(sessionTraineesState.selectedCandidates.values()).map(item => `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white dark:bg-slate-900 text-indigo-700 dark:text-indigo-300 rounded-lg text-[11px] font-bold border border-indigo-200 dark:border-indigo-800 shadow-sm">
                        <i class="fas fa-user-check text-[9px] text-indigo-500"></i>
                        <span>${item.fullName}</span>
                        <span class="font-mono text-[9px] text-slate-400">(${item.userCode})</span>
                        <button type="button" onclick="removeSelectedKey('${item.key}')" class="hover:text-rose-500 ml-1 text-xs font-bold leading-none" title="إزالة">×</button>
                    </span>
                `).join('');
            } else {
                tray.classList.add('hidden');
                chipsList.innerHTML = '';
            }
        };

        window.clearSearchInput = function () {
            const input = document.getElementById('traineeSearchInput');
            if (input) input.value = '';
            document.getElementById('searchSpinner').classList.add('hidden');
            sessionTraineesState.currentResults = [];
            renderEmptySearchState();
        };

        window.saveTraineesAssignment = async function () {
            const sessionId = sessionTraineesState.sessionId;
            const candidateKeys = Array.from(sessionTraineesState.selectedCandidates.keys());

            if (candidateKeys.length === 0) {
                showAppToast('warning', 'Notice', 'Please select at least one trainee.');
                return;
            }

            const sendNotif = document.getElementById('chkSendNotification').checked;
            const sendN8n = document.getElementById('chkSendN8nEmail').checked;
            const bypassApproval = document.getElementById('chkBypassApproval') ? document.getElementById('chkBypassApproval').checked : false;

            showAppToast('info', 'Assigning...', 'Registering trainees and triggering platform & n8n webhook notifications...');

            try {
                const res = await fetch('/Attendance/AssignTraineesToSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        candidateKeys: candidateKeys,
                        sendNotification: sendNotif,
                        sendEmailViaN8n: sendN8n,
                        bypassApproval: bypassApproval
                    })
                });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    sessionTraineesState.selectedCandidates.clear();
                    updateSelectedUi();
                    showAppToast('success', 'Assigned Successfully', data.message || 'Trainees enrolled successfully.');
                    switchTraineesTab('current');
                    loadSessionTraineesData(sessionId);
                } else {
                    showAppToast('error', 'Assignment Failed', data.message || 'Could not assign trainees.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        window.removeTraineeFromSession = async function (sessionId, traineeId, name) {
            try {
                const res = await fetch(`/Attendance/RemoveTraineeFromSession?sessionId=${sessionId}&traineeId=${traineeId}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'Removed Successfully', data.message || `Removed ${decodeURIComponent(name || '')} successfully.`);
                    loadSessionTraineesData(sessionId);
                } else {
                    showAppToast('error', 'Error', data.message || 'Could not remove trainee.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        window.uploadSessionExcelDirect = async function () {
            const fileInput = document.getElementById('sessionExcelFile');
            if (!fileInput.files || fileInput.files.length === 0) {
                showAppToast('warning', 'Notice', 'Please select an Excel file first.');
                return;
            }

            const bypassExcel = document.getElementById('chkExcelBypassApproval') ? document.getElementById('chkExcelBypassApproval').checked : false;

            const formData = new FormData();
            formData.append('sessionId', sessionTraineesState.sessionId);
            formData.append('excelFile', fileInput.files[0]);
            formData.append('bypassApproval', bypassExcel);

            showAppToast('info', 'Importing...', 'Reading Excel file and assigning trainees...');

            try {
                const res = await fetch('/Attendance/ImportSessionTraineesFromExcel', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'Imported Successfully', data.message || 'Excel trainees imported successfully.');
                    fileInput.value = '';
                    switchTraineesTab('current');
                    loadSessionTraineesData(sessionTraineesState.sessionId);
                } else {
                    showAppToast('error', 'Import Error', data.message || 'Failed to import Excel.');
                }
            } catch (err) {
                showAppToast('error', 'Upload Failed', err.message);
            }
        };
    </script>
}
