                showAppToast('warning', 'Notice', 'يرجى تحديد كوتة عددية للصيادلة أو المساعدين أو الأقسام الإدارية قبل الحفظ.');
                return;
            }

            const isCombined = (pharmQuota > 0 || assistQuota > 0) && quotas.length > 0;
            const rulePayload = {
                ruleType: isCombined ? 'combined' : (quotas.length > 0 ? 'departments' : 'branchStaff'),
