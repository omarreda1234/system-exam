                            <button type="button" onclick="deleteCurrentSelectedRule()" id="btnDeleteSelectedRule" class="hidden px-2.5 py-2 text-rose-500 hover:bg-rose-50 rounded-xl text-xs font-bold transition-colors" title="Delete this rule preset">
