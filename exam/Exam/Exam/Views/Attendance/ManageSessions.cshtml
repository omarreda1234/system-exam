                const val = parseInt(input.value) || 0;
                if (val > 0) {
                    deptQuotas.push({
                        departmentId: parseInt(input.dataset.deptId),
                        departmentName: input.dataset.deptName,
                        quota: val
                    });
                }
            });

            if (userIds.length === 0 && pharmQuota === 0 && assistQuota === 0 && deptQuotas.length === 0) {
                showAppToast('warning', 'Notice', 'يرجى تحديد الكوتة أولاً أو معاينة المرشحين.');
                return;
            }

            const sendNotif = document.getElementById('chkInjectionSendNotif').checked;
            const sendN8n = document.getElementById('chkInjectionSendN8n').checked;
            const bypassApproval = document.getElementById('chkInjectionBypassApproval').checked;
            const sendRabbitMqEmail = document.getElementById('chkInjectionSendRabbitMqEmail') ? document.getElementById('chkInjectionSendRabbitMqEmail').checked : true;

            const totalCandidateCount = userIds.length > 0 ? userIds.length : (pharmQuota + assistQuota + deptQuotas.reduce((a, b) => a + b.quota, 0));
            const totalSeats = parseInt(document.getElementById('inputSessionTotalSeats')?.value) || sessionTraineesState.totalSeats || 50;

            if (totalCandidateCount > totalSeats) {
                showAppToast('error', 'ممنوع التسكين!', `إجمالي عدد المرشحين (${totalCandidateCount}) أكبر من سعة الجلسة (${totalSeats} مقعد).`);
                await Swal.fire({
                    title: '<div class="text-base font-black text-rose-600">❌ تم تجاوز سعة المقاعد!</div>',
                    html: `<div class="text-right space-y-2" dir="rtl">
                        <p class="text-xs text-slate-700 leading-relaxed font-bold">إجمالي عدد المرشحين المطلوب تسكينهم (<strong>${totalCandidateCount}</strong>) أكبر من سعة الجلسة المحددة (<strong>${totalSeats}</strong> مقعد).</p>
                        <p class="text-[11px] text-rose-600 font-bold bg-rose-50 p-2.5 rounded-xl border border-rose-200">
                            لا يمكن إتمام عملية التسكين عند تجاوز الحد الأقصى للمقاعد. يرجى تعديل الكوتة أو زيادة سعة الجلسة أولاً.
                        </p>
                    </div>`,
                    icon: 'error',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#e11d48',
                    customClass: {
                        confirmButton: 'px-4 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs shadow-sm'
                    }
                });
                return;
            }

            const confirm = await Swal.fire({
                title: 'تأكيد تسكين وتوزيع المرشحين مجمعين',
                html: `<p class="text-xs text-slate-600 leading-relaxed">سيتم تسكين <strong>${totalCandidateCount}</strong> متدرب مجمعين (صيادلة + مساعدين + أقسام إدارية) وفق التوزيع العادل (الأقل حضوراً أولاً) وإرسال الإشعارات والإيميلات فوراً.</p>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#7c3aed',
                confirmButtonText: 'نعم، تسكين المرشحين الآن',
                cancelButtonText: 'إلغاء'
            });

            if (!confirm.isConfirmed) return;

            showAppToast('info', 'جاري التسكين...', 'يتم تسكين المرشحين مجمعين وإرسال الإيميلات والإشعارات...');

            try {
                const res = await fetch('/Attendance/ExecuteInjectionRule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: sessionTraineesState.sessionId,
                        companyId: sessionTraineesState.companyId || null,
                        mode: 'combined',
                        pharmacistQuota: pharmQuota,
                        assistantQuota: assistQuota,
                        branchIds: injectionState.selectedBranchIds.length > 0 ? injectionState.selectedBranchIds : null,
                        shiftIds: injectionState.selectedShiftIds.length > 0 ? injectionState.selectedShiftIds : null,
                        departmentQuotas: deptQuotas.length > 0 ? deptQuotas : null,
                        userIds: userIds.length > 0 ? userIds : null,
                        confirmedCandidateKeys: userIds.length > 0 ? userIds.map(u => `U_${u}`) : null,
                        bypassApproval: bypassApproval,
                        sendNotification: sendNotif,
                        sendN8nWebhook: sendN8n,
                        sendEmail: sendRabbitMqEmail
                    })
                });

                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'تم التسكين بنجاح', data.message || `تم تسكين المرشحين مجمعين بنجاح.`);
                    switchTraineesTab('current');
                    loadSessionTraineesData(sessionTraineesState.sessionId);
                } else {
                    showAppToast('error', 'فشل التسكين', data.message || 'حدث خطأ أثناء التسكين.');
                }
            } catch (err) {
                showAppToast('error', 'خطأ في الاتصال', err.message);
            }
        };

        window.exportPreviewToExcel = async function () {
            if (!injectionState.previewCandidates || injectionState.previewCandidates.length === 0) {
                showAppToast('warning', 'Notice', 'يرجى إجراء المعاينة (Preview) أولاً للحصول على المرشحين قبل التصدير.');
                return;
            }

            // Only export candidates that are checked in the preview
            const checkedBoxes = document.querySelectorAll('.preview-candidate-chk:checked');
            let checkedUserIds = new Set();
            checkedBoxes.forEach(chk => checkedUserIds.add(chk.dataset.previewUserId));

            let candidatesToExport = injectionState.previewCandidates.filter(c => checkedUserIds.has(c.userId));
            if (candidatesToExport.length === 0) {
                candidatesToExport = injectionState.previewCandidates;
            }

            showAppToast('info', 'جاري التصدير...', 'يتم إنشاء وتنسيق شيت الإكسيل الاحترافي...');

            try {
                const res = await fetch('/Attendance/ExportInjectionPreviewExcel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: sessionTraineesState.sessionId,
                        candidates: candidatesToExport
                    })
                });

                if (!res.ok) {
                    const errJson = await res.json().catch(() => null);
                    throw new Error(errJson?.message || 'تعذر استخراج ملف الإكسيل.');
                }

                const buffer = await res.arrayBuffer();
                const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Trainees_Roster_Session_${sessionTraineesState.sessionId || 'Preview'}.xlsx`;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    a.remove();
                    window.URL.revokeObjectURL(url);
                }, 3000);

                showAppToast('success', 'تم التصدير بنجاح', `تم تحميل شيت الإكسيل بنجاح (${candidatesToExport.length} متدرب).`);
            } catch (err) {
                showAppToast('error', 'فشل التصدير', err.message);
            }
        };
    </script>
}
