                        <label class="flex items-center justify-between p-3.5 bg-indigo-50/40 hover:bg-indigo-50/70 border border-indigo-200/80 rounded-2xl cursor-pointer shadow-2xs transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-sm shrink-0 border border-indigo-200">
                                    <i class="fas fa-paper-plane"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-black text-indigo-900">إرسال إيميل رسمي للمرشحين (RabbitMQ Broker)</div>
                                    <div class="text-[11px] text-indigo-700/80 font-medium">إرسال تفاصيل وموعد الدورة إلى بريد الموظف تلقائياً عبر وسيط الرسائل</div>
                                </div>
                            </div>
                            <input type="checkbox" id="chkInjectionSendRabbitMqEmail" checked class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-indigo-300" />
                        </label>

                        <!-- Instant Direct Approval -->
                        <label class="flex items-center justify-between p-3.5 bg-amber-50/40 hover:bg-amber-50/70 border border-amber-200/80 rounded-2xl cursor-pointer shadow-2xs transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-sm shrink-0 border border-amber-200">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-black text-amber-900">Instant Direct Approval (Bypass Approval)</div>
                                    <div class="text-[11px] text-amber-700/80 font-medium">Confirm attendance without waiting for branch manager review</div>
                                </div>
                            </div>
                            <input type="checkbox" id="chkInjectionBypassApproval" class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-amber-300" />
                        </label>
                    </div>

                    <!-- Preview & Action Buttons -->
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
                        <button type="button" id="btnPreviewInjection" onclick="previewInjectionRule()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-black text-xs uppercase tracking-wider shadow-2xs hover:border-purple-300 transition-all flex items-center justify-center gap-2 active:scale-95">
                            <i class="fas fa-eye text-purple-600"></i> <span>Preview Fair Rotation</span>
                        </button>
                        <button type="button" onclick="executeInjectionRule()" id="btnExecuteInjection" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-purple-600 to-brand-600 hover:from-purple-700 hover:to-brand-700 active:scale-95 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-purple-600/25 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-bolt"></i> <span>Confirm & Enroll Candidates</span>
                        </button>
                    </div>

                    <!-- Preview Results Area -->
                    <div id="injectionPreviewResultsCard" class="hidden p-4 bg-slate-50/80 rounded-2xl border border-slate-200 space-y-3 shadow-2xs">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-black text-slate-800 flex items-center gap-2">
                                    <i class="fas fa-users text-purple-600"></i>
                                    <span>Rotation Preview Results: <span id="injectionPreviewCountBadge" class="font-mono text-purple-600">0</span> Candidates</span>
                                </span>
                                <span class="text-[11px] font-bold text-slate-400 hidden sm:inline">• الأقل حضوراً أولاً</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="exportPreviewToExcel()" id="btnExportPreviewExcel" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white rounded-xl text-xs font-bold transition-all shadow-xs flex items-center gap-1.5 cursor-pointer" title="تصدير كشف التحضير والمتابعة كشيت إكسيل ملون ومنظم">
                                    <i class="fas fa-file-excel text-sm"></i>
                                    <span>Export Preview to Excel (تصدير كشف التحضير)</span>
                                </button>
                            </div>
                        </div>
                        <div id="injectionPreviewCandidatesList" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar pr-1">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- Flatpickr CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        $(function() {
            flatpickr("#sessionDatePicker", {
                altInput: true,
                altFormat: "d/m/Y",
                dateFormat: "Y-m-d",
                altInputClass: "w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white"
            });
        });

        async function editSession(id, currentName, currentDate, currentStart, currentEnd) {
            const { value: formValues } = await Swal.fire({
                title: '<div class="text-base font-black uppercase text-slate-800 dark:text-white">Edit Session</div>',
                html: `
                    <div class="text-left space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Session Name / Label:</label>
                            <input id="sw-edit-name" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentName || ''}" placeholder="e.g. Session 1">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Session Date:</label>
                            <input id="sw-edit-date" type="date" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentDate}">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Start Time:</label>
                                <input id="sw-edit-start" type="time" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentStart}">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">End Time:</label>
                                <input id="sw-edit-end" type="time" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" value="${currentEnd}">
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Save Changes',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'rounded-[28px] border border-slate-100 dark:border-slate-800 shadow-2xl bg-white dark:bg-slate-900',
                    confirmButton: 'bg-brand-600 hover:bg-brand-700 text-white px-6 py-2.5 rounded-xl font-bold text-xs uppercase shadow-md mr-2',
                    cancelButton: 'bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-500 font-bold text-xs px-6 py-2.5 rounded-xl'
                },
                buttonsStyling: false,
                preConfirm: () => {
                    const name = document.getElementById('sw-edit-name').value;
                    const date = document.getElementById('sw-edit-date').value;
                    const start = document.getElementById('sw-edit-start').value;
                    const end = document.getElementById('sw-edit-end').value;
                    if (!name || !name.trim()) {
                        Swal.showValidationMessage('Session name is required');
                        return false;
                    }
                    if (!date) {
                        Swal.showValidationMessage('Session date is required');
                        return false;
                    }
                    return { name: name.trim(), date, start, end };
                }
            });

            if (formValues) {
                Swal.showLoading();
                try {
                    const fd = new FormData();
                    fd.append('sessionId', id);
                    fd.append('sessionName', formValues.name);
                    fd.append('sessionDate', formValues.date);
                    if (formValues.start) fd.append('startTime', formValues.start);
                    if (formValues.end) fd.append('endTime', formValues.end);

                    const res = await fetch('@Url.Action("UpdateSession")', {
                        method: 'POST',
                        body: fd
                    });
                    const json = await res.json();
                    if (json.success) {
                        location.reload();
                    } else {
                        Swal.fire('Error', json.message || 'Could not update session', 'error');
                    }
                } catch(e) {
                    Swal.fire('Error', 'An error occurred while communicating with the server', 'error');
                }
            }
        }

        function deleteSession(id) {
            Swal.fire({
                title: 'Delete Session?',
                text: "All attendance records for this day will be permanently removed.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: 'Yes, Delete it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteSession")', { sessionId: id }, function(res) {
                        if (res.success) {
                            location.reload();
                        }
                    });
                }
            });
        }

        // ==========================================
        // Session Trainees Management Logic (n8n API & In-App Notifications)
        // ==========================================
        let sessionTraineesState = {
            sessionId: 0,
            hasModified: false,
            assignedTrainees: [],
            selectedCandidates: new Map(),
            currentResults: []
        };

        window.showAppToast = function (type, title, message) {
            let container = document.getElementById('appGlobalToastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'appGlobalToastContainer';
                container.className = 'fixed top-5 left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 z-[999999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto transform translate-y-[-16px] opacity-0 transition-all duration-300 ease-out flex items-start gap-3 p-4 rounded-2xl shadow-2xl backdrop-blur-xl border text-xs select-none';

            let iconHtml = '';
            let bgBorder = '';
            let progressBg = '';

            const t = (type || 'info').toLowerCase();
            if (t === 'success') {
                bgBorder = 'bg-slate-900/95 text-emerald-100 border-emerald-500/40 shadow-emerald-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-check-circle"></i></div>';
                progressBg = 'bg-emerald-400';
            } else if (t === 'error' || t === 'danger') {
                bgBorder = 'bg-slate-900/95 text-rose-100 border-rose-500/40 shadow-rose-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-circle"></i></div>';
                progressBg = 'bg-rose-400';
            } else if (t === 'warning') {
                bgBorder = 'bg-slate-900/95 text-amber-100 border-amber-500/40 shadow-amber-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-exclamation-triangle"></i></div>';
                progressBg = 'bg-amber-400';
            } else {
                bgBorder = 'bg-slate-900/95 text-indigo-100 border-indigo-500/40 shadow-indigo-950/40';
                iconHtml = '<div class="w-7 h-7 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 text-sm shadow-sm"><i class="fas fa-info-circle"></i></div>';
                progressBg = 'bg-indigo-400';
            }

            toast.className += ' ' + bgBorder;
            toast.innerHTML = `
                ${iconHtml}
                <div class="flex-1 min-w-0 pr-1">
                    <h5 class="font-black text-xs text-white leading-snug">${title || ''}</h5>
                    ${message ? `<p class="text-[11px] opacity-80 mt-0.5 leading-normal break-words">${message}</p>` : ''}
                </div>
                <button type="button" class="text-white/40 hover:text-white transition-colors text-xs p-1 shrink-0" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
                <div class="absolute bottom-0 left-0 right-0 h-1 rounded-b-2xl overflow-hidden bg-white/10">
                    <div class="h-full ${progressBg} transition-all ease-linear" style="width: 100%; transition-duration: 3500ms;"></div>
                </div>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-[-16px]', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
                const progressBar = toast.querySelector(`.${progressBg}`);
                if (progressBar) {
                    requestAnimationFrame(() => {
                        progressBar.style.width = '0%';
                    });
                }
            });

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-[-8px]', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        };

        function showToast(icon, title, message) {
            showAppToast(icon, title, message);
        }

        window.refreshCurrentSessionTrainees = async function () {
            const icon = document.getElementById('iconRefreshSessionTrainees');
            if (icon) icon.classList.add('fa-spin');
            if (sessionTraineesState.sessionId) {
                await loadSessionTraineesData(sessionTraineesState.sessionId);
            }
            if (icon) icon.classList.remove('fa-spin');
            showAppToast('info', 'Updated', 'Session trainees and their statuses have been refreshed.');
        };

        window.openManageSessionTrainees = function (sessionId, sessionName, companyId) {
            sessionTraineesState.sessionId = sessionId;
            sessionTraineesState.companyId = companyId;
            sessionTraineesState.hasModified = false;
            sessionTraineesState.selectedCandidates.clear();
            sessionTraineesState.currentResults = [];
            document.getElementById('currentSessionId').value = sessionId;
            document.getElementById('modalSessionTitle').textContent = `Manage Trainees - ${sessionName}`;
            document.getElementById('sessionTraineesModal').classList.remove('hidden');
            clearSearchInput();
            updateSelectedUi();
            switchTraineesTab('current');
            loadSessionTraineesData(sessionId);
        };

        window.closeManageSessionTrainees = function () {
            document.getElementById('sessionTraineesModal').classList.add('hidden');
            if (sessionTraineesState.sessionId && sessionTraineesState.assignedTrainees) {
                const sessionBadge = document.getElementById(`session-badge-${sessionTraineesState.sessionId}`);
                if (sessionBadge) {
                    const approvedCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'approved').length;
                    const pendingCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'pending').length;
                    let badgeText = `${approvedCount} Trainees`;
                    if (pendingCount > 0) badgeText += ` (${pendingCount} Pending)`;
                    sessionBadge.className = 'text-[9px] sm:text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest bg-indigo-50 dark:bg-indigo-950/40 px-2 py-0.5 rounded-full border border-indigo-200 dark:border-indigo-800';
                    sessionBadge.innerHTML = `<i class="fas fa-users mr-1"></i> ${badgeText}`;
                }
            }
        };

        window.switchTraineesTab = function (tab) {
            const tabs = ['current', 'assign', 'excel', 'injection'];
            tabs.forEach(t => {
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                const content = document.getElementById('tabContent' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn && content) {
                    if (t === tab) {
                        btn.className = 'px-4 py-2 text-xs font-black rounded-xl transition-all shrink-0 flex items-center gap-2 bg-white text-brand-700 shadow-xs border border-slate-200/50';
                        content.classList.remove('hidden');
                    } else {
                        btn.className = 'px-4 py-2 text-xs font-bold rounded-xl transition-all shrink-0 flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60';
                        content.classList.add('hidden');
                    }
                }
            });
            if (tab === 'injection') {
                if (!injectionState.branchStaffLoaded) {
                    loadInjectionBranchStaffMetadata();
                }
                if (!injectionState.loaded) {
                    loadInjectionDepartments();
                }
                loadCompanyInjectionRules(sessionTraineesState.companyId);
            }
        };

        window.loadSessionTraineesData = async function (sessionId) {
            const listWrapper = document.getElementById('assignedTraineesList');
            const countBadge = document.getElementById('assignedCountBadge');

            listWrapper.innerHTML = `
                <div class="text-center py-10 text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl text-brand-600 mb-2 block"></i>
                    Loading session trainees...
                </div>`;

            try {
                const res = await fetch(`/Attendance/GetSessionTrainees?sessionId=${sessionId}`);
                const data = await res.json();

                if (!data.success) {
                    listWrapper.innerHTML = `<div class="text-center py-6 text-rose-500 font-bold">${data.message}</div>`;
                    return;
                }

                sessionTraineesState.assignedTrainees = data.assignedTrainees || [];
                const approvedCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'approved').length;
                const pendingCount = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'pending').length;

                // Sync Total Seats
                sessionTraineesState.totalSeats = data.totalSeats || 50;
                const totalSeatsInput = document.getElementById('inputSessionTotalSeats');
                if (totalSeatsInput) totalSeatsInput.value = sessionTraineesState.totalSeats;

                // Set approved count as main count badge
                countBadge.textContent = approvedCount;

                // Sync badge on outer session card in real-time
                const sessionBadge = document.getElementById(`session-badge-${sessionId}`);
                if (sessionBadge) {
                    if (approvedCount > 0 || pendingCount > 0) {
                        let badgeText = `${approvedCount} Trainees`;
                        if (pendingCount > 0) badgeText += ` (${pendingCount} Pending)`;
                        sessionBadge.className = 'text-[9px] sm:text-[10px] font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-2 py-0.5 rounded-full border border-brand-200';
                        sessionBadge.innerHTML = `<i class="fas fa-users mr-1"></i> ${badgeText}`;
                    }
                }

                // Split active vs replaced trainees
                const activeTrainees = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() !== 'replaced');
                const replacedTrainees = sessionTraineesState.assignedTrainees.filter(t => (t.approvalStatus || t.ApprovalStatus || '').toLowerCase() === 'replaced');

                if (sessionTraineesState.assignedTrainees.length === 0) {
                    listWrapper.innerHTML = `
                        <div class="p-8 text-center bg-slate-50/70 rounded-2xl border border-slate-200/80">
                            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center mx-auto mb-3 text-xl border border-amber-200/60 shadow-2xs">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <h4 class="text-xs font-black uppercase text-slate-800">No trainees assigned to this session yet</h4>
                            <p class="text-[11px] text-slate-400 mt-1 max-w-md mx-auto">
                                You can search and assign employees via "Assign Trainees", import an Excel file, or use "Fair Rotation".
                            </p>
                            <button type="button" onclick="switchTraineesTab('assign')" class="mt-4 px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-bold hover:bg-brand-700 transition-all shadow-xs">
                                <i class="fas fa-user-plus mr-1"></i> Assign Trainees Now
                            </button>
                        </div>`;
                } else {
                    const renderTraineeRow = (t) => {
                        const traineeId = t.traineeId || t.TraineeId || t.id || t.Id;
                        const fullName = t.fullName || t.FullName || 'Trainee';
                        const userCode = t.userCode || t.UserCode || '--';
                        const branchName = t.branchName || t.BranchName || 'General';
                        const jobTitle = t.jobTitle || t.JobTitle || 'Trainee';
                        const status = (t.approvalStatus || t.ApprovalStatus || 'Approved').toLowerCase();
                        let badgeHtml = '';
                        if (status === 'approved') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1.5 shadow-2xs"><i class="fas fa-check-circle text-emerald-600"></i> Approved</span>`;
                        } else if (status === 'pending') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5 shadow-2xs"><i class="fas fa-clock text-amber-600"></i> Pending Review</span>`;
                        } else if (status === 'rejected') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-rose-50 text-rose-700 border border-rose-200 flex items-center gap-1.5 shadow-2xs" title="Reason: ${t.rejectionReason || t.RejectionReason || 'None'}"><i class="fas fa-times-circle text-rose-600"></i> Declined</span>`;
                        } else if (status === 'replaced') {
                            badgeHtml = `<span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-slate-100 text-slate-500 border border-slate-200 flex items-center gap-1.5 shadow-2xs"><i class="fas fa-exchange-alt"></i> Replaced (Inactive)</span>`;
                        }

                        return `
                        <div class="p-3.5 bg-white rounded-2xl border border-slate-200/90 shadow-2xs hover:shadow-xs flex items-center justify-between gap-4 transition-all group">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-black flex items-center justify-center text-xs border border-brand-100/80 shadow-2xs group-hover:bg-brand-600 group-hover:text-white transition-all">
                                    ${(fullName || 'T')[0]}
                                </div>
                                <div>
                                    <h4 class="text-xs font-black text-slate-800 leading-tight">${fullName}</h4>
                                    <p class="text-[10px] text-slate-400 font-mono mt-0.5">Code: <span class="font-bold text-slate-600">${userCode}</span> | Branch: <span class="font-bold text-slate-600">${branchName}</span> | ${jobTitle}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                ${badgeHtml}
                                ${status === 'pending' ? `
                                    <button type="button" 
                                            onclick="adminApproveSessionTrainee(${t.assignmentId || t.AssignmentId || 0}, '${(fullName || '').replace(/'/g, "\\'")}', ${sessionId})" 
                                            class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white flex items-center justify-center text-xs transition-all shadow-2xs active:scale-95 border border-emerald-200/80" 
                                            title="اعتماد وقبول المتدرب فوراً كمسؤول (Direct Admin Approval)">
                                        <i class="fas fa-check"></i>
                                    </button>
                                ` : ''}
                                ${status !== 'replaced' && status !== 'declined' && status !== 'rejected' ? `
                                    <button type="button" 
                                            onclick="initiateSessionTraineeReplace(${t.assignmentId || t.AssignmentId || 0}, ${sessionId}, ${sessionTraineesState.companyId || 0}, '${(branchName || '').replace(/'/g, "\\'")}', '${(fullName || '').replace(/'/g, "\\'")}', ${t.branchId || t.BranchId || 0}, '${(userCode || '').replace(/'/g, "\\'")}', '${(t.userId || t.UserId || '')}')" 
                                            class="w-8 h-8 rounded-xl bg-brand-50 text-brand-700 hover:bg-brand-600 hover:text-white flex items-center justify-center text-xs transition-all shadow-2xs active:scale-95 border border-brand-200/60" 
                                            title="Replace Trainee with Colleague (استبدال بزميل بديل في حال طرأ ظرف طارئ)">
                                        <i class="fas fa-exchange-alt"></i>
                                    </button>
                                ` : ''}
                                <button type="button" onclick="removeTraineeFromSession(${sessionId}, ${traineeId}, '${encodeURIComponent(fullName)}')" class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white flex items-center justify-center text-xs transition-all shadow-2xs active:scale-95 border border-rose-200/60" title="Remove from session">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>`;
                    };

                    let html = '';
                    if (pendingCount > 0) {
                        html += `
                            <div class="flex items-center justify-between p-3.5 bg-amber-50/70 border border-amber-200/80 rounded-2xl mb-3 shadow-2xs">
                                <div class="flex items-center gap-2.5">
                                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                                    <span class="text-xs font-bold text-amber-900">يوجد <strong>${pendingCount}</strong> متدرب بانتظار الاعتماد من الفروع</span>
                                </div>
                                <button type="button" 
                                        onclick="adminApproveAllPendingSessionTrainees(${sessionId})" 
                                        class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black transition-all shadow-xs active:scale-95 flex items-center gap-1.5">
                                    <i class="fas fa-check-double"></i> <span>اعتماد وقبول الكل فوراً</span>
                                </button>
                            </div>`;
                    }
                    html += activeTrainees.map(renderTraineeRow).join('');

                    if (replacedTrainees.length > 0) {
                        html += `
                            <div class="pt-4 mt-4 border-t border-dashed border-slate-200">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                                        <i class="fas fa-history"></i> Replaced / Inactive Trainees (${replacedTrainees.length})
                                    </span>
                                </div>
                                <div class="space-y-2 opacity-75">
                                    ${replacedTrainees.map(renderTraineeRow).join('')}
                                </div>
                            </div>
                        `;
                    }

                    listWrapper.innerHTML = html;
                }

                renderEmptySearchState();
            } catch (err) {
                listWrapper.innerHTML = `<div class="text-center py-6 text-rose-500 font-bold">Failed to load data: ${err.message}</div>`;
            }
        };

        window.renderEmptySearchState = function () {
            const poolWrapper = document.getElementById('traineePoolList');
            const header = document.getElementById('searchResultsHeader');
            if (header) header.classList.add('hidden');
            if (!poolWrapper) return;

            poolWrapper.innerHTML = `
                <div class="p-8 text-center bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
                    <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-2 text-xl border border-brand-200/60 shadow-2xs">
                        <i class="fas fa-id-card-clip"></i>
                    </div>
                    <h4 class="text-xs font-black text-slate-800">Search Trainees to Assign</h4>
                    <p class="text-[11px] text-slate-400 mt-1 max-w-sm mx-auto">
                        Type code, name, or paste multiple codes separated by comma <strong>( , )</strong> or pipe <strong>( | )</strong> for instant bulk search.
                    </p>
                </div>`;
        };

        let searchDebounceTimeout = null;
        window.filterTraineePool = function () {
            const input = document.getElementById('traineeSearchInput');
            const q = input.value.trim();
            clearTimeout(searchDebounceTimeout);

            if (!q) {
                document.getElementById('searchSpinner').classList.add('hidden');
                renderEmptySearchState();
                return;
            }

            document.getElementById('searchSpinner').classList.remove('hidden');

            searchDebounceTimeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/Attendance/SearchSessionCandidates?sessionId=${sessionTraineesState.sessionId}&query=${encodeURIComponent(q)}`);
                    const data = await res.json();
                    document.getElementById('searchSpinner').classList.add('hidden');

                    if (data.success && data.candidates) {
                        sessionTraineesState.currentResults = data.candidates;
                        renderSearchResults(data.candidates, data.isMultiCode);
                    } else {
                        document.getElementById('traineePoolList').innerHTML = `<div class="p-6 text-center text-xs text-rose-500 font-bold">${data.message || 'Search error occurred'}</div>`;
                    }
                } catch(err) {
                    document.getElementById('searchSpinner').classList.add('hidden');
                    console.error('Search error:', err);
                }
            }, 250);
        };

        window.renderSearchResults = function (candidates, isMultiCode) {
            const poolWrapper = document.getElementById('traineePoolList');
            const header = document.getElementById('searchResultsHeader');
            const countText = document.getElementById('searchResultCountText');

            if (!candidates || candidates.length === 0) {
                header.classList.add('hidden');
                poolWrapper.innerHTML = `
                    <div class="p-8 text-center bg-slate-50/70 rounded-2xl border border-slate-200">
                        <i class="fas fa-user-slash text-2xl text-slate-400 mb-2 block"></i>
                        <h4 class="text-xs font-black text-slate-800">No matching candidates found</h4>
                        <p class="text-[10px] text-slate-400 mt-1">Check the codes or try searching by name or branch.</p>
                    </div>`;
                return;
            }

            header.classList.remove('hidden');
            countText.textContent = `Found (${candidates.length}) ${isMultiCode ? 'candidates matching codes' : 'matching results'}`;

            // If multi-code search, auto-select them all for convenience!
            if (isMultiCode) {
                candidates.forEach(c => {
                    const key = c.candidateKey || c.CandidateKey || (c.companyTraineeId || c.CompanyTraineeId ? `CT_${c.companyTraineeId || c.CompanyTraineeId}` : `U_${c.userId || c.UserId}`);
                    const fn = c.fullName || c.FullName || c.userName || c.UserName || 'Trainee';
                    const cd = c.userCode || c.UserCode || '--';
                    const br = c.branchName || c.BranchName || 'General';
                    sessionTraineesState.selectedCandidates.set(key, {
                        key: key,
                        fullName: fn,
                        userCode: cd,
                        branchName: br
                    });
                });
                updateSelectedUi();
            }

            poolWrapper.innerHTML = candidates.map(t => {
                const key = t.candidateKey || t.CandidateKey || (t.companyTraineeId || t.CompanyTraineeId ? `CT_${t.companyTraineeId || t.CompanyTraineeId}` : `U_${t.userId || t.UserId}`);
                const isSelected = sessionTraineesState.selectedCandidates.has(key);
                const isExempt = (t.isBranchExempt == 1 || t.IsBranchExempt == 1 || t.isBranchExempt === true || t.IsBranchExempt === true);
                const fullName = t.fullName || t.FullName || t.userName || t.UserName || 'Trainee';
                const role = t.jobTitle || t.JobTitle || 'Trainee';
                const branch = t.branchName || t.BranchName || 'General';
                const code = t.userCode || t.UserCode || '--';

                return `
                    <div onclick="toggleCandidateSelection('${key}', '${encodeURIComponent(fullName)}', '${code}', '${encodeURIComponent(branch)}')" 
                         id="candidate-row-${key}"
                         class="p-3.5 bg-white hover:bg-slate-50 cursor-pointer flex items-center justify-between rounded-2xl border ${isSelected ? 'border-brand-500 bg-brand-50/20 ring-1 ring-brand-500/20 shadow-xs' : 'border-slate-200/90 shadow-2xs'} transition-all select-none">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-xs shrink-0 border border-brand-100">
                                <i class="fas fa-user"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs font-black text-slate-800 leading-tight">${fullName}</span>
                                    ${isExempt ? '<span class="px-2 py-0.5 rounded text-[9px] font-black bg-amber-50 text-amber-700 border border-amber-200">Exempt</span>' : ''}
                                </div>
                                <div class="text-[10px] text-slate-400 font-bold mt-0.5">${role} - Branch: <span class="text-slate-600">${branch}</span></div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 rounded-lg bg-slate-50 font-mono text-[10px] font-black text-brand-700 border border-slate-200">Code: ${code}</span>
                            <input type="checkbox" id="chk-${key}" ${isSelected ? 'checked' : ''} class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300 pointer-events-none" />
                        </div>
                    </div>
                `;
            }).join('');
        };

        window.toggleCandidateSelection = function (key, encodedName, code, encodedBranch) {
            if (sessionTraineesState.selectedCandidates.has(key)) {
                sessionTraineesState.selectedCandidates.delete(key);
            } else {
                sessionTraineesState.selectedCandidates.set(key, {
                    key: key,
                    fullName: decodeURIComponent(encodedName || ''),
                    userCode: code || '--',
                    branchName: decodeURIComponent(encodedBranch || '')
                });
            }

            const row = document.getElementById(`candidate-row-${key}`);
            const chk = document.getElementById(`chk-${key}`);
            const isSelected = sessionTraineesState.selectedCandidates.has(key);
            if (row) {
                if (isSelected) {
                    row.classList.add('border-brand-500', 'bg-brand-50/20', 'ring-1', 'ring-brand-500/20', 'shadow-xs');
                    row.classList.remove('border-slate-200/90', 'shadow-2xs');
                } else {
                    row.classList.remove('border-brand-500', 'bg-brand-50/20', 'ring-1', 'ring-brand-500/20', 'shadow-xs');
                    row.classList.add('border-slate-200/90', 'shadow-2xs');
                }
            }
            if (chk) chk.checked = isSelected;

            updateSelectedUi();
        };

        window.removeSelectedKey = function (key) {
            sessionTraineesState.selectedCandidates.delete(key);
            const row = document.getElementById(`candidate-row-${key}`);
            const chk = document.getElementById(`chk-${key}`);
            if (row) {
                row.classList.remove('border-brand-500', 'bg-brand-50/20', 'ring-1', 'ring-brand-500/20', 'shadow-xs');
                row.classList.add('border-slate-200/90', 'shadow-2xs');
            }
            if (chk) chk.checked = false;
            updateSelectedUi();
        };

        window.clearAllSelected = function () {
            sessionTraineesState.selectedCandidates.clear();
            document.querySelectorAll('#traineePoolList input[type="checkbox"]').forEach(c => c.checked = false);
            document.querySelectorAll('#traineePoolList > div').forEach(row => {
                row.classList.remove('border-brand-500', 'bg-brand-50/20', 'ring-1', 'ring-brand-500/20', 'shadow-xs');
                row.classList.add('border-slate-200/90', 'shadow-2xs');
            });
            updateSelectedUi();
        };

        window.toggleSelectAllSearchResults = function () {
            const results = sessionTraineesState.currentResults || [];
            if (results.length === 0) return;

            const allSelected = results.every(c => {
                const key = c.candidateKey || c.CandidateKey || (c.companyTraineeId || c.CompanyTraineeId ? `CT_${c.companyTraineeId || c.CompanyTraineeId}` : `U_${c.userId || c.UserId}`);
                return sessionTraineesState.selectedCandidates.has(key);
            });

            results.forEach(c => {
                const key = c.candidateKey || c.CandidateKey || (c.companyTraineeId || c.CompanyTraineeId ? `CT_${c.companyTraineeId || c.CompanyTraineeId}` : `U_${c.userId || c.UserId}`);
                if (allSelected) {
                    sessionTraineesState.selectedCandidates.delete(key);
                } else {
                    const fn = c.fullName || c.FullName || c.userName || c.UserName || 'Trainee';
                    const cd = c.userCode || c.UserCode || '--';
                    const br = c.branchName || c.BranchName || 'General';
                    sessionTraineesState.selectedCandidates.set(key, {
                        key: key,
                        fullName: fn,
                        userCode: cd,
                        branchName: br
                    });
                }
            });

            renderSearchResults(results, false);
            updateSelectedUi();
        };

        window.updateSelectedUi = function () {
            const count = sessionTraineesState.selectedCandidates.size;
            const badge = document.getElementById('selectedPoolCount');
            const tray = document.getElementById('selectedTrayContainer');
            const trayCount = document.getElementById('trayCount');
            const chipsList = document.getElementById('selectedChipsList');

            if (badge) badge.textContent = `${count} Selected`;
            if (trayCount) trayCount.textContent = count;

            if (count > 0) {
                tray.classList.remove('hidden');
                chipsList.innerHTML = Array.from(sessionTraineesState.selectedCandidates.values()).map(item => `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white dark:bg-slate-900 text-indigo-700 dark:text-indigo-300 rounded-lg text-[11px] font-bold border border-indigo-200 dark:border-indigo-800 shadow-sm">
                        <i class="fas fa-user-check text-[9px] text-indigo-500"></i>
                        <span>${item.fullName}</span>
                        <span class="font-mono text-[9px] text-slate-400">(${item.userCode})</span>
                        <button type="button" onclick="removeSelectedKey('${item.key}')" class="hover:text-rose-500 ml-1 text-xs font-bold leading-none" title="Remove">×</button>
                    </span>
                `).join('');
            } else {
                tray.classList.add('hidden');
                chipsList.innerHTML = '';
            }
        };

        window.clearSearchInput = function () {
            const input = document.getElementById('traineeSearchInput');
            if (input) input.value = '';
            document.getElementById('searchSpinner').classList.add('hidden');
            sessionTraineesState.currentResults = [];
            renderEmptySearchState();
        };

        window.saveTraineesAssignment = async function () {
            const sessionId = sessionTraineesState.sessionId;
            const candidateKeys = Array.from(sessionTraineesState.selectedCandidates.keys());

            if (candidateKeys.length === 0) {
                showAppToast('warning', 'Notice', 'Please select at least one trainee.');
                return;
            }

            const sendNotif = document.getElementById('chkSendNotification').checked;
            const sendN8n = document.getElementById('chkSendN8nEmail').checked;
            const bypassApproval = document.getElementById('chkBypassApproval') ? document.getElementById('chkBypassApproval').checked : false;
            const sendRabbitMqEmail = document.getElementById('chkManualSendRabbitMqEmail') ? document.getElementById('chkManualSendRabbitMqEmail').checked : true;

            showAppToast('info', 'Assigning...', 'Registering trainees and triggering platform & n8n webhook notifications...');

            try {
                const res = await fetch('/Attendance/AssignTraineesToSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        candidateKeys: candidateKeys,
                        sendNotification: sendNotif,
                        sendEmailViaN8n: sendN8n,
                        bypassApproval: bypassApproval,
                        sendRabbitMqEmail: sendRabbitMqEmail
                    })
                });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    sessionTraineesState.selectedCandidates.clear();
                    updateSelectedUi();
                    showAppToast('success', 'Assigned Successfully', data.message || 'Trainees enrolled successfully.');
                    switchTraineesTab('current');
                    loadSessionTraineesData(sessionId);
                } else {
                    showAppToast('error', 'Assignment Failed', data.message || 'Could not assign trainees.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        window.removeTraineeFromSession = async function (sessionId, traineeId, name) {
            try {
                const res = await fetch(`/Attendance/RemoveTraineeFromSession?sessionId=${sessionId}&traineeId=${traineeId}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'Removed Successfully', data.message || `Removed ${decodeURIComponent(name || '')} successfully.`);
                    loadSessionTraineesData(sessionId);
                } else {
                    showAppToast('error', 'Error', data.message || 'Could not remove trainee.');
                }
            } catch (err) {
                showAppToast('error', 'Connection Error', err.message);
            }
        };

        window.adminApproveSessionTrainee = async function (assignmentId, traineeName, sessionId, sendEmail = true) {
            if (!assignmentId) return;
            try {
                const res = await fetch(`/Attendance/ApproveSessionTrainee?assignmentId=${assignmentId}&sendEmail=${sendEmail}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'تم الاعتماد بنجاح', data.message || `تم اعتماد المتدرب ${traineeName} بنجاح.`);
                    loadSessionTraineesData(sessionId || sessionTraineesState.sessionId);
                } else {
                    showAppToast('error', 'تعذر الاعتماد', data.message);
                }
            } catch (err) {
                showAppToast('error', 'خطأ في الاتصال', err.message);
            }
        };

        window.adminApproveAllPendingSessionTrainees = async function (sessionId, sendEmail = true) {
            sessionId = sessionId || sessionTraineesState.sessionId;
            if (!sessionId) return;

            const confirmResult = await Swal.fire({
                title: '<div class="text-base font-black text-slate-800">اعتماد وقبول جميع المتدربين المعلقين؟</div>',
                html: '<p class="text-xs text-slate-500 leading-relaxed">سيتم قبول واعتماد جميع المتدربين المعلقين في هذه الجلسة فوراً دون الحاجة لانتظار موافقة مدراء الفروع مع إشعارهم عبر البريد الإلكتروني.</p>',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-check-double mr-1"></i> نعم، اعتماد الكل الآن',
                cancelButtonText: 'إلغاء',
                customClass: {
                    confirmButton: 'px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs',
                    cancelButton: 'px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs'
                }
            });

            if (!confirmResult.isConfirmed) return;

            try {
                const res = await fetch(`/Attendance/ApproveAllPendingSessionTrainees?sessionId=${sessionId}&sendEmail=${sendEmail}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'تم الاعتماد بنجاح', data.message);
                    loadSessionTraineesData(sessionId);
                } else {
                    showAppToast('error', 'تعذر الاعتماد', data.message);
                }
            } catch (err) {
                showAppToast('error', 'خطأ في الاتصال', err.message);
            }
        };

        window.initiateSessionTraineeReplace = function (cstId, sessionId, companyId, branchName, traineeName, branchId, userCode, userId) {
            if (typeof openReplaceCompanyModal === 'function') {
                openReplaceCompanyModal(cstId, sessionId, companyId, branchName, traineeName, branchId, userCode, userId);
            } else {
                showAppToast('error', 'Error', 'Replacement modal is not available on this page.');
            }
        };

        window.uploadSessionExcelDirect = async function () {
            const fileInput = document.getElementById('sessionExcelFile');
            if (!fileInput.files || fileInput.files.length === 0) {
                showAppToast('warning', 'Notice', 'Please select an Excel file first.');
                return;
            }

            const bypassExcel = document.getElementById('chkExcelBypassApproval') ? document.getElementById('chkExcelBypassApproval').checked : false;
            const sendRabbitMqEmail = document.getElementById('chkExcelSendRabbitMqEmail') ? document.getElementById('chkExcelSendRabbitMqEmail').checked : true;

            const formData = new FormData();
            formData.append('sessionId', sessionTraineesState.sessionId);
            formData.append('excelFile', fileInput.files[0]);
            formData.append('bypassApproval', bypassExcel);
            formData.append('sendEmail', sendRabbitMqEmail);

            showAppToast('info', 'Importing...', 'Reading Excel file and assigning trainees...');

            try {
                const res = await fetch('/Attendance/ImportSessionTraineesFromExcel', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    sessionTraineesState.hasModified = true;
                    showAppToast('success', 'Imported Successfully', data.message || 'Excel trainees imported successfully.');
                    fileInput.value = '';
                    switchTraineesTab('current');
                    loadSessionTraineesData(sessionTraineesState.sessionId);
                } else {
                    showAppToast('error', 'Import Error', data.message || 'Failed to import Excel.');
                }
            } catch (err) {
                showAppToast('error', 'Upload Failed', err.message);
            }
        };

        // ==========================================
        // Session Total Seats Direct Management
        // ==========================================
        window.saveSessionTotalSeatsDirect = async function () {
            const input = document.getElementById('inputSessionTotalSeats');
            const val = parseInt(input?.value) || 50;
            if (val <= 0) {
                showAppToast('warning', 'Notice', 'يرجى إدخال رقم صحيح لسعة المقاعد.');
                return;
            }
            sessionTraineesState.totalSeats = val;
            try {
                const res = await fetch('/Attendance/UpdateSessionTotalSeats', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId: sessionTraineesState.sessionId, totalSeats: val })
                });
                const data = await res.json();
                if (data.success) {
                    showAppToast('success', 'تم حفظ السعة', `تم تحديث سعة مقاعد الجلسة إلى ${val} مقعد.`);
                    updateInjectionHeadcount();
                } else {
                    showAppToast('error', 'تعذر الحفظ', data.message || 'فشل تحديث سعة المقاعد.');
                }
            } catch (err) {
                showAppToast('error', 'خطأ في الاتصال', err.message);
            }
        };

        window.onSessionTotalSeatsChanged = function () {
            const input = document.getElementById('inputSessionTotalSeats');
            const val = parseInt(input?.value) || 50;
            sessionTraineesState.totalSeats = val;
            updateInjectionHeadcount();
        };

        // ==========================================
        // Session Injection Rule & Fair Rotation Logic
        // ==========================================
        let injectionState = {
            loaded: false,
            branchStaffLoaded: false,
            currentMode: 'branchStaff',
            departments: [],
            branches: [],
            shifts: [],
            shiftGroups: [],
            selectedBranchIds: [], // Empty means all branches
            selectedShiftIds: [],  // Empty means all shifts
            savedRules: [],
            previewCandidates: [],
            availablePharmacists: 0,
            availableAssistants: 0,
            _lastExceededCount: null
        };

        window.switchInjectionMode = function(mode) {
            injectionState.currentMode = mode;
            const btnBranch = document.getElementById('btnModeBranchStaff');
            const btnDept = document.getElementById('btnModeDepartments');
            const btnCombined = document.getElementById('btnModeCombined');
            const containerBranch = document.getElementById('injectionBranchStaffContainer');
            const containerDept = document.getElementById('injectionDepartmentsContainer');
            const titleElem = document.getElementById('injectionSectionTitle');

            const activeClass = 'flex-1 py-2.5 px-3 rounded-xl font-black text-xs transition-all flex items-center justify-center gap-1.5 bg-white text-purple-700 shadow-sm border border-purple-200/50';
            const inactiveClass = 'flex-1 py-2.5 px-3 rounded-xl font-bold text-xs transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800';

            if (btnBranch) btnBranch.className = mode === 'branchStaff' ? activeClass : inactiveClass;
            if (btnDept) btnDept.className = mode === 'departments' ? activeClass : inactiveClass;
            if (btnCombined) btnCombined.className = mode === 'combined' ? activeClass : inactiveClass;

            if (mode === 'branchStaff') {
                containerBranch.classList.remove('hidden');
                containerDept.classList.add('hidden');
                if (titleElem) titleElem.textContent = 'كوتة الصيادلة والمساعدين بالفروع';
                if (!injectionState.branchStaffLoaded) {
                    loadInjectionBranchStaffMetadata();
                }
            } else if (mode === 'departments') {
                containerDept.classList.remove('hidden');
                containerBranch.classList.add('hidden');
                if (titleElem) titleElem.textContent = 'كوتة الأقسام الإدارية (Departments)';
                if (!injectionState.loaded) {
                    loadInjectionDepartments();
                }
            } else { // combined
                containerBranch.classList.remove('hidden');
                containerDept.classList.remove('hidden');
                if (titleElem) titleElem.textContent = 'توزيع مجمع (صيادلة + مساعدين + أقسام إدارية معاً)';
                if (!injectionState.branchStaffLoaded) {
                    loadInjectionBranchStaffMetadata();
                }
                if (!injectionState.loaded) {
                    loadInjectionDepartments();
                }
            }
            updateInjectionHeadcount();
        };

        window.loadInjectionBranchStaffMetadata = async function () {
            try {
                const res = await fetch(`/Attendance/GetBranchStaffMetadataForInjection?sessionId=${sessionTraineesState.sessionId || 0}`);
                const data = await res.json();
                if (data.success) {
                    injectionState.branches = data.branches || [];
                    injectionState.shifts = data.shifts || [];
                    injectionState.shiftGroups = data.shiftGroups || [];
                    injectionState.availablePharmacists = data.totalPharmacists || 0;
                    injectionState.availableAssistants = data.totalAssistants || 0;
                    injectionState.branchStaffLoaded = true;

                    renderInjectionBranches();
                    renderInjectionShiftGroups();
                    renderInjectionShifts();
                    updateAvailableStaffBadges(data.totalPharmacists, data.totalAssistants);
                }
            } catch (err) {
                console.error('Failed to load branch staff metadata:', err);
            }
        };

        window.renderInjectionShiftGroups = function () {
            const container = document.getElementById('injectionShiftGroupsBar');
            if (!container) return;
            const groups = injectionState.shiftGroups || [];
            if (groups.length === 0) {
                container.innerHTML = '';
                return;
            }

            const totalShifts = injectionState.shifts.length;
            const selectedCount = injectionState.selectedShiftIds.length;

            let currentVal = 'ALL';
            if (selectedCount === 0) {
                currentVal = 'NONE';
            } else if (selectedCount === totalShifts) {
                currentVal = 'ALL';
            } else {
                // Check if it matches a specific group exactly
                const matchedGroup = groups.find(g => {
                    const gId = g.id ?? g.Id;
                    const groupShiftIds = injectionState.shifts.filter(s => (s.groupId ?? s.GroupId) === gId).map(s => s.id ?? s.Id);
                    return groupShiftIds.length > 0 && 
                           groupShiftIds.length === selectedCount && 
                           groupShiftIds.every(id => injectionState.selectedShiftIds.includes(id));
                });
                if (matchedGroup) {
                    currentVal = String(matchedGroup.id ?? matchedGroup.Id);
                } else {
                    currentVal = 'CUSTOM';
                }
            }

            let optionsHtml = '';
            if (currentVal === 'CUSTOM') {
                optionsHtml += `<option value="CUSTOM" selected>اختيار مخصص (${selectedCount} شيفت محدد)</option>`;
            }
            optionsHtml += `<option value="ALL" ${currentVal === 'ALL' ? 'selected' : ''}>تحديد جميع الشيفتات (الكل - ${totalShifts})</option>`;

            groups.forEach(g => {
                const gId = String(g.id ?? g.Id);
                const gName = g.groupName || g.GroupName || 'Group';
                const count = g.shiftsCount ?? g.ShiftsCount ?? 0;
                const isSelected = (currentVal === gId);
                optionsHtml += `<option value="${gId}" ${isSelected ? 'selected' : ''}>${gName} (${count} شيفت)</option>`;
            });

            optionsHtml += `<option value="NONE" ${currentVal === 'NONE' ? 'selected' : ''}>إلغاء تحديد الكل</option>`;

            container.innerHTML = `
                <div class="relative w-full">
                    <div class="flex items-center gap-2 bg-slate-50 hover:bg-slate-100/70 border border-slate-200 rounded-xl px-2.5 py-1.5 focus-within:border-indigo-500 focus-within:bg-white shadow-2xs transition-all">
                        <i class="fas fa-layer-group text-indigo-600 text-xs shrink-0"></i>
                        <select id="injectionShiftGroupSelect" onchange="onInjectionShiftGroupSelectChange(this.value)" class="w-full bg-transparent text-xs font-bold text-slate-800 outline-none cursor-pointer">
                            ${optionsHtml}
                        </select>
                    </div>
                </div>
            `;
        };

        window.onInjectionShiftGroupSelectChange = function (val) {
            if (!val || val === 'CUSTOM') return;

            if (val === 'ALL') {
                selectAllInjectionShifts(true);
                return;
            }

            if (val === 'NONE') {
                selectAllInjectionShifts(false);
                return;
            }

            const groupId = parseInt(val);
            const groupShifts = injectionState.shifts.filter(s => (s.groupId ?? s.GroupId) === groupId);
            const groupShiftIds = groupShifts.map(s => s.id ?? s.Id);
            const groupObj = injectionState.shiftGroups.find(g => (g.id ?? g.Id) === groupId);
            const groupName = groupObj ? (groupObj.groupName || groupObj.GroupName) : 'المجموعة المحددة';

            injectionState.selectedShiftIds = [...groupShiftIds];
            renderInjectionShifts();
            renderInjectionShiftGroups();
            updateShiftFilterUI();
            fetchLiveAvailableStaffCounts();

            showAppToast('info', 'تم تحديد المجموعة', `تم تحديد ${groupShiftIds.length} شيفت تابع لمجموعة "${groupName}".`);
        };

        window.toggleShiftGroupByPill = function (groupId) {
            onInjectionShiftGroupSelectChange(String(groupId));
        };

        window.updateAvailableStaffBadges = function (pharmCount, assistCount) {
            const pharmBadge = document.getElementById('badgeAvailablePharmacists');
            const assistBadge = document.getElementById('badgeAvailableAssistants');
            if (pharmBadge) {
                pharmBadge.innerHTML = `<i class="fas fa-check-circle text-purple-600 mr-1"></i> ${pharmCount} صيدلي متاح`;
            }
            if (assistBadge) {
                assistBadge.innerHTML = `<i class="fas fa-check-circle text-indigo-600 mr-1"></i> ${assistCount} مساعد متاح`;
            }
        };

        window.updateScopeBadge = function () {
            const scopeBadge = document.getElementById('scopeActiveFiltersBadge');
            if (!scopeBadge) return;
            const bTotal = injectionState.branches.length;
            const bSel = injectionState.selectedBranchIds.length;
            const sTotal = injectionState.shifts.length;
            const sSel = injectionState.selectedShiftIds.length;

            const bText = (bSel === 0 || bSel === bTotal) ? 'جميع الفروع' : `${bSel} فرع محدد`;
            const sText = (sSel === 0 || sSel === sTotal) ? 'جميع الشيفتات' : `${sSel} شيفت محدد`;

            scopeBadge.textContent = `${bText} • ${sText}`;
            if ((bSel > 0 && bSel < bTotal) || (sSel > 0 && sSel < sTotal)) {
                scopeBadge.className = 'text-[10px] font-black bg-purple-600 text-white px-3 py-1 rounded-full shadow-2xs';
            } else {
                scopeBadge.className = 'text-[10px] font-black bg-purple-50 text-purple-700 border border-purple-200 px-3 py-1 rounded-full shadow-2xs';
            }
        };

        let liveCountDebounceTimer = null;
        window.fetchLiveAvailableStaffCounts = function () {
            clearTimeout(liveCountDebounceTimer);
            liveCountDebounceTimer = setTimeout(async () => {
                try {
                    // 1. Live counts for Pharmacists & Assistants
                    const res = await fetch('/Attendance/GetAvailableBranchStaffCounts', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            sessionId: sessionTraineesState.sessionId || 0,
                            branchIds: injectionState.selectedBranchIds.length > 0 ? injectionState.selectedBranchIds : null,
                            shiftIds: injectionState.selectedShiftIds.length > 0 ? injectionState.selectedShiftIds : null
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        injectionState.availablePharmacists = data.availablePharmacists || 0;
                        injectionState.availableAssistants = data.availableAssistants || 0;
                        updateAvailableStaffBadges(data.availablePharmacists, data.availableAssistants);
                    }

                    // 2. Also refresh Department personnel live counts based on chosen branches and shifts!
                    await loadInjectionDepartments(true);
                } catch (err) {
                    console.error('Failed to fetch live counts:', err);
                }
            }, 250);
        };

        window.renderInjectionBranches = function (filteredList) {
            const container = document.getElementById('injectionBranchesContainer');
            if (!container) return;
            const list = filteredList || injectionState.branches;
            if (!list || list.length === 0) {
                container.innerHTML = '<div class="col-span-full text-center py-4 text-xs text-slate-400">لا توجد فروع مطابقة للبحث</div>';
                return;
            }

            container.innerHTML = list.map(b => {
                const bId = b.id ?? b.Id;
                const bName = b.branchName || b.BranchName || 'Branch';
                const isChecked = injectionState.selectedBranchIds.includes(bId);
                const pCount = b.pharmacistCount ?? b.PharmacistCount ?? 0;
                const aCount = b.assistantCount ?? b.AssistantCount ?? 0;

                return `
                    <label class="flex items-center justify-between p-2 rounded-xl border ${isChecked ? 'bg-purple-50/90 border-purple-300 text-purple-900 shadow-2xs font-bold' : 'bg-white border-slate-200/90 text-slate-700 hover:border-purple-200'} cursor-pointer transition-all select-none text-xs">
                        <div class="flex items-center gap-2 truncate min-w-0">
                            <input type="checkbox" value="${bId}" ${isChecked ? 'checked' : ''} onchange="toggleInjectionBranch(${bId}, this.checked)" class="w-3.5 h-3.5 rounded text-purple-600 focus:ring-purple-500 border-slate-300" />
                            <span class="truncate">${bName}</span>
                        </div>
                        <span class="text-[9px] font-mono text-slate-400 shrink-0 ml-1" title="الصيادلة: ${pCount} | المساعدين: ${aCount}">
                            ${pCount}ص / ${aCount}م
                        </span>
                    </label>
                `;
            }).join('');
        };

        window.filterInjectionBranchesList = function (term) {
            if (!term || !term.trim()) {
                renderInjectionBranches();
                return;
            }
            const q = term.trim().toLowerCase();
            const filtered = injectionState.branches.filter(b => {
                const name = (b.branchName || b.BranchName || '').toLowerCase();
                return name.includes(q);
            });
            renderInjectionBranches(filtered);
        };

        window.toggleInjectionBranch = function (bId, isChecked) {
            if (isChecked) {
                if (!injectionState.selectedBranchIds.includes(bId)) {
                    injectionState.selectedBranchIds.push(bId);
                }
            } else {
                injectionState.selectedBranchIds = injectionState.selectedBranchIds.filter(id => id !== bId);
            }
            updateBranchFilterUI();
            fetchLiveAvailableStaffCounts();
        };

        window.selectAllInjectionBranches = function (selectAll) {
            if (selectAll) {
                injectionState.selectedBranchIds = injectionState.branches.map(b => b.id ?? b.Id);
            } else {
                injectionState.selectedBranchIds = [];
            }
            renderInjectionBranches();
            updateBranchFilterUI();
            fetchLiveAvailableStaffCounts();
        };

        window.updateBranchFilterUI = function () {
            const badge = document.getElementById('selectedBranchesCountBadge');
            const total = injectionState.branches.length;
            const selected = injectionState.selectedBranchIds.length;

            if (badge) {
                if (selected === 0 || selected === total) {
                    badge.textContent = `جميع الفروع (${total})`;
                    badge.className = 'text-[10px] font-black bg-purple-100 text-purple-700 px-2.5 py-0.5 rounded-full';
                } else {
                    badge.textContent = `تم تحديد ${selected} من ${total} فرع`;
                    badge.className = 'text-[10px] font-black bg-brand-100 text-brand-700 px-2.5 py-0.5 rounded-full';
                }
            }
            updateScopeBadge();
        };

        window.renderInjectionShifts = function (filteredList) {
            const container = document.getElementById('injectionShiftsContainer');
            if (!container) return;
            const list = filteredList || injectionState.shifts;
            if (!list || list.length === 0) {
                container.innerHTML = '<span class="text-xs text-slate-400 p-2 block text-center">لا توجد شيفتات مسجلة</span>';
                return;
            }

            container.innerHTML = list.map(s => {
                const sId = s.id ?? s.Id;
                const sName = s.shiftName || s.ShiftName || 'Shift';
                const isChecked = injectionState.selectedShiftIds.includes(sId);
                const timeStr = s.timeFormatted || (s.startTime && s.endTime ? `من ${s.startTime} إلى ${s.endTime}` : '');
                const pCount = s.pharmacistCount ?? 0;
                const aCount = s.assistantCount ?? 0;
                const gName = s.groupName || s.GroupName || '';
                const gColor = s.groupColor || s.GroupColor || '#7C3AED';

                return `
                    <label class="flex items-center justify-between p-2 rounded-xl border ${isChecked ? 'bg-indigo-50 border-indigo-400 text-indigo-950 shadow-2xs font-bold' : 'bg-white border-slate-200/90 text-slate-700 hover:border-indigo-300 font-medium'} cursor-pointer text-xs transition-all select-none">
                        <div class="flex items-center gap-2 min-w-0">
                            <input type="checkbox" value="${sId}" ${isChecked ? 'checked' : ''} onchange="toggleInjectionShift(${sId}, this.checked)" class="w-3.5 h-3.5 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 shrink-0" />
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="font-black text-slate-900 truncate">${sName}</span>
                                    ${gName ? `<span class="px-1.5 py-0.5 rounded text-[8px] font-black border" style="background-color: ${gColor}15; color: ${gColor}; border-color: ${gColor}40;">${gName}</span>` : ''}
                                </div>
                                ${timeStr ? `<div class="text-[10px] text-indigo-700 font-bold mt-0.5 flex items-center gap-1"><i class="fas fa-clock text-[9px] text-indigo-500"></i><span>${timeStr}</span></div>` : ''}
                            </div>
                        </div>
                        <span class="text-[9px] font-mono text-slate-400 shrink-0 ml-1.5" title="الصيادلة: ${pCount} | المساعدين: ${aCount}">
                            ${pCount}ص / ${aCount}م
                        </span>
                    </label>
                `;
            }).join('');
        };

        window.filterInjectionShiftsList = function (term) {
            if (!term || !term.trim()) {
                renderInjectionShifts();
                return;
            }
            const q = term.trim().toLowerCase();
            const filtered = injectionState.shifts.filter(s => {
                const name = (s.shiftName || s.ShiftName || '').toLowerCase();
                const time = (s.timeFormatted || '').toLowerCase();
                const gName = (s.groupName || s.GroupName || '').toLowerCase();
                return name.includes(q) || time.includes(q) || gName.includes(q);
            });
            renderInjectionShifts(filtered);
        };

        window.toggleInjectionShift = function (sId, isChecked) {
            if (isChecked) {
                if (!injectionState.selectedShiftIds.includes(sId)) {
                    injectionState.selectedShiftIds.push(sId);
                }
            } else {
                injectionState.selectedShiftIds = injectionState.selectedShiftIds.filter(id => id !== sId);
            }
            renderInjectionShiftGroups();
            updateShiftFilterUI();
            fetchLiveAvailableStaffCounts();
        };

        window.selectAllInjectionShifts = function (selectAll) {
            if (selectAll) {
                injectionState.selectedShiftIds = injectionState.shifts.map(s => s.id ?? s.Id);
            } else {
                injectionState.selectedShiftIds = [];
            }
            renderInjectionShifts();
            renderInjectionShiftGroups();
            updateShiftFilterUI();
            fetchLiveAvailableStaffCounts();
        };

        window.updateShiftFilterUI = function () {
            const badge = document.getElementById('selectedShiftsCountBadge');
            const total = injectionState.shifts.length;
            const selected = injectionState.selectedShiftIds.length;

            if (badge) {
                if (selected === 0 || selected === total) {
                    badge.textContent = `جميع الشيفتات (${total})`;
                    badge.className = 'text-[10px] font-black bg-indigo-100 text-indigo-700 px-2.5 py-0.5 rounded-full';
                } else {
                    badge.textContent = `تم تحديد ${selected} من ${total} شيفت`;
                    badge.className = 'text-[10px] font-black bg-purple-100 text-purple-700 px-2.5 py-0.5 rounded-full';
                }
            }
            updateScopeBadge();
        };

        window.onBranchStaffQuotaChanged = function () {
            updateInjectionHeadcount();
        };

        window.loadInjectionDepartments = async function (preserveValues = false) {
            const listWrapper = document.getElementById('injectionDepartmentsList');
            if (!listWrapper) return;

            // Save any values entered by the user
            const savedQuotas = {};
            if (preserveValues) {
                document.querySelectorAll('.dept-quota-input').forEach(input => {
                    const val = parseInt(input.value) || 0;
                    if (val > 0) savedQuotas[input.dataset.deptId] = val;
                });
            } else if (!injectionState.departments || injectionState.departments.length === 0) {
                listWrapper.innerHTML = `
                    <div class="col-span-full text-center py-8 text-slate-400">
                        <i class="fas fa-spinner fa-spin text-xl text-purple-500 mb-2 block"></i>
                        Loading departments and staff data...
                    </div>`;
            }

            try {
                const res = await fetch('/Attendance/GetDepartmentsForInjection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: sessionTraineesState.sessionId || 0,
                        branchIds: injectionState.selectedBranchIds.length > 0 ? injectionState.selectedBranchIds : null,
                        shiftIds: injectionState.selectedShiftIds.length > 0 ? injectionState.selectedShiftIds : null
                    })
                });
                const data = await res.json();
                if (data.success && data.data) {
                    injectionState.departments = data.data;
                    injectionState.loaded = true;
                    renderInjectionDepartments(savedQuotas);
                } else {
                    if (!preserveValues) {
                        listWrapper.innerHTML = `<div class="col-span-full text-center py-6 text-rose-500 font-bold">${data.message || 'Failed to load departments'}</div>`;
                    }
                }
            } catch (err) {
                if (!preserveValues) {
                    listWrapper.innerHTML = `<div class="col-span-full text-center py-6 text-rose-500 font-bold">Connection error: ${err.message}</div>`;
                }
            }
        };

        window.renderInjectionDepartments = function (savedQuotas = {}) {
            const listWrapper = document.getElementById('injectionDepartmentsList');
            if (!listWrapper) return;
            if (!injectionState.departments || injectionState.departments.length === 0) {
                listWrapper.innerHTML = `<div class="col-span-full text-center py-6 text-slate-400">No departments found in the system</div>`;
                return;
            }

            listWrapper.innerHTML = injectionState.departments.map(d => {
                const deptId = d.id ?? d.Id;
                const deptName = d.name || d.Name || 'Department';
                const staffCount = d.staffCount ?? d.ActiveStaffCount ?? 0;
                const prevVal = savedQuotas[deptId] !== undefined ? savedQuotas[deptId] : '';

                return `
                <div class="p-3.5 bg-white rounded-2xl border border-slate-200/90 hover:border-purple-300 flex items-center justify-between gap-3 shadow-2xs hover:shadow-xs transition-all group">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm shrink-0 font-bold border border-purple-100 group-hover:bg-purple-600 group-hover:text-white transition-all shadow-2xs">
                            <i class="fas fa-users-gear"></i>
                        </div>
                        <div class="min-w-0">
                            <h5 class="text-xs font-black text-slate-800 truncate">${deptName}</h5>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <span class="w-1.5 h-1.5 rounded-full ${staffCount > 0 ? 'bg-emerald-500' : 'bg-slate-300'}"></span>
                                <span class="text-[10px] text-slate-400 font-bold">${staffCount} Available Staff</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 focus-within:border-purple-500 focus-within:bg-white transition-all shadow-2xs">
                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">Quota:</span>
                        <input type="number" min="0" max="${staffCount}" data-dept-id="${deptId}" data-dept-name="${deptName}"
                               oninput="updateInjectionHeadcount()"
                               value="${prevVal}"
                               placeholder="0"
                               class="dept-quota-input w-14 px-1 py-0.5 bg-transparent text-xs font-black text-center text-purple-700 outline-none font-mono" />
                    </div>
                </div>`;
            }).join('');
            updateInjectionHeadcount();
        };

        window.updateInjectionHeadcount = function () {
            const badge = document.getElementById('injectionTotalHeadcountBadge');
            const badgeBranch = document.getElementById('badgeTabBranchStaffCount');
            const badgeDept = document.getElementById('badgeTabDeptCount');

            const pharmQuota = parseInt(document.getElementById('inputQuotaPharmacist')?.value) || 0;
            const assistQuota = parseInt(document.getElementById('inputQuotaAssistant')?.value) || 0;
            const branchStaffTotal = pharmQuota + assistQuota;

            let deptTotal = 0;
            document.querySelectorAll('.dept-quota-input').forEach(input => {
                deptTotal += parseInt(input.value) || 0;
            });

            if (badgeBranch) {
                if (branchStaffTotal > 0) {
                    badgeBranch.textContent = `${branchStaffTotal} مقعد`;
                    badgeBranch.classList.remove('hidden');
                } else {
                    badgeBranch.classList.add('hidden');
                }
            }

            if (badgeDept) {
                if (deptTotal > 0) {
                    badgeDept.textContent = `${deptTotal} مقعد`;
                    badgeDept.classList.remove('hidden');
                } else {
                    badgeDept.classList.add('hidden');
                }
            }

            const grandTotal = branchStaffTotal + deptTotal;
            const totalSeats = parseInt(document.getElementById('inputSessionTotalSeats')?.value) || sessionTraineesState.totalSeats || 50;
            const btnPreview = document.getElementById('btnPreviewInjection');
            const btnExecute = document.getElementById('btnExecuteInjection');
            const previewCard = document.getElementById('injectionPreviewResultsCard');

            if (grandTotal > totalSeats) {
                // If count exceeds total seats, immediately hide and reset preview
                if (previewCard && !previewCard.classList.contains('hidden')) {
                    previewCard.classList.add('hidden');
                    injectionState.previewCandidates = [];
                }

                // Visually disable preview and confirm buttons
                if (btnPreview) {
                    btnPreview.classList.add('opacity-50', 'cursor-not-allowed');
                    btnPreview.title = `تجاوزت سعة المقاعد المحددة (${grandTotal} / ${totalSeats} مقعد)`;
                }
                if (btnExecute) {
                    btnExecute.classList.add('opacity-50', 'cursor-not-allowed');
                    btnExecute.title = `تجاوزت سعة المقاعد المحددة (${grandTotal} / ${totalSeats} مقعد)`;
                }

                if (badge) {
                    let details = [];
                    if (pharmQuota > 0) details.push(`${pharmQuota} صيدلي`);
                    if (assistQuota > 0) details.push(`${assistQuota} مساعد`);
                    if (deptTotal > 0) details.push(`${deptTotal} إداري`);

                    const detailsStr = details.length > 0 ? ` (${details.join(' + ')})` : '';

                    badge.className = 'text-xs font-black font-mono text-rose-700 bg-rose-50 px-3.5 py-1.5 rounded-xl border-2 border-rose-400 shadow-sm animate-pulse';
                    badge.innerHTML = `<i class="fas fa-exclamation-triangle text-rose-600 mr-1.5"></i> تجاوز سعة المقاعد: ${grandTotal} / ${totalSeats} مقعد${detailsStr}`;

                    // Trigger toast error if count newly exceeds total seats
                    if (injectionState._lastExceededCount !== grandTotal) {
                        injectionState._lastExceededCount = grandTotal;
                        showAppToast('error', 'تم تجاوز سعة المقاعد!', `العدد المطلوب (${grandTotal} مقعد) أكبر من سعة الجلسة المتاحة (${totalSeats} مقعد)! تم إيقاف المعاينة والتسكين.`);
                    }
                }
            } else {
                injectionState._lastExceededCount = null;

                if (btnPreview) {
                    btnPreview.classList.remove('opacity-50', 'cursor-not-allowed');
                    btnPreview.removeAttribute('title');
                }
                if (btnExecute) {
                    btnExecute.classList.remove('opacity-50', 'cursor-not-allowed');
                    btnExecute.removeAttribute('title');
                }

                if (badge) {
                    let details = [];
                    if (pharmQuota > 0) details.push(`${pharmQuota} صيدلي`);
                    if (assistQuota > 0) details.push(`${assistQuota} مساعد`);
                    if (deptTotal > 0) details.push(`${deptTotal} إداري`);

                    const detailsStr = details.length > 0 ? ` (${details.join(' + ')})` : '';

                    badge.className = 'text-xs font-black font-mono text-purple-700 bg-purple-50 px-3.5 py-1.5 rounded-xl border border-purple-200/80 shadow-2xs';
