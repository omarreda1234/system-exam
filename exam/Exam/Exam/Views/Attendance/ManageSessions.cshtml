                                Loading departments and available personnel...
                            </div>
                        </div>
                    </div>

                    <!-- Options: Notifications & Approval -->
                    <div class="grid grid-cols-1 gap-2.5">
                        <!-- In-App Notification -->
                        <label class="flex items-center justify-between p-3.5 bg-white hover:bg-slate-50/80 border border-slate-200/90 rounded-2xl cursor-pointer shadow-2xs transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm shrink-0 border border-blue-100">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-black text-slate-800">In-App Notification</div>
                                    <div class="text-[11px] text-slate-400 font-medium">Send instant in-app platform notification to nominated candidates</div>
                                </div>
                            </div>
                            <input type="checkbox" id="chkInjectionSendNotif" checked class="w-4 h-4 rounded text-purple-600 focus:ring-purple-500 border-slate-300" />
                        </label>

                        <!-- n8n Automated Email Dispatch -->
                        <label class="flex items-center justify-between p-3.5 bg-white hover:bg-slate-50/80 border border-slate-200/90 rounded-2xl cursor-pointer shadow-2xs transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm shrink-0 border border-purple-100">
                                    <i class="fas fa-envelope-open-text"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-black text-slate-800">n8n Automated Email Dispatch</div>
                                    <div class="text-[11px] text-slate-400 font-medium">Trigger <strong>n8n Webhook API</strong> for automated calendar and email invitations</div>
                                </div>
                            </div>
                            <input type="checkbox" id="chkInjectionSendN8n" checked class="w-4 h-4 rounded text-purple-600 focus:ring-purple-500 border-slate-300" />
                        </label>

                        <!-- Instant Direct Approval -->
                        <label class="flex items-center justify-between p-3.5 bg-amber-50/40 hover:bg-amber-50/70 border border-amber-200/80 rounded-2xl cursor-pointer shadow-2xs transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-sm shrink-0 border border-amber-200">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-black text-amber-900">Instant Direct Approval (Bypass Approval)</div>
                                    <div class="text-[11px] text-amber-700/80 font-medium">Confirm attendance without waiting for branch manager review</div>
                                </div>
                            </div>
                            <input type="checkbox" id="chkInjectionBypassApproval" class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-amber-300" />
                        </label>
                    </div>

                    <!-- Preview & Action Buttons -->
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
                        <button type="button" onclick="previewInjectionRule()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-black text-xs uppercase tracking-wider shadow-2xs hover:border-purple-300 transition-all flex items-center justify-center gap-2 active:scale-95">
                            <i class="fas fa-eye text-purple-600"></i> <span>Preview Fair Rotation</span>
                        </button>
                        <button type="button" onclick="executeInjectionRule()" id="btnExecuteInjection" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-purple-600 to-brand-600 hover:from-purple-700 hover:to-brand-700 active:scale-95 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-purple-600/25 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-bolt"></i> <span>Confirm & Enroll Candidates</span>
                        </button>
                    </div>

                    <!-- Preview Results Area -->
                    <div id="injectionPreviewResultsCard" class="hidden p-4 bg-slate-50/80 rounded-2xl border border-slate-200 space-y-3 shadow-2xs">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-users text-purple-600"></i>
                                <span>Rotation Preview Results: <span id="injectionPreviewCountBadge" class="font-mono text-purple-600">0</span> Candidates</span>
                            </span>
                            <span class="text-[11px] font-bold text-slate-500">Sorted: Lowest attendance history first, followed by registration date</span>
                        </div>
                        <div id="injectionPreviewCandidatesList" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar pr-1">
