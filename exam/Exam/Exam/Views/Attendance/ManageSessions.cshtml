                html: '<p class="text-xs text-slate-500 mb-3 leading-relaxed">يتيح لك حفظ أعداد المقاعد المحددة كقالب محفوظ (Preset) لاستدعائه وتطبيقه بضغطة زر واحدة في أي جلسة قادمة دون الحاجة لإعادة كتابة الأرقام يدوياً كل مرة.</p>',
                input: 'text',
                inputLabel: 'اسم القالب (مثال: كوتة الفروع 5 صيادلة + 2 مساعدين - صباحي)',
                inputPlaceholder: 'أدخل اسماً معبراً للقالب...',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-save mr-1"></i> حفظ القالب',
                cancelButtonText: 'إلغاء',
                customClass: {
                    confirmButton: 'px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-xs',
                    cancelButton: 'px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs'
                },
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'يرجى إدخال اسم للقالب أولاً!';
                    }
                }
            });

            if (ruleName) {
                try {
                    const res = await fetch('/Attendance/SaveCompanyInjectionRule', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            companyId: sessionTraineesState.companyId || null,
                            ruleName: ruleName.trim(),
                            quotasJson: JSON.stringify(rulePayload),
                            departmentQuotasJson: JSON.stringify(rulePayload)
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showAppToast('success', 'تم الحفظ بنجاح', data.message || 'تم حفظ قالب التوزيع بنجاح.');
                        loadCompanyInjectionRules(sessionTraineesState.companyId);
                    } else {
                        showAppToast('error', 'تعذر الحفظ', data.message);
                    }
                } catch (err) {
                    showAppToast('error', 'خطأ في الاتصال', err.message);
                }
            }
        };

