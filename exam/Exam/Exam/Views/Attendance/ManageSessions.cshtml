                <!-- Tab 4: Injection Rule with Fair Rotation -->
                <div id="tabContentInjection" class="hidden space-y-5">
                    <!-- Header Card / Explainer -->
                    <div class="p-4 bg-gradient-to-r from-purple-50 via-indigo-50/40 to-white border border-purple-100 rounded-2xl flex items-start justify-between gap-4 shadow-2xs">
                        <div class="flex items-start gap-3.5">
                            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white flex items-center justify-center shrink-0 shadow-sm text-base">
                                <i class="fas fa-random"></i>
                            </div>
                            <div>
                                <h4 class="text-xs font-black text-slate-900 uppercase flex items-center gap-2">
                                    <span>Fair-Rotation Department Distribution (Injection Rule)</span>
