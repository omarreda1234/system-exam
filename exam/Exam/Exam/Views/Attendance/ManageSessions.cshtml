@model IEnumerable<dynamic>
@{
    var wave = ViewBag.Wave;
    var company = ViewBag.Company;
    bool isCompany = ViewBag.IsCompany == true;
    
    var title = isCompany ? company.Name : wave.WaveName;
    var subtitle = isCompany ? "Company Training Sessions" : "Wave Training Sessions";
    ViewData["Title"] = $"Manage Sessions - {title}";
}

<div class="min-h-screen bg-slate-50/50 dark:bg-slate-950/20 pb-20">
    <!-- Header -->
    <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-24 pb-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
                    <a href="@Url.Action("Index")" class="w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-400 hover:text-brand-600 hover:bg-brand-50 transition-all shrink-0">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase">@title</h1>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mt-1">@subtitle</p>
                    </div>
                </div>
                
                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    @if (!User.IsInRole("Reception"))
                    {
                        <a href="@Url.Action("ExportAttendance", new { waveId = isCompany ? null : (int?)wave.Id, companyId = isCompany ? (int?)company.Id : null })" class="flex-1 md:flex-none justify-center bg-emerald-600 text-white px-8 py-4 md:py-3 rounded-2xl transition-all text-xs font-black uppercase shadow-lg shadow-emerald-600/20 hover:bg-emerald-700 flex items-center gap-3">
                            <i class="fas fa-file-excel"></i> Export Attendance Report
                        </a>
                        <button onclick="$('#addSessionModal').removeClass('hidden').addClass('flex')" class="flex-1 md:flex-none justify-center bg-brand-600 text-white px-8 py-4 md:py-3 rounded-2xl transition-all text-xs font-black uppercase shadow-lg shadow-brand-600/20 hover:bg-brand-700 flex items-center gap-3">
                            <i class="fas fa-plus"></i> Add New Session
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions List -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-8">
        <div class="grid grid-cols-1 gap-4">
            @foreach (var session in Model)
            {
                <div class="saas-card flex flex-col sm:flex-row sm:items-center justify-between gap-6 group hover:border-brand-500/30 transition-all">
                    <div class="flex items-center gap-4 sm:gap-6">
                        <div class="w-14 h-14 sm:w-16 sm:h-16 bg-slate-50 dark:bg-slate-800 rounded-2xl flex flex-col items-center justify-center border border-slate-100 dark:border-slate-800 shrink-0">
                            <span class="text-[9px] sm:text-[10px] font-black text-brand-600 uppercase">@session.SessionDate.ToString("MMM")</span>
                            <span class="text-lg sm:text-xl font-black text-slate-900 dark:text-white">@session.SessionDate.ToString("dd")</span>
                        </div>
                        <div>
                            <h3 class="font-black text-slate-900 dark:text-white uppercase text-xs sm:text-sm">@session.SessionName</h3>
                            <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-1">
                                <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                                    <i class="far fa-clock text-brand-500"></i> @session.SessionDate.ToString("dddd")
                                    @if (session.StartTime != null && session.EndTime != null)
                                    {
                                        <span class="text-slate-600 dark:text-slate-300 font-extrabold bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-lg border border-slate-200 dark:border-slate-700">
                                            @(((TimeSpan)session.StartTime).ToString(@"hh\:mm")) - @(((TimeSpan)session.EndTime).ToString(@"hh\:mm"))
                                        </span>
                                    }
                                </span>
                                @if (isCompany)
                                {
                                    var specificAssigned = session.SpecificAssignedCount != null ? (int)session.SpecificAssignedCount : 0;
                                    var totalPool = session.TotalTraineesCount != null ? (int)session.TotalTraineesCount : 0;
                                    int enrolledCount = specificAssigned > 0 ? specificAssigned : totalPool;
                                    int present = Convert.ToInt32(session.PresentCount);
                                    int pendingCount = 0;
                                    try { pendingCount = session.PendingAssignedCount != null ? Convert.ToInt32(session.PendingAssignedCount) : 0; } catch {}

                                    if (specificAssigned > 0 || pendingCount > 0)
                                    {
                                        <span id="session-badge-@session.Id" class="text-[9px] sm:text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest bg-indigo-50 dark:bg-indigo-950/40 px-2.5 py-0.5 rounded-full border border-indigo-200 dark:border-indigo-800" title="المتدربين المسجلين في هذه الجلسة">
                                            <i class="fas fa-users mr-1"></i> @specificAssigned Session Trainees @(pendingCount > 0 ? $"({pendingCount} معلق)" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span id="session-badge-@session.Id" class="text-[9px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 rounded-full" title="متدربي الشركة بالكامل">
                                            <i class="fas fa-building mr-1"></i> Company Pool (@totalPool)
                                        </span>
                                    }

                                    if (present > 0)
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest bg-emerald-50 dark:bg-emerald-950/30 px-2.5 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800" title="عدد الحاضرين المسجلين في شيت الغياب">
                                            <i class="fas fa-user-check mr-1"></i> الحضور الفعلي: @present من @enrolledCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-slate-100/70 dark:bg-slate-800/50 px-2.5 py-0.5 rounded-full border border-slate-200/50 dark:border-slate-700/50" title="لم يتم تسجيل حضور للسيشن بعد في شيت الغياب">
                                            <i class="far fa-clock mr-1"></i> لم يسجل حضور بعد (0 من @enrolledCount)
                                        </span>
                                    }
                                }
                                else
                                {
                                    int present = Convert.ToInt32(session.PresentCount);
                                    if (present > 0)
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest bg-emerald-50 dark:bg-emerald-950/20 px-2.5 py-0.5 rounded-full border border-emerald-200/60">
                                            <i class="fas fa-user-check mr-1"></i> @present Trainees Attended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-slate-100 dark:bg-slate-800/60 px-2.5 py-0.5 rounded-full">
                                            <i class="far fa-clock mr-1"></i> 0 Attended (لم يسجل حضور)
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2 border-t sm:border-t-0 pt-4 sm:pt-0 border-slate-100 dark:border-slate-800">
                        @if (isCompany)
                        {
                            <button onclick="openManageSessionTrainees(@session.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(session.SessionName))', @(company?.Id ?? 0))" 
                                    class="flex-1 sm:flex-none text-center bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 sm:py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5" 
                                    title="تعيين متدربي السيشن وتفعيل إشعارات n8n">
                                <i class="fas fa-users-cog"></i> Manage Trainees
                            </button>
                        }
                        <a href="@Url.Action("TakeAttendance", new { sessionId = session.Id })" class="flex-1 sm:flex-none text-center bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white px-6 py-3 sm:py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-600 transition-all">
                            Take Attendance
                        </a>
                        <a href="@Url.Action("ExportSessionAttendance", new { sessionId = session.Id })" class="flex-1 sm:flex-none text-center bg-emerald-50 hover:bg-emerald-600 text-emerald-600 hover:text-white px-5 py-3 sm:py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest border border-emerald-100 dark:border-emerald-950/30 transition-all flex items-center justify-center gap-1.5" title="Export Excel">
                            <i class="fas fa-file-excel"></i> Export Excel
                        </a>
                        @if (!User.IsInRole("Reception"))
                        {
                            <button onclick="editSession(@session.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(session.SessionName))', '@session.SessionDate.ToString("yyyy-MM-dd")', '@(session.StartTime != null ? ((TimeSpan)session.StartTime).ToString(@"hh\:mm") : "09:00")', '@(session.EndTime != null ? ((TimeSpan)session.EndTime).ToString(@"hh\:mm") : "12:00")')" class="w-12 h-12 sm:w-10 sm:h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center hover:bg-amber-500 hover:text-white transition-all border border-amber-100 dark:border-amber-950/30" title="تعديل وقت وتاريخ المحاضرة (Edit Session)">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                            <button onclick="deleteSession(@session.Id)" class="w-12 h-12 sm:w-10 sm:h-10 bg-rose-50 text-rose-500 rounded-xl flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all border border-rose-100 dark:border-rose-950/30" title="Delete Session">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="bg-white dark:bg-slate-900 rounded-[32px] p-20 text-center border-2 border-dashed border-slate-200 dark:border-slate-800 shadow-sm">
                    <p class="text-slate-400 font-bold uppercase text-[10px] tracking-widest">No sessions defined for this training ciclo yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal -->
<div id="addSessionModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-6">
    <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-[32px] p-8 shadow-2xl border border-slate-200 dark:border-slate-800">
        <div class="flex justify-between items-center mb-8">
            <h3 class="text-xl font-black text-slate-900 dark:text-white uppercase">New Session</h3>
            <button onclick="$('#addSessionModal').addClass('hidden').removeClass('flex')" class="text-slate-400 hover:text-rose-500 transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <form asp-action="CreateSession" method="post" class="space-y-5">
            @if (isCompany)
            {
                <input type="hidden" name="companyId" value="@company.Id" />
            }
            else
            {
                <input type="hidden" name="waveId" value="@wave.Id" />
            }
            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Session Date / تاريخ المحاضرة</label>
                <input type="text" id="sessionDatePicker" name="sessionDate" placeholder="dd/mm/yyyy" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Start Time / وقت البداية</label>
                    <input type="time" name="startTime" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-4 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">End Time / وقت النهاية</label>
                    <input type="time" name="endTime" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-4 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
                </div>
            </div>

            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Session Name / Label</label>
                <input type="text" name="sessionName" placeholder="e.g. Day 1: Product Intro" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3.5 text-xs font-bold outline-none focus:border-brand-500 transition-all text-slate-900 dark:text-white" />
            </div>
            <button type="submit" class="w-full bg-brand-600 text-white py-4 rounded-2xl font-black uppercase text-xs tracking-widest shadow-lg shadow-brand-600/20 hover:bg-brand-700 transition-all mt-4">
                Confirm & Create
            </button>
        </form>
    </div>
</div>

@if (isCompany)
{
    <!-- Modal: Manage Session Trainees (Assignment per Session) -->
    <div id="sessionTraineesModal" class="hidden fixed inset-0 z-[105] flex items-center justify-center p-3 sm:p-6 bg-slate-900/60 backdrop-blur-sm animate-fade-in overflow-hidden">
        <style>
            #sessionTraineesModal .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }
            #sessionTraineesModal .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }
            #sessionTraineesModal .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 9999px;
            }
            #sessionTraineesModal .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
        </style>

        <div class="bg-white rounded-[28px] sm:rounded-[32px] shadow-[0_25px_70px_rgba(15,23,42,0.22)] border border-slate-200/90 w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden text-slate-800">
            <!-- Modal Header -->
            <div class="p-5 sm:p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/60 shrink-0">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-50 to-brand-100 text-brand-700 flex items-center justify-center text-lg shadow-2xs border border-brand-200/60">
                        <i class="fas fa-users-cog"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="text-base sm:text-lg font-black text-slate-900 tracking-tight" id="modalSessionTitle">Manage Session Trainees</h3>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-brand-50 text-brand-700 uppercase border border-brand-200 font-mono tracking-wider">Session Level</span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium mt-0.5">Assign attendees, trigger in-app notifications, and dispatch email invites via n8n API</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-wrap justify-end">
                    <!-- Total Seats Control -->
                    <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200/90 shadow-2xs" title="إجمالي سعة المقاعد المخصصة لهذه الجلسة التدريبية">
                        <span class="text-[10px] font-black uppercase text-slate-500 tracking-wider flex items-center gap-1.5">
                            <i class="fas fa-chair text-purple-600"></i>
                            <span>سعة المقاعد:</span>
                        </span>
                        <input type="number" id="inputSessionTotalSeats" min="1" max="1000" value="50" oninput="onSessionTotalSeatsChanged()"
                               class="w-14 text-center text-xs font-black text-purple-700 bg-purple-50 rounded-lg py-1 border border-purple-200 outline-none focus:ring-1 focus:ring-purple-500 font-mono" />
                        <button type="button" onclick="saveSessionTotalSeatsDirect()" class="text-xs font-black text-purple-600 hover:text-purple-800 p-1 transition-all" title="حفظ سعة المقاعد للجلسة">
                            <i class="fas fa-save"></i>
                        </button>
                    </div>

                    <button type="button" id="btnRefreshSessionTrainees" onclick="refreshCurrentSessionTrainees()" class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 font-bold text-xs flex items-center gap-2 transition-all shadow-2xs active:scale-95" title="Refresh Trainee List">
                        <i class="fas fa-sync-alt text-brand-600" id="iconRefreshSessionTrainees"></i>
                        <span>Refresh</span>
                    </button>
                    <button type="button" onclick="closeManageSessionTrainees()" class="w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-all active:scale-95">
                        <i class="fas fa-times text-base"></i>
                    </button>
                </div>
            </div>

            <!-- Tabs Segmented Control -->
            <div class="px-6 py-3 bg-slate-50/70 border-b border-slate-100 flex items-center shrink-0 overflow-x-auto custom-scrollbar">
                <div class="inline-flex p-1 bg-slate-200/60 rounded-2xl gap-1 w-full sm:w-auto">
                    <button type="button" onclick="switchTraineesTab('current')" id="tabBtnCurrent" class="px-4 py-2 text-xs font-black rounded-xl transition-all shrink-0 flex items-center gap-2 bg-white text-brand-700 shadow-xs border border-slate-200/50">
                        <i class="fas fa-user-check"></i> <span>Assigned Trainees (<span id="assignedCountBadge">0</span>)</span>
                    </button>
                    <button type="button" onclick="switchTraineesTab('assign')" id="tabBtnAssign" class="px-4 py-2 text-xs font-bold rounded-xl transition-all shrink-0 flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                        <i class="fas fa-user-plus"></i> <span>Assign Trainees</span>
                    </button>
                    <button type="button" onclick="switchTraineesTab('excel')" id="tabBtnExcel" class="px-4 py-2 text-xs font-bold rounded-xl transition-all shrink-0 flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                        <i class="fas fa-file-excel text-emerald-600"></i> <span>Import Excel Roster</span>
                    </button>
                    <button type="button" onclick="switchTraineesTab('injection')" id="tabBtnInjection" class="px-4 py-2 text-xs font-bold rounded-xl transition-all shrink-0 flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-white/60">
                        <i class="fas fa-random text-purple-600"></i> <span>Fair Rotation Rule</span>
                    </button>
                </div>
            </div>

            <!-- Modal Content Area -->
            <div class="p-6 overflow-y-auto flex-1 custom-scrollbar space-y-4 min-h-0 bg-white">
                <input type="hidden" id="currentSessionId" />

                <!-- Tab 1: Current Assigned -->
                <div id="tabContentCurrent" class="space-y-4">
                    <div id="assignedTraineesList" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Tab 2: Assign from Pool / Search -->
                <div id="tabContentAssign" class="hidden space-y-4">
                    <div class="space-y-2.5 bg-slate-50/80 p-4 rounded-2xl border border-slate-200/80">
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                            <div class="relative w-full flex-1">
                                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="traineeSearchInput" onkeyup="filterTraineePool()" placeholder="Search by name, employee code, or paste multiple codes (e.g. 5061, 5063, 5065)..." class="w-full pl-10 pr-10 py-3 bg-white border border-slate-200 rounded-xl text-xs font-bold outline-none focus:border-brand-500 text-slate-900 transition-all shadow-2xs" autocomplete="off" />
                                <div id="searchSpinner" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-brand-600">
                                    <i class="fas fa-spinner fa-spin text-sm"></i>
                                </div>
                            </div>
                            <div class="flex items-center gap-2.5 shrink-0">
                                <button type="button" onclick="clearSearchInput()" class="px-3.5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-600 text-xs font-bold border border-slate-200 transition-all flex items-center gap-1.5 shadow-2xs">
                                    <i class="fas fa-times text-[10px]"></i> <span>Clear</span>
                                </button>
                                <span id="selectedPoolCount" class="text-xs font-mono font-black text-brand-700 bg-brand-50 px-3.5 py-2 rounded-xl border border-brand-200/80 shadow-2xs">0 Selected</span>
                            </div>
                        </div>
                        <p class="text-[11px] text-slate-400 font-bold flex items-center gap-1.5 pt-0.5">
                            <i class="fas fa-lightbulb text-amber-500 text-xs"></i>
                            <span>Individual or bulk search: Enter candidate name or employee code, or paste multiple codes separated by commas ( , ) or pipes ( | ).</span>
                        </p>
                    </div>

                    <!-- Selected Candidates Queue Tray -->
                    <div id="selectedTrayContainer" class="hidden p-3.5 bg-brand-50/40 border border-brand-100 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-brand-900 flex items-center gap-1.5">
                                <i class="fas fa-user-check text-brand-600"></i>
                                <span>Selected Candidates for Assignment (<span id="trayCount" class="font-mono">0</span>)</span>
                            </span>
                            <button type="button" onclick="clearAllSelected()" class="text-[11px] font-bold text-rose-500 hover:underline">
                                Clear All
                            </button>
                        </div>
                        <div id="selectedChipsList" class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto custom-scrollbar p-0.5">
                            <!-- Populated via JS -->
                        </div>
                    </div>

                    <!-- Options for Notification, n8n Email & Branch Exemption -->
                    <div class="grid grid-cols-1 gap-2.5">
                        <label class="flex items-center justify-between p-3.5 bg-white hover:bg-slate-50/80 border border-slate-200/90 rounded-2xl cursor-pointer shadow-2xs transition-all">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm shrink-0 border border-blue-100">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-black text-slate-800">In-App Notification</div>
                                    <div class="text-[11px] text-slate-400 font-medium">Send instant in-app platform notification to nominated candidates</div>
                                </div>
                            </div>
                            <input type="checkbox" id="chkSendNotification" checked class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300" />
                        </label>

                        <label class="flex items-center justify-between p-3.5 bg-white hover:bg-slate-50/80 border border-slate-200/90 rounded-2xl cursor-pointer shadow-2xs transition-all">
